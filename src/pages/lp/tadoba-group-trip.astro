    .glp-blob-b { left: -8rem; bottom: -8rem; background: radial-gradient(circle, rgba(253,203,8,.14) 0%, rgba(253,203,8,.05) 40%, rgba(253,203,8,0) 70%); }
  }

  .glp-container { position: relative; z-index: 1; margin-inline: auto; max-width: 96rem; padding: 1.5rem 1rem 3rem; }
  @media (min-width: 1024px) { .glp-container { padding: 2.5rem 3rem; } }
  @media (max-width: 1023px) { .glp-container { padding: 0 1rem 2.5rem; } }

  /* Top bar (desktop only, matching reference) */
  .glp-topbar { display: none; }
  @media (min-width: 1024px) { .glp-topbar { display: block; margin-bottom: 2.5rem; width: 80.1875rem; max-width: 100%; margin-inline: auto; } }
  .glp-logo { display: inline-flex; align-items: center; gap: .65rem; }
  .glp-logo-img { width: 2.75rem; height: 2.75rem; border-radius: 50%; flex-shrink: 0; }
  .glp-logo-text { position: relative; top: -.1em; font-family: 'Charmelade Demo', 'Fredoka', Arial, sans-serif; font-weight: 400; font-size: 2rem; line-height: 1; color: #fdcb08; }
  .glp-divider-full { margin-top: 1.5rem; height: 2px; background: rgba(255,255,255,.75); }

  /* Mobile-only logo + divider + glow, scoped to hero (hidden on desktop) */
  .glp-mobile-glow { display: none; }
  .glp-mobile-logo { display: none; }
  @media (max-width: 1023px) {
    .glp-hero { overflow: hidden; }
    .glp-mobile-glow {
      display: block;
      position: absolute;
      right: -5rem;
      top: -6rem;
      width: 17.5rem;
      height: 17.5rem;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(253,203,8,.45) 0%, rgba(253,203,8,.18) 35%, rgba(253,203,8,0) 70%);
      pointer-events: none;
      z-index: 0;
    }
    .glp-mobile-logo {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: .6rem;
      padding-top: 1.5rem;
      margin-right: 1rem;
      margin-bottom: 1.25rem;
      padding-bottom: 1.1rem;
      border-bottom: 1px solid rgba(255,255,255,.75);
    }
    .glp-mobile-logo-img { width: 2rem; height: 2rem; border-radius: 50%; flex-shrink: 0; }
    .glp-mobile-logo-text { position: relative; top: -.1em; font-family: 'Charmelade Demo', 'Fredoka', Arial, sans-serif; font-weight: 400; font-size: 1.5rem; line-height: 1; color: #fdcb08; }
  }

  .glp-layout { display: flex; flex-direction: column; gap: 2.5rem; }
  @media (min-width: 1024px) { .glp-layout { flex-direction: row; align-items: flex-start; justify-content: center; gap: 6rem; } }

  /* Hero */
  .glp-hero { position: relative; color: #fff; }
  @media (min-width: 1024px) { .glp-hero { width: 26.4rem; flex-shrink: 0; } }

  .glp-heading { font-family: 'Fredoka', Arial, sans-serif; font-weight: 600; font-size: 2rem; line-height: 1.25; letter-spacing: -.01em; }
  @media (min-width: 1024px) { .glp-heading { font-size: 2.75rem; } }
