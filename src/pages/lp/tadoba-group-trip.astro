---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { tours } from '../../data/tours';
import wildExcursionsLogo from '../../../we.logo.webp';

const tadobaTours = tours.filter((tour) => tour.jungle === 'tadoba').sort((a, b) => a.price - b.price);
const cheapest = tadobaTours[0];
const avgRating = Math.round((tadobaTours.reduce((sum, t) => sum + t.rating, 0) / tadobaTours.length) * 10) / 10;

type SeatStatus = 'available' | 'low' | 'sold-out';
interface Departure { range: string; status: SeatStatus; label: string; start: string; end: string; }
interface MonthGroup { month: string; year: number; dates: Departure[]; }

const groupDepartures: MonthGroup[] = [
  {
    month: 'October', year: 2026,
    dates: [
      { range: '2 – 4 Oct', status: 'sold-out', label: 'Sold out', start: '2026-10-02', end: '2026-10-04' },
      { range: '9 – 11 Oct', status: 'low', label: 'Only 2 seats left', start: '2026-10-09', end: '2026-10-11' },
      { range: '16 – 18 Oct', status: 'low', label: 'Last 2 seats left', start: '2026-10-16', end: '2026-10-18' },
      { range: '23 – 25 Oct', status: 'available', label: 'Available', start: '2026-10-23', end: '2026-10-25' },
      { range: '30 Oct – 1 Nov', status: 'available', label: 'Available', start: '2026-10-30', end: '2026-11-01' },
    ],
  },
  {
    month: 'November', year: 2026,
    dates: [
      { range: '6 – 8 Nov', status: 'low', label: 'Last 2 seats left', start: '2026-11-06', end: '2026-11-08' },
      { range: '13 – 15 Nov', status: 'sold-out', label: 'Sold out', start: '2026-11-13', end: '2026-11-15' },
      { range: '20 – 22 Nov', status: 'low', label: 'Last 2 seats', start: '2026-11-20', end: '2026-11-22' },
      { range: '27 – 29 Nov', status: 'low', label: 'Last 3 seats left', start: '2026-11-27', end: '2026-11-29' },
    ],
  },
  {
    month: 'December', year: 2026,
    dates: [
      { range: '4 – 6 Dec', status: 'available', label: 'Available', start: '2026-12-04', end: '2026-12-06' },
      { range: '11 – 13 Dec', status: 'available', label: 'Available', start: '2026-12-11', end: '2026-12-13' },
      { range: '18 – 20 Dec', status: 'available', label: 'Available', start: '2026-12-18', end: '2026-12-20' },
      { range: '25 – 27 Dec', status: 'low', label: 'Last 4 seats left', start: '2026-12-25', end: '2026-12-27' },
    ],
  },
  {
    month: 'January', year: 2027,
    dates: [
      { range: '1 – 3 Jan', status: 'low', label: 'Last 3 seats left', start: '2027-01-01', end: '2027-01-03' },
      { range: '8 – 10 Jan', status: 'available', label: 'Available', start: '2027-01-08', end: '2027-01-10' },
      { range: '15 – 17 Jan', status: 'available', label: 'Available', start: '2027-01-15', end: '2027-01-17' },
      { range: '23 – 25 Jan', status: 'low', label: 'Last 4 seats left', start: '2027-01-23', end: '2027-01-25' },
      { range: '29 – 31 Jan', status: 'available', label: 'Available', start: '2027-01-29', end: '2027-01-31' },
    ],
  },
];

const trustCards = [
  {
    title: `★ ${avgRating} Rating`,
    sub: 'Verified Google reviews',
    icon: '<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg>',
  },
  {
    title: '24/7 Customer Support',
    sub: 'Real humans, always on call',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="#1f9d55" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>',
  },
  {
    title: 'Flexible Payments',
    sub: 'EMI and card options available',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#39814f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>',
  },
  {
    title: 'Experience First',
    sub: "It's about the journey, not just the tour",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#a17c00" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="#fdf3d0"/></svg>',
  },
];

const calendarIcon = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>';
const peopleIcon = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>';
const walletIcon = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>';
const sparkleIcon = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>';
const sendIcon = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>';
const chevronIcon = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>';
---

<Layout
  title="Tadoba Group Safari — Check Dates & Book"
  description="Fixed-departure Tadoba tiger safari group trips. Check live seat availability by date and get a callback in minutes."
  hideHeader
  noindex
  hideTripPlannerPopup
  footerCtaOnly
  hideWhatsAppOnMobile
>
  <div class="glp-page">
    <div class="glp-blob glp-blob-a" aria-hidden="true"></div>
    <div class="glp-blob glp-blob-b" aria-hidden="true"></div>

    <div class="glp-container">
      <div class="glp-topbar">
        <a class="glp-logo" href="/">
          <Image src={wildExcursionsLogo} alt="Wild Excursions" width={160} height={160} format="webp" quality={90} loading="eager" fetchpriority="high" class="glp-logo-img" />
          <span class="glp-logo-text">Wild Excursions</span>
        </a>
        <div class="glp-divider-full" aria-hidden="true"></div>
      </div>

      <div class="glp-layout">
        <section class="glp-hero">
          <div class="glp-mobile-glow" aria-hidden="true"></div>
          <div class="glp-mobile-logo">
            <Image src={wildExcursionsLogo} alt="Wild Excursions" width={160} height={160} format="webp" quality={90} loading="eager" fetchpriority="high" class="glp-mobile-logo-img" />
            <span class="glp-mobile-logo-text">Wild Excursions</span>
          </div>
          <h1 class="glp-heading">
            <span class="glp-heading-line">98.7% Chance You'll</span>
            <span class="glp-heading-line">See a Tiger.</span>
            <span class="glp-heading-line glp-heading-accent glp-heading-last">100% Unforgettable experience. <span class="glp-sparkle" set:html={sparkleIcon} /></span>
          </h1>
          <p class="glp-sub">The jungle keeps its secrets - until you arrive.</p>

          <div class="glp-trust-list">
            {trustCards.map((card) => (
              <div class="glp-trust-card">
                <span class="glp-trust-icon" set:html={card.icon} />
                <span class="glp-trust-text">
                  <span class="glp-trust-title">{card.title}</span>
                  <span class="glp-trust-sub" set:html={card.sub} />
                </span>
              </div>
            ))}
          </div>
        </section>

        <section class="glp-panel">
          <div class="glp-card">
            <div class="glp-card-topshape" aria-hidden="true">
              <svg class="glp-card-wave" viewBox="0 0 400 36" preserveAspectRatio="none">
                <path d="M 0,28 A 28,28 0 0 1 28,0 L 160,0 C 178,0 178,26 200,26 C 222,26 222,0 240,0 L 372,0 A 28,28 0 0 1 400,28 L 400,36 L 0,36 Z" fill="#ffffff" />
              </svg>
              <div class="glp-card-handle"></div>
            </div>
            <h2 class="glp-card-heading">Plan my Tadoba trip</h2>
            <p class="glp-card-subheading">Fill in your details and our safari experts will get in touch with you shortly ⚡</p>

            <div class="glp-eyebrow-row">
              <span class="glp-eyebrow">Trip Type</span>
              <span class="glp-eyebrow-line" aria-hidden="true"></span>
            </div>

            <div class="glp-trip-type" role="tablist" aria-label="Trip type">
              <button type="button" class="glp-type-card is-active" role="tab" aria-selected="true" data-lp-tab="group">
                <span class="glp-type-top"><span class="glp-type-emoji">🧳</span><span class="glp-type-title">Group Trip</span></span>
                <span class="glp-type-desc">Travel with like-minded travellers</span>
              </button>
              <button type="button" class="glp-type-card" role="tab" aria-selected="false" data-lp-tab="custom">
                <span class="glp-type-top"><span class="glp-type-emoji">🗺️</span><span class="glp-type-title">Custom Trip</span></span>
                <span class="glp-type-desc">My dates, my pace, my way</span>
              </button>
            </div>

            <!-- Group Trip form -->
            <form class="glp-form" id="group-trip-form" method="post" data-group-trip-form data-lp-panel="group">
              <input type="hidden" name="destination" value="Tadoba" />

              <div class="glp-grid-2">
                <div class="glp-col">
                  <div class="glp-eyebrow-row glp-eyebrow-row--tight">
                    <span class="glp-eyebrow">Your Details</span>
                    <span class="glp-eyebrow-line" aria-hidden="true"></span>
                  </div>

                  <label class="glp-field">
                    <span class="glp-label">Full Name<span class="glp-required">*</span></span>
                    <input type="text" name="name" placeholder="Chota Matka" required class="glp-input" />
                  </label>

                  <label class="glp-field">
                    <span class="glp-label">Phone Number<span class="glp-required">*</span></span>
                    <div class="glp-input glp-phone">
                      <select name="phoneCountry" class="glp-phone-code" aria-label="Country code">
                        <option value="+91" selected>+91</option>
                        <option value="+1">+1</option>
                        <option value="+44">+44</option>
                        <option value="+61">+61</option>
                        <option value="+971">+971</option>
                      </select>
                      <input type="tel" name="phone" placeholder="XXXXXXXXXX" required maxlength="10" inputmode="numeric" class="glp-phone-input" />
                    </div>
                  </label>

                  <label class="glp-field">
                    <span class="glp-label">Email Address</span>
                    <input type="email" name="email" placeholder="chotamatka@tadoba.com" class="glp-input" />
                  </label>

                  <div class="glp-field" data-date-selector>
                    <span class="glp-label glp-label-icon"><span set:html={calendarIcon} />Travel Date<span class="glp-required">*</span></span>
                    <button type="button" class="glp-input glp-date-trigger" data-date-trigger aria-expanded="false">
                      <span data-date-summary>Select a date</span>
                      <span class="glp-chevron" set:html={chevronIcon} />
                    </button>

                    <div class="glp-date-panel" data-date-panel hidden>
                      <div class="glp-date-step" data-date-step="months">
                        <p class="glp-date-step-label">Pick a month</p>
                        <div class="glp-month-grid">
                          {groupDepartures.map((group) => (
                            <button type="button" class="glp-month-chip" data-month-chip data-month={group.month}>
                              {group.month} {group.year}
                            </button>
                          ))}
                        </div>
                      </div>

                      <div class="glp-date-step" data-date-step="dates" hidden>
                        <button type="button" class="glp-date-back" data-date-back>
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 5-5 5 5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                          Back to months
                        </button>
                        {groupDepartures.map((group) => (
                          <div class="glp-date-list" data-month-dates={group.month} hidden>
                            {group.dates.map((d) => (
                              <button
                                type="button"
                                class:list={['glp-date-option', `is-${d.status}`]}
                                data-date-option
                                data-start={d.start}
                                data-end={d.end}
                                data-range={d.range}
                                disabled={d.status === 'sold-out'}
                              >
                                <span class="glp-date-range">{d.range}</span>
                                <span class="glp-date-status">{d.label}</span>
                              </button>
                            ))}
                          </div>
                        ))}
                      </div>
                    </div>
                    <input type="hidden" name="startDate" data-start-date required />
                    <input type="hidden" name="endDate" data-end-date required />
                  </div>
                </div>

                <div class="glp-col">
                  <div class="glp-eyebrow-row glp-eyebrow-row--tight">
                    <span class="glp-eyebrow">Trip Preferences</span>
                    <span class="glp-eyebrow-line" aria-hidden="true"></span>
                  </div>

                  <label class="glp-field">
                    <span class="glp-label glp-label-icon"><span set:html={peopleIcon} />No. of Travellers<span class="glp-required">*</span></span>
                    <select name="travellers" class="glp-input glp-select" required>
                      <option value="" selected disabled>0</option>
                      {Array.from({ length: 9 }, (_, i) => i + 1).map((n) => <option value={n}>{n}</option>)}
                      <option value="10+">10+</option>
                    </select>
                  </label>

                  <div class="glp-field">
                    <span class="glp-label glp-label-icon"><span set:html={walletIcon} />Budget per person</span>
                    <div class="glp-budget">
                      <div class="glp-budget-top">
                        <span class="glp-budget-value">₹<span id="group-budget-value">25,000</span></span>
                        <span class="glp-budget-hint">Slide to adjust</span>
                      </div>
                      <input type="range" name="budget" min="10000" max="100000" step="5000" value="25000" class="glp-range" id="group-budget-range" />
                      <div class="glp-budget-scale" data-budget-scale="group">
                        <button type="button" data-budget-set="10000">₹10k</button>
                        <button type="button" data-budget-set="40000">₹40k</button>
                        <button type="button" data-budget-set="70000">₹70k</button>
                        <button type="button" data-budget-set="100000">₹1L+</button>
                      </div>
                    </div>
                  </div>

                </div>

                <label class="glp-field glp-field--full">
                  <span class="glp-label">Anything specific in mind?</span>
                  <textarea name="notes" placeholder="e.g. travelling with friends, need hotel + transport, interested in a photography trip..." rows="3" class="glp-input glp-textarea"></textarea>
                </label>
              </div>

              <p class="glp-consent">By submitting, you agree to our <a href="/privacy-policy/">Privacy Policy</a>. We'll never spam you. Promise 🤝</p>
              <button type="submit" class="glp-submit"><span set:html={sendIcon} />Let's Plan My Trip!</button>
              <p class="glp-message glp-message-success" data-crm-form-success>Thanks! Your enquiry has been sent — a safari specialist will contact you shortly.</p>
              <p class="glp-message glp-message-error" data-crm-form-error>We could not send your enquiry. Please check your connection and try again.</p>
            </form>

            <!-- Custom Trip form -->
            <form class="glp-form" id="custom-trip-form" method="post" data-custom-trip-form data-lp-panel="custom" hidden>
              <input type="hidden" name="destination" value="Tadoba" />

              <div class="glp-grid-2">
                <div class="glp-col">
                  <div class="glp-eyebrow-row glp-eyebrow-row--tight">
                    <span class="glp-eyebrow">Your Details</span>
                    <span class="glp-eyebrow-line" aria-hidden="true"></span>
                  </div>

                  <label class="glp-field">
                    <span class="glp-label">Full Name<span class="glp-required">*</span></span>
                    <input type="text" name="fullName" placeholder="Chota Matka" required class="glp-input" />
                  </label>

                  <label class="glp-field">
                    <span class="glp-label">Email<span class="glp-required">*</span></span>
                    <input type="email" name="email" placeholder="chotamatka@tadoba.com" required class="glp-input" />
                  </label>

                  <label class="glp-field">
                    <span class="glp-label">Phone Number<span class="glp-required">*</span></span>
                    <div class="glp-input glp-phone">
                      <select name="phoneCountry" class="glp-phone-code" aria-label="Country code">
                        <option value="+91" selected>+91</option>
                        <option value="+1">+1</option>
                        <option value="+44">+44</option>
                        <option value="+61">+61</option>
                        <option value="+971">+971</option>
                      </select>
                      <input type="tel" name="phone" placeholder="XXXXXXXXXX" required maxlength="10" inputmode="numeric" class="glp-phone-input" />
                    </div>
                  </label>

                  <label class="glp-field">
                    <span class="glp-label">City Travelling From<span class="glp-required">*</span></span>
                    <input type="text" name="fromCity" placeholder="Mumbai" required class="glp-input" />
                  </label>

                  <div class="glp-field" data-custom-date-selector>
                    <span class="glp-label glp-label-icon"><span set:html={calendarIcon} />Travel Dates<span class="glp-required">*</span></span>
                    <button type="button" class="glp-input glp-date-trigger" data-custom-date-trigger aria-expanded="false">
                      <span data-custom-date-summary>Add dates</span>
                      <span class="glp-chevron" set:html={chevronIcon} />
                    </button>
                    <div class="glp-cal-panel" data-custom-date-panel hidden>
                      <div class="glp-cal-header">
                        <button type="button" class="glp-cal-nav" data-custom-date-prev aria-label="Previous month">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 5-5 5 5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                        <span data-custom-date-month-label></span>
                        <button type="button" class="glp-cal-nav" data-custom-date-next aria-label="Next month">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="m8 5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                      </div>
                      <div class="glp-cal-weekdays"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div>
                      <div class="glp-cal-grid" data-custom-date-grid></div>
                      <p class="glp-cal-help" data-custom-date-help>Select your start date</p>
                    </div>
                    <input type="hidden" name="startDate" data-custom-start-date required />
                    <input type="hidden" name="endDate" data-custom-end-date required />
                  </div>
                </div>

                <div class="glp-col">
                  <div class="glp-eyebrow-row glp-eyebrow-row--tight">
                    <span class="glp-eyebrow">Trip Preferences</span>
                    <span class="glp-eyebrow-line" aria-hidden="true"></span>
                  </div>

                  <div class="glp-field" data-guest-selector>
                    <span class="glp-label glp-label-icon"><span set:html={peopleIcon} />No. of Travellers<span class="glp-required">*</span></span>
                    <button type="button" class="glp-input glp-guest-trigger" data-guest-trigger aria-expanded="false">
                      <span data-guest-summary>Select travellers</span>
                      <span class="glp-chevron" set:html={chevronIcon} />
                    </button>
                    <div class="glp-guest-panel" data-guest-panel hidden>
                      {[
                        { key: 'adults', title: 'Adults', age: 'Ages 12 and above' },
                        { key: 'children', title: 'Children', age: 'Ages 6–12' },
                        { key: 'infants', title: 'Children', age: 'Under 6' },
                      ].map((guest) => (
                        <div class="glp-guest-row">
                          <div><strong>{guest.title}</strong><span>{guest.age}</span></div>
                          <div class="glp-guest-stepper">
                            <button type="button" data-guest-minus={guest.key} aria-label={`Remove ${guest.title}`}>−</button>
                            <output data-guest-count={guest.key}>0</output>
                            <button type="button" data-guest-plus={guest.key} aria-label={`Add ${guest.title}`}>+</button>
                          </div>
                        </div>
                      ))}
                    </div>
                    <input type="hidden" name="adults" value="0" data-guest-input="adults" />
                    <input type="hidden" name="children" value="0" data-guest-input="children" />
                    <input type="hidden" name="childrenUnder6" value="0" data-guest-input="infants" />
                  </div>

                  <div class="glp-field">
                    <span class="glp-label glp-label-icon"><span set:html={walletIcon} />Budget Per Person<span class="glp-required">*</span></span>
                    <div class="glp-budget">
                      <div class="glp-budget-top">
                        <span class="glp-budget-value">₹<span id="custom-budget-value">25,000</span></span>
                        <span class="glp-budget-hint">Slide to adjust</span>
                      </div>
                      <input type="range" name="budget" min="10000" max="100000" step="5000" value="25000" required class="glp-range" id="custom-budget-range" />
                      <div class="glp-budget-scale" data-budget-scale="custom">
                        <button type="button" data-budget-set="10000">₹10k</button>
                        <button type="button" data-budget-set="40000">₹40k</button>
                        <button type="button" data-budget-set="70000">₹70k</button>
                        <button type="button" data-budget-set="100000">₹1L+</button>
                      </div>
                    </div>
                  </div>

                  <label class="glp-field">
                    <span class="glp-label">Jeep Safaris<span class="glp-required">*</span></span>
                    <select name="safaris" class="glp-input glp-select" required>
                      <option value="" selected disabled>Select number of safaris</option>
                      {Array.from({ length: 9 }, (_, i) => i + 1).map((n) => <option value={n}>{n}</option>)}
                      <option value="10+">10+</option>
                    </select>
                  </label>

                  <label class="glp-field">
                    <span class="glp-label">Resort Category<span class="glp-required">*</span></span>
                    <select name="resortTier" class="glp-input glp-select" required>
                      <option value="" selected disabled>Select resort category</option>
                      <option value="Deluxe">Deluxe</option>
                      <option value="Semi-Luxury">Semi-Luxury</option>
                      <option value="Luxury">Luxury</option>
                    </select>
                  </label>

                </div>

                <label class="glp-field glp-field--full">
                  <span class="glp-label">Anything specific in mind?</span>
                  <textarea name="notes" placeholder="e.g. travelling with friends, need hotel + transport, interested in a photography trip..." rows="3" class="glp-input glp-textarea"></textarea>
                </label>
              </div>

              <p class="glp-consent">By submitting, you agree to our <a href="/privacy-policy/">Privacy Policy</a>. We'll never spam you. Promise 🤝</p>
              <button type="submit" class="glp-submit"><span set:html={sendIcon} />Let's Plan My Trip!</button>
              <p class="glp-message glp-message-success" data-crm-form-success>Thanks! Your request has been sent — a safari specialist will contact you shortly.</p>
              <p class="glp-message glp-message-error" data-crm-form-error>We could not send your request. Please check your connection and try again.</p>
            </form>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>

<style>
  @font-face {
    font-family: 'Charmelade Demo';
    src: url('/fonts/charmelade-demo.subset.woff2') format('woff2');
