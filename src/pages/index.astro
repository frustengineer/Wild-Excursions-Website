  .wild-paw span:nth-child(1) { left: 0.55rem; top: 1.1rem; transform: rotate(-28deg); }
  .wild-paw span:nth-child(2) { left: 2.2rem; top: 0; transform: rotate(-8deg); }
  .wild-paw span:nth-child(3) { right: 1.65rem; top: 0.2rem; transform: rotate(12deg); }
  .wild-paw span:nth-child(4) { right: 0.2rem; top: 1.5rem; transform: rotate(30deg); }
  .wild-paw strong { left: 1.45rem; bottom: 0; width: 4.5rem; height: 3.8rem; }

