<script>
  const searchDialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const searchOpenButtons = document.querySelectorAll<HTMLButtonElement>('[data-search-open]');
  const searchClose = document.querySelector<HTMLButtonElement>('[data-search-close]');

  searchOpenButtons.forEach((button) => button.addEventListener('click', () => searchDialog?.showModal()));
  searchClose?.addEventListener('click', () => searchDialog?.close());
  searchDialog?.addEventListener('click', (event) => {
    if (event.target === searchDialog) searchDialog.close();
  });

  const tripPlannerDialog = document.querySelector<HTMLDialogElement>('[data-trip-planner-dialog]');
  const tripPlannerClose = document.querySelector<HTMLButtonElement>('[data-trip-planner-close]');
  const tripPlannerForm = document.querySelector<HTMLFormElement>('.trip-planner-form');

  tripPlannerClose?.addEventListener('click', () => tripPlannerDialog?.close());
  tripPlannerDialog?.addEventListener('cancel', (event) => event.preventDefault());
  tripPlannerForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    tripPlannerDialog?.close();
  });

  const enquireForm = document.querySelector<HTMLFormElement>('.enquire-form');
  enquireForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    enquireForm.reset();
  });

  if (tripPlannerDialog && !sessionStorage.getItem('tripPlannerShown')) {
    setTimeout(() => {
      tripPlannerDialog.showModal();
      sessionStorage.setItem('tripPlannerShown', 'true');
    }, 5000);
  }

  const mobileMenuToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  const closeMobileMenu = () => {
    mobileMenu?.classList.add('hidden');
    mobileMenuToggle?.classList.remove('is-open');
    mobileMenuToggle?.setAttribute('aria-expanded', 'false');
    mobileMenuToggle?.setAttribute('aria-label', 'Open navigation menu');
  };

  mobileMenuToggle?.addEventListener('click', () => {
    const willOpen = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden', !willOpen);
    mobileMenuToggle.classList.toggle('is-open', Boolean(willOpen));
    mobileMenuToggle.setAttribute('aria-expanded', String(Boolean(willOpen)));
    mobileMenuToggle.setAttribute('aria-label', willOpen ? 'Close navigation menu' : 'Open navigation menu');
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMobileMenu));

  document.addEventListener('click', (event) => {
    if (!mobileMenu || !mobileMenuToggle || mobileMenu.classList.contains('hidden')) return;
    const target = event.target as Node;
    if (!mobileMenu.contains(target) && !mobileMenuToggle.contains(target)) closeMobileMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMobileMenu();
  });

  function initToursMegaMenu() {
    const item = document.querySelector<HTMLElement>('.wild-nav-item--tours');
    if (!item) return;

    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    function open() {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      item!.classList.add('is-open');
    }

    function scheduleClose() {
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        item!.classList.remove('is-open');
      }, 300);
    }

    item.addEventListener('mouseenter', open);
    item.addEventListener('mouseleave', scheduleClose);
    item.addEventListener('focusin', open);
    item.addEventListener('focusout', (event) => {
      if (!item!.contains(event.relatedTarget as Node)) scheduleClose();
    });
  }

  initToursMegaMenu();

  function initReferenceFeatureStack() {
    const stack = document.querySelector<HTMLElement>('.reference-feature-list');
    const stages = Array.from(document.querySelectorAll<HTMLElement>('.reference-feature-card-stage'));
    const cards = stages.map((stage) => stage.querySelector<HTMLElement>('.reference-feature-card'));
    if (!stack || !stages.length || cards.some((card) => !card)) return;
    if (window.innerWidth > 639) return;

    let frame: number | null = null;

    const clearPin = (card: HTMLElement) => {
      card.classList.remove('is-stack-pinned');
      card.style.removeProperty('top');
      card.style.removeProperty('left');
      card.style.removeProperty('width');
      card.style.removeProperty('height');
    };

    const updateStack = () => {
      const stackBottom = stack.getBoundingClientRect().bottom;

      stages.forEach((stage, index) => {
        const card = cards[index]!;
        const stageBounds = stage.getBoundingClientRect();
        const offset = (window.innerWidth <= 900 ? 76 : 80) + index * 18;
        const shouldPin = stageBounds.top <= offset && stackBottom > offset + card.offsetHeight;

        if (!shouldPin) {
          clearPin(card);
          return;
        }

        if (!card.classList.contains('is-stack-pinned')) {
          const cardBounds = card.getBoundingClientRect();
          card.style.setProperty('left', `${cardBounds.left}px`);
          card.style.setProperty('width', `${cardBounds.width}px`);
          card.style.setProperty('height', `${cardBounds.height}px`);
          card.classList.add('is-stack-pinned');
        }

        card.style.setProperty('top', `${offset}px`);
      });

      frame = null;
    };

    const requestUpdate = () => {
      if (frame === null) frame = requestAnimationFrame(updateStack);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', () => {
      cards.forEach((card) => clearPin(card!));
      requestUpdate();
    });
    requestUpdate();
  }

  initReferenceFeatureStack();

  function initJourneySearch() {
    const form = document.querySelector<HTMLFormElement>('[data-journey-search-form]');
    if (!form) return;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const destination = form.querySelector<HTMLSelectElement>('[name="destination"]')?.value;
      const month = form.querySelector<HTMLSelectElement>('[name="month"]')?.value;
      if (!destination || !month) return;
      window.location.assign(`/tours/${destination}?month=${encodeURIComponent(month)}#departures`);
    });
  }

  initJourneySearch();

</script>
