  @keyframes wild-backdrop-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes wild-content-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes wild-orbit-spin {
    to { transform: rotate(360deg); }
  }

  @keyframes wild-paw-float {
