  <script>
    import Swiper from 'swiper';
    import { EffectCards } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/effect-cards';

    function initExploreToursCarousel() {
      const track = document.querySelector<HTMLElement>('.explore-tours-track');
      const prevBtn = document.querySelector<HTMLElement>('.explore-tours-arrow-left');
      const nextBtn = document.querySelector<HTMLElement>('.explore-tours-arrow-right');
      if (!track || !prevBtn || !nextBtn) return;

      const AUTO_SCROLL_INTERVAL = 4000;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let autoScrollTimer: ReturnType<typeof setInterval> | null = null;

      function getScrollAmount() {
        const card = track!.querySelector<HTMLElement>('.explore-tour-card:not(.is-hidden)');
        return card ? card.clientWidth + 24 : 320;
      }

      function scrollNext() {
        if (track!.scrollWidth <= track!.clientWidth + 1) return;
        const atEnd = track!.scrollLeft + track!.clientWidth >= track!.scrollWidth - 4;
        track!.scrollTo(atEnd ? { left: 0, behavior: 'smooth' } : { left: track!.scrollLeft + getScrollAmount(), behavior: 'smooth' });
      }

      function scrollPrev() {
        track!.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      }

      function stopAutoScroll() {
        if (autoScrollTimer) {
          clearInterval(autoScrollTimer);
          autoScrollTimer = null;
        }
      }

      function startAutoScroll() {
        if (prefersReducedMotion) return;
        stopAutoScroll();
        autoScrollTimer = setInterval(scrollNext, AUTO_SCROLL_INTERVAL);
      }

      prevBtn.addEventListener('click', () => {
        scrollPrev();
        startAutoScroll();
      });
      nextBtn.addEventListener('click', () => {
        scrollNext();
        startAutoScroll();
      });
      track.addEventListener('mouseenter', stopAutoScroll);
      track.addEventListener('mouseleave', startAutoScroll);
      track.addEventListener('touchstart', stopAutoScroll, { passive: true });
      track.addEventListener('touchend', startAutoScroll);

      startAutoScroll();
    }

    function initJungleFilter() {
      const filterButtons = document.querySelectorAll<HTMLButtonElement>('.jungle-filter-btn');
      const cards = document.querySelectorAll<HTMLElement>('.explore-tour-card');
      const track = document.querySelector<HTMLElement>('.explore-tours-track');
      if (!filterButtons.length || !cards.length || !track) return;

      function refreshLayout() {
        track!.scrollLeft = 0;
        const fits = track!.scrollWidth <= track!.clientWidth + 1;
        track!.classList.toggle('is-centered', fits);
      }

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const jungle = button.dataset.jungleFilter;

          filterButtons.forEach((btn) => {
            const isActive = btn === button;
            btn.classList.toggle('is-active', isActive);
            btn.classList.toggle('border-brand-amber', isActive);
            btn.classList.toggle('text-brand-amber', isActive);
            btn.classList.toggle('border-transparent', !isActive);
            btn.classList.toggle('text-brand-ivory/70', !isActive);
          });

          cards.forEach((cardEl) => {
            const matches = jungle === 'all' || cardEl.dataset.jungle === jungle;
            cardEl.classList.toggle('is-hidden', !matches);
          });

          refreshLayout();
        });
      });

      refreshLayout();
      window.addEventListener('resize', refreshLayout);
    }

    function initOfferPills() {
      const pills = document.querySelectorAll<HTMLElement>('.offer-pill');
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const willOpen = !pill.classList.contains('is-open');
          pills.forEach((p) => p.classList.remove('is-open'));
          if (willOpen) pill.classList.add('is-open');
        });
      });
    }

    function initPromoBannerCarousel() {
      const track = document.querySelector<HTMLElement>('.promo-banner-track');
      const dots = document.querySelectorAll<HTMLElement>('.promo-banner-dots span');
      if (!track) return;

      const AUTO_SCROLL_INTERVAL = 5000;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let autoScrollTimer: ReturnType<typeof setInterval> | null = null;

      function getSlideWidth() {
        const slide = track!.querySelector<HTMLElement>('.promo-banner');
        return slide ? slide.clientWidth : track!.clientWidth;
      }

      function getActiveIndex() {
        return Math.round(track!.scrollLeft / getSlideWidth());
      }

      function updateDots() {
        const active = getActiveIndex();
        dots.forEach((dot, index) => dot.classList.toggle('is-active', index === active));
      }

      function scrollToIndex(index: number) {
        track!.scrollTo({ left: index * getSlideWidth(), behavior: 'smooth' });
      }

      function scrollNext() {
        if (track!.scrollWidth <= track!.clientWidth + 1) return;
        const atEnd = track!.scrollLeft + track!.clientWidth >= track!.scrollWidth - 4;
        scrollToIndex(atEnd ? 0 : getActiveIndex() + 1);
      }

      function stopAutoScroll() {
        if (autoScrollTimer) {
          clearInterval(autoScrollTimer);
          autoScrollTimer = null;
        }
      }

      function startAutoScroll() {
        if (prefersReducedMotion) return;
        stopAutoScroll();
        autoScrollTimer = setInterval(scrollNext, AUTO_SCROLL_INTERVAL);
      }

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          scrollToIndex(index);
          startAutoScroll();
        });
      });
      track.addEventListener('scroll', updateDots, { passive: true });
      track.addEventListener('mouseenter', stopAutoScroll);
      track.addEventListener('mouseleave', startAutoScroll);
      track.addEventListener('touchstart', stopAutoScroll, { passive: true });
      track.addEventListener('touchend', startAutoScroll);

      startAutoScroll();
    }

    function initMahaToursCarousel() {
      const track = document.querySelector<HTMLElement>('.maha-tours-track');
      const prevBtn = document.querySelector<HTMLElement>('.maha-tours-arrow-left');
      const nextBtn = document.querySelector<HTMLElement>('.maha-tours-arrow-right');
      if (!track || !prevBtn || !nextBtn) return;

      const AUTO_SCROLL_INTERVAL = 4000;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let autoScrollTimer: ReturnType<typeof setInterval> | null = null;

      function getScrollAmount() {
        const card = track!.querySelector<HTMLElement>('.maha-tour-card');
        return card ? card.clientWidth + 24 : 320;
      }

      function scrollNext() {
        if (track!.scrollWidth <= track!.clientWidth + 1) return;
        const atEnd = track!.scrollLeft + track!.clientWidth >= track!.scrollWidth - 4;
        track!.scrollTo(atEnd ? { left: 0, behavior: 'smooth' } : { left: track!.scrollLeft + getScrollAmount(), behavior: 'smooth' });
      }

      function scrollPrev() {
        track!.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      }

      function stopAutoScroll() {
        if (autoScrollTimer) {
          clearInterval(autoScrollTimer);
          autoScrollTimer = null;
        }
      }

      function startAutoScroll() {
        if (prefersReducedMotion) return;
        stopAutoScroll();
        autoScrollTimer = setInterval(scrollNext, AUTO_SCROLL_INTERVAL);
      }

      prevBtn.addEventListener('click', () => {
        scrollPrev();
        startAutoScroll();
      });
      nextBtn.addEventListener('click', () => {
        scrollNext();
        startAutoScroll();
      });
      track.addEventListener('mouseenter', stopAutoScroll);
      track.addEventListener('mouseleave', startAutoScroll);
      track.addEventListener('touchstart', stopAutoScroll, { passive: true });
      track.addEventListener('touchend', startAutoScroll);

      startAutoScroll();
    }

    function initExploreCategoriesNav() {
      const track = document.querySelector<HTMLElement>('.explore-categories-track');
      const prevBtn = document.querySelector<HTMLButtonElement>('[data-explore-prev]');
      const nextBtn = document.querySelector<HTMLButtonElement>('[data-explore-next]');
