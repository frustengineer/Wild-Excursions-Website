  { eager: true }
);

const genericGalleryFillerPool = Object.entries(wildlifeGalleryModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

function getJungleGallery(jungleSlug: string, fallback: ImageMetadata, fillerOffset = 0): ImageMetadata[] {
  const homePool = getJungleHomeImages(jungleSlug);
  if (homePool.length > 0) {
    return Array.from({ length: Math.min(3, homePool.length) }, (_, index) => homePool[(fillerOffset + index) % homePool.length]);
  }

  const matches = Object.entries(jungleGalleryModules)
    .filter(([path]) => path.includes(`/jungle-gallery/${jungleSlug}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
  if (matches.length > 0) return matches;

  const jungleWildlife = getJungleWildlifePool(jungleSlug, `homepage-${fillerOffset}`).map((photo) => photo.image);
  const fillerSource = jungleWildlife.length ? jungleWildlife : genericGalleryFillerPool;
  const filler = fillerSource
    .filter((img) => img.src !== fallback.src)
    .slice(0, 2);
  return [fallback, ...filler];
}
