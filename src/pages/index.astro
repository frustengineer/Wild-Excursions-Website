    background: #fdcb08;
  }

  .support-heading {
    font-size: 2rem;
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: #ffffff;
    text-wrap: balance;
  }

  .support-subhead {
    max-width: 34rem;
    font-size: 1.02rem;
    line-height: 1.6;
    color: rgba(255, 251, 235, 0.7);
  }

  .support-features {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    margin: 0 -1rem;
    padding: 0 1rem 0.5rem;
    scrollbar-width: none;
  }

  .support-features::-webkit-scrollbar {
    display: none;
  }

  .support-feature {
    flex: 0 0 auto;
    width: min(78vw, 300px);
    scroll-snap-align: start;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    padding: 1.25rem;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease, transform 0.6s ease, border-color 0.3s ease;
  }

  @media (min-width: 640px) {
    .support-features {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      overflow: visible;
      margin: 0;
      padding: 0;
    }

    .support-feature {
      width: auto;
      scroll-snap-align: none;
    }
  }

  .support-feature.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .support-feature:hover {
    border-color: rgba(253, 203, 8, 0.35);
  }

  .support-feature-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: #ffffff;
  }

  .support-feature-desc {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: rgba(255, 251, 235, 0.62);
  }

  .support-quote {
    font-size: 0.95rem;
    font-style: italic;
    color: rgba(255, 251, 235, 0.55);
  }

  /* Phone mockup */
  .support-phone-wrap {
    width: min(100%, 320px);
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .support-phone-wrap.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .support-phone {
    position: relative;
    height: 660px;
    border-radius: 2.75rem;
    border: 10px solid #0b0b0b;
    background: #fffdf8;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .support-phone-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 6rem;
    height: 1.6rem;
    border-radius: 0 0 1rem 1rem;
    background: #0b0b0b;
    z-index: 3;
  }

  .support-phone-statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 1.4rem 0.2rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #171717;
  }

  .support-phone-status-icons {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .support-phone-status-icons svg {
    height: 0.7rem;
  }

  .support-phone-status-icons svg:first-child {
    width: 0.9rem;
  }

  .support-phone-status-icons svg:nth-child(2) {
    width: 0.95rem;
  }

  .support-phone-status-icons svg:last-child {
    width: 1.3rem;
  }

  .support-phone-header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 1.1rem 0.75rem;
    border-bottom: 1px solid rgba(23, 23, 23, 0.08);
    font-size: 0.92rem;
    font-weight: 700;
    color: #171717;
  }

  .support-phone-header svg {
    height: 1.1rem;
    width: 1.1rem;
    flex-shrink: 0;
  }

  .support-phone-chat {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    scrollbar-width: none;
  }

  .support-phone-chat::-webkit-scrollbar {
    display: none;
  }

  .support-chat-row {
    max-width: 82%;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .support-chat-row.is-shown {
    opacity: 1;
    transform: translateY(0);
  }

  .support-chat-row.is-user {
    align-self: flex-end;
  }

  .support-chat-row.is-agent {
    align-self: flex-start;
  }

  .support-chat-label {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: #cfa100;
  }

  .support-chat-bubble {
    margin: 0;
    border-radius: 1rem;
    padding: 0.6rem 0.85rem;
    font-size: 0.82rem;
    line-height: 1.42;
  }

  .support-chat-row.is-user .support-chat-bubble {
    border-bottom-right-radius: 0.25rem;
    background: #fdcb08;
    color: #171717;
    font-weight: 600;
  }

  .support-chat-row.is-agent .support-chat-bubble {
    border-bottom-left-radius: 0.25rem;
    background: #f1efe8;
    color: #26261f;
  }

  .support-chat-typing {
    align-self: flex-start;
    display: none;
    align-items: center;
    gap: 0.28rem;
    border-radius: 1rem;
    border-bottom-left-radius: 0.25rem;
    background: #f1efe8;
    padding: 0.55rem 0.8rem;
  }

  .support-chat-typing.is-shown {
    display: flex;
  }

  .support-chat-typing span {
    height: 0.4rem;
    width: 0.4rem;
    border-radius: 9999px;
    background: rgba(38, 38, 31, 0.45);
    animation: supportTypingBounce 1.1s ease-in-out infinite;
  }

  .support-chat-typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .support-chat-typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes supportTypingBounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-3px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .support-chat-typing span {
      animation: none;
    }
    .support-feature,
    .support-phone-wrap,
    .support-chat-row {
      transition: none;
    }
  }
</style>

<script>
  const searchDialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const searchOpenButtons = document.querySelectorAll<HTMLButtonElement>('[data-search-open]');
  const searchClose = document.querySelector<HTMLButtonElement>('[data-search-close]');

  searchOpenButtons.forEach((button) => button.addEventListener('click', () => searchDialog?.showModal()));
  searchClose?.addEventListener('click', () => searchDialog?.close());
  searchDialog?.addEventListener('click', (event) => {
    if (event.target === searchDialog) searchDialog.close();
  });

  const journeySearchForm = document.querySelector<HTMLFormElement>('[data-journey-search-form]');
  journeySearchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const destination = journeySearchForm.querySelector<HTMLSelectElement>('[name="destination"]')?.value;
    const month = journeySearchForm.querySelector<HTMLSelectElement>('[name="month"]')?.value;
    if (!destination || !month) return;
    window.location.assign(`/tours/${destination}?month=${encodeURIComponent(month)}#departures`);
  });

  const enquireForm = document.querySelector<HTMLFormElement>('.enquire-form');

  function initEnquireDatePicker() {
    const selector = enquireForm?.querySelector<HTMLElement>('[data-enquire-date-selector]');
    const trigger = selector?.querySelector<HTMLButtonElement>('[data-enquire-date-trigger]');
    const panel = selector?.querySelector<HTMLElement>('[data-enquire-date-panel]');
    const summary = selector?.querySelector<HTMLElement>('[data-enquire-date-summary]');
    const startInput = selector?.querySelector<HTMLInputElement>('[data-enquire-date-value]');
    const endInput = selector?.querySelector<HTMLInputElement>('[data-enquire-date-end-value]');
    const monthLabel = selector?.querySelector<HTMLElement>('[data-enquire-date-month-label]');
    const grid = selector?.querySelector<HTMLElement>('[data-enquire-date-grid]');
    const prevBtn = selector?.querySelector<HTMLButtonElement>('[data-enquire-date-prev]');
    const nextBtn = selector?.querySelector<HTMLButtonElement>('[data-enquire-date-next]');
    if (!selector || !trigger || !panel || !summary || !startInput || !endInput || !monthLabel || !grid || !prevBtn || !nextBtn) return;

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    let viewYear = today.getFullYear();
    let viewMonth = today.getMonth();
    let rangeStart: Date | null = null;
    let rangeEnd: Date | null = null;

    const toISO = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const formatLabel = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    const formatRange = (start: Date, end: Date) => {
      const sameMonthYear = start.getMonth() === end.getMonth() && start.getFullYear() === end.getFullYear();
      if (sameMonthYear) {
        const monthYear = end.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
        return `${start.getDate()} - ${end.getDate()} ${monthYear}`;
      }
      const sameYear = start.getFullYear() === end.getFullYear();
      const startLabel = start.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: sameYear ? undefined : 'numeric' });
      return `${startLabel} - ${formatLabel(end)}`;
    };

    const renderCalendar = () => {
      monthLabel.textContent = new Date(viewYear, viewMonth, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
      grid.innerHTML = '';
      const firstWeekday = new Date(viewYear, viewMonth, 1).getDay();
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

      for (let i = 0; i < firstWeekday; i++) grid.appendChild(document.createElement('span'));

      for (let day = 1; day <= daysInMonth; day++) {
        const cellDate = new Date(viewYear, viewMonth, day);
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = String(day);
        button.dataset.dateIso = toISO(cellDate);
        if (cellDate < today) button.disabled = true;
        if (rangeStart && toISO(cellDate) === toISO(rangeStart)) button.classList.add('is-range-start');
        if (rangeEnd && toISO(cellDate) === toISO(rangeEnd)) button.classList.add('is-range-end');
        if (rangeStart && rangeEnd && cellDate > rangeStart && cellDate < rangeEnd) button.classList.add('is-in-range');
        grid.appendChild(button);
      }
    };

    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
      if (!open) renderCalendar();
    });

    prevBtn.addEventListener('click', () => {
      viewMonth -= 1;
      if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
      renderCalendar();
    });

    nextBtn.addEventListener('click', () => {
      viewMonth += 1;
      if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
      renderCalendar();
    });

    grid.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-date-iso]');
      if (!button || button.disabled) return;
      const chosen = new Date(`${button.dataset.dateIso}T00:00:00`);
      if (!rangeStart || rangeEnd || chosen < rangeStart) {
        rangeStart = chosen;
        rangeEnd = null;
        startInput.value = button.dataset.dateIso ?? '';
        endInput.value = '';
        summary.textContent = `${formatLabel(rangeStart)} — Select end date`;
      } else {
        rangeEnd = chosen;
        endInput.value = button.dataset.dateIso ?? '';
        summary.textContent = formatRange(rangeStart, rangeEnd);
      }
      renderCalendar();
      if (rangeEnd) {
        panel.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('click', (event) => {
      if (event.composedPath().includes(selector)) return;
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    });
  }

  initEnquireDatePicker();

  enquireForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    enquireForm.reset();
    const summary = enquireForm.querySelector<HTMLElement>('[data-enquire-date-summary]');
    if (summary) summary.textContent = 'Tentative travel dates';
  });

  const mobileMenuToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  const closeMobileMenu = () => {
    mobileMenu?.classList.add('hidden');
    mobileMenuToggle?.classList.remove('is-open');
    mobileMenuToggle?.setAttribute('aria-expanded', 'false');
    mobileMenuToggle?.setAttribute('aria-label', 'Open navigation menu');
  };

  mobileMenuToggle?.addEventListener('click', () => {
    const willOpen = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden', !willOpen);
    mobileMenuToggle.classList.toggle('is-open', Boolean(willOpen));
    mobileMenuToggle.setAttribute('aria-expanded', String(Boolean(willOpen)));
    mobileMenuToggle.setAttribute('aria-label', willOpen ? 'Close navigation menu' : 'Open navigation menu');
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMobileMenu));

  document.addEventListener('click', (event) => {
    if (!mobileMenu || !mobileMenuToggle || mobileMenu.classList.contains('hidden')) return;
    const target = event.target as Node;
    if (!mobileMenu.contains(target) && !mobileMenuToggle.contains(target)) closeMobileMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMobileMenu();
  });

  function initToursMegaMenu() {
    const item = document.querySelector<HTMLElement>('.wild-nav-item--tours');
    if (!item) return;

    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    function open() {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      item!.classList.add('is-open');
    }

    function scheduleClose() {
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        item!.classList.remove('is-open');
      }, 300);
    }

    item.addEventListener('mouseenter', open);
    item.addEventListener('mouseleave', scheduleClose);
    item.addEventListener('focusin', open);
    item.addEventListener('focusout', (event) => {
      if (!item!.contains(event.relatedTarget as Node)) scheduleClose();
    });
  }

  initToursMegaMenu();

  function initFeatureVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>('[data-feature-video]');
    if (!videos.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            void video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.2 }
    );

    videos.forEach((video) => observer.observe(video));
  }

  initFeatureVideos();

  function initJourneySearch() {
    const form = document.querySelector<HTMLFormElement>('[data-journey-search-form]');
    if (!form) return;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const destination = form.querySelector<HTMLSelectElement>('[name="destination"]')?.value;
      const month = form.querySelector<HTMLSelectElement>('[name="month"]')?.value;
      if (!destination || !month) return;
      window.location.assign(`/tours/${destination}?month=${encodeURIComponent(month)}#departures`);
    });
  }

  initJourneySearch();

</script>
