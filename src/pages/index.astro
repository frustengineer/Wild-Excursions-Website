// Drop extra real photos in src/assets/jungle-gallery/<jungle-slug>/ (any filename, jpg/png/webp/avif)
// to give a jungle's tour cards a real multi-photo carousel. Until then, this falls back to filler
// slides pulled from the site's general photo pool (not real photos of that specific jungle) just so
// the carousel is visibly functional — swap them out by adding real photos to the folder above.
const jungleGalleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/jungle-gallery/*/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const genericGalleryFillerPool = [hero1, hero2, hero3, hero4, hero5, hero6, hero7, heroBg2, heroBg3, tigerPanna];

function getJungleGallery(jungleSlug: string, fallback: ImageMetadata, fillerOffset = 0): ImageMetadata[] {
  const matches = Object.entries(jungleGalleryModules)
    .filter(([path]) => path.includes(`/jungle-gallery/${jungleSlug}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
  if (matches.length > 0) return matches;

  const filler = genericGalleryFillerPool
    .filter((img) => img.src !== fallback.src)
    .slice(fillerOffset, fillerOffset + 2);
  return [fallback, ...filler];
}
