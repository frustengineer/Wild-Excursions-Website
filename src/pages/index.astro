const featuredJungleOrder = ['tadoba', 'pench', 'kanha', 'bandhavgarh', 'satpura', 'tipeshwar'];

function interleaveToursByJungle<T extends { jungle: string }>(items: T[]): T[] {
  const groups = new Map<string, T[]>();
  items.forEach((item) => groups.set(item.jungle, [...(groups.get(item.jungle) ?? []), item]));

  const result: T[] = [];
  const queues = Array.from(groups.values());
  while (queues.some((queue) => queue.length > 0)) {
    queues.forEach((queue) => {
      const next = queue.shift();
      if (next) result.push(next);
    });
  }
  return result;
}

// Interleaved round-robin across jungles (grouped-then-sorted previously meant every
// duration variant of the same jungle appeared back-to-back, e.g. 3 Kanha cards in a row).
const featuredTours = interleaveToursByJungle(
  tours
    .filter((tour) => featuredJungleOrder.includes(tour.jungle))
    .sort((a, b) => featuredJungleOrder.indexOf(a.jungle) - featuredJungleOrder.indexOf(b.jungle))
);

