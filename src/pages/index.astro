  <script>
    function initSupportChatDemo() {
      const wrap = document.querySelector<HTMLElement>('[data-support-phone]');
      if (!wrap) return;
      const list = wrap.querySelector<HTMLElement>('[data-chat-list]');
      const typing = wrap.querySelector<HTMLElement>('[data-chat-typing]');
      const rows = Array.from(wrap.querySelectorAll<HTMLElement>('[data-chat-msg]'));
      if (!list || !typing || !rows.length) return;

      let timers: ReturnType<typeof setTimeout>[] = [];
      const clearTimers = () => {
        timers.forEach((t) => clearTimeout(t));
        timers = [];
      };

      const resetChat = () => {
        rows.forEach((row) => row.classList.remove('is-shown'));
        typing.classList.remove('is-shown');
        list.scrollTop = 0;
      };

      const playSequence = () => {
        resetChat();
        let delay = 500;
        rows.forEach((row) => {
          const isAgent = row.classList.contains('is-agent');
          if (isAgent) {
            delay += 700;
            timers.push(
              setTimeout(() => {
                typing.classList.add('is-shown');
                list.scrollTop = list.scrollHeight;
              }, delay)
            );
            delay += 950;
            timers.push(
              setTimeout(() => {
                typing.classList.remove('is-shown');
                row.classList.add('is-shown');
                list.scrollTop = list.scrollHeight;
              }, delay)
            );
          } else {
            delay += 700;
            timers.push(
              setTimeout(() => {
                row.classList.add('is-shown');
                list.scrollTop = list.scrollHeight;
              }, delay)
            );
          }
        });
        delay += 2800;
        timers.push(setTimeout(playSequence, delay));
      };

      if (!('IntersectionObserver' in window)) {
        playSequence();
        return;
      }

      let started = false;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !started) {
              started = true;
              playSequence();
            }
            if (!entry.isIntersecting && started) {
              clearTimers();
              resetChat();
              started = false;
            }
          });
        },
        { threshold: 0.35 }
      );
      observer.observe(wrap);
    }

    initSupportChatDemo();

    function initSupportFeaturesAutoScroll() {
      const track = document.querySelector<HTMLElement>('.support-features');
      if (!track) return;

      const AUTO_SCROLL_INTERVAL = 2600;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let autoScrollTimer: ReturnType<typeof setInterval> | null = null;

      function getScrollAmount() {
        const card = track!.querySelector<HTMLElement>('.support-feature');
        return card ? card.clientWidth + 16 : 300;
      }

      function scrollNext() {
        if (track!.scrollWidth <= track!.clientWidth + 1) return;
        const atEnd = track!.scrollLeft + track!.clientWidth >= track!.scrollWidth - 4;
        track!.scrollTo(atEnd ? { left: 0, behavior: 'smooth' } : { left: track!.scrollLeft + getScrollAmount(), behavior: 'smooth' });
      }

      function stopAutoScroll() {
        if (autoScrollTimer) {
          clearInterval(autoScrollTimer);
          autoScrollTimer = null;
        }
      }

      function startAutoScroll() {
        if (prefersReducedMotion) return;
        stopAutoScroll();
        autoScrollTimer = setInterval(scrollNext, AUTO_SCROLL_INTERVAL);
      }

      track.addEventListener('touchstart', stopAutoScroll, { passive: true });
      track.addEventListener('touchend', startAutoScroll);
      track.addEventListener('mouseenter', stopAutoScroll);
      track.addEventListener('mouseleave', startAutoScroll);

      if (!('IntersectionObserver' in window)) {
        startAutoScroll();
        return;
      }

      const visibilityObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) startAutoScroll();
            else stopAutoScroll();
          });
        },
        { threshold: 0.2 }
      );
      visibilityObserver.observe(track);
    }

    initSupportFeaturesAutoScroll();
  </script>

