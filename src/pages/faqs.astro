---
import Layout from '../layouts/Layout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import allFaqs from '../data/faqs.json';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="Frequently Asked Questions"
  description="Answers to common questions about booking a Wild Excursions safari — group sizes, pricing, customization, timing, and more."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="faqs-page bg-black px-4 py-16 text-brand-ivory sm:px-6 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-3xl">
      <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-brand-amber">Have a question?</p>
      <h1 class="mt-3 text-4xl font-black uppercase leading-[0.95] sm:text-5xl">Frequently Asked Questions</h1>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-white/55">
        Everything you need to know before booking a safari with us. Can't find your answer? <a href="/contact/" class="text-brand-amber hover:underline">Get in touch</a>.
      </p>

      <div class="mt-10">
        <FaqAccordion faqs={allFaqs} />
      </div>
    </div>
  </section>
</Layout>
