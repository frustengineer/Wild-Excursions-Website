      background: var(--surface); border: 1px solid var(--line); border-radius: .9rem;
      padding: .85rem .95rem;
      box-shadow: 0 1px 4px rgba(0,0,0,.05);
    }
    .plp-trust-icon { grid-row: span 2; width: 2.5rem; height: 2.5rem; }
    .plp-trust-icon svg { width: 1.2rem; height: 1.2rem; }
    .plp-trust-title { font-size: .92rem; }
    .plp-trust-sub { font-size: .74rem; margin: 0; }
    @keyframes plp-trust-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(calc(-50% - .375rem)); }
    }
    @media (prefers-reduced-motion: reduce) { .plp-trust-track { animation: none; } }
    .plp-deal { flex-direction: column; align-items: flex-start; }
    .plp-mob-cta { display: flex; position: fixed; inset-inline: 0; bottom: 0; z-index: 60; align-items: center; justify-content: space-between; gap: 1rem; background: var(--surface); border-top: 1px solid var(--line); padding: .65rem 1rem; box-shadow: 0 -6px 20px rgba(0,0,0,.08); }
    .plp-mob-cta, .plp-mob-cta:hover { text-decoration: none; }
    .plp-mob-cta > span:first-child { font-size: .8rem; font-weight: 700; color: var(--ink); line-height: 1.25; }
    .plp-mob-cta > span:first-child em { display: block; font-style: normal; font-weight: 500; font-size: .72rem; color: var(--muted); }
    .plp-mob-cta > span:first-child i { font-style: normal; }
    .plp-mob-cta-btn { flex-shrink: 0; background: var(--amber); color: #241a00; font-weight: 800; font-size: .82rem; padding: .6rem 1.1rem; border-radius: 999px; }

    /* enquiry modal opens as a bottom sheet on mobile */
    .plp-modal { place-items: end stretch; padding: 0; }
    .plp-modal-card {
      width: 100%; max-width: none; max-height: 88vh;
      border-radius: 1.3rem 1.3rem 0 0;
      padding: 1.6rem 1.3rem calc(1.4rem + env(safe-area-inset-bottom));
      animation: plp-sheet-in .3s cubic-bezier(.2,.8,.2,1) both;
    }
    .plp-modal-title { font-size: 1.3rem; }
    .plp-modal-sub { margin-bottom: 1rem; }
  }
</style>

<script>
  // ---- countdown (shared by top bar + deal card) ----
  const root = document.querySelector<HTMLElement>('.plp');
  const target = root?.dataset.saleEnd ? new Date(root.dataset.saleEnd).getTime() : 0;
  const cdGroups = document.querySelectorAll<HTMLElement>('[data-countdown]');
  const pad = (n: number) => String(n).padStart(2, '0');
  function tickCountdown() {
    const diff = Math.max(0, target - Date.now());
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    cdGroups.forEach((g) => {
      const setEl = (sel: string, v: string) => { const el = g.querySelector(sel); if (el) el.textContent = v; };
      setEl('[data-cd-days]', String(d));
      setEl('[data-cd-hours]', pad(h));
      setEl('[data-cd-mins]', pad(m));
    });
  }
  if (target) { tickCountdown(); setInterval(tickCountdown, 30000); }

  // ---- itinerary / summary view state ----
  const itinViews = document.querySelectorAll<HTMLElement>('[data-view="itinerary"]');
  const sumViews = document.querySelectorAll<HTMLElement>('[data-view="summary"]');
  const stayViews = document.querySelectorAll<HTMLElement>('[data-view="stay"]');
  const transferViews = document.querySelectorAll<HTMLElement>('[data-view="transfers"]');
  let currentView: 'itinerary' | 'summary' | 'activities' | 'stay' | 'transfers' = 'itinerary';
  let activeDays = document.querySelector<HTMLElement>('[data-duration-cards]')?.dataset.defaultDays ?? '';
  const hero = document.querySelector<HTMLElement>('[data-itin-hero]');
  const applyView = () => {
    const showItin = currentView === 'itinerary' || currentView === 'activities';
    itinViews.forEach((v) => {
      v.hidden = !(showItin && v.dataset.itinVariant === activeDays);
      v.classList.toggle('is-activities', currentView === 'activities');
      if (currentView === 'activities' && !v.hidden) {
        v.querySelectorAll<HTMLDetailsElement>('.plp-day').forEach((d) => (d.open = true));
      }
    });
    sumViews.forEach((v) => { v.hidden = !(currentView === 'summary' && v.dataset.itinVariant === activeDays); });
    transferViews.forEach((v) => { v.hidden = !(currentView === 'transfers' && v.dataset.itinVariant === activeDays); });
    stayViews.forEach((v) => { v.hidden = currentView !== 'stay'; });
    if (hero) hero.hidden = currentView !== 'itinerary';
  };

  // ---- duration cards ----
  const inr = (n: number) => n.toLocaleString('en-IN');
  const cards = document.querySelectorAll<HTMLButtonElement>('[data-duration-cards] .plp-dur-card');
  const set = (sel: string, txt: string) => document.querySelectorAll(sel).forEach((el) => (el.textContent = txt));

  // ---- stay tier picker: reveal the selected tier's photo collections ----
  // Delegated, and declared early, so it keeps working regardless of the rest of this script.
  const syncStaySub = () => {
    const staySub = document.querySelector<HTMLElement>('[data-staysub]');
    const tier = document.querySelector<HTMLElement>('[data-stay-pick].is-active')?.dataset.stayPick ?? null;
    let any = false;
    document.querySelectorAll<HTMLElement>('[data-staysub-for]').forEach((g) => {
      const on = !!tier && g.dataset.staysubFor === tier;
      g.hidden = !on;
      if (on) any = true;
    });
    if (staySub) staySub.hidden = !any;
  };

  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLElement>('[data-stay-pick]');
    if (!btn) return;
    const wasActive = btn.classList.contains('is-active');
    document.querySelectorAll<HTMLElement>('[data-stay-pick]').forEach((b) => {
      b.classList.toggle('is-active', b === btn && !wasActive);
    });
    syncStaySub();
    if (!wasActive) {
      // the revealed collections sit below the fold on a phone - bring them up past the sticky tabs
      const panel = document.querySelector<HTMLElement>('[data-staysub]');
      if (panel) {
        const y = panel.getBoundingClientRect().top + window.scrollY - 88;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    }
  });

  syncStaySub();
  const setInr = (sel: string, n: number) =>
    document.querySelectorAll<HTMLElement>(sel).forEach((el) => { el.dataset.inr = String(n); });

  let selectedPrice = 0;
  const mobPriceEl = document.querySelector<HTMLElement>('[data-mob-price]');
  if (mobPriceEl) mobPriceEl.dataset.base = mobPriceEl.dataset.inr ?? '';
  const sidePriceEl = document.querySelector<HTMLElement>('[data-side-price]');
  if (sidePriceEl) sidePriceEl.dataset.base = sidePriceEl.dataset.inr ?? '';
  /** Published rates. Resort rates are per room per night; safaris per drive; transfers per vehicle per day. */
  const RATES = {
    stay: {
      'Semi-Luxury': { single: 7800, double: 8800, extraAdult: 3000, extraChild: 2500 },
      Luxury: { single: 17800, double: 18800, extraAdult: 5000, extraChild: 4500 },
    } as Record<string, { single: number; double: number; extraAdult: number; extraChild: number }>,
    safari: 10000,
    transferPerVehiclePerDay: 5500,
    gst: 0.05,
  };

  /**
   * Adults set the room count - two to a room, with an odd adult on a triple-share bed.
   * Children then share those rooms at the child rate, whatever their number.
   * Under-6s stay free.
   */
  const roomCostPerNight = (tier: string, adults: number, children: number) => {
    const rate = RATES.stay[tier];
    if (!rate || adults + children <= 0) return 0;
    let cost = 0;
    if (adults === 0) cost = rate.single;
    else if (adults === 1) cost = rate.single;
    else {
      cost = Math.floor(adults / 2) * rate.double;
      if (adults % 2) cost += rate.extraAdult;
    }
    return cost + (adults > 0 ? children * rate.extraChild : Math.max(0, children - 1) * rate.extraChild);
  };

  const activeChip = (group: string) =>
    document.querySelector<HTMLElement>(`[data-config-chips="${group}"] .plp-chip.is-active`);

  const quoteTotal = () => {
    const card = document.querySelector<HTMLElement>('[data-duration-cards] .plp-dur-card.is-active');
    const days = Number(card?.dataset.days ?? 0);
    const nights = Number(card?.dataset.nights ?? 0);
    const safaris = Number(activeChip('safari')?.dataset.safariN ?? 0);
    const tier = activeChip('stay')?.dataset.chip ?? '';
    const wantsTransfers = (activeChip('transfers')?.dataset.chip ?? '').startsWith('Yes');
    const adults = Number(cfgTrav?.dataset.adults ?? 0);
    const children = Number(cfgTrav?.dataset.children ?? 0);

    const stay = roomCostPerNight(tier, adults, children) * nights;
    const safari = RATES.safari * safaris;
    // transfers follow the safari rule: one vehicle charge per day, whatever the group size
    const transfers = wantsTransfers ? RATES.transferPerVehiclePerDay * days : 0;
    const subtotal = stay + safari + transfers;
    return { total: Math.round(subtotal * (1 + RATES.gst)), adults };
  };

  const updateConfigPrice = () => {
    const complete =
      !!document.querySelector('[data-duration-cards] .plp-dur-card.is-active') &&
      !!activeChip('safari') &&
      !!activeChip('stay') &&
      !!activeChip('transfers') &&
      !!document.querySelector<HTMLInputElement>('[data-config-date]')?.value &&
      !!document.querySelector<HTMLInputElement>('[data-config-travellers]')?.value;

    const { total, adults } = quoteTotal();
    selectedPrice = complete && adults ? Math.round(total / adults) : 0;

    set('[data-config-price]', complete ? fmtMoney(total) : '—');
    document.querySelectorAll('[data-config-per]').forEach((el) => ((el as HTMLElement).hidden = !complete));
    document.querySelectorAll('[data-config-perhead]').forEach((el) => {
      (el as HTMLElement).hidden = !complete || !adults;
      if (complete && adults) el.textContent = `(${fmtMoney(Math.round(total / adults))} per adult)`;
    });
    set('[data-config-foot-label]', complete ? 'Estimated price' : 'Your price');
    set('[data-config-foot-hint]', complete ? 'Includes 5% GST. This is an estimated price — enquire now for the exact price.' : 'Fill all the details above to see your price');

    // the package list describes whatever the traveller has configured
    const incTier = document.querySelector<HTMLElement>('[data-inc-tier]');
    const incOcc = document.querySelector<HTMLElement>('[data-inc-occupancy]');
    const incSafaris = document.querySelector<HTMLElement>('[data-inc-safaris]');
    const incTransfers = document.querySelector<HTMLElement>('[data-inc-transfers]');
    const tierChip = activeChip('stay')?.dataset.chip ?? '';
    const safariChip = activeChip('safari')?.dataset.safariN ?? '';
    const transfersChip = activeChip('transfers')?.dataset.chip ?? '';
    const adultCount = Number(cfgTrav?.dataset.adults ?? 0);
    const childCount = Number(cfgTrav?.dataset.children ?? 0);

    if (incTier && tierChip) incTier.textContent = tierChip.toLowerCase();
    if (incSafaris && safariChip) incSafaris.textContent = safariChip;
    if (incOcc && adultCount) {
      incOcc.textContent =
        adultCount === 1 && childCount === 0 ? 'single-occupancy'
        : childCount > 0 || adultCount % 2 === 1 ? 'double-sharing, with an extra bed'
        : 'double-sharing';
    }
    if (transfersChip) {
      const wantsTransfers = transfersChip.startsWith('Yes');
      if (incTransfers) incTransfers.hidden = !wantsTransfers;
      document.querySelectorAll<HTMLElement>('[data-exc-transfers]').forEach((el) => { el.hidden = wantsTransfers; });
    }

    const sidePrice = document.querySelector<HTMLElement>('[data-side-price]');
    const sidePer = document.querySelector<HTMLElement>('[data-side-per]');
    const sideStrike = document.querySelector<HTMLElement>('[data-side-strike]');
    const sideSale = document.querySelector<HTMLElement>('[data-side-sale]');
    const sidePerHead = document.querySelector<HTMLElement>('[data-side-perhead]');
    if (sidePrice) {
      const estimating = complete && adults > 0;
      const headline = estimating ? total : Number(sidePrice.dataset.base ?? 0);
      sidePrice.dataset.inr = String(headline);
      sidePrice.textContent = fmtMoney(headline);
      if (sidePer) sidePer.textContent = estimating ? 'total · estimated price' : 'Per Adult';
      if (sidePerHead) {
        sidePerHead.hidden = !estimating;
        if (estimating) sidePerHead.textContent = `(${fmtMoney(Math.round(total / adults))} per adult)`;
      }
      // the rack-rate discount no longer applies to a custom-built trip
      if (sideStrike) sideStrike.hidden = estimating;
      if (sideSale) sideSale.hidden = estimating;
    }

    const mobPrice = document.querySelector<HTMLElement>('[data-mob-price]');
    const mobPrefix = document.querySelector<HTMLElement>('[data-mob-prefix]');
    const mobSub = document.querySelector<HTMLElement>('[data-mob-sub]');
    if (mobPrice && mobPrefix && mobSub) {
      // once the traveller has started configuring, the rack rate would be stale -
      // hold the number back until the quote is real
      const touched =
        !!document.querySelector('[data-duration-cards] .plp-dur-card.is-active') ||
        !!activeChip('safari') || !!activeChip('stay') || !!activeChip('transfers') ||
        !!document.querySelector<HTMLInputElement>('[data-config-date]')?.value ||
        !!document.querySelector<HTMLInputElement>('[data-config-travellers]')?.value;

      if (complete && adults) {
        mobPrefix.textContent = 'Estimated price';
        mobPrice.hidden = false;
        mobPrice.dataset.inr = String(total);
        mobPrice.textContent = fmtMoney(total);
        mobSub.textContent = `(${fmtMoney(Math.round(total / adults))} per adult)`;
      } else if (touched) {
        mobPrefix.textContent = 'Complete all details';
        mobPrice.hidden = true;
        mobSub.textContent = 'to see your estimated price';
      } else {
        mobPrefix.textContent = 'Starting from';
        mobPrice.hidden = false;
        mobPrice.dataset.inr = mobPrice.dataset.base ?? '';
        mobPrice.textContent = fmtMoney(Number(mobPrice.dataset.base ?? 0));
        mobSub.textContent = 'per adult';
      }
    }
  };

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      cards.forEach((c) => c.classList.remove('is-active'));
      card.classList.add('is-active');
      const days = card.dataset.days ?? '';
      const nights = card.dataset.nights ?? '';
      const price = Number(card.dataset.price);
      const original = Number(card.dataset.original);
      const savings = Number(card.dataset.savings);
      const safaris = card.dataset.safaris ?? '';
      activeDays = days;
      applyView();
      set('[data-duration-pill]', `${days}D/${nights}N`);
      set('[data-daysin-num]', days);
      set('[data-stay-nights]', `${nights}N`);
      setInr('[data-side-price]', price);
      if (sidePriceEl) sidePriceEl.dataset.base = String(price);
      setInr('[data-side-strike]', original);
      setInr('[data-side-save]', savings);
      setInr('[data-mob-price]', price);
      if (mobPriceEl) mobPriceEl.dataset.base = String(price);
      renderPrices();
      const dur = document.querySelector<HTMLInputElement>('[data-side-duration]');
      if (dur) dur.value = `${days} days / ${nights} nights`;

      // reveal / limit the "number of safaris" chips for this duration
      const maxSafaris = Number(safaris);
      document.querySelector<HTMLElement>('[data-safari-hint]')?.setAttribute('hidden', '');
      const safariGroup = document.querySelector<HTMLElement>('[data-config-chips="safari"]');
      if (safariGroup) {
        safariGroup.hidden = false;
        safariGroup.querySelectorAll<HTMLButtonElement>('.plp-chip').forEach((chip) => {
          chip.hidden = Number(chip.dataset.safariN) > maxSafaris;
          chip.classList.remove('is-active');
        });
      }
      updateConfigPrice();
    });
  });

  // ---- "Get Your Price" modal ----
  const quoteModal = document.querySelector<HTMLElement>('[data-quote-modal]');
  const quoteFormWrap = document.querySelector<HTMLElement>('[data-quote-form-wrap]');
  const quoteResult = document.querySelector<HTMLElement>('[data-quote-result]');
  const quoteForm = quoteModal?.querySelector<HTMLFormElement>('.plp-modal-form');
  const quoteCopy: Record<string, { title: string; sub: string; submit: string; label: string; note: string; price: boolean }> = {
    price: {
      title: 'Get Your Price',
      sub: 'Fill in the form below to reveal the estimated price for your trip.',
      submit: 'Get Price',
      label: 'This is an estimated price',
      note: 'Enquire now for the exact price — our Tadoba expert will call you shortly with a quote for your dates and group.',
      price: true,
    },
    callback: {
      title: 'Get A Callback',
      sub: 'Leave your phone number and email — our Tadoba safari expert will call you back with a quote.',
      submit: 'Request Callback',
      label: 'Request received',
      note: 'Thanks! Our Tadoba expert will call you back shortly to plan your trip.',
      price: false,
    },
    enquiry: {
      title: 'Connect with a Travel Expert',
      sub: 'Share your details and our Tadoba safari expert will call you back.',
      submit: 'Connect with an Expert',
      label: 'Request received',
      note: 'Thanks! Our Tadoba safari expert will call you back shortly to plan your trip.',
      price: false,
    },
  };
  const setQ = (sel: string, txt: string) => { const el = quoteModal?.querySelector(sel); if (el) el.textContent = txt; };
  const openQuote = (rawMode: string) => {
    if (!quoteModal) return;
    const mode = quoteCopy[rawMode] ? rawMode : 'price';
    const c = quoteCopy[mode];
    quoteModal.dataset.mode = mode;
    setQ('[data-quote-title]', c.title);
    setQ('[data-quote-sub]', c.sub);
    setQ('[data-quote-submit]', c.submit);
    if (quoteFormWrap) quoteFormWrap.hidden = false;
    if (quoteResult) quoteResult.hidden = true;
    // "enquiry" drops the name field; "callback" asks for phone + email only
    const noName = mode === 'enquiry' || mode === 'callback';
    const noTravellers = mode === 'callback';
    quoteModal.querySelectorAll<HTMLInputElement>('.plp-modal-form input[name="name"]').forEach((el) => {
      el.hidden = noName;
      if (noName) el.removeAttribute('required'); else el.setAttribute('required', '');
    });
    quoteModal.querySelectorAll<HTMLElement>('[data-modal-travellers]').forEach((el) => { el.hidden = noTravellers; });
    const durEl = document.querySelector<HTMLButtonElement>('[data-duration-cards] .plp-dur-card.is-active');
    const md = quoteModal.querySelector<HTMLInputElement>('[data-modal-duration]');
    if (md) md.value = durEl ? `${durEl.dataset.days} days / ${durEl.dataset.nights} nights` : '';
    quoteModal.hidden = false;
    document.body.style.overflow = 'hidden';
  };
  const closeQuote = () => {
    if (!quoteModal) return;
    quoteModal.hidden = true;
    document.body.style.overflow = '';
  };
  document.querySelectorAll('[data-quote-open]').forEach((el) => el.addEventListener('click', () => openQuote((el as HTMLElement).dataset.quoteOpen ?? 'price')));
  quoteModal?.querySelectorAll('[data-quote-close]').forEach((el) => el.addEventListener('click', closeQuote));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && quoteModal && !quoteModal.hidden) closeQuote(); });
  quoteForm?.addEventListener('crm:success', () => {
    const c = quoteCopy[quoteModal?.dataset.mode ?? 'price'] ?? quoteCopy.price;
    setQ('[data-quote-result-label]', c.label);
    setQ('[data-quote-result-note]', c.note);
    const priceRow = quoteModal?.querySelector<HTMLElement>('[data-quote-price-row]');
    if (priceRow) priceRow.hidden = !c.price;
    if (c.price) {
      const fallback = Number(quoteModal?.dataset.fallbackPrice ?? 0);
      const price = selectedPrice > 0 ? selectedPrice : fallback;
      setQ('[data-quote-price]', `${selectedPrice > 0 ? '' : 'from '}${fmtMoney(price)}`);
    }
    if (quoteFormWrap) quoteFormWrap.hidden = true;
    if (quoteResult) quoteResult.hidden = false;
  });

  // ---- "customize" nudge: glow the configurator instead of navigating ----
  const cfgCard = document.querySelector<HTMLElement>('.plp-config');
  if (cfgCard && window.matchMedia('(max-width: 767px)').matches && 'IntersectionObserver' in window) {
    const attentionObserver = new IntersectionObserver((entries, observer) => {
      const entry = entries[0];
      if (!entry?.isIntersecting) return;
      cfgCard.classList.add('is-scroll-attention');
      observer.disconnect();
      window.setTimeout(() => cfgCard.classList.remove('is-scroll-attention'), 2800);
    }, { threshold: .18, rootMargin: '0px 0px -12% 0px' });
    attentionObserver.observe(cfgCard);
  }
  document.querySelector<HTMLButtonElement>('[data-config-nudge]')?.addEventListener('click', () => {
    if (!cfgCard) return;
    cfgCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
    cfgCard.classList.remove('is-nudge');
    void cfgCard.offsetWidth;
    cfgCard.classList.add('is-nudge');
    window.setTimeout(() => cfgCard.classList.remove('is-nudge'), 2400);
  });

  // ---- configurator chips (safari / stay / transfers) ----
  document.querySelectorAll<HTMLElement>('[data-config-chips]').forEach((group) => {
    const chips = group.querySelectorAll<HTMLButtonElement>('.plp-chip');
    chips.forEach((chip) => chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      updateConfigPrice();
    }));
  });

  // ---- configurator travel details -> mirror into the enquiry form ----
  const cfgDate = document.querySelector<HTMLInputElement>('[data-config-date]');
  const cfgTrav = document.querySelector<HTMLInputElement>('[data-config-travellers]');

  // ---- traveller pickers (every instance on the page) ----
  type TravApi = { set: (adults: number, children: number, infants: number) => void };
  const travPickers = new Map<HTMLElement, TravApi>();
  const MAX_TRAVELLERS = 8;
  const travOne: Record<string, string> = { adults: 'Adult', children: 'Child', infants: 'Infant' };
  const travMany: Record<string, string> = { adults: 'Adults', children: 'Children', infants: 'Infants' };

  document.querySelectorAll<HTMLElement>('[data-trav-field]').forEach((field) => {
    const toggle = field.querySelector<HTMLButtonElement>('[data-trav-toggle]');
    const panel = field.querySelector<HTMLElement>('[data-trav-panel]');
    const label = field.querySelector<HTMLElement>('[data-trav-label]');
    const totalInput = field.querySelector<HTMLInputElement>('[data-trav-total]');
    if (!toggle || !panel || !label || !totalInput) return;
    const outs: Record<string, HTMLInputElement | null> = {
      adults: field.querySelector('[data-trav-adults]'),
      children: field.querySelector('[data-trav-children]'),
      infants: field.querySelector('[data-trav-infants]'),
    };
    const counts: Record<string, number> = { adults: 0, children: 0, infants: 0 };

    const render = (notify: boolean) => {
      const total = counts.adults + counts.children + counts.infants;
      Object.keys(counts).forEach((k) => {
        const cell = field.querySelector<HTMLElement>('[data-trav-count="' + k + '"]');
        if (cell) cell.textContent = String(counts[k]);
        if (outs[k]) outs[k]!.value = String(counts[k]);
      });
      field.querySelectorAll<HTMLButtonElement>('[data-trav-inc]').forEach((b) => { b.disabled = total >= MAX_TRAVELLERS; });
      field.querySelectorAll<HTMLButtonElement>('[data-trav-dec]').forEach((b) => { b.disabled = counts[b.dataset.travDec ?? ''] === 0; });
      const parts = Object.keys(counts).filter((k) => counts[k] > 0)
        .map((k) => counts[k] + ' ' + (counts[k] > 1 ? travMany[k] : travOne[k]));
      label.textContent = parts.length ? parts.join(' · ') : 'Select travellers';
      label.classList.toggle('is-empty', parts.length === 0);
      totalInput.value = total ? String(total) : '';
      totalInput.dataset.adults = String(counts.adults);
      totalInput.dataset.children = String(counts.children);
      totalInput.dataset.infants = String(counts.infants);
      if (notify) totalInput.dispatchEvent(new Event('change', { bubbles: true }));
    };

    const close = () => { panel.hidden = true; toggle.setAttribute('aria-expanded', 'false'); };
    toggle.addEventListener('click', () => {
      const open = panel.hidden;
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    });
    field.querySelectorAll<HTMLButtonElement>('[data-trav-inc]').forEach((b) => b.addEventListener('click', () => {
      if (counts.adults + counts.children + counts.infants >= MAX_TRAVELLERS) return;
      counts[b.dataset.travInc ?? ''] += 1;
      render(true);
    }));
    field.querySelectorAll<HTMLButtonElement>('[data-trav-dec]').forEach((b) => b.addEventListener('click', () => {
      const k = b.dataset.travDec ?? '';
      if (counts[k] > 0) counts[k] -= 1;
      render(true);
    }));
    field.querySelector<HTMLButtonElement>('[data-trav-done]')?.addEventListener('click', close);
    document.addEventListener('click', (e) => { if (!panel.hidden && !field.contains(e.target as Node)) close(); });

    travPickers.set(field, {
      set: (a, c, i) => { counts.adults = a; counts.children = c; counts.infants = i; render(false); },
    });
    render(false);
  });

  // ---- date pickers (every instance on the page) ----
  type CalApi = { set: (startISO: string, endISO: string, flex: number) => void };
  const calPickers = new Map<HTMLElement, CalApi>();
  const CAL_MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

  document.querySelectorAll<HTMLElement>('[data-cal]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('[data-cal-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-cal-panel]');
    const summary = root.querySelector<HTMLElement>('[data-cal-label]');
    const help = root.querySelector<HTMLElement>('[data-cal-note]');
    const monthLabel = root.querySelector<HTMLElement>('[data-cal-month]');
    const grid = root.querySelector<HTMLElement>('[data-cal-grid]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-cal-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-cal-next]');
    const startInput = root.querySelector<HTMLInputElement>('[data-cal-start]');
    const endInput = root.querySelector<HTMLInputElement>('[data-cal-end]');
    const flexInput = root.querySelector<HTMLInputElement>('[data-cal-flex-value]');
    const flexChips = root.querySelectorAll<HTMLButtonElement>('[data-flex]');
    if (!trigger || !panel || !summary || !monthLabel || !grid || !prevBtn || !nextBtn || !startInput) return;

    // only the trip configurator caps the range by the chosen package length
    const capsToDuration = startInput.hasAttribute('data-config-date');

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const lastMonth = new Date(today.getFullYear(), today.getMonth() + 18, 1);
    let viewYear = today.getFullYear();
    let viewMonth = today.getMonth();
    let rangeStart: Date | null = null;
    let rangeEnd: Date | null = null;

    const pad2 = (n: number) => String(n).padStart(2, '0');
    const toISO = (d: Date) => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
    const dayLabel = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    const tripDays = () => Number(
      document.querySelector<HTMLElement>('[data-duration-cards] .plp-dur-card.is-active')?.dataset.days ?? 0
    );
    const maxEndFor = (from: Date) => {
      if (!capsToDuration) return null;
      const days = tripDays();
      return days ? new Date(from.getFullYear(), from.getMonth(), from.getDate() + days - 1) : null;
    };
    const rangeLabel = (from: Date, to: Date, days: number) => {
      const nights = days - 1;
      const flex = Number(flexInput?.value ?? '0');
      const suffix = flex ? ` · ±${flex}d` : '';
      if (from.getMonth() === to.getMonth() && from.getFullYear() === to.getFullYear()) {
        const monthYear = to.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
        return `${from.getDate()}-${to.getDate()} ${monthYear} (${days}D/${nights}N)${suffix}`;
      }
      const sameYear = from.getFullYear() === to.getFullYear();
      const fromLabel = from.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: sameYear ? undefined : 'numeric' });
      return `${fromLabel} - ${dayLabel(to)} (${days}D/${nights}N)${suffix}`;
    };

    const paint = () => {
      if (!rangeStart) {
        summary.textContent = 'Add dates';
        if (help) help.textContent = 'Select your start date';
      } else if (!rangeEnd) {
        summary.textContent = `${dayLabel(rangeStart)} — Select end date`;
        const max = maxEndFor(rangeStart);
        if (help) help.textContent = max ? `Your ${tripDays()}D/${tripDays() - 1}N trip ends by ${dayLabel(max)}` : 'Now select your end date';
      } else {
        const days = Math.round((rangeEnd.getTime() - rangeStart.getTime()) / 86400000) + 1;
        summary.textContent = rangeLabel(rangeStart, rangeEnd, days);
        if (help) help.textContent = `${days} day${days === 1 ? '' : 's'} selected`;
      }
      summary.classList.toggle('is-empty', !rangeStart);
      startInput.value = rangeStart ? toISO(rangeStart) : '';
      if (endInput) endInput.value = rangeEnd ? toISO(rangeEnd) : '';
    };

    const renderCalendar = () => {
      monthLabel.textContent = `${CAL_MONTHS[viewMonth]} ${viewYear}`;
      prevBtn.disabled = viewYear === today.getFullYear() && viewMonth === today.getMonth();
      nextBtn.disabled = viewYear === lastMonth.getFullYear() && viewMonth === lastMonth.getMonth();
      grid.innerHTML = '';
      const lead = new Date(viewYear, viewMonth, 1).getDay();
      for (let i = 0; i < lead; i += 1) grid.appendChild(document.createElement('span'));
      const days = new Date(viewYear, viewMonth + 1, 0).getDate();
      for (let d = 1; d <= days; d += 1) {
        const cellDate = new Date(viewYear, viewMonth, d);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(d);
        btn.dataset.dateIso = toISO(cellDate);
        if (cellDate < today) btn.disabled = true;
        if (rangeStart && !rangeEnd) {
          const max = maxEndFor(rangeStart);
          if (max && cellDate > max) btn.disabled = true;
        }
        if (rangeStart && toISO(cellDate) === toISO(rangeStart)) btn.classList.add('is-picked', 'is-start');
        if (rangeEnd && toISO(cellDate) === toISO(rangeEnd)) btn.classList.add('is-picked', 'is-end');
        if (rangeStart && rangeEnd && cellDate > rangeStart && cellDate < rangeEnd) btn.classList.add('is-in');
        grid.appendChild(btn);
      }
    };

    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
      if (!open) renderCalendar();
    });
    prevBtn.addEventListener('click', () => {
      viewMonth -= 1;
      if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
      renderCalendar();
    });
    nextBtn.addEventListener('click', () => {
      viewMonth += 1;
      if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
      renderCalendar();
    });
    grid.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-date-iso]');
      if (!btn || btn.disabled) return;
      const chosen = new Date(`${btn.dataset.dateIso}T00:00:00`);
      if (!rangeStart || rangeEnd || chosen < rangeStart) {
        rangeStart = chosen;
        rangeEnd = null;
      } else {
        const max = maxEndFor(rangeStart);
        if (max && chosen > max) return;
        rangeEnd = chosen;
      }
      paint();
      renderCalendar();
      startInput.dispatchEvent(new Event('change', { bubbles: true }));
      if (rangeEnd) {
        panel.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
    flexChips.forEach((chip) => chip.addEventListener('click', () => {
      flexChips.forEach((c) => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      if (flexInput) flexInput.value = chip.dataset.flex ?? '0';
      paint();
      startInput.dispatchEvent(new Event('change', { bubbles: true }));
    }));
    document.addEventListener('click', (event) => {
      if (event.composedPath().includes(root)) return;
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    });

    calPickers.set(root, {
      set: (startISO, endISO, flex) => {
        rangeStart = startISO ? new Date(`${startISO}T00:00:00`) : null;
        rangeEnd = endISO ? new Date(`${endISO}T00:00:00`) : null;
        if (flexInput) flexInput.value = String(flex);
        flexChips.forEach((c) => c.classList.toggle('is-active', Number(c.dataset.flex ?? 0) === flex));
        if (rangeStart) { viewYear = rangeStart.getFullYear(); viewMonth = rangeStart.getMonth(); }
        paint();
        renderCalendar();
      },
    });

    renderCalendar();
  });

  // a shorter package pulls the configurator's end date back with it
  document.querySelectorAll<HTMLButtonElement>('[data-duration-cards] .plp-dur-card').forEach((card) => {
    card.addEventListener('click', () => {
      const startISO = cfgDate?.value ?? '';
      const endISO = document.querySelector<HTMLInputElement>('[data-config-end]')?.value ?? '';
      if (!startISO || !endISO) return;
      const days = Number(card.dataset.days ?? 0);
      if (!days) return;
      const start = new Date(`${startISO}T00:00:00`);
      const max = new Date(start.getFullYear(), start.getMonth(), start.getDate() + days - 1);
      if (new Date(`${endISO}T00:00:00`) > max) {
        const iso = `${max.getFullYear()}-${String(max.getMonth() + 1).padStart(2, '0')}-${String(max.getDate()).padStart(2, '0')}`;
        const root = cfgDate?.closest<HTMLElement>('[data-cal]');
        const flex = Number(document.querySelector<HTMLInputElement>('[data-config-flex]')?.value ?? 0);
        if (root) calPickers.get(root)?.set(startISO, iso, flex);
        cfgDate?.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  });

  cfgDate?.addEventListener('change', () => {
    const own = cfgDate.closest<HTMLElement>('[data-cal]');
    const endISO = document.querySelector<HTMLInputElement>('[data-config-end]')?.value ?? '';
    const flex = Number(document.querySelector<HTMLInputElement>('[data-config-flex]')?.value ?? 0);
    calPickers.forEach((api, root) => { if (root !== own) api.set(cfgDate.value, endISO, flex); });
    updateConfigPrice();
  });
  cfgTrav?.addEventListener('change', () => {
    const own = cfgTrav.closest<HTMLElement>('[data-trav-field]');
    const a = Number(cfgTrav.dataset.adults ?? 0);
    const c = Number(cfgTrav.dataset.children ?? 0);
    const i = Number(cfgTrav.dataset.infants ?? 0);
    travPickers.forEach((api, field) => { if (field !== own) api.set(a, c, i); });
    updateConfigPrice();
  });

  // ---- itinerary tabs ----
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-itin-tabs] button');
  const views: Record<string, typeof currentView> = { itinerary: 'itinerary', summary: 'summary', activities: 'activities', stay: 'stay', transfers: 'transfers' };
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('is-active'));
      tab.classList.add('is-active');
      currentView = views[tab.dataset.itinTab ?? 'itinerary'] ?? 'itinerary';
      applyView();
    });
  });

  // ---- top gallery hero carousel ----
  const heroCar = document.querySelector<HTMLElement>('[data-hero-carousel]');
  if (heroCar) {
    const hSlides = Array.from(heroCar.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const hDots = Array.from(heroCar.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    let hIdx = 0;
    let hTimer = 0;
    const hGo = (n: number) => {
      hIdx = (n + hSlides.length) % hSlides.length;
      hSlides.forEach((s, i) => s.classList.toggle('is-active', i === hIdx));
      hDots.forEach((d, i) => d.classList.toggle('is-active', i === hIdx));
    };
    const hPlay = () => {
      window.clearInterval(hTimer);
      hTimer = window.setInterval(() => hGo(hIdx + 1), 4500);
    };
    hDots.forEach((d, i) => d.addEventListener('click', () => { hGo(i); hPlay(); }));
    // swipe sideways on touch
    let hStartX = 0;
    heroCar.addEventListener('touchstart', (e) => { hStartX = e.changedTouches[0].clientX; }, { passive: true });
    heroCar.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - hStartX;
      if (Math.abs(dx) > 45) { hGo(hIdx + (dx < 0 ? 1 : -1)); hPlay(); }
    });
    // pause while the tab is hidden or the pointer is over it
    heroCar.addEventListener('mouseenter', () => window.clearInterval(hTimer));
    heroCar.addEventListener('mouseleave', hPlay);
    document.addEventListener('visibilitychange', () => (document.hidden ? window.clearInterval(hTimer) : hPlay()));
    if (hSlides.length > 1) hPlay();
  }

  // ---- itinerary hero carousel ----
  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-itin-hero] [data-itin-slide]'));
  let cur = 0;
  const counter = document.querySelector<HTMLElement>('[data-itin-count]');
  const go = (n: number) => {
    cur = (n + slides.length) % slides.length;
    slides.forEach((s, i) => s.classList.toggle('is-active', i === cur));
    if (counter) counter.textContent = `${cur + 1}/${slides.length}`;
  };
  document.querySelectorAll('[data-itin-prev]').forEach((el) => el.addEventListener('click', () => go(cur - 1)));
  document.querySelectorAll('[data-itin-next]').forEach((el) => el.addEventListener('click', () => go(cur + 1)));
  if (slides.length > 1) setInterval(() => go(cur + 1), 5000);

  // ---- additional info read more ----
  const addlToggle = document.querySelector<HTMLButtonElement>('[data-addl-toggle]');
  const addlBody = document.querySelector<HTMLElement>('[data-addl-body]');
  const addlHidden = document.querySelector<HTMLElement>('[data-addl-hidden]');
  addlToggle?.addEventListener('click', () => {
    const open = addlBody?.classList.toggle('is-open');
    if (addlHidden) addlHidden.hidden = !open;
    if (addlToggle) addlToggle.textContent = open ? 'Read Less' : 'Read More';
  });

  // ---- mobile CTA -> open the enquiry sidebar as a bottom sheet ----
  const enquirySide = document.querySelector<HTMLElement>('.plp-side');
  const enquiryBackdrop = document.querySelector<HTMLElement>('.plp-side-backdrop');
  const openEnquiry = () => {
    if (!enquirySide) return;
    enquirySide.classList.add('is-open');
    if (enquiryBackdrop) enquiryBackdrop.hidden = false;
    document.body.style.overflow = 'hidden';
    enquirySide.scrollTop = 0;
  };
  const closeEnquiry = () => {
    enquirySide?.classList.remove('is-open');
    if (enquiryBackdrop) enquiryBackdrop.hidden = true;
    document.body.style.overflow = '';
  };
  document.querySelector<HTMLAnchorElement>('[data-mob-cta]')?.addEventListener('click', (e) => {
    e.preventDefault();
    openEnquiry();
  });
  document.querySelectorAll('[data-enquiry-close]').forEach((el) => el.addEventListener('click', closeEnquiry));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && enquirySide?.classList.contains('is-open')) closeEnquiry(); });

  // ---- reviews slider ----
  const reviewsStrip = document.querySelector<HTMLElement>('[data-reviews-strip]');
  const reviewsNav = document.querySelector<HTMLElement>('[data-reviews-nav]');
  if (reviewsStrip && reviewsNav) {
    const rStep = () => ((reviewsStrip.querySelector('.plp-review') as HTMLElement | null)?.offsetWidth ?? 300) + 16;
    const [rPrev, rNext] = reviewsNav.querySelectorAll('button');
    const syncReviewsNav = () => {
      const max = reviewsStrip.scrollWidth - reviewsStrip.clientWidth;
      rPrev.disabled = reviewsStrip.scrollLeft <= 1;
      rNext.disabled = reviewsStrip.scrollLeft >= max - 1;
    };
    rPrev.addEventListener('click', () => reviewsStrip.scrollBy({ left: -rStep() * 3, behavior: 'smooth' }));
    rNext.addEventListener('click', () => reviewsStrip.scrollBy({ left: rStep() * 3, behavior: 'smooth' }));
    reviewsStrip.addEventListener('scroll', syncReviewsNav, { passive: true });
    window.addEventListener('resize', syncReviewsNav);
    syncReviewsNav();
  }

  // ---- phone fields: digits only ----
  document.querySelectorAll<HTMLInputElement>('input[type="tel"][name="phone"]').forEach((input) => {
    input.addEventListener('input', () => {
      const digits = input.value.replace(/\D+/g, '').slice(0, 15);
      if (digits !== input.value) {
        const atEnd = input.selectionStart === input.value.length;
        input.value = digits;
        if (atEnd) input.setSelectionRange(digits.length, digits.length);
      }
      input.setCustomValidity(
        digits.length === 0 || digits.length >= 7 ? '' : 'Please enter a complete phone number.',
      );
    });
    input.addEventListener('blur', () => {
      const digits = input.value.replace(/\D+/g, '');
      input.setCustomValidity(
        digits.length === 0 || digits.length >= 7 ? '' : 'Please enter a complete phone number.',
      );
    });
  });

  // ---- related products: advance to the next tour every 3s ----
  const relStrip = document.querySelector<HTMLElement>('.plp-related');
  if (relStrip && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let paused = false;
    let resumeAt = 0;

    // a touch, a click or a manual scroll hands control back to the reader for a while
    const holdOff = () => { resumeAt = Date.now() + 6000; };
    ['pointerdown', 'touchstart', 'wheel', 'keydown'].forEach((evt) =>
      relStrip.addEventListener(evt, holdOff, { passive: true }));
    relStrip.addEventListener('mouseenter', () => { paused = true; });
    relStrip.addEventListener('mouseleave', () => { paused = false; });

    // only run while the strip is actually on screen
    let onScreen = false;
    new IntersectionObserver(
      (entries) => entries.forEach((e) => { onScreen = e.isIntersecting; }),
      { threshold: 0.4 },
    ).observe(relStrip);

    window.setInterval(() => {
      if (paused || !onScreen || Date.now() < resumeAt) return;
      // the slider only exists on narrow screens; on desktop the cards sit in a grid
      if (relStrip.scrollWidth <= relStrip.clientWidth + 4) return;
      const card = relStrip.querySelector<HTMLElement>('.plp-rel-card');
      const step = (card?.offsetWidth ?? 280) + 13;
      const atEnd = relStrip.scrollLeft >= relStrip.scrollWidth - relStrip.clientWidth - 4;
      relStrip.scrollTo({ left: atEnd ? 0 : relStrip.scrollLeft + step, behavior: 'smooth' });
    }, 3000);
  }

  // ---- minimise the shared footer columns on this landing page ----
  document.querySelectorAll<HTMLDetailsElement>('.footer-accordion').forEach((d) => d.removeAttribute('open'));

  // ---- scroll arrows for the "amazing experiences" card strips ----
  document.querySelectorAll<HTMLElement>('.plp-act-cards').forEach((strip) => {
    const note = strip.previousElementSibling as HTMLElement | null;
    if (!note || !note.classList.contains('plp-act-note')) return;
    const label = note.textContent ?? '';
    note.textContent = '';
    const span = document.createElement('span');
    span.className = 'plp-act-note-txt';
    span.textContent = label;
    const nav = document.createElement('div');
    nav.className = 'plp-act-nav';
    nav.innerHTML =
      '<button type="button" aria-label="Scroll left"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m14.5 6.5-5 5.5 5 5.5"/></svg></button>' +
      '<button type="button" aria-label="Scroll right"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9.5 6.5 5 5.5-5 5.5"/></svg></button>';
    note.classList.add('plp-act-note--has-nav');
    note.append(span, nav);
    const step = () => ((strip.querySelector('.plp-act-card') as HTMLElement | null)?.offsetWidth ?? 150) + 12;
    const [prevBtn, nextBtn] = nav.querySelectorAll('button');
    const syncNav = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      prevBtn.disabled = strip.scrollLeft <= 1;
      nextBtn.disabled = strip.scrollLeft >= max - 1;
    };
    prevBtn.addEventListener('click', () => strip.scrollBy({ left: -step() * 2, behavior: 'smooth' }));
    nextBtn.addEventListener('click', () => strip.scrollBy({ left: step() * 2, behavior: 'smooth' }));
    strip.addEventListener('scroll', syncNav, { passive: true });
    window.addEventListener('resize', syncNav);
    syncNav();
  });

  // ---- currency picker ----
  let curCode = 'INR';
  let curSym = '₹';
  let curRate = 1;
  let curRates: Record<string, number> | null = null;
  const curPill = document.querySelector<HTMLElement>('[data-cur-open]');
  const curSheet = document.querySelector<HTMLElement>('[data-cur-sheet]');

  /** Non-INR prices carry a 15% international handling markup. */
  const FX_MARKUP = 1.15;

  function fmtMoney(amountInr: number) {
    if (curCode === 'INR' || !curRate) return `₹${amountInr.toLocaleString('en-IN')}`;
    const val = amountInr * curRate * FX_MARKUP;
    const shown = val >= 100 ? Math.round(val) : Math.round(val * 100) / 100;
    return `${curSym}${shown.toLocaleString('en-US')}`;
  }

  /** Repaints every price node from its INR base into the active currency. */
  function renderPrices() {
    document.querySelectorAll<HTMLElement>('[data-inr]').forEach((el) => {
      const base = Number(el.dataset.inr);
      if (base) el.textContent = fmtMoney(base);
    });
    updateConfigPrice();
  }

  if (curPill && curSheet) {
    const curInput = curSheet.querySelector<HTMLInputElement>('[data-cur-input]');
    const curItems = Array.from(curSheet.querySelectorAll<HTMLButtonElement>('[data-cur-pick]'));
    const curEmpty = curSheet.querySelector<HTMLElement>('[data-cur-empty]');
    const curGroups = Array.from(curSheet.querySelectorAll<HTMLElement>('.plp-cur-group'));
    const curGrids = Array.from(curSheet.querySelectorAll<HTMLElement>('.plp-cur-grid'));
    const STORE = 'we_lp_currency';

    const loadRates = async () => {
      if (curRates) return curRates;
      try {
        const cached = sessionStorage.getItem('we_lp_rates');
        if (cached) { curRates = JSON.parse(cached); return curRates; }
      } catch {}
      try {
        const res = await fetch('https://open.er-api.com/v6/latest/INR');
        const data = await res.json();
        if (data && data.rates) {
          curRates = data.rates as Record<string, number>;
          try { sessionStorage.setItem('we_lp_rates', JSON.stringify(curRates)); } catch {}
        }
      } catch {}
      return curRates;
    };

    const flagSrc = (code: string) => `https://flagcdn.com/${code === 'EUR' ? 'eu' : code.slice(0, 2).toLowerCase()}.svg`;

    const applyCurrency = async (code: string, sym: string, save = true) => {
      curCode = code; curSym = sym;
      curPill.querySelector<HTMLImageElement>('[data-cur-flag]')!.src = flagSrc(code);
      curPill.querySelector('[data-cur-code]')!.textContent = code;
      curPill.querySelector('[data-cur-sym]')!.textContent = sym;
      curItems.forEach((b) => b.classList.toggle('is-active', b.dataset.curPick === code));
      if (save) { try { localStorage.setItem(STORE, JSON.stringify({ code, sym })); } catch {} }
      if (code === 'INR') { curRate = 1; renderPrices(); return; }
      const rates = await loadRates();
      curRate = rates && rates[code] ? rates[code] : 0;
      renderPrices();
    };

    const closeCur = () => { curSheet.hidden = true; document.body.style.overflow = ''; };
    curPill.addEventListener('click', () => {
      curSheet.hidden = false; document.body.style.overflow = 'hidden'; curInput?.focus();
    });
    curSheet.querySelectorAll('[data-cur-close]').forEach((el) => el.addEventListener('click', closeCur));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !curSheet.hidden) closeCur(); });

    curItems.forEach((b) => b.addEventListener('click', () => {
      applyCurrency(b.dataset.curPick ?? 'INR', b.dataset.curSym ?? '');
      closeCur();
    }));

    curInput?.addEventListener('input', () => {
      const q = curInput.value.trim().toLowerCase();
      let any = false;
      curItems.forEach((b) => {
        const match = !q || (b.dataset.curSearch ?? '').includes(q);
        b.hidden = !match;
        if (match) any = true;
      });
      curGroups.forEach((g) => (g.hidden = q.length > 0));
      curGrids.forEach((gr) => {
        gr.hidden = !Array.from(gr.querySelectorAll<HTMLElement>('[data-cur-pick]')).some((x) => !x.hidden);
      });
      if (curEmpty) curEmpty.hidden = any;
    });

    try {
      const saved = JSON.parse(localStorage.getItem(STORE) || 'null');
      if (saved && saved.code && saved.code !== 'INR') applyCurrency(saved.code, saved.sym, false);
    } catch {}
  }
</script>
