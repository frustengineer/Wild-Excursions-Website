  .plp-config-travel input, .plp-config-travel select { width: 100%; min-width: 0; max-width: 100%; min-height: 2.75rem; box-sizing: border-box; border: 1px solid var(--line); border-radius: .55rem; background: var(--surface); color: var(--ink); font-size: .88rem; font-family: inherit; padding: .7rem .8rem; outline: none; cursor: pointer; }
