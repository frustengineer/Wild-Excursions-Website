  .plp-stay-img { position: relative; display: block; aspect-ratio: 1 / 1; border-radius: .6rem; overflow: hidden; }
  .plp-stay-body { display: block; min-width: 0; }
  .plp-stay-cat { display: block; font-size: .6rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
