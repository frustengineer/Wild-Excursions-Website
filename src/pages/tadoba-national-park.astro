              <svg class="plp-modal-trust-logo" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.3-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.1 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35 26.7 36 24 36c-5.3 0-9.7-3.1-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C39.9 41.6 44 36.5 44 24c0-1.3-.1-2.3-.4-3.5z"/></svg>
              <b>4.9/5</b><em>Google</em>
            </span>
            <span><Image src={weLogo} alt="Wild Excursions" width={40} height={40} format="webp" class="plp-modal-trust-logo" loading="lazy" /><b>4.9/5</b><em>Wild Excursions</em></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Currency picker sheet -->
    <div class="plp-cur" data-cur-sheet hidden>
      <div class="plp-cur-overlay" data-cur-close></div>
      <div class="plp-cur-panel" role="dialog" aria-modal="true" aria-label="Currency picker">
        <div class="plp-cur-grip" aria-hidden="true"></div>
        <div class="plp-cur-head">
          <p>Currency Picker</p>
          <button type="button" data-cur-close aria-label="Close currency picker"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
        </div>
        <label class="plp-cur-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5" stroke-linecap="round"/></svg>
          <input type="text" placeholder="Search currencies" data-cur-input autocomplete="off" />
        </label>
        <div class="plp-cur-body" data-cur-list>
          <p class="plp-cur-group">Commonly Used Currencies</p>
          <div class="plp-cur-grid">
            {currencies.filter((c) => commonCurrencyCodes.includes(c.code)).map((c) => (
              <button type="button" class="plp-cur-item" data-cur-pick={c.code} data-cur-sym={c.symbol} data-cur-search={`${c.code} ${c.name}`.toLowerCase()}>
                <img class="plp-cur-flag" src={flagUrl(c.code)} alt="" width="26" height="20" loading="lazy" decoding="async" />
                <span class="plp-cur-code"><b>{c.code}</b> <i>&ndash;{c.symbol}</i></span>
                <span class="plp-cur-name">{c.name}</span>
              </button>
            ))}
          </div>
          <p class="plp-cur-group">All Other Currencies</p>
          <div class="plp-cur-grid">
            {currencies.filter((c) => !commonCurrencyCodes.includes(c.code)).map((c) => (
              <button type="button" class="plp-cur-item" data-cur-pick={c.code} data-cur-sym={c.symbol} data-cur-search={`${c.code} ${c.name}`.toLowerCase()}>
                <img class="plp-cur-flag" src={flagUrl(c.code)} alt="" width="26" height="20" loading="lazy" decoding="async" />
                <span class="plp-cur-code"><b>{c.code}</b> <i>&ndash;{c.symbol}</i></span>
                <span class="plp-cur-name">{c.name}</span>
              </button>
            ))}
          </div>
          <p class="plp-cur-empty" data-cur-empty hidden>No currency found.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  :global(html), :global(body) { max-width: 100%; overflow-x: clip; }

  /* collapsible footer columns on this landing page only */
  :global(.footer-payment-badge[aria-label='RuPay'] img) { width: auto !important; height: .75rem !important; }
  :global(.footer-accordion-summary) { pointer-events: auto !important; cursor: pointer !important; }
  :global(.footer-accordion-chevron) { display: block !important; }
  @media (min-width: 768px) {
    :global(footer > div:has(> .footer-accordion)) { grid-template-columns: repeat(5, minmax(0, 1fr)) !important; }
  }

  /* glass navbar on this landing page only (mirrors .wild-navbar--glass) */
  @media (min-width: 768px) {
    :global(.wild-navbar) {
      background: linear-gradient(115deg, rgba(34,34,34,.6), rgba(5,5,5,.72) 52%, rgba(24,24,24,.58)) !important;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 18px 42px rgba(0,0,0,.5) !important;
      backdrop-filter: blur(22px) saturate(135%) !important;
      -webkit-backdrop-filter: blur(22px) saturate(135%) !important;
    }
  }

  /* mobile: transparent nav that sits over the hero image (like the reference) */
  @media (max-width: 767px) {
    :global(main) { padding-top: 0 !important; }
    :global(.wild-navbar) {
      position: absolute !important;
      top: 1.7rem !important; left: 0 !important; right: 0 !important;
      width: auto !important; margin: 0 !important;
      border-radius: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      backdrop-filter: none !important; -webkit-backdrop-filter: none !important;
      padding: .55rem 1rem !important;
      justify-content: flex-start !important; gap: .55rem;
    }
    :global(.wild-navbar)::before, :global(.wild-navbar)::after { display: none !important; }
    /* hamburger to the far left, search stays right */
    :global(.wild-navbar > div:nth-child(3)) { display: contents; }
    :global(.wild-navbar > div:nth-child(3) > [data-mobile-menu-toggle]) { order: -1; }
    :global(.wild-navbar > div:nth-child(3) > [data-theme-toggle]) { order: 1; margin-left: auto; margin-right: 5rem; }
    /* smaller logo + tidier brand text */
    :global(.wild-navbar > div:first-child > a > img) { height: 1.9rem !important; width: 1.9rem !important; }
    :global(.wild-navbar > div:first-child > a) { gap: .45rem !important; }
    :global(.wild-navbar-brand) { font-size: 20px !important; letter-spacing: .02em !important; line-height: 1 !important; display: flex !important; align-items: center !important; transform: translateY(.12em) !important; text-shadow: 0 1px 8px rgba(0,0,0,.45) !important; }
  }

  .plp {
    --ink: #1f1f1f; --ink-soft: #4a463f; --muted: #8a857e; --line: #e8e5e1;
    --field: #f7f6f4; --amber: #fdcb08; --gold: #cfa100; --green: #0fb680; --red: #e0483e;
    --page: #ffffff; --surface: #ffffff; --surface-2: #f4f6f9;
    background: var(--page); color: var(--ink);
    font-family: "Poppins", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 15px; line-height: 1.6;
    padding-bottom: 5rem;
  }
  .plp * { box-sizing: border-box; }
  .plp a { color: var(--gold); text-decoration: none; }
  .plp a:hover { text-decoration: underline; }
  .plp h1, .plp h2 { color: var(--ink); letter-spacing: -0.01em; }
  .plp-shell { width: min(1160px, calc(100% - 2rem)); margin-inline: auto; }
  .plp-rule { border: 0; border-top: 1px solid var(--line); margin: 1.75rem 0; }

  /* sale bar */
  .plp-salebar { position: relative; isolation: isolate; overflow: hidden; width: 100vw; margin-left: calc(50% - 50vw); background: linear-gradient(100deg, #fdcb08, #ff9d1e); color: #201700; }
  .plp-salebar::after {
    content: "";
    position: absolute;
    z-index: 0;
    inset-block: -70%;
    left: -8rem;
    width: 6rem;
    transform: skewX(-18deg);
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.18) 30%, rgba(255,255,255,.72) 48%, rgba(255,255,255,.2) 66%, transparent);
    animation: plp-sale-highlight 3.6s ease-in-out infinite;
    pointer-events: none;
  }
  .plp-salebar-inner { position: relative; z-index: 1; width: min(1160px, calc(100% - 2rem)); margin-inline: auto; display: flex; align-items: center; justify-content: center; gap: 1.25rem; padding: .55rem 1rem; font-size: .82rem; flex-wrap: wrap; }
  .plp-salebar-inner p { margin: 0; }
  .plp-salebar-copy { display: grid; min-width: min(31rem, 100%); overflow: hidden; }
  .plp-salebar-copy > span {
    grid-area: 1 / 1;
    text-align: center;
    white-space: nowrap;
    animation: plp-sale-copy 12s ease-in-out infinite both;
  }
  .plp-salebar-copy > span:nth-child(2) { animation-delay: -8s; }
  .plp-salebar-copy > span:nth-child(3) { animation-delay: -4s; }
  .plp-salebar-timer { display: inline-flex; align-items: center; gap: .1rem; font-weight: 800; }
  .plp-salebar-timer span { background: rgba(0,0,0,.14); border-radius: .3rem; padding: .1rem .35rem; }
  .plp-salebar-timer b { font-weight: 700; margin: 0 .15rem 0 .1rem; font-size: .72rem; }
  .plp-salebar-timer i { font-style: normal; opacity: .6; margin: 0 .15rem; }
  @keyframes plp-sale-highlight {
    0%, 12% { left: -8rem; opacity: 0; }
    20% { opacity: 1; }
    72% { left: calc(100% + 8rem); opacity: 1; }
    80%, 100% { left: calc(100% + 8rem); opacity: 0; }
  }
  @keyframes plp-sale-copy {
    0%, 28% { opacity: 1; transform: translateY(0); }
    34%, 94% { opacity: 0; transform: translateY(-.65rem); }
    95% { opacity: 0; transform: translateY(.65rem); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .plp-salebar::after { animation: none; display: none; }
    .plp-salebar-copy > span { animation: none; }
    .plp-salebar-copy > span:not(:first-child) { display: none; }
  }

  /* gallery */
  .plp-gallery { display: grid; grid-template-columns: 1.55fr 1fr; gap: .55rem; margin-top: 1.25rem; align-items: stretch; }
  .plp-gallery-main { position: relative; aspect-ratio: 16 / 11; overflow: hidden; border-radius: .9rem; background: #e8e5e1; }
  /* hero carousel */
  .plp-hero-slide { position: absolute; inset: 0; opacity: 0; transition: opacity .7s ease; }
  .plp-hero-slide.is-active { opacity: 1; }
  /* blurred copy fills the frame; the real photo sits on top, whole and uncropped */
  .plp-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: blur(26px) brightness(.62) saturate(1.15); transform: scale(1.18); }
  .plp-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .plp-hero-dashes { position: absolute; left: 50%; bottom: 1rem; transform: translateX(-50%); z-index: 3; display: flex; align-items: center; gap: .35rem; }
  .plp-hero-dash {
    width: 1.5rem; height: 3px; padding: 0; border: 0; border-radius: 999px; cursor: pointer;
    background: rgba(255,255,255,.45); box-shadow: 0 1px 3px rgba(0,0,0,.35);
    transition: background .25s ease, width .25s ease;
  }
  .plp-hero-dash:hover { background: rgba(255,255,255,.75); }
  .plp-hero-dash.is-active { background: #fff; width: 2.2rem; }
  .plp-gallery-side { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: .55rem; min-height: 0; }
  .plp-gallery-tile { position: relative; margin: 0; min-height: 0; height: 100%; overflow: hidden; border-radius: .8rem; }
  .plp-gallery-tile figcaption { position: absolute; left: .55rem; bottom: .55rem; color: #fff; font-size: .72rem; font-weight: 700; text-shadow: 0 1px 4px rgba(0,0,0,.6); }
  .plp a.plp-view-all { position: absolute; right: .6rem; bottom: .6rem; z-index: 1; display: inline-flex; align-items: center; gap: .4rem; background: var(--surface); color: #111; font-weight: 700; font-size: .76rem; letter-spacing: -.01em; padding: .5rem .8rem; border-radius: .75rem; box-shadow: 0 6px 16px rgba(0,0,0,.16); text-decoration: none; }
  .plp a.plp-view-all:hover { color: #111; text-decoration: none; background: #fff; }
  .plp-view-all svg { width: .95rem; height: .95rem; color: #111; }
  .plp-gallery-stack { display: none; }

  /* layout */
  .plp-layout { display: grid; grid-template-columns: minmax(0,1fr) 360px; gap: 2.5rem; align-items: start; margin-top: 2rem; }
  .plp-body h1 { font-size: clamp(1.6rem, 3.6vw, 2.4rem); font-weight: 800; margin: 0; line-height: 1.15; }
  .plp-titlerow { display: flex; align-items: center; gap: 1rem; margin-top: .85rem; }
  .plp-pill { background: var(--amber); color: #241a00; font-size: .74rem; font-weight: 800; padding: .3rem .7rem; border-radius: 999px; }
  .plp-titlerow-right { display: none; }

  .plp-inc-strip { overflow: hidden; }
  .plp-inc-track { display: flex; flex-wrap: wrap; gap: .75rem 1.75rem; }
  .plp-inc-track > span { display: inline-flex; align-items: center; gap: .5rem; font-size: .8rem; font-weight: 600; color: var(--ink-soft); }
  .plp-inc-track > span[aria-hidden='true'] { display: none; }
  .plp-inc-strip .icon-png { width: 1.2rem; height: 1.2rem; flex-shrink: 0; }

  /* dark theme: the navbar switch flips html.dark, this repaints the page's own palette */
  :global(html.dark) .plp {
    --ink: #f1eeea; --ink-soft: #cbc5bc; --muted: #948d85; --line: #302d29;
    --field: #1b1a18; --page: #0e0d0c; --surface: #171614; --surface-2: #201e1b;
  }
  :global(html.dark) .plp img:not(.plp-hero-bg) { filter: brightness(.94); }

  .plp-block { margin-top: 2.5rem; }
  .plp-block-title { font-size: 1.15rem; font-weight: 800; margin: 0 0 1rem; }

  /* duration cards */
  .plp-dur-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: .7rem; }
  .plp-config-hero {
    position: relative; overflow: hidden;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .9rem 1rem;
    padding: 1.2rem 1.3rem 1.3rem;
    background: linear-gradient(112deg, #fdcb08 0%, #ffb214 52%, #ff9d1e 100%);
    color: #241a00;
  }
  /* light catching the corner, so the header feels lit rather than filled */
  .plp-config-hero::before {
    content: ""; position: absolute; inset: 0 -3.5rem;
    background: repeating-linear-gradient(114deg, rgba(255,255,255,.16) 0 10px, transparent 10px 28px);
    animation: plp-config-stripes 1.8s linear infinite;
    will-change: transform;
  }
  @keyframes plp-config-stripes {
    to { transform: translate3d(-30.65px, 0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .plp-config-hero::before { animation: none; }
  }
  .plp-config-hero::after {
    content: ""; position: absolute; top: -5.5rem; right: -3.5rem; width: 13rem; height: 13rem; border-radius: 999px;
    background: radial-gradient(circle, rgba(255,255,255,.55), transparent 66%);
  }
  .plp-config-hero > * { position: relative; z-index: 1; }
  .plp-config-hero-text { min-width: 12rem; flex: 1 1 14rem; }
  .plp-config-eyebrow {
    display: inline-flex; align-items: center; gap: .35rem;
    padding: .26rem .6rem; border-radius: 999px;
    background: rgba(36,26,0,.14); color: #241a00;
    font-size: .6rem; font-weight: 900; letter-spacing: .14em; text-transform: uppercase;
  }
  .plp-config-eyebrow svg { width: .82rem; height: .82rem; }
  .plp-config-hero-title { margin: .5rem 0 0; font-size: 1rem; font-weight: 800; line-height: 1.35; max-width: 24rem; }
  .plp-config-hero-btn {
    flex-shrink: 0; border: 0; cursor: pointer; font-family: inherit;
    display: inline-flex; align-items: center; gap: .45rem;
    background: #241a00; color: #fff; font-weight: 800; font-size: .85rem;
    padding: .65rem 1.25rem; border-radius: 999px;
    box-shadow: 0 6px 16px rgba(36,26,0,.28);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .plp-config-hero-btn span { transition: transform .15s ease; }
  .plp-config-hero-btn:hover { transform: translateY(-1px); box-shadow: 0 9px 20px rgba(36,26,0,.34); }
  .plp-config-hero-btn:hover span { transform: translateX(3px); }
  .plp-config.is-nudge { animation: plp-nudge 1.1s ease 2; }
  @keyframes plp-nudge {
    0%, 100% { box-shadow: 0 0 0 0 rgba(224,72,62,0); border-color: var(--line); }
    50% { box-shadow: 0 0 0 5px rgba(224,72,62,.32); border-color: #e0483e; }
  }
  @media (max-width: 767px) and (prefers-reduced-motion: no-preference) {
    .plp-config.is-scroll-attention .plp-config-hero-btn { animation: plp-config-cta-pop 1.15s cubic-bezier(.2,.8,.2,1) .12s both; }
    .plp-config.is-scroll-attention .plp-config-body { animation: plp-config-form-slide .95s cubic-bezier(.2,.8,.2,1) both; }
  }
  @keyframes plp-config-form-slide {
    0% { opacity: .25; transform: translateX(-3rem); }
    68% { opacity: 1; transform: translateX(.35rem); }
    100% { opacity: 1; transform: translateX(0); }
  }
  @keyframes plp-config-cta-pop {
    0% { opacity: .45; transform: scale(.78); box-shadow: 0 4px 10px rgba(36,26,0,.2); }
    52% { opacity: 1; transform: scale(1.12); box-shadow: 0 0 0 7px rgba(255,255,255,.34), 0 12px 28px rgba(36,26,0,.42); }
    76% { transform: scale(.96); }
    100% { opacity: 1; transform: scale(1); box-shadow: 0 6px 16px rgba(36,26,0,.28); }
  }
  .plp-dur-card {
    position: relative; display: grid; gap: .2rem; place-items: center; text-align: center;
    cursor: pointer; font-family: inherit; overflow: hidden; isolation: isolate;
    padding: .95rem .6rem .8rem; border-radius: .8rem;
    border: 1.5px solid var(--line); background: var(--surface);
    transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease, background-color .18s ease;
  }
  /* a warm wash that sweeps in on hover, so the tile invites the tap */
  .plp-dur-card::after {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(120% 90% at 50% 0%, rgba(253,203,8,.22), transparent 70%);
    opacity: 0; transition: opacity .18s ease;
  }
  .plp-dur-card::before {
    content: "✓"; position: absolute; z-index: 2; top: .4rem; right: .4rem;
    display: grid; place-items: center; width: 1.2rem; height: 1.2rem; border-radius: 999px;
    background: var(--amber); color: #241a00; font-size: .68rem; font-weight: 900;
    opacity: 0; transform: scale(.5); transition: opacity .18s ease, transform .18s ease;
  }
  .plp-dur-card:hover { border-color: rgba(253,203,8,.7); transform: translateY(-2px); }
  .plp-dur-card:hover::after { opacity: 1; }
  .plp-dur-card.is-active {
    border-color: var(--amber); background: rgba(253,203,8,.09);
    box-shadow: 0 6px 18px rgba(253,203,8,.3); transform: translateY(-2px);
  }
  .plp-dur-card.is-active::after { opacity: 1; }
  .plp-dur-card.is-active::before { opacity: 1; transform: scale(1); }
  .plp-dur-code { font-size: 1.15rem; font-weight: 900; color: var(--ink); letter-spacing: .01em; line-height: 1.1; }
  .plp-dur-sub { font-size: .66rem; font-weight: 600; color: var(--muted); }
  .plp-dur-card.is-active .plp-dur-sub { color: var(--gold); }

  /* trip configurator */
  .plp-config { border: 1px solid var(--line); border-radius: .9rem; overflow: hidden; box-shadow: 0 12px 30px rgba(0,0,0,.08); }
  /* the steps hang off a dotted rail, so the form reads as a short journey */
  .plp-config-body { position: relative; padding: 1.25rem 1.4rem 1.35rem 3.3rem; }
  .plp-config-body::before {
    content: ""; position: absolute; left: 2.1rem; top: 2rem; bottom: 1.8rem; width: 2px;
    background: repeating-linear-gradient(var(--line) 0 4px, transparent 4px 9px);
  }
  .plp-config-step { position: relative; display: flex; align-items: center; gap: .55rem; margin: 0 0 .85rem -1.9rem; font-size: .95rem; font-weight: 800; color: var(--ink); }
  .plp-config-step:not(:first-child) { margin-top: 1.6rem; }
  .plp-config-step > span {
    position: relative; z-index: 1; display: grid; place-items: center;
    width: 1.4rem; height: 1.4rem; border-radius: 999px;
    background: var(--amber); color: #241a00; font-size: .78rem;
    box-shadow: 0 0 0 4px var(--page);
  }
  .plp-config-hint { margin: -.4rem 0 .85rem; font-size: .8rem; color: var(--muted); line-height: 1.5; }
  .plp-config-travel { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  /* min-width:0 stops the native date field's intrinsic width from blowing the column out */
  .plp-config-travel .plp-field { display: flex; flex-direction: column; gap: .35rem; min-width: 0; }
  .plp-config-travel .plp-field > span { font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  .plp-config-travel input::placeholder { color: var(--muted); }

  /* date picker: our own month view, so every phone gets the same thing in one tap */
  .plp-cal { position: relative; }
  .plp-cal-toggle {
    display: flex; align-items: center; justify-content: space-between; gap: .6rem;
    width: 100%; box-sizing: border-box; cursor: pointer; font-family: inherit; text-align: left;
    border: 1px solid var(--line); border-radius: .55rem; background: var(--surface);
    color: var(--ink); font-size: .88rem; padding: .7rem .8rem; min-height: 2.75rem;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .plp-cal-toggle:hover { border-color: var(--muted); }
  .plp-cal-toggle[aria-expanded="true"] { border-color: var(--amber); box-shadow: 0 0 0 3px rgba(253,203,8,.22); }
  .plp-cal-toggle svg { width: .95rem; height: .95rem; flex-shrink: 0; color: var(--ink-soft); transition: transform .18s ease; }
