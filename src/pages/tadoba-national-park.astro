    .plp-title-sale::before {
      content: ""; position: absolute; left: -.3rem; top: 50%; transform: translateY(-50%);
      border: .34rem solid transparent; border-right-color: #f43f5e;
    }

    /* inclusion strip: one item per row, quiet grey icons */
    .plp-inc-strip {
      width: 100vw; margin-left: calc(50% - 50vw);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 1.25rem, #000 calc(100% - 1.25rem), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 1.25rem, #000 calc(100% - 1.25rem), transparent);
    }
    .plp-inc-track {
      flex-wrap: nowrap; width: max-content; gap: 1.6rem;
      animation: plp-inc-marquee 16s linear infinite;
    }
    .plp-inc-track > span,
    .plp-inc-track > span[aria-hidden='true'] {
      display: inline-flex; flex-shrink: 0; white-space: nowrap;
      font-size: .92rem; font-weight: 500; gap: .7rem; color: var(--muted);
    }
    .plp-inc-strip .icon-png { width: 1.3rem; height: 1.3rem; background-color: var(--muted); }
    @keyframes plp-inc-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(calc(-50% - .8rem)); }
    }
    @media (prefers-reduced-motion: reduce) { .plp-inc-track { animation: none; } }

    /* itinerary tabs: white scroll pills with icons, orange active pill */
    .plp-itin-tabs {
      width: 100vw; margin-left: calc(50% - 50vw);
      flex-wrap: nowrap; gap: .55rem;
      background: var(--surface-2); border: 0; border-radius: 0; padding: .6rem 1rem;
      overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
      top: 0; box-shadow: 0 8px 16px -10px rgba(0,0,0,.22);
    }
    .plp-itin-tabs::-webkit-scrollbar { display: none; }
    .plp-itin-tabs button {
      flex-shrink: 0; display: inline-flex; align-items: center; gap: .4rem;
      background: var(--surface); border: 1px solid var(--line); border-radius: 999px;
      padding: .5rem .9rem; color: var(--ink-soft);
      box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }
    .plp-itin-tabs button.is-active {
      background: var(--amber); border-color: var(--amber); color: #241a00;
    }
    .plp-itin-tico {
      display: inline-block; width: 1rem; height: 1rem;
      background-color: var(--ink-soft);
    }
    .plp-itin-tabs button.is-active .plp-itin-tico { background-color: #241a00; }
    /* Stay sits 3rd on mobile */
    .plp-itin-tabs button[data-itin-tab="activities"] { order: 1; }
    .plp-itin-tabs button[data-itin-tab="transfers"] { order: 2; }

    /* itinerary hero: compact caption, no arrows */
    .plp-itin-hero { aspect-ratio: 16 / 9; }
    .plp-itin-arrow { display: none; }
    .plp-itin-caption { left: .9rem; bottom: .8rem; gap: .45rem; }
    .plp-itin-caption b { font-size: 2.5rem; margin-top: .35rem; }
    .plp-itin-caption-txt { padding-top: .1rem; }
    .plp-itin-caption-txt > span { font-size: .68rem; }
    .plp-itin-caption-txt strong { font-size: 1.2rem; }
    .plp-itin-dots { bottom: .95rem; gap: .4rem; }
    .plp-itin-navdot { width: 6px; height: 6px; }
    .plp-itin-count { font-size: .66rem; padding: .16rem .55rem; }
    .plp-itin-thumbs { right: .8rem; bottom: .8rem; }
    .plp-itin-thumb { width: 2rem; height: 2rem; margin-left: -.6rem; }
    .plp-itin-thumb--more { font-size: .62rem; }

    /* ─── Trip Summary — premium card layout ─── */
    .plp-summary { border: 0; border-radius: 0; padding: 0; }
    .plp-sum-title { font-size: 1.15rem; letter-spacing: -.01em; }

    .plp-sum-head {
      display: flex; flex-wrap: nowrap; align-items: center; justify-content: center;
      gap: .7rem; margin: .85rem 0 1.3rem;
      font-size: .76rem; font-weight: 600; color: var(--ink-soft);
      overflow-x: auto; scrollbar-width: none;
    }
    .plp-sum-head::-webkit-scrollbar { display: none; }
    .plp-sum-head i {
      display: block; flex-shrink: 0; width: 1px; height: 1rem; background: var(--line);
    }
    .plp-sum-head > span {
      position: static; flex-shrink: 0; flex-direction: row; align-items: center; gap: .4rem;
      background: none; border: 0; border-radius: 0; padding: 0; text-align: left;
    }
    .plp-sum-head > span::before { content: none; }
    .plp-sum-head > span .icon-png {
      position: static; margin: 0; width: 1rem; height: 1rem; background-color: var(--muted);
    }

    .plp-sum-day {
      border: 1px solid var(--line); border-radius: 1.1rem; padding: 0;
      margin-bottom: .85rem; overflow: hidden;
      box-shadow: 0 6px 22px rgba(25,20,10,.05);
