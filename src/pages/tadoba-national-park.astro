    }
    .plp-sum-meals .icon-png { width: 1rem; height: 1rem; background-color: var(--gold); }

    /* gallery: single full-bleed hero + photo-stack, like the reference */
    .plp-gallery {
      position: relative; grid-template-columns: 1fr; gap: 0; margin-top: 0;
      width: 100vw; margin-left: calc(50% - 50vw);
    }
    .plp-gallery-side { display: none; }
    .plp-gallery-main { aspect-ratio: auto; height: 600px; border-radius: 0; }
    /* the mobile frame is already portrait-ish, so fill it — no letterbox, no blur pass */
    .plp-hero-img { object-fit: cover; }
    .plp-hero-bg { display: none; }
    .plp-gallery-stack {
      display: flex; align-items: center; text-decoration: none;
      position: absolute; right: 1rem; bottom: 1rem; z-index: 2;
    }
    .plp-gallery-stack-thumb {
      width: 2.5rem; height: 2.5rem; border-radius: 999px; overflow: hidden;
