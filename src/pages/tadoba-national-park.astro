      -webkit-overflow-scrolling: touch; scrollbar-width: none;
    }
    .plp-related::-webkit-scrollbar { display: none; }
    .plp-rel-card { flex: 0 0 78vw; max-width: 19rem; scroll-snap-align: center; }
    .plp-review { flex-basis: 85%; }
    /* trust badges: continuous marquee of compact cards */
    .plp-trust {
      width: 100vw; margin-left: calc(50% - 50vw);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 1.5rem, #000 calc(100% - 1.5rem), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 1.5rem, #000 calc(100% - 1.5rem), transparent);
    }
    .plp-trust-track {
      display: flex; flex-wrap: nowrap; width: max-content; gap: .75rem;
      padding: .2rem 0 .4rem;
      animation: plp-trust-marquee 38s linear infinite;
    }
    .plp-trust-track > [aria-hidden='true'] { display: grid; }
    .plp-trust-item {
      flex: 0 0 15.5rem;
      display: grid; grid-template-columns: auto 1fr; align-items: center;
      column-gap: .75rem; row-gap: .15rem;
