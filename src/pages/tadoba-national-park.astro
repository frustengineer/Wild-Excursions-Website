    .plp-chips[data-config-chips="safari"] { display: grid; grid-template-columns: repeat(3, 1fr); }
    .plp-chips[data-config-chips="safari"] .plp-chip { padding: .55rem .35rem; text-align: center; font-size: .8rem; }
    .plp-config-travel { grid-template-columns: 1fr; }
    .plp-inex, .plp-trust, .plp-linkfarm-cols { grid-template-columns: 1fr; }

    /* related products: swipeable card slider */
    .plp-related {
      display: flex; gap: .8rem;
      width: 100vw; margin-left: calc(50% - 50vw);
