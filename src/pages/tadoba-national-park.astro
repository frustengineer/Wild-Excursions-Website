  .plp-modal-card { position: relative; width: min(460px, 100%); max-height: 92vh; overflow-y: auto; background: var(--surface); color: var(--ink); border-radius: 1.4rem; padding: 2rem 1.75rem 1.5rem; box-shadow: 0 30px 80px rgba(0,0,0,.4); animation: plp-modal-in .25s cubic-bezier(.2,.8,.2,1) both; }
