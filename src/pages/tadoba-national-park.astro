    .plp-sum-daymeta .icon-png { width: .78rem; height: .78rem; }

    .plp-sum-row {
      position: relative; align-items: center; gap: 0;
      padding: .8rem 1rem .8rem 3.5rem;
      border-bottom: 1px solid #f2efe9; color: var(--ink);
