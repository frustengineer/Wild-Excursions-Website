  .plp-cal-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .plp-cal-value.is-empty { color: var(--muted); }
  .plp-cal-panel {
    margin-top: .5rem; border: 1px solid var(--line); border-radius: .7rem;
    background: var(--surface); padding: .9rem .8rem .85rem;
