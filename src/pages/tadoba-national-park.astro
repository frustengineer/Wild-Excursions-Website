  .plp-trav-toggle svg { width: .95rem; height: .95rem; flex-shrink: 0; color: var(--ink-soft); transition: transform .18s ease; }
  .plp-trav-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  .plp-trav-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .plp-trav-value.is-empty { color: var(--muted); }
  .plp-trav-panel {
    margin-top: .5rem; border: 1px solid var(--line); border-radius: .7rem;
    background: var(--surface); padding: .2rem .9rem .9rem;
