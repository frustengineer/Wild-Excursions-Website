---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PhoneCountrySelect from '../components/PhoneCountrySelect.astro';
import { tours } from '../data/tours';
import { parkFaqsByJungle } from '../data/parkFaqs';
import { tadobaGalleryCounts, stayGroups, stayGroupImageCount, stayTiers, sylvonCover } from '../data/tadobaGallery';
import { currencies, commonCurrencyCodes, flagUrl } from '../data/currencies';
import { testimonialsByJungle } from '../data/testimonials';
import { buildFixedTourItinerary } from '../utils/fixedTourItinerary';
import heroMain from '../../tour_images/bengal-tiger-forest-tour-01.webp';
import hero1 from '../../meta_ads/hero1.webp';
import hero2 from '../../meta_ads/hero2.webp';
import hero3 from '../../meta_ads/hero3.webp';
import hero4 from '../../meta_ads/hero4.png';
import galRoute from '../../home_images/forest-safari-road-01.webp';
import galStay from '../../home_images/wild-excursions-jungle-resort.webp';
import galActivity from '../../home_images/wild-excursions-jeep-safari.webp';
import galWildlife from '../../home_images/bengal-tiger-wildlife-09.webp';
import dur4 from '../../home_images/spotted-deer-forest-01.webp';
import itin1 from '../../home_images/bengal-tiger-wildlife-05.webp';
import itin2 from '../../home_images/indian-wild-dog-dhole-01.webp';
import itin3 from '../../home_images/sloth-bear-wildlife-01.webp';
import rel1 from '../../home_images/bengal-tiger-wildlife-07.webp';
import rel2 from '../../home_images/indian-leopard-wildlife-02.webp';
import rel3 from '../../home_images/bengal-tiger-wildlife-16.webp';
import tripAdvisorLogo from '../../trip_advisor.webp';
import weLogo from '../../we.logo.webp';
import stayResort from '../../meta_ads/resort/TJC-25.webp';
import actBonfire from '../../meta_ads/activity/Bonfire.webp';
import actJeepDrive from '../../meta_ads/jeep_safari.jpg';
import actBirding from '../../meta_ads/birdwatch.jpg';
import actVillageTour from '../../meta_ads/village vist.jpg';
import actTrail from '../../meta_ads/nature-trail.jpg';
import actGames from '../../meta_ads/indoor & outdoor games.webp';
import spotTiger from '../../tour_images/bengal-tiger-safari-jeep-tour.webp';
import spotLeopard from '../../home_images/indian-leopard-wildlife-05.webp';
import spotSloth from '../../home_images/sloth-bear-and-bengal-tiger-01.webp';
import spotGaur from '../../meta_ads/indian_gaur.webp';
import dholePack from '../../home_images/indian-wild-dog-dhole-02.webp';
import expSaoji from '../../meta_ads/Soaji_food.jpg';
import expLakeSunset from '../../meta_ads/tadoba_lake_sunset.webp';
import expTribalDance from '../../meta_ads/tribal_dance.webp';
import expTadobaLake from '../../meta_ads/Bird-Tadoba-Watching-point.jpg';

const stayOptions = [
  { cat: 'Luxury', name: 'Luxury', tier: 'jungle-camp', image: stayResort, blurb: 'Forest-facing rooms and split-level suites with a plunge pool, water gardens, a games lounge and multi-cuisine dining — set right against the Tadoba tree line.' },
  { cat: 'Semi-Luxury', name: 'Semi-Luxury', tier: 'sylvon-woods', image: sylvonCover, blurb: 'Comfortable AC cottages set in native woodland near the safari gate, with an on-site restaurant, bonfire deck and quick access for early-morning drives.' },
];

const day1Activities = [
  { name: 'Jeep Safari', image: actJeepDrive },
  { name: 'Bird Watching', image: actBirding },
  { name: 'Village Visit', image: actVillageTour },
  { name: 'Nature Walk', image: actTrail },
  { name: 'Bonfire Evening', image: actBonfire },
  { name: 'Indoor & Outdoor Games', image: actGames },
];

const day2Species = [
  { name: 'Royal Bengal Tiger', image: spotTiger },
  { name: 'Indian Leopard', image: spotLeopard },
  { name: 'Sloth Bear', image: spotSloth },
  { name: 'Indian Wild Dog (Dhole)', image: dholePack },
  { name: 'Indian Gaur', image: spotGaur },
];

const day3Experiences = [
  { name: 'Saoji Food', image: expSaoji },
  { name: 'Tribal Dance', image: expTribalDance },
  { name: 'Tadoba Lake', image: expTadobaLake },
  { name: 'Sunset by the Lake', image: expLakeSunset },
];

const tadobaTours = tours.filter((t) => t.jungle === 'tadoba').sort((a, b) => a.price - b.price);
const cheapest = tadobaTours[0];
/** Landing-page rates per adult, by trip length; anything not listed falls back to tours.ts. */
const lpPriceByDays: Record<number, number> = { 3: 23690 };

const durations = tadobaTours.map((t) => {
  const days = parseInt(t.duration, 10) || 2;
  const price = lpPriceByDays[days] ?? t.price;
  return {
    days,
    nights: days - 1,
    safaris: (days - 1) * 2,
    price,
    originalPrice: t.originalPrice,
    savings: t.originalPrice - price,
    rating: t.rating,
    reviews: t.reviews,
    items: buildFixedTourItinerary(cheapest, days),
  };
});
const selectedIndex = 1;
const selected = durations[selectedIndex];
const maxSave = Math.max(...durations.map((d) => d.savings));

/** Hero carousel — the strongest shots: a tiger sighting, the room, the camp, the drive.
 *  Slides are letterbox-free: the photo is `contain`-fitted whole, over a blurred copy of itself. */
const heroSlides = [
  { src: hero1, alt: 'A tigress and her cubs crossing the forest road in front of a line of safari jeeps in Tadoba' },
  { src: hero4, alt: 'Duplex forest-facing room with twin beds, a loft and floor-to-ceiling windows opening onto the trees' },
  { src: hero3, alt: 'Stone-clad guest cottage framed by tall grasses at the camp near Tadoba' },
  { src: hero2, alt: 'Open safari jeep on a teak-lined forest road in Tadoba' },
];

const itineraryHero = [itin1, itin2, itin3];
const heroThumbs = [galRoute, galStay, galWildlife];
const heroExtra = Math.max(0, tadobaGalleryCounts.all - heroThumbs.length);
const galleryHref = '/tadoba-national-park/gallery/';

const inclusionStrip = [
  { label: 'Transfers Included', icon: 'transfer' },
  { label: 'Stay Included', icon: 'stay' },
  { label: 'Meals Included', icon: 'food' },
  { label: 'Jeep Safari Included', icon: 'jeep' },
];

const exclusions = [
  'Lens / camera charges (if any).',
  'Tips to guides and drivers.',
  'Extra orders of meals, snacks, hard drinks, or cold drinks.',
  'Any train or airfare tickets to and from your home city.',
  'Difference in cost arising due to mishaps, political unrest, natural calamities, or sudden changes in forest fees, permits, etc.',
  'Anything not mentioned in the list of inclusions.',
];

const highlights = [
  'Explore Tadoba’s teak and bamboo forests, open meadows and the lakes that pull tigers into the open.',
  'Enjoy an open-jeep safari while searching for tigers, leopards, wild dogs, gaur, sloth bear and deer.',
  'Experience local village life and the slow rhythm of the buffer-zone countryside.',
  'Unwind between drives with a bonfire evening and indoor and outdoor games with your group.',
];

const knowBeforeYouGo = [
  'Connectivity: mobile network is patchy inside most reserves. Let people know you’ll be off-grid for the length of each drive.',
  'Gate timings: entry and exit times are set and enforced by the forest department, not by us. Arrive at the meeting point on time so the whole group isn’t held up.',
  'On the road: safari tracks are unpaved and can be bumpy for a few hours at a stretch. It’s a real jeep safari, not a sightseeing coach.',
  'Rates: quoted pricing can change with the season or a change in group size — always confirmed with you before you pay anything.',
  'Wildlife sightings are never guaranteed — our naturalists and drivers use their experience to give you the best possible chance.',
  'Cancellations & rescheduling: refunds are based on how far ahead of departure you cancel, from 100% (120+ days out) down to no refund inside 30 days. Full terms are on our Terms & Conditions page.',];
const thingsToCarry = [
  'Original ID proof — Aadhaar, PAN, Driving License, or Passport',
  'Prescription medicines, a basic first-aid kit, insect repellent, and sunscreen',
  'Light, comfortable clothing in neutral colors — khaki, beige, olive green',
  'A light jacket or sweater for early morning and evening safaris',
  'Sports shoes or other comfortable, sturdy footwear',
  'Sunglasses and a scarf or balaclava',
  'Camera, lenses, memory cards, charger, and spare batteries',
  'A bean bag or monopod for camera stability',
  'Binoculars for wildlife viewing',
  'A torch or flashlight for use after dark',];
const cancellationPolicy = [
  'All cancellation requests must be sent via email to info@wildexcursions.in.',
  'Cancellation fees apply based on the proximity to the tour start date.',
  'Participants are responsible for any non-refundable expenses incurred, such as visa fees or flight tickets.',
  '120 days or more before departure: 100% of the total amount will be refunded.',
  '60 days or more before departure: 75% of the total amount will be refunded.',
  '45–60 days before departure: 50% of the total amount will be refunded.',
  '30–45 days before departure: 25% of the total amount will be refunded.',
  'Within 30 days of departure or no-show: 0% refund.',
  'Refunds will be based on the total tour cost and processed within 7–8 working days.',
  'Any bank or transaction fees incurred during the refund process will be deducted from the refund amount.',
  'All applicable refunds will be made to the respective bank details provided by the participants.',
  'Full Refund: you will receive a full refund of all trip payments made to Wild Excursions when applicable under the policy above.',
  'Rebooking: you may rebook your trip for a future departure date with no change fees.',];

const googleReviewLinks = [
  'https://share.google/NmLNv2NZQNJFH3qnh',
  'https://share.google/gEUgHH1lg1aIlWtFa',
  'https://share.google/sFAzbhcdLLkbOzu5A',
  'https://share.google/GZDojMtwuZgIq1oES',
  'https://share.google/7RUOxuFOeL8lEQJaJ',
  'https://share.google/xpVc6YtCwoARKxkbR',
  'https://share.google/FW8fjb2cZJYUOvoOj',
];
const reviews = [...(testimonialsByJungle.tadoba ?? [])]
  .sort((a, b) => Number(/tadoba/i.test(a.quote)) - Number(/tadoba/i.test(b.quote)))
  .slice(0, googleReviewLinks.length)
  .map((t, i) => ({
    name: t.name,
    city: t.city.replace(/\s*·.*$/, '') || 'Google review',
    stars: Math.round(t.rating ?? 5),
    quote: t.quote.length > 300 ? `${t.quote.slice(0, 300).trim()}…` : t.quote,
    href: googleReviewLinks[i],
  }));
const tadobaFaqs = parkFaqsByJungle.tadoba ?? [];

const relatedProducts = [
  { name: 'Pench Tiger & Wildlife Safari', duration: '2 days & 1 night', rating: 4.8, reviews: 33, price: 10690, original: 14300, image: rel1, href: '/tours/pench/pench-tiger-safari/' },
  { name: 'Panna Tiger Safari', duration: '3 days & 2 nights', rating: 4.7, reviews: 24, price: 21900, original: 29600, image: rel2, href: '/tours/panna/panna-tiger-safari/' },
  { name: 'Bandhavgarh Tiger Safari', duration: '3 days & 2 nights', rating: 4.9, reviews: 51, price: 22690, original: 29900, image: rel3, href: '/tours/bandhavgarh/bandhavgarh-tiger-safari/' },
];

/** Traveller picker rows; the hidden field still posts a single head count. */
const travellerRows = [
  { key: 'adults', title: 'Adults', sub: 'Ages 12 and above' },
  { key: 'children', title: 'Children', sub: 'Ages 6–12' },
  { key: 'infants', title: 'Children', sub: 'Under 6' },
];

const trustBadges = [
  { title: '30,000+', sub: 'Travellers have explored the wild with us across India.', d: 'M12 21s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z' },
  { title: '4.9 / 5', sub: 'Rated across TripAdvisor and Google reviews.', d: 'M12 3l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6z' },
  { title: 'Curated with love', sub: 'Handpicked stays and naturalist-led safaris, planned end to end.', d: 'M12 21s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z' },
  { title: '24/7 on-trip assistance', sub: 'We are reachable before, during and after your trip.', d: 'M4 12a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-1v-6h3M4 12v4a2 2 0 0 0 2 2h1v-6H4' },
];

const linkFarm = [
  { title: 'Central India Safaris', links: [
    { label: 'Tadoba Tour Packages', href: '/tours/tadoba/' },
    { label: 'Pench Tour Packages', href: '/tours/pench/' },
    { label: 'Kanha Tour Packages', href: '/tours/kanha/' },
    { label: 'Bandhavgarh Tour Packages', href: '/tours/bandhavgarh/' },
    { label: 'Satpura Tour Packages', href: '/tours/satpura/' },
    { label: 'Panna Tour Packages', href: '/tours/panna/' },
  ]},
  { title: 'More Wildlife Destinations', links: [
    { label: 'Ranthambore Tour Packages', href: '/tours/ranthambore/' },
    { label: 'Kaziranga Tour Packages', href: '/tours/kaziranga/' },
    { label: 'Jim Corbett Tour Packages', href: '/tours/jim-corbett/' },
    { label: 'Tipeshwar Tour Packages', href: '/tours/tipeshwar/' },
    { label: 'Nagzira Tour Packages', href: '/tours/nagzira/' },
    { label: 'All Tour Packages', href: '/tours/' },
  ]},
  { title: 'Plan Your Tadoba Trip', links: [
    { label: 'Tadoba Safari Guide', href: '/blogs/tadoba-safari-booking-guide' },
    { label: 'Tadoba Safari Zones', href: '/blogs/tadoba-safari-zones-explained' },
    { label: 'Tadoba vs Pench vs Kanha', href: '/blogs/tadoba-vs-pench-vs-kanha' },
    { label: 'Customize a Trip', href: '/customize-trip/' },
    { label: 'Contact Us', href: '/contact/' },
  ]},
];

const saleEnd = '2026-09-15T23:59:59';
const pageUrl = new URL('/tadoba-national-park', Astro.site).toString();
const productSchema = {
  '@context': 'https://schema.org',
  '@type': ['Product', 'TouristTrip'],
  name: 'Tadoba National Park Safari Package',
  description: cheapest.description,
  image: new URL(heroMain.src, Astro.site).toString(),
  brand: { '@type': 'TravelAgency', name: 'Wild Excursions' },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: cheapest.rating, reviewCount: cheapest.reviews, bestRating: 5 },
  offers: { '@type': 'Offer', price: cheapest.price, priceCurrency: 'INR', availability: 'https://schema.org/InStock', url: pageUrl },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tadobaFaqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
};

const inr = (n: number) => n.toLocaleString('en-IN');
---

<Layout
  title="Tadoba National Park Safari Package — Permits, Stay & Jeep Safaris | Wild Excursions"
  description={`Tadoba tiger safari packages from ₹${inr(cheapest.price)} — forest permits, semi-luxury stay, naturalist-led jeep safaris and Nagpur transfers, planned end to end.`}
  rawTitle
  hideTripPlannerPopup
  hideWhatsAppOnMobile
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  {tadobaFaqs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />

  <div class="plp" data-sale-end={saleEnd}>
    <!-- Currency picker trigger (mobile) -->
    <button type="button" class="plp-cur-pill" data-cur-open aria-label="Change currency">
      <img data-cur-flag src={flagUrl('INR')} alt="" width="20" height="15" decoding="async" /><span data-cur-code>INR</span><span data-cur-sym>₹</span>
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 8 5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <!-- Top sale bar -->
    <div class="plp-salebar">
      <div class="plp-salebar-inner">
        <p class="plp-salebar-copy">
          <span><strong>Winter Sale</strong> &middot; Save Upto <strong>₹{inr(maxSave)}</strong> on your Tadoba trip</span>
          <span><strong>98.7%</strong> Tiger Sighting Ratio</span>
          <span><strong>4.9 Rating</strong> Across All Platforms</span>
        </p>
        <div class="plp-salebar-timer" data-countdown>
          <span data-cd-days>0</span><b>days</b><i>:</i>
          <span data-cd-hours>0</span><b>hrs</b><i>:</i>
          <span data-cd-mins>0</span><b>min</b>
        </div>
      </div>
    </div>

    <div class="plp-shell">
      <!-- Gallery -->
      <div class="plp-gallery">
        <div class="plp-gallery-main" data-hero-carousel>
          {heroSlides.map((s, i) => (
            <div class:list={['plp-hero-slide', { 'is-active': i === 0 }]} data-hero-slide>
              <Image
                src={s.src}
                alt=""
                aria-hidden="true"
                width={480}
                format="webp"
                quality={40}
                loading={i === 0 ? 'eager' : 'lazy'}
                class="plp-hero-bg"
              />
              <Image
                src={s.src}
                alt={s.alt}
                widths={[640, 1200]}
                sizes="(max-width: 900px) 100vw, 720px"
                format="webp"
                quality={82}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                class="plp-hero-img"
              />
            </div>
          ))}
          <div class="plp-hero-dashes" data-hero-dashes role="tablist" aria-label="Hero photos">
            {heroSlides.map((s, i) => (
              <button type="button" class:list={['plp-hero-dash', { 'is-active': i === 0 }]} data-hero-dot aria-label={`Show photo ${i + 1}: ${s.alt}`}></button>
            ))}
          </div>
        </div>
        <div class="plp-gallery-side">
          <figure class="plp-gallery-tile"><Image src={galRoute} alt="Forest safari track in Tadoba" width={520} height={400} format="webp" quality={72} loading="lazy" class="h-full w-full object-cover" /><figcaption>Destination</figcaption></figure>
          <figure class="plp-gallery-tile"><Image src={galStay} alt="Semi-luxury jungle resort near Tadoba" width={520} height={400} format="webp" quality={72} loading="lazy" class="h-full w-full object-cover" /><figcaption>Stay</figcaption></figure>
          <figure class="plp-gallery-tile"><Image src={galActivity} alt="Jeep safari in Tadoba" width={520} height={400} format="webp" quality={72} loading="lazy" class="h-full w-full object-cover" /><figcaption>Activity &amp; Sightseeing</figcaption></figure>
          <figure class="plp-gallery-tile plp-gallery-tile--more">
            <Image src={galWildlife} alt="Indian peafowl in Tadoba" width={520} height={400} format="webp" quality={72} loading="lazy" class="h-full w-full object-cover" />
            <a href={galleryHref} class="plp-view-all"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="15" cy="9" r="1.6"/><path d="M3.5 16.5 8 12a2 2 0 0 1 2.7-.1l2 1.8a2 2 0 0 0 2.8-.1L20.5 11"/></svg>View All Images</a>
          </figure>
        </div>
        <a href={galleryHref} class="plp-gallery-stack" aria-label="View all photos">
          {heroThumbs.map((img) => (
            <span class="plp-gallery-stack-thumb"><Image src={img} alt="" width={88} height={88} format="webp" quality={58} loading="lazy" class="h-full w-full object-cover" /></span>
          ))}
          <span class="plp-gallery-stack-thumb plp-gallery-stack-more">+{heroExtra}</span>
        </a>
      </div>
    </div>

    <div class="plp-shell plp-layout">
      <!-- LEFT -->
      <div class="plp-body">
        <h1>Tadoba National Park Safari Package</h1>
        <div class="plp-titlerow">
          <span class="plp-pill" data-duration-pill>{selected.days}D/{selected.nights}N</span>
          <span class="plp-titlerow-right">
            <span class="plp-title-rating">
              <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.3 5.9.9-4.25 4.1 1 5.9L10 14.9l-5.25 2.8 1-5.9L1.5 7.7l5.9-.9L10 1.5z"/></svg>
              4.9 <i>(87)</i>
            </span>
            <span class="plp-title-sale">Winter Sale!</span>
          </span>
        </div>

        <hr class="plp-rule" />

        <div class="plp-inc-strip">
          <div class="plp-inc-track">
            {[0, 1].map((copy) => inclusionStrip.map((item) => (
              <span aria-hidden={copy === 1 ? 'true' : undefined}>
                <span class:list={['icon-png', `icon-png--${item.icon}`]} aria-hidden="true"></span>
                <span>{item.label}</span>
              </span>
            )))}
          </div>
        </div>

        <hr class="plp-rule" />

        <!-- Trip Highlights -->
        <section class="plp-block">
          <h2 class="plp-block-title">Trip Highlights</h2>
          <ul class="plp-highlights">
            {highlights.map((h) => <li>{h}</li>)}
          </ul>
        </section>

        <!-- Itinerary -->
        <section class="plp-block" id="itinerary">
          <div class="plp-itin-tabs" data-itin-tabs>
            <button type="button" class="is-active" data-itin-tab="itinerary">Itinerary</button>
            <button type="button" data-itin-tab="summary">Summarised View</button>
            <button type="button" data-itin-tab="activities"><span class="icon-png icon-png--jeep plp-itin-tico" aria-hidden="true"></span>Activities</button>
            <button type="button" data-itin-tab="stay"><span class="icon-png icon-png--stay plp-itin-tico" aria-hidden="true"></span>Stay</button>
            <button type="button" data-itin-tab="transfers"><span class="icon-png icon-png--transfer plp-itin-tico" aria-hidden="true"></span>Transfers</button>
          </div>

          <div class="plp-itin-hero" data-itin-hero>
            {itineraryHero.map((img, i) => (
              <div class:list={['plp-itin-slide', { 'is-active': i === 0 }]} data-itin-slide>
                <Image src={img} alt={`Tadoba wildlife ${i + 1}`} width={900} height={520} format="webp" quality={78} loading="lazy" class="h-full w-full object-cover" />
              </div>
            ))}
            <button type="button" class="plp-itin-arrow plp-itin-arrow--prev" data-itin-prev aria-label="Previous photo"><svg viewBox="0 0 24 24"><path d="m14.5 6.5-5 5.5 5 5.5"/></svg></button>
            <button type="button" class="plp-itin-arrow plp-itin-arrow--next" data-itin-next aria-label="Next photo"><svg viewBox="0 0 24 24"><path d="m9.5 6.5 5 5.5-5 5.5"/></svg></button>
            <div class="plp-itin-caption">
              <b data-daysin-num>{selected.days}</b>
              <span class="plp-itin-caption-txt"><span>Days in</span><strong>Tadoba</strong></span>
            </div>
            <a href={galleryHref} class="plp-itin-thumbs" aria-label="View all photos">
              {heroThumbs.map((img) => (
                <span class="plp-itin-thumb"><Image src={img} alt="" width={96} height={96} format="webp" quality={60} loading="lazy" class="h-full w-full object-cover" /></span>
              ))}
              <span class="plp-itin-thumb plp-itin-thumb--more">+{heroExtra}</span>
            </a>
            <div class="plp-itin-dots">
              <button type="button" class="plp-itin-navdot" data-itin-prev aria-label="Previous photo"></button>
