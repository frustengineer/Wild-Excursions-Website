    }
    .plp-sum-daymeta { gap: .4rem; }
    .plp-sum-daymeta > span {
      background: var(--surface); border: 1px solid var(--line); border-radius: 999px;
      padding: .12rem .45rem; gap: .22rem; font-size: .68rem;
