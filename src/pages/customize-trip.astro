  .customize-date-trigger[aria-expanded="true"] .customize-guests-chevron { transform:rotate(180deg); }
  .customize-date-panel { position:absolute; z-index:20; top:calc(100% + .55rem); left:0; width:19rem; max-width:calc(100vw - 2.5rem); border:1px solid #e4e0db; border-radius:1.25rem; background:#fff; padding:1.1rem; box-shadow:0 22px 50px rgba(0,0,0,.18); }
  .customize-date-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:.75rem; }
  .customize-date-header span { font-size:.9rem; font-weight:800; color:#242321; }
  .customize-date-nav { display:grid; place-items:center; width:1.9rem; height:1.9rem; border:0; border-radius:50%; background:#f1f1f1; color:#292929; }
  .customize-date-nav:hover { background:#fdcb08; color:#111; }
  .customize-date-nav svg { width:.9rem; height:.9rem; }
  .customize-date-weekdays { display:grid; grid-template-columns:repeat(7,1fr); text-align:center; font-size:.68rem; font-weight:700; color:#a19c93; margin-bottom:.35rem; }
  .customize-date-grid { display:grid; grid-template-columns:repeat(7,1fr); row-gap:.2rem; }
  .customize-date-grid :global(button) { display:grid; place-items:center; aspect-ratio:1; width:100%; border:0; border-radius:999px; background:transparent; font-size:.82rem; color:#242321; appearance:none; }
  .customize-date-grid :global(button:hover:not(:disabled)) { background:#f1f1f1; }
  .customize-date-grid :global(button.is-selected) { background:#111111; color:#ffffff; font-weight:700; }
  .customize-date-grid :global(button.is-range-start),
  .customize-date-grid :global(button.is-range-end) { background:#111; color:#fff; font-weight:800; }
  .customize-date-grid :global(button.is-in-range) { border-radius:.35rem; background:rgba(253,203,8,.22); color:#111; }
  .customize-date-grid :global(button:disabled) { color:#d5d1cb; cursor:not-allowed; }
  .customize-date-grid :global(span) { visibility:hidden; }
  .customize-date-help { margin:.75rem 0 0; text-align:center; color:#8a857e; font-size:.72rem; font-weight:650; }
  .customize-date-flex {
    display: flex;
