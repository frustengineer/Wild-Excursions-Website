---
import Layout from '../layouts/Layout.astro';

const destinations = [
  { value: 'Tadoba', label: 'Tadoba–Andhari Tiger Reserve' },
  { value: 'Pench', label: 'Pench Tiger Reserve' },
  { value: 'Kanha', label: 'Kanha Tiger Reserve' },
  { value: 'Bandhavgarh', label: 'Bandhavgarh Tiger Reserve' },
  { value: 'Panna', label: 'Panna Tiger Reserve' },
  { value: 'Satpura', label: 'Satpura Tiger Reserve' },
  { value: 'Umred Karhandla', label: 'Umred–Karhandla Wildlife Sanctuary' },
  { value: 'Tipeshwar', label: 'Tipeshwar Wildlife Sanctuary' },
  { value: 'Sanjay Dubri', label: 'Sanjay–Dubri Tiger Reserve' },
  { value: 'Nagzira', label: 'Nawegaon–Nagzira Tiger Reserve' },
  { value: 'Jim Corbett', label: 'Jim Corbett National Park' },
  { value: 'Ranthambore', label: 'Ranthambore Tiger Reserve' },
  { value: 'Gir', label: 'Gir National Park' },
  { value: 'Dudhwa', label: 'Dudhwa Tiger Reserve' },
  { value: 'Pilibhit', label: 'Pilibhit Tiger Reserve' },
  { value: 'Bandipur', label: 'Bandipur Tiger Reserve' },
  { value: 'Bor', label: 'Bor Wildlife Sanctuary' },
  { value: 'Jawai Bera', label: 'Jawai–Bera Leopard Safari' },
  { value: 'Jhalana', label: 'Jhalana Leopard Safari Park' },
  { value: 'Kaziranga', label: 'Kaziranga National Park' },
  { value: 'Kishanpur', label: 'Kishanpur Wildlife Sanctuary' },
  { value: 'Manas', label: 'Manas National Park' },
  { value: 'Rajaji', label: 'Rajaji Tiger Reserve' },
  { value: 'Sunderban', label: 'Sundarban Tiger Reserve' },
];

const trustBadges = [
  {
    title: '4.9/5 Google Reviews',
    sub: 'Rated by travelers who have been on safari with us',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L10 1.5Z"/></svg>',
  },
  {
    title: '24/7 Support',
    sub: "We're reachable before, during, and after your trip",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12a8 8 0 0 1 16 0" stroke-linecap="round"/><path d="M4 12v3a2 2 0 0 0 2 2h1v-6H5a1 1 0 0 0-1 1Z"/><path d="M20 12v3a2 2 0 0 1-2 2h-1v-6h1a1 1 0 0 1 1 1Z"/></svg>',
  },
  {
    title: 'Experience First',
    sub: "It's about the journey, not just the tour",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M15 9l-2.5 6L8 17l2.5-6L15 9Z" stroke-linejoin="round"/></svg>',
  },
  {
    title: 'Flexible Payments',
    sub: 'EMI and card options available',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18" stroke-linecap="round"/></svg>',
  },
];
---

<Layout
  title="Customize Your Trip"
  description="Tell us your dates, destinations, and priorities — we'll build a safari itinerary around them."
  hideWhatsAppOnMobile
>
  <div class="customize-layout lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
    <section class="customize-hero px-4 pb-16 pt-10 text-brand-ivory sm:px-6 sm:pb-20 sm:pt-14 lg:flex lg:flex-col lg:justify-start lg:pl-10 lg:pr-6 lg:py-16">
      <div class="customize-hero-inner mx-auto max-w-2xl lg:mx-auto lg:max-w-sm">
        <p class="customize-wordmark">Wild Excursions</p>
        <h1 class="customize-hero-heading">
          Your wild escape<br /><span>is calling.</span>
        </h1>
        <p class="customize-hero-sub">Where every safari tells a story you'll never forget.</p>

        <div class="customize-trust-list">
          {trustBadges.map((badge) => (
            <div class="customize-trust-card">
              <span class="customize-trust-icon" set:html={badge.icon} />
              <span class="customize-trust-text">
                <span class="customize-trust-title">{badge.title}</span>
                <span class="customize-trust-sub">{badge.sub}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="customize-section px-4 pb-28 sm:px-6 sm:pb-16 lg:flex lg:items-start lg:px-12 lg:py-16">
    <div class="mx-auto max-w-2xl lg:mx-0 lg:w-full">
      <div class="customize-card">
        <h2 class="customize-heading">Customize my trip</h2>
        <p class="customize-subheading">Fill in your details and our safari expert will get in touch with you shortly ⚡</p>

        <form class="customize-form" id="customize-form" method="post">
          <div class="customize-eyebrow-row">
            <span class="customize-eyebrow">Trip Details</span>
            <span class="customize-eyebrow-line" aria-hidden="true"></span>
          </div>

          <div class="customize-grid">
            <label class="customize-field">
              <span class="customize-label">Full Name<span class="customize-required">*</span></span>
              <input type="text" name="fullName" placeholder="Chota Matka" required class="customize-input" />
            </label>

            <label class="customize-field">
              <span class="customize-label">Email<span class="customize-required">*</span></span>
              <input type="email" name="email" placeholder="chotamatka@tadoba.com" required class="customize-input" />
            </label>

            <label class="customize-field">
              <span class="customize-label">Nationality<span class="customize-required">*</span></span>
              <select name="nationality" class="customize-input wild-select" required>
                <option value="Indian" selected>Indian</option>
                <option value="American">American</option>
                <option value="British">British</option>
                <option value="Canadian">Canadian</option>
                <option value="Australian">Australian</option>
                <option value="New Zealander">New Zealander</option>
                <option value="Emirati">Emirati</option>
                <option value="Saudi Arabian">Saudi Arabian</option>
                <option value="Qatari">Qatari</option>
                <option value="Kuwaiti">Kuwaiti</option>
                <option value="Singaporean">Singaporean</option>
                <option value="Malaysian">Malaysian</option>
                <option value="German">German</option>
                <option value="French">French</option>
                <option value="Spanish">Spanish</option>
                <option value="Italian">Italian</option>
                <option value="Dutch">Dutch</option>
                <option value="Swiss">Swiss</option>
                <option value="Japanese">Japanese</option>
                <option value="Chinese">Chinese</option>
                <option value="South Korean">South Korean</option>
                <option value="Russian">Russian</option>
                <option value="South African">South African</option>
                <option value="Bangladeshi">Bangladeshi</option>
                <option value="Sri Lankan">Sri Lankan</option>
                <option value="Nepali">Nepali</option>
                <option value="Other">Other</option>
              </select>
            </label>

            <label class="customize-field">
              <span class="customize-label">Phone Number<span class="customize-required">*</span></span>
              <div class="customize-input customize-phone">
                <select name="phoneCountry" class="customize-phone-code" aria-label="Country code">
                  <option value="+91" selected>🇮🇳 +91</option>
                  <option value="+1">🇺🇸 +1</option>
                  <option value="+1">🇨🇦 +1</option>
                  <option value="+44">🇬🇧 +44</option>
                  <option value="+61">🇦🇺 +61</option>
                  <option value="+64">🇳🇿 +64</option>
                  <option value="+971">🇦🇪 +971</option>
                  <option value="+966">🇸🇦 +966</option>
                  <option value="+974">🇶🇦 +974</option>
                  <option value="+965">🇰🇼 +965</option>
                  <option value="+65">🇸🇬 +65</option>
                  <option value="+60">🇲🇾 +60</option>
                  <option value="+49">🇩🇪 +49</option>
                  <option value="+33">🇫🇷 +33</option>
                  <option value="+34">🇪🇸 +34</option>
                  <option value="+39">🇮🇹 +39</option>
                  <option value="+31">🇳🇱 +31</option>
                  <option value="+41">🇨🇭 +41</option>
                  <option value="+81">🇯🇵 +81</option>
                  <option value="+86">🇨🇳 +86</option>
                  <option value="+82">🇰🇷 +82</option>
                  <option value="+7">🇷🇺 +7</option>
                  <option value="+27">🇿🇦 +27</option>
                  <option value="+880">🇧🇩 +880</option>
                  <option value="+94">🇱🇰 +94</option>
                  <option value="+977">🇳🇵 +977</option>
                </select>
                <input type="tel" name="phone" placeholder="XXXXX XXXXX" required class="customize-phone-input" />
              </div>
            </label>

            <label class="customize-field">
              <span class="customize-label">Destination<span class="customize-required">*</span></span>
              <select name="destination" class="customize-input wild-select" required>
                <option value="" selected disabled>Select a destination</option>
                {destinations.map((destination) => <option value={destination.value}>{destination.label}</option>)}
              </select>
            </label>

            <div class="customize-field customize-date" data-date-selector>
              <span class="customize-label">Travel Dates<span class="customize-required">*</span></span>
              <button type="button" class="customize-input customize-date-trigger" data-date-trigger aria-expanded="false">
                <span data-date-summary>Add dates</span>
                <svg class="customize-guests-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m5 7 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div class="customize-date-panel" data-date-panel hidden>
                <div class="customize-date-header">
                  <button type="button" class="customize-date-nav" data-date-prev aria-label="Previous month">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 5-5 5 5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                  <span data-date-month-label></span>
                  <button type="button" class="customize-date-nav" data-date-next aria-label="Next month">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="m8 5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                </div>
                <div class="customize-date-weekdays"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div>
                <div class="customize-date-grid" data-date-grid></div>
                <p class="customize-date-help" data-date-help>Select your start date</p>
                <div class="customize-date-flex" data-date-flex role="group" aria-label="Date flexibility">
                  <button type="button" class="customize-date-chip is-active" data-flex-chip data-flex-value="0">Exact dates</button>
                  <button type="button" class="customize-date-chip" data-flex-chip data-flex-value="1">&plusmn; 1 day</button>
                  <button type="button" class="customize-date-chip" data-flex-chip data-flex-value="2">&plusmn; 2 days</button>
                  <button type="button" class="customize-date-chip" data-flex-chip data-flex-value="3">&plusmn; 3 days</button>
                  <button type="button" class="customize-date-chip" data-flex-chip data-flex-value="7">&plusmn; 7 days</button>
                  <button type="button" class="customize-date-chip" data-flex-chip data-flex-value="14">&plusmn; 14 days</button>
                </div>
              </div>
              <input type="hidden" name="startDate" data-start-date required />
              <input type="hidden" name="dateFlexibility" data-date-flexibility value="0" />
              <input type="hidden" name="endDate" data-end-date required />
            </div>

            <div class="customize-field customize-guests" data-guest-selector>
              <span class="customize-label">No. of Travellers<span class="customize-required">*</span></span>
              <button type="button" class="customize-input customize-guests-trigger" data-guest-trigger aria-expanded="false">
                <span data-guest-summary>Select travellers</span>
                <svg class="customize-guests-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m5 7 5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div class="customize-guests-panel" data-guest-panel hidden>
                {[
                  { key: 'adults', title: 'Adults', age: 'Ages 12 and above' },
                  { key: 'children', title: 'Children', age: 'Ages 6–12' },
                  { key: 'infants', title: 'Children', age: 'Under 6' },
                ].map((guest) => (
                  <div class="customize-guest-row">
                    <div><strong>{guest.title}</strong><span>{guest.age}</span></div>
                    <div class="customize-guest-stepper">
                      <button type="button" data-guest-minus={guest.key} aria-label={`Remove ${guest.title}`}>−</button>
                      <output data-guest-count={guest.key}>0</output>
                      <button type="button" data-guest-plus={guest.key} aria-label={`Add ${guest.title}`}>+</button>
                    </div>
                  </div>
                ))}
              </div>
              <input type="hidden" name="adults" value="0" data-guest-input="adults" />
              <input type="hidden" name="children" value="0" data-guest-input="children" />
              <input type="hidden" name="childrenUnder6" value="0" data-guest-input="infants" />
            </div>

            <div class="customize-field">
              <span class="customize-label">Budget Per Person<span class="customize-required">*</span></span>
              <div class="customize-budget">
                <input type="range" name="budget" min="10000" max="100000" step="5000" value="25000" required class="customize-range" id="customize-budget-range" />
                <span class="customize-budget-value" id="customize-budget-value">₹25,000</span>
              </div>
              <div class="customize-budget-scale" aria-hidden="true">
                <span>₹10,000</span>
                <span>₹1L+</span>
              </div>
            </div>

            <label class="customize-field">
              <span class="customize-label">Jeep Safaris<span class="customize-required">*</span></span>
              <select name="safaris" id="customize-safaris" class="customize-input wild-select" required>
                <option value="" selected disabled>Select number of safaris</option>
                {Array.from({ length: 9 }, (_, i) => i + 1).map((n) => <option value={n}>{n}</option>)}
                <option value="10+">10+</option>
              </select>
            </label>

            <label class="customize-field">
              <span class="customize-label">Resort Category<span class="customize-required">*</span></span>
              <select name="resortTier" id="customize-resort-tier" class="customize-input wild-select" required>
                <option value="" selected disabled>Select resort category</option>
                <option value="6000">Deluxe</option>
                <option value="9000">Semi-Luxury</option>
                <option value="18800">Luxury</option>
              </select>
            </label>

            <label class="customize-field">
              <span class="customize-label">City Travelling From<span class="customize-required">*</span></span>
              <input type="text" name="fromCity" placeholder="Mumbai" required class="customize-input" />
            </label>

            <label class="customize-field">
              <span class="customize-label">How Did You Hear About Us?<span class="customize-required">*</span></span>
              <select name="referralSource" class="customize-input wild-select" required>
                <option value="" selected disabled>Select an option</option>
                <option value="Instagram">Instagram</option>
                <option value="Facebook">Facebook</option>
                <option value="Google">Google</option>
                <option value="YouTube">YouTube</option>
                <option value="LinkedIn">LinkedIn</option>
                <option value="AI Platforms">AI Platforms</option>
                <option value="Word of Mouth">Word of Mouth</option>
              </select>
            </label>

            <label class="customize-field customize-field--full">
              <span class="customize-label">Anything specific in mind?</span>
              <textarea name="notes" placeholder="Tiger sightings, wildlife photography, a honeymoon trip…" rows="3" class="customize-input customize-textarea"></textarea>
            </label>
          </div>

          <p class="customize-consent">
            By submitting, you agree to our <a href="/privacy-policy">Privacy Policy</a>. We'll never spam you. Promise 🤝
          </p>

          <button type="submit" class="customize-submit">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5" aria-hidden="true">
              <path d="M22 2 11 13" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M22 2 15 22l-4-9-9-4 20-7Z" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Let's Plan My Trip!
          </button>
          <p class="customize-crm-message customize-crm-success" data-crm-form-success>Your trip request has been sent successfully. Our safari expert will contact you shortly.</p>
          <p class="customize-crm-message customize-crm-error" data-crm-form-error>We could not send your request. Please check your connection and try again.</p>
        </form>
      </div>
    </div>
    </section>
  </div>
</Layout>

<style>
  .customize-crm-message { display:none; margin-top:1rem; border-radius:.85rem; padding:.85rem 1rem; font-size:.82rem; font-weight:700; line-height:1.5; }
  .customize-crm-message.is-visible { display:block; }
  .customize-crm-success { border:1px solid rgba(37,211,102,.35); background:rgba(37,211,102,.1); color:#8cf0b1; }
  .customize-crm-error { border:1px solid rgba(255,90,90,.35); background:rgba(255,90,90,.1); color:#ff9d9d; }
  .customize-hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(120% 100% at 0% 0%, rgba(253, 203, 8, 0.16) 0%, #0b0b0b 55%);
  }

  .customize-wordmark {
    font-size: 0.85rem;
    font-weight: 800;
    color: #fdcb08;
  }

  .customize-hero-heading {
    margin-top: 0.75rem;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
  }

  .customize-hero-heading span {
    color: #fdcb08;
  }

  @media (min-width: 640px) {
    .customize-hero-heading {
      font-size: 2.75rem;
    }
  }

  @media (min-width: 1024px) {
    .customize-hero {
      overflow: visible;
    }

    .customize-hero-inner {
      position: sticky;
      top: 7rem;
      width: 100%;
    }

    .customize-hero-heading {
      font-size: 2.4rem;
    }
  }

  .customize-hero-sub {
    margin-top: 0.75rem;
    max-width: 26rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Trust badges — desktop/laptop only */
  .customize-trust-list {
    display: none;
  }

  @media (min-width: 1024px) {
    .customize-trust-list {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-top: 2rem;
    }

    .customize-trust-card {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.04);
      padding: 0.9rem 1.1rem;
    }

    .customize-trust-icon {
      display: grid;
      height: 2.75rem;
      width: 2.75rem;
      flex-shrink: 0;
      place-items: center;
      border-radius: 0.75rem;
      background: #ffffff;
      color: #cfa100;
    }

    .customize-trust-icon :global(svg) {
      height: 1.35rem;
      width: 1.35rem;
    }

    .customize-trust-text {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
    }

    .customize-trust-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: #ffffff;
    }

    .customize-trust-sub {
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.55);
    }
  }

  .customize-section {
    background: #0b0b0b;
  }

  .customize-card {
    position: relative;
    border-radius: 1.75rem;
    background: #ffffff;
    padding: 2rem 1.5rem 1.75rem;
    color: #1f1f1f;
  }

  @media (min-width: 640px) {
    .customize-card {
      border-radius: 1.75rem;
      padding: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .customize-card {
      width: 100%;
      box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.5);
    }
  }

  .customize-card::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0.75rem;
    height: 0.3rem;
    width: 3rem;
    border-radius: 999px;
    background: #e5e2dd;
    transform: translateX(-50%);
  }

  @media (min-width: 640px) {
    .customize-card::before {
      display: none;
    }
  }

  .customize-heading {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.1;
    color: #1f1f1f;
  }

  @media (min-width: 640px) {
    .customize-heading {
      font-size: 1.9rem;
    }
  }

  .customize-subheading {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    color: #8a857e;
  }

  .customize-eyebrow-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.75rem 0 0.85rem;
  }

  .customize-form > .customize-eyebrow-row:first-child {
    margin-top: 1.75rem;
  }

  .customize-eyebrow {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #cfa100;
  }

  .customize-eyebrow-line {
    height: 1px;
    flex: 1;
    background: linear-gradient(to right, rgba(207, 161, 0, 0.3), transparent);
  }

  /* Your Details / Trip Preferences — side by side on desktop/laptop only */
  .customize-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .customize-grid {
      grid-template-columns: 1fr 1fr;
    }

    .customize-field--full {
      grid-column: 1 / -1;
    }
  }

  .customize-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .customize-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: #3d3a36;
  }

  .customize-required {
    margin-left: 0.15rem;
    color: #ef4444;
  }

  .customize-input {
    width: 100%;
    height: 51px;
    border-radius: 1rem;
    border: 1px solid transparent;
    background-color: #f9f8f7;
    padding: 0 1.1rem;
