  .customize-guest-stepper button { position:relative; display:block; box-sizing:border-box; width:1.75rem; height:1.75rem; min-width:1.75rem; min-height:1.75rem; border:0; border-radius:50%; background:#f1f1f1; padding:0; color:#292929; font-size:0; line-height:1; appearance:none; transition:background .2s ease,color .2s ease; }
  .customize-guest-stepper button::before,
  .customize-guest-stepper button[data-guest-plus]::after { content:""; position:absolute; left:50%; top:50%; width:.6rem; height:2px; border-radius:999px; background:currentColor; transform:translate(-50%,-50%); }
  .customize-guest-stepper button[data-guest-plus]::after { transform:translate(-50%,-50%) rotate(90deg); }
