  @media (max-width: 639px) {
    .customize-budget {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding: 1.1rem 1rem;
    }

    .customize-budget-value {
      order: -1;
      min-width: unset;
      text-align: center;
      font-size: 1.3rem;
    }

    .customize-range {
