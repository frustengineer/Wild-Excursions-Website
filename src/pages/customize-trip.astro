  }

  .customize-consent a {
    font-weight: 600;
    color: #a17c00;
  }

  .customize-consent a:hover {
    text-decoration: underline;
  }

  .customize-submit {
    display: flex;
    height: 3.4rem;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: 999px;
    background: #fdcb08;
    color: #111111;
    font-size: 1rem;
    font-weight: 800;
    box-shadow: 0 8px 20px rgba(253, 203, 8, 0.3);
    transition: opacity 0.2s ease;
  }

  .customize-submit:hover {
    opacity: 0.9;
  }

  .customize-submit {
    margin-top: 1rem;
  }
</style>

<script>
  function initCustomizeForm() {
    const budgetRange = document.querySelector<HTMLInputElement>('#customize-budget-range');
    const budgetValue = document.querySelector<HTMLElement>('#customize-budget-value');

    const formatBudget = (value: number) => (value >= 100000 ? '₹1L+' : `₹${value.toLocaleString('en-IN')}`);

    const updateBudgetDisplay = () => {
      if (budgetRange && budgetValue) budgetValue.textContent = formatBudget(Number(budgetRange.value));
    };

    if (budgetRange) {
      updateBudgetDisplay();
      budgetRange.addEventListener('input', updateBudgetDisplay);
    }

    const guestSelector = document.querySelector<HTMLElement>('[data-guest-selector]');
    const guestTrigger = guestSelector?.querySelector<HTMLButtonElement>('[data-guest-trigger]');
    const guestPanel = guestSelector?.querySelector<HTMLElement>('[data-guest-panel]');
    const guestSummary = guestSelector?.querySelector<HTMLElement>('[data-guest-summary]');
    const guestCounts: Record<string, number> = { adults: 0, children: 0, infants: 0 };

    const updateGuests = () => {
      Object.entries(guestCounts).forEach(([key, count]) => {
        const output = guestSelector?.querySelector<HTMLOutputElement>(`[data-guest-count="${key}"]`);
        const input = guestSelector?.querySelector<HTMLInputElement>(`[data-guest-input="${key}"]`);
        if (output) output.value = String(count);
        if (input) input.value = String(count);
      });
      const total = Object.values(guestCounts).reduce((sum, count) => sum + count, 0);
      if (guestSummary) guestSummary.textContent = total ? `${total} traveller${total === 1 ? '' : 's'}` : 'Select travellers';
    };

    guestTrigger?.addEventListener('click', () => {
      const open = guestTrigger.getAttribute('aria-expanded') === 'true';
      guestTrigger.setAttribute('aria-expanded', String(!open));
      if (guestPanel) guestPanel.hidden = open;
    });
    guestSelector?.querySelectorAll<HTMLButtonElement>('[data-guest-plus], [data-guest-minus]').forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.guestPlus ?? button.dataset.guestMinus;
        if (!key) return;
        guestCounts[key] = Math.max(0, Math.min(12, guestCounts[key] + (button.dataset.guestPlus ? 1 : -1)));
        updateGuests();
      });
    });
    document.addEventListener('click', (event) => {
      if (!guestSelector || !guestTrigger || !guestPanel || guestSelector.contains(event.target as Node)) return;
      guestPanel.hidden = true;
      guestTrigger.setAttribute('aria-expanded', 'false');
    });
    updateGuests();

    const dateSelector = document.querySelector<HTMLElement>('[data-date-selector]');
    const dateTrigger = dateSelector?.querySelector<HTMLButtonElement>('[data-date-trigger]');
    const datePanel = dateSelector?.querySelector<HTMLElement>('[data-date-panel]');
    const dateSummary = dateSelector?.querySelector<HTMLElement>('[data-date-summary]');
    const startDateInput = dateSelector?.querySelector<HTMLInputElement>('[data-start-date]');
    const endDateInput = dateSelector?.querySelector<HTMLInputElement>('[data-end-date]');
    const dateHelp = dateSelector?.querySelector<HTMLElement>('[data-date-help]');
    const dateMonthLabel = dateSelector?.querySelector<HTMLElement>('[data-date-month-label]');
    const dateGrid = dateSelector?.querySelector<HTMLElement>('[data-date-grid]');
    const datePrev = dateSelector?.querySelector<HTMLButtonElement>('[data-date-prev]');
    const dateNext = dateSelector?.querySelector<HTMLButtonElement>('[data-date-next]');
    const dateFlexInput = dateSelector?.querySelector<HTMLInputElement>('[data-date-flexibility]');
    const flexChips = dateSelector?.querySelectorAll<HTMLButtonElement>('[data-flex-chip]');

    if (dateSelector && dateTrigger && datePanel && dateSummary && startDateInput && endDateInput && dateMonthLabel && dateGrid && datePrev && dateNext) {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      let viewYear = today.getFullYear();
      let viewMonth = today.getMonth();
      let rangeStart: Date | null = null;
      let rangeEnd: Date | null = null;

      const toISO = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const formatLabel = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      const formatRange = (start: Date, end: Date, days: number) => {
        const nights = days - 1;
        const sameMonthYear = start.getMonth() === end.getMonth() && start.getFullYear() === end.getFullYear();
        const flex = Number(dateFlexInput?.value ?? '0');
        const flexSuffix = flex ? ` · ±${flex}d` : '';
        if (sameMonthYear) {
          const monthYear = end.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
          return `${start.getDate()}-${end.getDate()} ${monthYear} (${days}D/${nights}N)${flexSuffix}`;
        }
        const sameYear = start.getFullYear() === end.getFullYear();
        const startLabel = start.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: sameYear ? undefined : 'numeric' });
        const endLabel = formatLabel(end);
        return `${startLabel} - ${endLabel} (${days}D/${nights}N)${flexSuffix}`;
      };

      const renderCalendar = () => {
        dateMonthLabel.textContent = new Date(viewYear, viewMonth, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
        dateGrid.innerHTML = '';
        const firstWeekday = new Date(viewYear, viewMonth, 1).getDay();
        const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

        for (let i = 0; i < firstWeekday; i++) dateGrid.appendChild(document.createElement('span'));

        for (let day = 1; day <= daysInMonth; day++) {
          const cellDate = new Date(viewYear, viewMonth, day);
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = String(day);
          button.dataset.dateIso = toISO(cellDate);
          if (cellDate < today) button.disabled = true;
          if (rangeStart && toISO(cellDate) === toISO(rangeStart)) button.classList.add('is-range-start');
          if (rangeEnd && toISO(cellDate) === toISO(rangeEnd)) button.classList.add('is-range-end');
          if (rangeStart && rangeEnd && cellDate > rangeStart && cellDate < rangeEnd) button.classList.add('is-in-range');
          dateGrid.appendChild(button);
        }
      };

      dateTrigger.addEventListener('click', () => {
        const open = dateTrigger.getAttribute('aria-expanded') === 'true';
        dateTrigger.setAttribute('aria-expanded', String(!open));
        datePanel.hidden = open;
        if (!open) renderCalendar();
      });

      datePrev.addEventListener('click', () => {
        viewMonth -= 1;
        if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
        renderCalendar();
      });

      dateNext.addEventListener('click', () => {
        viewMonth += 1;
        if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
        renderCalendar();
      });

      dateGrid.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-date-iso]');
        if (!button || button.disabled) return;
        const chosen = new Date(`${button.dataset.dateIso}T00:00:00`);
        if (!rangeStart || rangeEnd || chosen < rangeStart) {
          rangeStart = chosen;
          rangeEnd = null;
          startDateInput.value = button.dataset.dateIso ?? '';
          endDateInput.value = '';
          dateSummary.textContent = `${formatLabel(rangeStart)} — Select end date`;
          if (dateHelp) dateHelp.textContent = 'Now select your end date';
        } else {
          rangeEnd = chosen;
          endDateInput.value = button.dataset.dateIso ?? '';
          const days = Math.round((rangeEnd.getTime() - rangeStart.getTime()) / 86400000) + 1;
          dateSummary.textContent = formatRange(rangeStart, rangeEnd, days);
          if (dateHelp) dateHelp.textContent = `${days} day${days === 1 ? '' : 's'} selected`;
        }
        renderCalendar();
        if (rangeEnd) {
          datePanel.hidden = true;
          dateTrigger.setAttribute('aria-expanded', 'false');
          dateTrigger.classList.remove('is-invalid');
        }
      });

      flexChips?.forEach((chip) => {
        chip.addEventListener('click', () => {
          flexChips.forEach((c) => c.classList.remove('is-active'));
          chip.classList.add('is-active');
          if (dateFlexInput) dateFlexInput.value = chip.dataset.flexValue ?? '0';
          if (rangeStart && rangeEnd) {
            const days = Math.round((rangeEnd.getTime() - rangeStart.getTime()) / 86400000) + 1;
            dateSummary.textContent = formatRange(rangeStart, rangeEnd, days);
          }
        });
      });

      document.addEventListener('click', (event) => {
        if (event.composedPath().includes(dateSelector)) return;
        datePanel.hidden = true;
        dateTrigger.setAttribute('aria-expanded', 'false');
      });

      document.querySelector<HTMLFormElement>('#customize-form')?.addEventListener('submit', (event) => {
        if (startDateInput.value && endDateInput.value) return;
        event.preventDefault();
        dateTrigger.setAttribute('aria-expanded', 'true');
        datePanel.hidden = false;
        dateTrigger.classList.add('is-invalid');
        dateTrigger.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      const customizeForm = document.querySelector<HTMLFormElement>('#customize-form');
      customizeForm?.addEventListener('submit', () => {
        const success = customizeForm.querySelector<HTMLElement>('[data-crm-form-success]');
        const error = customizeForm.querySelector<HTMLElement>('[data-crm-form-error]');
        error?.classList.remove('is-visible');
        window.setTimeout(() => {
          success?.classList.add('is-visible');
          success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 350);
      });
    }

  }

  initCustomizeForm();
</script>
