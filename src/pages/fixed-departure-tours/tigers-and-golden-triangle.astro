---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { COUNTRY_CODES } from '../../data/countryCodes';
import heroImage from '../../../home_images/bengal-tiger-wildlife-04.webp';
import authorImage from '../../../hardik.webp';

const pageUrl = new URL('/fixed-departure-tours/tigers-and-golden-triangle/', Astro.site).toString();
const orgId = new URL('/#organization', Astro.site).toString();
const authorId = new URL('/about/#hardik-patel', Astro.site).toString();
const published = '2026-09-16';
const modified = '2026-09-16';

const atAGlance = [
  ['Duration', '12 nights / 13 days'],
  ['Heritage', 'Delhi · Agra · Jaipur (Golden Triangle)'],
  ['Reserves', 'Umred-Karhandla · Tadoba · Pench · Kanha'],
  ['Arrival / departure', 'Delhi'],
  ['Safari drives', '8 naturalist-led game drives'],
  ['Vehicle', 'Private car on heritage days, private 4x4 gypsy on every drive'],
  ['Group', 'Private departure — your party only'],
  ['Price', 'Custom quote (land-only, by lodge tier)'],
];

const itinerary = [
  { d: '1', t: 'Arrive Delhi', text: 'Meet on arrival and transfer to your hotel. The rest of the day is at leisure to recover from the flight.' },
  { d: '2', t: 'Delhi → Agra', text: 'Private road transfer to Agra (about 3.5–4 hours). Agra Fort in the afternoon light, then sunset across the river at Mehtab Bagh, facing the Taj Mahal.' },
  { d: '3', t: 'Taj Mahal → Jaipur', text: 'Sunrise entry to the Taj Mahal before the crowds, then a private drive to Jaipur (about 5–6 hours), stopping at Akbar’s abandoned red-sandstone capital, Fatehpur Sikri, on the way.' },
  { d: '4', t: 'Jaipur — full day', text: 'Amber Fort in the morning, then the City Palace and Hawa Mahal in the Pink City itself, with a private guide throughout.' },
  { d: '5', t: 'Jaipur → Nagpur → Umred-Karhandla', text: 'Domestic flight to Nagpur, then a short private transfer (about 1–1.5 hours) to Umred-Karhandla — the closest reserve to our Nagpur base, and the easiest first landing point after the heritage leg.' },
  { d: '6', t: 'Umred-Karhandla — full day', text: 'Morning and afternoon safaris in this dense, dhole- and tiger-rich forest bordering Tadoba’s wider landscape.' },
  { d: '7', t: 'Umred-Karhandla → Tadoba', text: 'Morning safari, then a private transfer to Tadoba (about 2.5–3 hours). Evening safari on arrival.' },
  { d: '8', t: 'Tadoba — full day', text: 'Morning and afternoon safaris in central India’s highest tiger-density reserve — dry, open terrain that makes for some of the country’s most reliable daytime sightings.' },
  { d: '9', t: 'Tadoba → Pench', text: 'Morning safari, then a private transfer to Pench (about 3–4 hours). Evening safari on arrival.' },
  { d: '10', t: 'Pench — full day', text: 'Morning and afternoon safaris through the teak forest and meadows that gave Kipling his Jungle Book setting — strong for photography and birdlife.' },
  { d: '11', t: 'Pench → Kanha', text: 'Morning safari, then a private transfer to Kanha (about 4–5 hours) through rural Madhya Pradesh. Evening at leisure.' },
  { d: '12', t: 'Kanha → Jabalpur → Delhi', text: 'A final morning safari across Kanha’s sal forest and grassland, home of the rare barasingha, then a road transfer to Jabalpur (about 4 hours) for a domestic flight back to Delhi. Overnight hotel.' },
  { d: '13', t: 'International departure', text: 'Transfer to the airport for your flight home.' },
];

const included = [
  'All forest entry permits, gate fees, gypsy (jeep) charges, driver and guide fees across all four reserves',
  'Monument entry tickets at the Taj Mahal, Agra Fort and Amber Fort',
  'Naturalist-led safari drives in the zones on your permit',
  'Twin-share accommodation throughout, all meals, applicable GST',
  'All domestic flights within India and every ground transfer in a private vehicle',
  'Airport / station assistance and a single point of contact for the whole trip',
];
const excluded = [
  'International flights to and from India',
  'India e-Visa fee and comprehensive travel insurance',
  'Camera / lens fees where a park levies them, tips and personal expenses',
  'Optional add-ons not listed as included',
];

const faqs = [
  { q: 'Is this a fixed group departure with a shared calendar date, or a private trip?', a: 'The itinerary and route are fixed — the sequence of Delhi, Agra, Jaipur and the four central India reserves is a proven structure we run often. The actual travel dates are set privately around your booking window and permit availability, the same way our other multi-park itineraries work, rather than a shared group departure with a published calendar.' },
  { q: 'Why these four reserves specifically — Umred-Karhandla, Tadoba, Pench and Kanha?', a: 'They sit on one practical road route through central India, each with a different character: Umred-Karhandla is the closest reserve to Nagpur and a gentle first stop, Tadoba has the highest tiger density in the region, Pench is the strongest for photography and birdlife, and Kanha closes the trip with scale and the rare barasingha alongside its tigers.' },
  { q: 'How much does the Tigers and Golden Triangle tour cost?', a: 'It is priced as a custom quote because the land cost depends on lodge tier, travel season and party size. Tell us your dates and preferred style and we return a written, itemised price — land-only, with international flights kept separate.' },
  { q: 'Can I shorten the trip or drop a reserve?', a: 'Yes — a 9- or 10-day version dropping one central India reserve keeps the same Golden Triangle-plus-safari structure. Ask for it when you enquire.' },
  { q: 'What is the best time of year for this trip?', a: 'November to February is most comfortable across both the heritage cities and the reserves. March to June is hotter but brings tigers to waterholes more predictably. Central India’s reserves close through the monsoon, roughly July to mid-October.' },
  { q: 'Do you guarantee a tiger sighting?', a: 'No ethical operator can. Four reserves and eight drives stack the odds strongly in your favour across the trip as a whole, but sightings depend on the animals, not a schedule.' },
];

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TouristTrip',
      '@id': `${pageUrl}#trip`,
      name: 'Tigers and Golden Triangle Tour',
      description:
        'A 12-night, 13-day private journey combining Delhi, Agra and Jaipur’s Golden Triangle with tiger safaris across Umred-Karhandla, Tadoba, Pench and Kanha in central India. Private transfers, selected lodges, 8 naturalist-led safari drives and complete permit coordination. Priced as a custom quote by lodge tier.',
      image: new URL(heroImage.src, Astro.site).toString(),
      touristType: ['Wildlife enthusiasts', 'First-time India visitors', 'Couples', 'Small private groups'],
      itinerary: {
        '@type': 'ItemList',
        numberOfItems: itinerary.length,
        itemListElement: itinerary.map((day, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: { '@type': 'TouristDestination', name: `Day ${day.d}: ${day.t}`, description: day.text },
        })),
      },
      provider: { '@id': orgId },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'INR',
        description: 'Custom quote, land-only, priced by lodge tier and season.',
        availability: 'https://schema.org/InStock',
        url: new URL('/customize-trip/', Astro.site).toString(),
        seller: { '@id': orgId },
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: 'Fixed Departure Tours', item: new URL('/fixed-departure-wildlife-tours-india/', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: 'Tigers and Golden Triangle', item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    {
      '@type': 'Person',
      '@id': authorId,
      name: 'Hardik Patel',
      jobTitle: 'Founder and Safari Route Planner',
      url: new URL('/about/', Astro.site).toString(),
      image: new URL(authorImage.src, Astro.site).toString(),
      worksFor: { '@id': orgId },
    },
  ],
};
---

<Layout
  title="Tigers and Golden Triangle - Fixed Departure Tour"
  description="A 12-night, 13-day journey combining Delhi, Agra and Jaipur's Golden Triangle with tiger safaris across Umred-Karhandla, Tadoba, Pench and Kanha in central India — day-by-day itinerary, private transfers and full permit coordination."
  image={heroImage.src}
  canonicalPath="/fixed-departure-tours/tigers-and-golden-triangle/"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaGraph)} />

  <div class="guide-root">
    <section class="hero" aria-labelledby="page-title">
      <Image
        src={heroImage}
        alt="A tigress and her cub at a waterhole in a central Indian forest"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="hero-img"
      />
      <div class="hero-inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/fixed-departure-wildlife-tours-india/">Fixed Departure Tours</a><span aria-hidden="true">/</span>
          <span aria-current="page">Tigers and Golden Triangle</span>
        </nav>
        <div class="eyebrow">Fixed-itinerary private journey</div>
        <h1 id="page-title">Tigers and <em>Golden Triangle</em> Tour in India</h1>
        <p class="dek">Delhi → Agra → Jaipur → Umred-Karhandla → Tadoba → Pench → Kanha → Delhi. Private transfers, selected lodges, 8 naturalist-led safari drives and complete permit coordination — planned end to end by local specialists.</p>
        <div class="hero-actions">
          <a class="button" href="/customize-trip/">Request a custom quote <span aria-hidden="true">→</span></a>
          <a class="button ghost" href="#itinerary">See the day-by-day</a>
        </div>
        <div class="byline">
          <img class="avatar" src={authorImage.src} width="52" height="52" alt="Hardik Patel, Founder and Safari Route Planner at Wild Excursions" loading="eager" decoding="async" />
          <div>
            <b>Planned by Hardik Patel · Founder &amp; Safari Route Planner</b>
            <span>Wild Excursions · Nagpur · Updated 16 September 2026</span>
          </div>
        </div>
      </div>
    </section>

    <div class="wrap layout">
      <article>
        <div class="quick">
          <span class="label">At a glance</span>
          <div class="glance">
            {atAGlance.map(([k, v]) => (
              <div><b>{k}</b><span>{v}</span></div>
            ))}
          </div>
        </div>

        <p>This is our combined heritage-and-wildlife flagship — the trip for travellers who want India's most iconic monuments and its best central India tiger country in one itinerary, rather than planning two separate holidays. Three heritage cities, four reserves with genuinely different character, and a route built to keep every transfer day short. Everything below is a starting structure: arrival city, park order, lodge tier and drive count all move to fit you.</p>

        <section id="why" aria-labelledby="why-title">
          <h2 id="why-title">Why this route</h2>
          <ul>
            <li><strong>Delhi, Agra, Jaipur</strong> — the classic Golden Triangle, anchored by a sunrise visit to the Taj Mahal and Agra Fort before the crowds arrive.</li>
            <li><strong>Umred-Karhandla</strong> — the closest reserve to our Nagpur base, and a gentle first landing point straight off the heritage leg.</li>
            <li><strong>Tadoba</strong> — the highest tiger density in central India, in dry open forest that produces reliable daytime sightings.</li>
            <li><strong>Pench</strong> — teak forest and meadows, superb light and birdlife, and an easy transfer from Tadoba.</li>
            <li><strong>Kanha</strong> — scale and quiet to close the trip: a vast sal-forest landscape with barasingha alongside the tigers.</li>
          </ul>
          <p>Related reading: <a href="/blogs/tadoba-vs-pench-vs-kanha/">Tadoba vs Pench vs Kanha</a> and our <a href="/tiger-safari-tours/extension-to-agra/">Agra extension</a> for the heritage leg on its own.</p>
        </section>

        <section id="itinerary" aria-labelledby="itinerary-title">
          <h2 id="itinerary-title">Day-by-day itinerary</h2>
          <ol class="days">
            {itinerary.map((day) => (
              <li>
                <span class="daynum">Day {day.d}</span>
                <div><h3>{day.t}</h3><p>{day.text}</p></div>
              </li>
            ))}
          </ol>
          <div class="note"><strong>Shorter on time?</strong> A 9- or 10-day version drops one central India reserve and keeps the same Golden Triangle-plus-safari structure. Ask for it when you enquire.</div>
        </section>

        <section id="included" aria-labelledby="included-title">
          <h2 id="included-title">What is included — and what is not</h2>
          <div class="cols">
            <div class="col"><h3>Included</h3><ul>{included.map((i) => <li>{i}</li>)}</ul></div>
            <div class="col"><h3>Not included</h3><ul>{excluded.map((i) => <li>{i}</li>)}</ul></div>
          </div>
        </section>

        <section id="lodges" aria-labelledby="lodges-title">
          <h2 id="lodges-title">Lodge tiers and pricing</h2>
          <p>The itinerary is fixed; the lodges and heritage hotels are not. We quote against your chosen tier and match each property to the gate on your confirmed permit, or to the best-located heritage hotel in Delhi, Agra and Jaipur.</p>
          <ul>
            <li><strong>Comfort</strong> — well-run forest lodges and heritage hotels close to each gate or monument, clean and unfussy.</li>
            <li><strong>Premium</strong> — boutique lodges, premium tented camps and heritage-style hotels with strong service.</li>
            <li><strong>Luxury</strong> — India's named luxury safari properties and palace-style hotels, where available on your dates. See our <a href="/luxury-tiger-safaris/">luxury tiger safari tours</a> guide.</li>
          </ul>
          <p><strong>How pricing works:</strong> quotes are land-only and per person on twin-share, with a 50% deposit to confirm and the balance due 30+ days before departure. Full terms are on our <a href="/terms/">terms page</a>.</p>
        </section>

        <section id="when" aria-labelledby="when-title">
          <h2 id="when-title">When to travel</h2>
          <p>Central-India reserves open around mid-October and close for the monsoon at the end of June, so this itinerary runs best <strong>November–June</strong>. Broadly: <strong>November–February</strong> for comfortable weather and cool mornings across both the heritage cities and the reserves; <strong>March–June</strong> for the highest tiger activity as water becomes scarce, though hotter for the Agra and Jaipur legs.</p>
        </section>

        <section id="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Frequently asked questions</h2>
          <div class="faq">
            {faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <div class="answer"><p>{f.a}</p></div>
              </details>
            ))}
          </div>
        </section>

        <section class="cta" id="quote" aria-labelledby="cta-title">
          <h2 id="cta-title">Request a custom quote</h2>
          <p>Tell us your travel month, group size, arrival city and preferred lodge tier. We'll come back with a finalised day-by-day and a written, itemised price — land-only, flights kept separate.</p>
          <a class="button dark" href="/customize-trip/">Open the enquiry form <span aria-hidden="true">→</span></a>
        </section>
      </article>

      <aside aria-label="Trip enquiry">
        <div class="side-inner">
          <nav class="toc" aria-label="On this page">
            <b>On this page</b>
            <ol>
              <li><a href="#why">Why this route</a></li>
              <li><a href="#itinerary">Day-by-day itinerary</a></li>
              <li><a href="#included">Included &amp; excluded</a></li>
              <li><a href="#lodges">Lodge tiers &amp; pricing</a></li>
              <li><a href="#when">When to travel</a></li>
              <li><a href="#faq">FAQs</a></li>
            </ol>
          </nav>
          <div class="enquiry-card">
            <h3>Request a quote for this itinerary</h3>
            <form class="enquiry-form" data-whatsapp-form data-crm-source="tigers_golden_triangle_tour">
              <input type="hidden" name="destination" value="Tigers and Golden Triangle Tour" />
              <input name="name" type="text" placeholder="Full Name" aria-label="Full name" autocomplete="name" required />
              <input name="email" type="email" placeholder="Email" aria-label="Email address" autocomplete="email" required />
              <select name="phoneCountry" class="cc-select" aria-label="Country dialing code">
                {COUNTRY_CODES.map((c) => (
                  <option value={c.dial} selected={c.iso === 'IN'}>{c.flag} {c.dial} · {c.name}</option>
                ))}
              </select>
              <input name="phone" type="tel" placeholder="Phone number" aria-label="Phone number" autocomplete="tel" required />
              <div class="phone-row">
                <select name="travelMonth" aria-label="Travel month" required>
                  <option value="">Travel Month</option>
                  <option>Not sure yet</option>
                  <option>Nov 2026</option><option>Dec 2026</option><option>Jan 2027</option><option>Feb 2027</option>
                  <option>Mar 2027</option><option>Apr 2027</option><option>May 2027</option><option>Jun 2027</option>
                  <option>Later / 2027–28</option>
                </select>
                <select name="travellers" aria-label="Group size" required>
                  <option value="">Group size</option>
                  <option>2 Travellers</option><option>3 Travellers</option><option>4 Travellers</option><option>5+ Travellers</option>
                </select>
              </div>
              <select name="lodgeTier" aria-label="Preferred lodge tier">
                <option value="">Preferred lodge tier</option>
                <option>Comfort</option><option>Premium</option><option>Luxury</option><option>Not sure — advise me</option>
              </select>
              <textarea name="message" placeholder="Arrival city, anything else..." aria-label="Trip details"></textarea>
              <button class="send-enquiry" type="submit">Send Enquiry</button>
            </form>
          </div>
          <a class="callback" href="/contact/">Request a Callback</a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style is:global>
  @font-face{font-family:Edo;src:url('/fonts/edo.ttf') format('truetype');font-display:swap}
  @font-face{font-family:Avant;src:url('/fonts/ITCAvantGardeStd-Bk.woff2') format('woff2');font-display:swap;font-weight:400}
  @font-face{font-family:Avant;src:url('/fonts/ITCAvantGardeStd-Demi.woff2') format('woff2');font-display:swap;font-weight:600 800}
</style>

<style>
  .guide-root{
    --ink:#121711;--forest:#1d2a1e;--yellow:#fdcb08;--cream:#f7f1e4;--paper:#fffdf8;--muted:#676b62;--line:#dcd5c6;
    --shadow:0 22px 60px rgba(30,35,25,.12);--radius:22px;--max:1180px;
    background:var(--paper);color:var(--ink);
    font-family:Avant,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased;
  }
  .guide-root :where(h1,h2,h3){line-height:1.12;margin:0;color:var(--ink)}
  :where(.guide-root a){color:inherit}
  .guide-root img{display:block;max-width:100%}
  .wrap{width:min(var(--max),calc(100% - 40px));margin-inline:auto}

  .hero{position:relative;min-height:600px;color:#fff;display:grid;align-items:end;overflow:hidden;background:#10150f}
  .hero .hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
  .hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,13,8,.93) 0%,rgba(9,13,8,.7) 48%,rgba(9,13,8,.2) 78%),linear-gradient(0deg,rgba(9,13,8,.8),transparent 55%)}
  .hero-inner{position:relative;z-index:2;padding:64px clamp(22px,3.4vw,54px) 60px;max-width:860px}
  .crumbs{display:flex;align-items:center;gap:9px;flex-wrap:wrap;font-size:.75rem;color:rgba(255,255,255,.68);margin-bottom:28px}
  .crumbs a{text-decoration:none}.crumbs a:hover{color:#fff}
  .eyebrow{display:flex;align-items:center;gap:10px;color:var(--yellow);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700}
  .eyebrow:before{content:"";width:30px;height:2px;background:var(--yellow)}
  .hero h1{font-size:clamp(2.5rem,5.8vw,4.9rem);color:#fff;max-width:15ch;letter-spacing:-.045em;margin-top:16px}
  .hero h1 em{color:var(--yellow);font-family:Edo,cursive;font-style:normal;font-weight:400;letter-spacing:0}
  .dek{font-size:clamp(1rem,1.7vw,1.22rem);color:rgba(255,255,255,.8);max-width:680px;margin:23px 0 26px}
  .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:30px}
  .byline{display:flex;align-items:center;gap:13px;font-size:.83rem;color:rgba(255,255,255,.7)}
  .avatar{width:52px;height:52px;border-radius:50%;object-fit:cover;border:2px solid var(--yellow);background:#151515;flex:none}
  .byline b{color:#fff;display:block}.byline span{display:block}

  .layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:74px;padding:70px 0 110px}
  article{min-width:0}
  article p{margin:0 0 1.1em;color:#383d36;font-size:1.02rem;line-height:1.68}
  .guide-root article h2{font-size:clamp(1.7rem,3.6vw,2.7rem);letter-spacing:-.035em;margin:58px 0 20px}
  .guide-root article h3{font-size:clamp(1.1rem,1.9vw,1.4rem);margin:0 0 8px;letter-spacing:-.02em}
  article ul,article ol{padding-left:1.35rem;color:#383d36}
  article li{padding-left:.35rem;margin:.5rem 0;line-height:1.6}
  article strong{color:var(--ink)}

  .quick{background:var(--cream);border-left:5px solid var(--yellow);border-radius:0 var(--radius) var(--radius) 0;padding:26px 30px;margin-bottom:44px;box-shadow:var(--shadow)}
  .quick .label{display:block;color:#6b5700;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;font-weight:800;margin-bottom:14px}
  .glance{display:grid;grid-template-columns:1fr 1fr;gap:12px 24px}
  .glance div{border-bottom:1px solid #e6ddc4;padding-bottom:8px}
  .glance b{display:block;font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:#8a7500}
  .glance span{font-size:.96rem;color:#22281f}

  .note{border:1px dashed #b79a2a;background:#fff9d9;border-radius:14px;padding:17px 19px;color:#5b511f;font-size:.86rem;margin:22px 0}
  .note strong{display:block;color:#4b4112;margin-bottom:3px}
  .note a{font-weight:700}

  .days{list-style:none;padding:0;margin:26px 0 0;border-top:1px solid var(--line)}
  .days li{display:grid;grid-template-columns:88px 1fr;gap:18px;padding:20px 0;border-bottom:1px solid var(--line)}
  .daynum{font-weight:800;color:#6b5700;font-size:.82rem;letter-spacing:.04em;padding-top:2px}
  .days p{margin:0;font-size:.96rem;color:#43483f}

  .cols{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:12px}
  .col{background:#f4f2eb;border:1px solid #e7e0d3;border-radius:16px;padding:22px 24px}
  .col h3{margin:0 0 10px}
  .col ul{margin:0}

  .faq{border-top:1px solid var(--line);margin-top:4px}
  details{border-bottom:1px solid var(--line);padding:0}
  summary{cursor:pointer;list-style:none;padding:16px 44px 10px 0;font-weight:700;position:relative;line-height:1.45}
  summary::-webkit-details-marker{display:none}
  summary:after{content:"+";position:absolute;right:7px;top:13px;color:#6c5b00;font-size:1.5rem;font-weight:400;line-height:1}
  details[open] summary:after{content:"–"}
  details[open]{padding-bottom:4px}
  .answer{padding:0 38px 18px 0}
  .answer p{font-size:.95rem;margin:0;line-height:1.6;color:#43483f}

  .cta{position:relative;overflow:hidden;background:var(--yellow);border-radius:28px;padding:43px;margin-top:70px}
  .cta:after{content:"";position:absolute;width:190px;height:190px;border:44px solid rgba(0,0,0,.06);border-radius:50%;right:-55px;bottom:-75px}
  .guide-root .cta h2{margin:0 0 13px;max-width:620px}
  .cta p{color:#35300e;max-width:630px}
