---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TourCard from '../components/TourCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { tours } from '../data/tours';
import { testimonialsByJungle } from '../data/testimonials';
import heroImage from '../../home_images/bengal-tiger-wildlife-24.webp';
import zonesImage from '../../home_images/bengal-tiger-wildlife-31.webp';
import gatesImage from '../../home_images/bengal-tiger-wildlife-27.webp';

const tadobaTours = tours
  .filter((tour) => tour.jungle === 'tadoba')
  .sort((a, b) => a.price - b.price);

const cheapest = tadobaTours[0];

const avgRating = Math.round((tadobaTours.reduce((sum, t) => sum + t.rating, 0) / tadobaTours.length) * 10) / 10;
const totalReviews = tadobaTours.reduce((sum, t) => sum + t.reviews, 0);
const tadobaTestimonials = (testimonialsByJungle.tadoba ?? []).slice(0, 3);

const zoneComparison = [
  { zone: 'Core zone', gates: 'Moharli, Kolara, Navegaon', density: 'Higher — capped daily permits, most established routes', bestFor: 'First-time visitors, widest resort choice' },
  { zone: 'Buffer zone', gates: 'Agarzari, Junona, Nimdhela', density: 'Lower — fewer vehicles per drive', bestFor: 'Repeat visitors, resident-tiger territories, quieter drives' },
];

const distanceFromNagpur = [
  { gate: 'Kolara', distance: '~110 km', time: '2 – 2.5 hrs' },
  { gate: 'Navegaon', distance: '~115 km', time: '~2.5 hrs' },
  { gate: 'Khutwanda', distance: '~135 km', time: '~3 hrs' },
  { gate: 'Moharli', distance: '~140 km', time: '3 – 3.5 hrs' },
  { gate: 'Agarzari (buffer)', distance: '~140 km', time: '~3 hrs' },
  { gate: 'Zari / Pangdi', distance: '~170 km', time: '3.5 – 4 hrs' },
];

const safariRules = [
  'Carry original photo ID (Aadhaar, PAN, Driving Licence or Passport) for every traveller — permits are checked at the gate against these details.',
  'Stay inside the vehicle at all times once the safari has entered the forest; getting out is not permitted except at designated stops.',
  'Keep noise to a minimum and avoid flash photography near wildlife — sudden sound or light can spook animals and ruin the sighting for the whole vehicle.',
  'No littering and no single-use plastic inside the reserve — carry a bag back for any wrapper or bottle.',
  'Do not feed or attempt to attract animals; follow your naturalist and driver\'s instructions on distance and vehicle positioning.',
  'Arrive at the gate at least 30 minutes before your slot — entry closes on time and does not wait for late arrivals.',
];

const thingsToCarry = [
  'Original ID proof — Aadhaar, PAN, Driving Licence, or Passport',
  'Light, comfortable clothing in neutral colours — khaki, beige, olive green',
  'A light jacket or sweater for early morning and evening safaris',
  'Sunglasses, a cap, and a scarf or balaclava for dust and cold wind',
  'Camera, lenses, memory cards, charger and spare batteries',
  'Binoculars for wildlife viewing, and a torch for use after dark',
];

const relatedGuides = [
  { href: '/blogs/tadoba-safari-booking-guide', label: 'Tadoba Safari Booking Guide 2026', blurb: 'Zones, gates, timings and the full step-by-step booking process.' },
  { href: '/blogs/tadoba-safari-booking-charges', label: 'Tadoba Safari Booking Charges', blurb: 'What a safari actually costs — permits, Gypsy hire and naturalist fees, broken down.' },
  { href: '/blogs/tadoba-safari-zones-explained', label: 'Tadoba Safari Zones Explained', blurb: 'Core vs buffer, compared properly — habitat, wildlife and crowding.' },
  { href: '/blogs/best-time-to-visit-tadoba', label: 'Best Time for Tiger Sightings in Tadoba', blurb: 'A month-by-month breakdown of weather, sighting odds and crowds.' },
  { href: '/blogs/tadoba-safari-gate-information', label: 'Tadoba Safari Gate Information', blurb: 'Every entry point explained, and how to pick one based on your stay.' },
  { href: '/blogs/tadoba-safari-vs-pench-safari', label: 'Tadoba Safari vs Pench Safari', blurb: 'A direct, two-reserve comparison for travellers deciding between the two.' },
];

const howToSteps = [
  { name: 'Pick your travel dates and trip length', text: 'Decide how many nights you have — this determines how many safaris (2 to 8) fit into the trip.' },
  { name: 'Choose your zones and gates', text: 'Core zones like Moharli and Kolara offer the most established routes; buffer gates like Agarzari and Nimdhela offer fewer vehicles per drive. Most trips mix both.' },
  { name: 'Confirm a package with permits, stay and transfers included', text: 'A packaged Tadoba tour bundles the forest department permit, Gypsy hire, naturalist fee and lodge into one transparent price.' },
  { name: 'Submit ID details for every traveller', text: 'Safari permits are issued against original photo ID for each adult — names must match exactly.' },
  { name: 'Receive your confirmed itinerary', text: 'Once permits are secured, you get a day-by-day plan showing gates, safari timings and your stay.' },
];

const faqs = [
  { question: 'How do I book a Tadoba jungle safari?', answer: 'Choose your travel dates and number of safaris, confirm a package that bundles permits, vehicle, naturalist and stay, then submit photo ID for every traveller. We handle the Maharashtra Forest Department permit booking directly once dates are confirmed.' },
  { question: 'Where can I do Tadoba safari booking online?', answer: 'You can book directly through Wild Excursions — Tadoba safari booking through a packaged operator bundles the Maharashtra Forest Department permit, Gypsy vehicle, naturalist fee and stay into one confirmed itinerary, instead of chasing permit, vehicle and resort bookings separately.' },
  { question: 'What is the best time to visit Tadoba for a tiger safari?', answer: 'April to June gives the highest tiger sighting odds as animals concentrate around shrinking water sources. November to February is the most comfortable weather. October and early December offer the best light and greenery for photography.' },
  { question: 'What are Tadoba safari zones?', answer: 'Tadoba is split into a strictly protected core zone and a much larger surrounding buffer zone. Tigers move freely between both — core zones offer the most established routes, buffer zones see fewer vehicles per drive.' },
  { question: 'How much does a Tadoba safari cost?', answer: 'It depends on the zone, season, and whether you book a full vehicle or a single seat. Complete packages — including permits, Gypsy hire, naturalist fee and stay — currently start from ₹10,900 per person for a short two-safari trip.' },
  { question: 'What are Tadoba safari timings?', answer: 'Safaris run in two daily slots: a morning safari entering around sunrise (roughly 6:00–6:30 AM) and an afternoon safari running until gate closing at dusk. Exact times shift slightly through the year.' },
  { question: 'How many days should I plan for a Tadoba safari?', answer: 'Two nights with four safaris is the practical minimum for a reasonable chance at multiple sightings. Three nights with six safaris is what we recommend for anyone travelling a long distance to get here.' },
  { question: 'Is Tadoba open all year round?', answer: 'Core zones close for the monsoon, typically from the start of July until early October. Selected buffer routes generally stay open through the monsoon under local forest department rules.' },
  { question: 'Which Tadoba gate should I choose?', answer: 'There is no single best gate — the right choice depends on your travel dates, permit availability and how close your stay is to the gate. Moharli is the most established for first-time visitors; buffer gates like Agarzari offer fewer vehicles.' },
  { question: 'How do I get from Nagpur to Tadoba?', answer: 'Nagpur is the nearest airport and rail hub. Driving time depends on your gate — Kolara is closest at roughly 2 to 2.5 hours, Moharli is about 3 to 3.5 hours. See our full Nagpur to Tadoba travel guide for routes from Mumbai, Pune and Hyderabad too.' },
  { question: 'What is the cancellation policy for a Tadoba safari booking?', answer: 'Refunds scale with how far ahead of departure you cancel: 100% at 120+ days out, 75% at 60+ days, 50% between 45–60 days, 25% between 30–45 days, and no refund inside 30 days or on a no-show. Full terms are on our Terms & Conditions page.' },
  { question: 'Is a Tadoba safari safe for families and first-time visitors?', answer: 'Yes. Every safari is naturalist-led and follows forest department safety rules — guests stay inside the vehicle throughout the drive. Moharli and Kolara, the most established core gates, are the easiest starting point for families and first-timers.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Book a Tadoba Jungle Safari',
  description: 'Step-by-step process for booking a tiger safari in Tadoba-Andhari Tiger Reserve.',
  step: howToSteps.map((step) => ({
    '@type': 'HowToStep',
    name: step.name,
    text: step.text,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Tadoba', item: new URL('/tours/tadoba/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: 'Tadoba Jungle Safari Booking', item: new URL('/tadoba-jungle-safari-booking', Astro.site).toString() },
  ],
};

const pageUrl = new URL('/tadoba-jungle-safari-booking', Astro.site).toString();

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageUrl,
  url: pageUrl,
  name: 'Tadoba Jungle Safari Booking',
  datePublished: '2026-01-01',
  dateModified: '2026-08-19',
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Tadoba Jungle Safari Booking',
  serviceType: 'Tadoba safari booking',
  url: pageUrl,
  provider: { '@type': 'TravelAgency', name: 'Wild Excursions', url: Astro.site.toString() },
  areaServed: { '@type': 'Place', name: 'Tadoba-Andhari Tiger Reserve' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: avgRating,
    reviewCount: totalReviews,
  },
  review: tadobaTestimonials.map((t) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: t.name },
    reviewRating: { '@type': 'Rating', ratingValue: t.rating, bestRating: 5 },
    reviewBody: t.quote,
  })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Tadoba Safari Packages',
    itemListElement: tadobaTours.map((tour) => ({
      '@type': 'Offer',
      name: tour.name,
      price: tour.price,
      priceCurrency: 'INR',
      url: new URL(`/tours/${tour.jungle}/${tour.slug}/`, Astro.site).toString(),
    })),
  },
};
---

<Layout
  title="Tadoba Jungle Safari Booking 2026 | Official Safari Booking Assistance"
  description="Tadoba safari booking made simple — permits, resorts and naturalist drives from ₹10,900. Official Tadoba jungle safari booking, planned by local experts."
  rawTitle
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <article class="tjs bg-black text-brand-ivory">
    <div class="tjs-shell">
      <nav class="tjs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/tours/tadoba/">Tadoba</a><span>/</span><span>Jungle Safari Booking</span>
      </nav>

      <p class="tjs-eyebrow">Official Safari Booking Assistance</p>
      <h1>Tadoba Jungle Safari Booking</h1>
      <p class="tjs-subtitle">Book permits, resorts and naturalist-led drives in Maharashtra's top tiger reserve — planned by a team that runs Tadoba safaris every week of the season.</p>

      <div class="tjs-quick-answer">
        <p><strong>Quick answer:</strong> A Tadoba jungle safari is booked by choosing your dates and number of drives, confirming a package that bundles the forest permit, safari vehicle, naturalist fee and stay, then submitting photo ID for each traveller. Packages currently start from ₹{cheapest.price.toLocaleString('en-IN')} per person. See <a href="#packages">current tour packages</a> below, or <a href="/contact/">talk to our team</a> for a same-day quote.</p>
      </div>

      <div class="tjs-hero-image">
        <Image src={heroImage} alt="Bengal tiger on safari in Tadoba-Andhari Tiger Reserve" width={1600} height={800} format="webp" quality={85} loading="eager" class="h-full w-full object-cover" />
      </div>
    </div>

    <div class="tjs-shell">
      <section id="how-to-book" aria-labelledby="how-to-book-heading">
        <h2 id="how-to-book-heading">How to Book a Tadoba Jungle Safari</h2>
        <p>Booking a Tadoba safari means securing four things together: a forest department permit, a safari vehicle, a mandatory naturalist guide, and a place to stay near your gate. Here is the process in order.</p>
        <ol class="tjs-steps">
          {howToSteps.map((step, index) => (
            <li>
              <span class="tjs-step-number">{index + 1}</span>
              <div>
                <strong>{step.name}</strong>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <p>For the full walkthrough — including how far ahead to book and full-vehicle vs per-seat decisions — read the <a href="/blogs/tadoba-safari-booking-guide">complete Tadoba safari booking guide</a>.</p>
      </section>

      <section id="best-time" aria-labelledby="best-time-heading">
        <h2 id="best-time-heading">Best Time to Visit Tadoba</h2>
        <p>There is no single best month — it depends on whether you are prioritising comfort, sighting odds or photography.</p>
        <div class="tjs-fact-grid">
          <div><strong>April – June</strong><span>Highest tiger sighting odds, as animals concentrate around shrinking water sources</span></div>
          <div><strong>November – February</strong><span>Most comfortable weather, best for families and first-time visitors</span></div>
          <div><strong>October – early December</strong><span>Best light and greenery for photography, after the monsoon</span></div>
          <div><strong>July – September</strong><span>Core zones close for monsoon; selected buffer routes stay open at low cost with almost no crowds</span></div>
        </div>
        <p>See the full month-by-month breakdown in our guide on the <a href="/blogs/best-time-to-visit-tadoba">best time for tiger sightings in Tadoba</a>.</p>
      </section>

      <section id="zones" aria-labelledby="zones-heading">
        <h2 id="zones-heading">Tadoba Safari Zones</h2>
        <div class="tjs-split">
          <div>
            <p>Tadoba-Andhari Tiger Reserve is split into a strictly protected <strong>core zone</strong> and a much larger surrounding <strong>buffer zone</strong>. Tigers and leopards move freely between the two — the difference is in permit availability, vehicle density and how established the routes are.</p>
            <ul class="tjs-bullets">
              <li><strong>Core zone</strong> — the most established routes, entered through gates like Moharli, Kolara and Navegaon. Best for a first safari.</li>
              <li><strong>Buffer zone</strong> — noticeably fewer vehicles per drive, entered through gates like Agarzari, Junona and Nimdhela. Several well-known resident tigers hold territory here.</li>
            </ul>
            <p>Most of our multi-day itineraries mix both zones. Read the full breakdown in <a href="/blogs/tadoba-safari-zones-explained">Tadoba safari zones explained</a>, or see every entry point in our <a href="/blogs/tadoba-safari-gate-information">gate-by-gate guide</a>.</p>
          </div>
          <div class="tjs-side-image">
            <Image src={zonesImage} alt="Tiger in Tadoba's core zone forest" width={700} height={560} format="webp" quality={82} loading="lazy" class="h-full w-full object-cover" />
          </div>
        </div>
        <div class="tjs-table-wrap">
          <table>
            <caption class="tjs-table-caption">Tadoba core zone vs buffer zone, compared</caption>
            <thead><tr><th scope="col">Zone</th><th scope="col">Example gates</th><th scope="col">Vehicle density</th><th scope="col">Best for</th></tr></thead>
            <tbody>
              {zoneComparison.map((row) => (
                <tr>
                  <td>{row.zone}</td>
                  <td>{row.gates}</td>
                  <td>{row.density}</td>
                  <td>{row.bestFor}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="booking-charges" aria-labelledby="charges-heading">
        <h2 id="charges-heading">Tadoba Safari Booking Charges</h2>
        <p>A safari charge is built from four parts: the forest department entry permit, Gypsy (vehicle) hire, the mandatory naturalist fee, and an optional camera fee for DSLR or video equipment. Core zone permits cost more than buffer zone permits, and a full vehicle costs more upfront than a single seat but is usually better value for a family or group.</p>
        <p>Rather than pricing each piece separately, our packages bundle everything — permits, vehicle, naturalist and stay — into one transparent number:</p>
        <div class="tjs-table-wrap">
          <table>
            <caption class="tjs-table-caption">Tadoba safari package pricing, permits and stay included</caption>
            <thead><tr><th scope="col">Package</th><th scope="col">Safaris</th><th scope="col">Duration</th><th scope="col">From</th></tr></thead>
            <tbody>
              {tadobaTours.map((tour) => (
                <tr>
                  <td><a href={`/tours/${tour.jungle}/${tour.slug}/`}>{tour.name}</a></td>
                  <td>{Math.max((parseInt(tour.duration, 10) || 1) - 1, 1) * 2} jeep safaris</td>
                  <td>{tour.duration}</td>
                  <td>₹{tour.price.toLocaleString('en-IN')} <span class="tjs-strike">₹{tour.originalPrice.toLocaleString('en-IN')}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>For a full charge-by-charge breakdown, read <a href="/blogs/tadoba-safari-booking-charges">Tadoba safari booking charges explained</a>.</p>
      </section>

      <section id="timings" aria-labelledby="timings-heading">
        <h2 id="timings-heading">Tadoba Safari Timings</h2>
        <p>Safaris run in two slots each day, shifting slightly with sunrise and sunset through the year:</p>
        <div class="tjs-fact-grid tjs-fact-grid--two">
          <div><strong>Morning safari</strong><span>Entry around sunrise — roughly 6:00 AM in summer, 6:30 AM in winter. Runs about four hours.</span></div>
          <div><strong>Afternoon safari</strong><span>Entry in the early-to-mid afternoon, running until gate closing at dusk.</span></div>
        </div>
        <p>Morning drives are cooler and generally more active for predators. Afternoon drives in the hot months (April–June) are excellent for waterhole sightings. Core zones close to tourists during the monsoon, typically from early July to early October.</p>
      </section>

      <section id="how-to-reach" aria-labelledby="how-to-reach-heading">
        <h2 id="how-to-reach-heading">How to Reach Tadoba</h2>
        <p>Nagpur is the nearest airport and rail hub for almost every visitor, with direct flights from Mumbai, Delhi, Bengaluru, Hyderabad and Pune. From there, driving time depends entirely on which gate you're entering:</p>
        <div class="tjs-table-wrap">
          <table>
            <caption class="tjs-table-caption">Distance and driving time from Nagpur, by gate</caption>
            <thead><tr><th scope="col">Gate</th><th scope="col">Distance from Nagpur</th><th scope="col">Driving time</th></tr></thead>
            <tbody>
              {distanceFromNagpur.map((row) => (
                <tr>
                  <td>{row.gate}</td>
                  <td>{row.distance}</td>
                  <td>{row.time}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>Book a resort on the same side as the gates on your permit — crossing the reserve between gates can add well over an hour each way. For routes from Mumbai, Pune, Hyderabad and Delhi, see our full <a href="/blogs/nagpur-to-tadoba-travel-guide">Nagpur to Tadoba travel guide</a>.</p>
      </section>

      <section id="packages" aria-labelledby="packages-heading">
        <h2 id="packages-heading">Tadoba Tour Packages</h2>
        <p>Every package below includes forest department permits, safari vehicle, naturalist fee and stay near your confirmed gate.</p>
        <div class="tjs-package-grid">
          {tadobaTours.map((tour) => <TourCard tour={tour} />)}
        </div>
      </section>

      <section id="rules" aria-labelledby="rules-heading">
        <h2 id="rules-heading">Safari Rules and What to Carry</h2>
        <div class="tjs-split tjs-split--equal">
          <div>
            <h3 class="tjs-h3">Forest department rules</h3>
            <ul class="tjs-bullets">
              {safariRules.map((rule) => <li>{rule}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="tjs-h3">What to carry</h3>
            <ul class="tjs-bullets">
              {thingsToCarry.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section id="reviews" aria-labelledby="reviews-heading">
        <h2 id="reviews-heading">What Travellers Say About Booking With Us</h2>
        <p><strong>{avgRating}/5</strong> average from {totalReviews} verified guest reviews across our Tadoba packages.</p>
        <div class="tjs-review-grid">
          {tadobaTestimonials.map((t) => (
            <div class="tjs-review-card">
              <span class="tjs-review-stars" aria-hidden="true">{'★'.repeat(Math.round(t.rating))}</span>
              <p class="tjs-review-quote">&ldquo;{t.quote.length > 260 ? `${t.quote.slice(0, 260).trim()}…` : t.quote}&rdquo;</p>
              <p class="tjs-review-name">{t.name}<span>{t.city}</span></p>
            </div>
          ))}
        </div>
      </section>

      <section id="guides" aria-labelledby="guides-heading">
        <h2 id="guides-heading">Explore More Tadoba Safari Guides</h2>
        <div class="tjs-guide-grid">
          {relatedGuides.map((guide) => (
            <a href={guide.href} class="tjs-guide-card">
              <strong>{guide.label}</strong>
              <span>{guide.blurb}</span>
            </a>
          ))}
        </div>
      </section>

      <section id="faqs" aria-labelledby="faqs-heading" class="tjs-faq-section">
        <h2 id="faqs-heading">Frequently Asked Questions</h2>
        <FaqAccordion faqs={faqs} />
      </section>

      <div class="tjs-final-cta">
        <div>
          <strong>Ready to book your Tadoba safari?</strong>
          <p>Send us your dates and group size — we reply with a zone plan, resort options and a clear price within hours.</p>
        </div>
        <a href="/contact/" class="tjs-cta-btn">Talk to Our Experts</a>
      </div>
    </div>

    <div class="tjs-gate-image">
      <Image src={gatesImage} alt="Safari jeep on a forest road at a Tadoba entry gate" width={1600} height={500} format="webp" quality={80} loading="lazy" class="h-full w-full object-cover" />
    </div>
  </article>
</Layout>

<style>
  :global(html),
  :global(body) {
    max-width: 100%;
    overflow-x: hidden;
  }

  .tjs {
    padding-bottom: 4rem;
    max-width: 100vw;
    overflow-x: hidden;
  }

  .tjs-shell {
    width: min(1000px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .tjs-breadcrumb {
    display: flex;
    gap: 0.55rem;
    padding-top: 1.5rem;
    color: #777;
    font-size: 0.75rem;
  }

  .tjs-breadcrumb a {
    color: #bbb;
  }

  .tjs-eyebrow {
    margin-top: 1.5rem;
    color: #fdcb08;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .tjs h1 {
    margin: 0.5rem 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .tjs-subtitle {
    max-width: 46rem;
    color: rgba(255, 255, 255, 0.65);
    font-size: 1rem;
    line-height: 1.65;
  }

  .tjs-quick-answer {
    margin-top: 1.5rem;
    border-radius: 1rem;
    border: 1px solid rgba(253, 203, 8, 0.35);
    background: rgba(253, 203, 8, 0.08);
    padding: 1.25rem 1.5rem;
  }

  .tjs-quick-answer p {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .tjs-quick-answer a {
    color: #fdcb08;
    font-weight: 700;
    text-decoration: underline;
  }

  .tjs-hero-image {
    margin-top: 2rem;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    border-radius: 1.25rem;
  }

