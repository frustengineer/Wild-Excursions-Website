---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { COUNTRY_CODES } from '../data/countryCodes';
import heroImage from '../../home_images/bengal-tiger-wildlife-06.webp';

const pageUrl = new URL('/canada-tiger-safari-guide/', Astro.site).toString();
const orgId = new URL('/#organization', Astro.site).toString();

const contents = [
  'Best travel months — comfort vs. peak tiger activity, month by month',
  'Recommended parks and which to combine (Tadoba, Pench, Kanha, Bandhavgarh)',
  '10- and 14-day sample routes with transfer times',
  'Estimated CAD budget by lodge tier, land-only vs. all-in',
  'The safari-permit timeline — when zones open and when to commit',
  'Packing checklist for an open-vehicle forest safari',
  'Vaccination, travel-insurance and India e-Visa resources for Canadians',
  'International and domestic flight considerations from Toronto, Vancouver and Montreal',
];

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'The Canadian Traveller’s Guide to an India Tiger Safari',
      description:
        'A free planning guide for Canadians: best travel months, recommended parks, 10- and 14-day routes, estimated CAD budgets, the permit timeline, a packing checklist, and visa, vaccination and flight resources.',
      inLanguage: 'en',
      isPartOf: { '@id': orgId },
      primaryImageOfPage: { '@type': 'ImageObject', url: new URL(heroImage.src, Astro.site).toString() },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: 'India Wildlife Tours from Canada', item: new URL('/india-wildlife-tours-from-canada/', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: 'The Canadian Traveller’s Guide to an India Tiger Safari', item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title="The Canadian Traveller’s Guide to an India Tiger Safari"
  description="A free planning guide for Canadians booking an India tiger safari: best months, recommended parks, 10- and 14-day routes, estimated CAD budgets, the permit timeline, a packing checklist, and visa, vaccination and flight resources. Enter your details to read it now."
  image={heroImage.src}
  canonicalPath="/canada-tiger-safari-guide/"
  hreflangAlternates={[{ hreflang: 'en-ca', href: '/canada-tiger-safari-guide/' }]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaGraph)} />

  <div class="guide-root">
    <section class="hero" aria-labelledby="page-title">
      <Image src={heroImage} alt="A Bengal tiger among dry grass in an Indian tiger reserve" format="webp" quality={82} loading="eager" fetchpriority="high" class="hero-img" />
      <div class="hero-inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/india-wildlife-tours-from-canada/">From Canada</a><span aria-hidden="true">/</span>
          <span aria-current="page">Free safari guide</span>
        </nav>
        <div class="eyebrow">Free download</div>
        <h1 id="page-title">The Canadian Traveller’s Guide to an <em>India Tiger Safari</em></h1>
        <p class="dek">Everything you need to plan the trip properly — from the operator who books the permits, lodges and transfers. Enter your details and the full guide opens on this page immediately.</p>
      </div>
    </section>

    <div class="wrap layout">
      <article>
        <h2>What’s inside</h2>
        <ul class="contents">
          {contents.map((c) => <li>{c}</li>)}
        </ul>
        <p>It’s written for travellers from Ontario, British Columbia and across Canada who want a professionally organised tiger and wildlife safari in India — not a generic “visit India” overview. For the full picture of how we plan these trips, see <a href="/india-wildlife-tours-from-canada/">India Tiger Safaris for Canadian Travellers</a> and our flagship <a href="/tours/tigers-of-central-india/">14-Day Tigers of Central India</a> itinerary.</p>

        <div id="guide-gate" class="gate">
          <h3>Read the guide now</h3>
          <p class="gate-sub">Tell us a little about your trip and the guide opens straight away. No spam — we’ll only follow up if you ask us to.</p>
          <form class="gate-form" data-crm-source="canada_safari_guide">
            <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <label>Full name<input name="name" type="text" autocomplete="name" required /></label>
            <label>Email<input name="email" type="email" autocomplete="email" required /></label>
            <div class="grid2">
              <label>Travel month
                <select name="travelMonth" required>
                  <option value="">Select…</option>
                  <option>Not sure yet</option>
                  <option>Nov 2026</option><option>Dec 2026</option><option>Jan 2027</option><option>Feb 2027</option>
                  <option>Mar 2027</option><option>Apr 2027</option><option>May 2027</option><option>Jun 2027</option>
                  <option>Later / 2027–28</option>
                </select>
              </label>
              <label>Group size
                <select name="travellers" required>
                  <option value="">Select…</option>
                  <option>2 travellers</option><option>3 travellers</option><option>4 travellers</option><option>5+ travellers</option>
                </select>
              </label>
            </div>
            <p class="form-status" data-crm-form-error></p>
            <p class="form-status" data-crm-form-success>Thanks — opening your guide…</p>
            <button type="submit">Open the guide →</button>
            <p class="gate-fineprint">Prefer to talk it through? <a href="/india-wildlife-tours-from-canada/#call">Book a 20-minute planning call</a>.</p>
          </form>
        </div>

        <div id="guide-body" hidden>
          <div class="unlocked-badge">✓ Guide unlocked — welcome</div>

          <section id="months" aria-labelledby="months-title">
            <h2 id="months-title">1. Best travel months</h2>
            <p>Central-India tiger reserves run a dry season from roughly mid-October to the end of June, then close for the monsoon.</p>
            <ul>
              <li><strong>November–February</strong> — the comfortable window. Cold early mornings (bring a fleece for the first hour), pleasant days, green-gold forest. Best for a first trip and for travellers escaping the Canadian winter.</li>
              <li><strong>March–April</strong> — warming up, thinning cover, rising tiger activity. A strong balance of weather and sightings.</li>
              <li><strong>May–June</strong> — hot (35–45°C) but the peak for sightings: animals concentrate at shrinking water. For committed wildlife watchers and photographers.</li>
            </ul>
          </section>

          <section id="parks" aria-labelledby="parks-title">
            <h2 id="parks-title">2. Recommended parks</h2>
            <ul>
              <li><strong>Tadoba</strong> (Maharashtra) — highest tiger density in central India, open dry forest, most reliable daytime sightings. The best place to start a trip.</li>
              <li><strong>Pench</strong> (MP/Maharashtra) — teak forest and meadows, superb light and birdlife, easy transfer from Tadoba.</li>
              <li><strong>Kanha</strong> (MP) — vast sal forest and grassland, quieter, with barasingha alongside the tigers.</li>
              <li><strong>Bandhavgarh</strong> (MP) — small, very high density, dramatic fort-country backdrops. A strong alternative to Kanha.</li>
            </ul>
            <p>For a two-week trip, Tadoba + Pench + Kanha (or Bandhavgarh) is the standard combination. With 10 days, drop to two reserves.</p>
          </section>

          <section id="routes" aria-labelledby="routes-title">
            <h2 id="routes-title">3. Sample routes</h2>
            <p><strong>10 days:</strong> Nagpur → Tadoba (3 nights) → Pench (3 nights) → Nagpur. Two reserves, 5–6 drives, minimal transfers.</p>
            <p><strong>14 days:</strong> Delhi or Mumbai → Nagpur → Tadoba (3n) → Pench (2n) → Kanha or Bandhavgarh (3n) → Jabalpur → city day → home. Three reserves, 8–10 drives. This is our flagship <a href="/tours/tigers-of-central-india/">14-Day Tigers of Central India</a> — the full day-by-day is on that page.</p>
          </section>

          <section id="budget" aria-labelledby="budget-title">
            <h2 id="budget-title">4. Estimated CAD budget</h2>
            <p>Indicative, land-only, per person on twin-share, converted from our rupee pricing at roughly CAD&nbsp;1&nbsp;:&nbsp;₹60. Confirmed in writing when we quote your dates.</p>
            <div class="table-scroll" tabindex="0" role="region" aria-label="Estimated CAD budget">
              <table>
                <thead><tr><th>Trip</th><th>Comfort lodges</th><th>Premium lodges</th><th>Excludes</th></tr></thead>
                <tbody>
                  <tr><td>10 days · 2 parks</td><td>from ~CAD 2,600</td><td>from ~CAD 3,600</td><td rowspan="2">Int’l flights (~CAD 1,400–2,600 return), e-Visa, insurance, tips</td></tr>
                  <tr><td>14 days · 3 parks</td><td>from ~CAD 3,800</td><td>from ~CAD 5,200</td></tr>
                </tbody>
              </table>
            </div>
            <p>Luxury properties add materially on top. A private vehicle for your party (recommended) is included in these figures; sharing reduces cost.</p>
          </section>

          <section id="permits" aria-labelledby="permits-title">
            <h2 id="permits-title">5. The safari-permit timeline</h2>
            <ul>
              <li><strong>90–120 days before travel</strong> — zone permits are released on state government portals. Peak dates (weekends, Canadian winter break, Indian holidays) can sell out within minutes.</li>
              <li><strong>What this means for you</strong> — commit your travel dates as early as you can. We book permits in your names the moment the window opens; lodges are then matched to the gate on your confirmed permit.</li>
              <li><strong>Identity documents</strong> — the passport details used to book the permit must match at the gate. We collect these at booking.</li>
            </ul>
          </section>

          <section id="packing" aria-labelledby="packing-title">
            <h2 id="packing-title">6. Packing checklist</h2>
            <ul class="pack">
              <li>Neutral-coloured layers (olive, khaki, brown) — no bright colours or white on drives</li>
              <li>Warm fleece or down layer for winter mornings; buff/scarf for dust</li>
              <li>Sun hat, high-SPF sunscreen, sunglasses, lip balm</li>
              <li>Binoculars (8×42 is ideal) — transforms every drive</li>
              <li>Camera, spare batteries and cards, dust protection, a bean bag for the vehicle</li>
              <li>Small daypack, refillable water bottle, headlamp or torch</li>
              <li>Personal medication, basic first aid, insect repellent</li>
              <li>Original passport (for permit checks), printed copies of key documents</li>
            </ul>
          </section>

          <section id="admin" aria-labelledby="admin-title">
            <h2 id="admin-title">7. Visa, vaccinations and insurance</h2>
            <ul>
              <li><strong>Visa</strong> — Canadian passport holders apply online for an India e-Visa (tourist) before travel, through the official Government of India portal. Apply 2–4 weeks ahead.</li>
              <li><strong>Health</strong> — check current recommendations with a travel clinic or the Government of Canada travel health notices for India well before departure. Carry a copy of your vaccination records.</li>
              <li><strong>Insurance</strong> — comprehensive travel insurance with medical evacuation cover is strongly recommended for every traveller. Buy it when you pay your deposit so pre-departure cancellation is covered.</li>
              <li><strong>Official guidance</strong> — review <a href="https://travel.gc.ca/destinations/india" rel="nofollow noopener" target="_blank">travel.gc.ca/destinations/india</a> before booking and again before you fly.</li>
            </ul>
          </section>

          <section id="flights" aria-labelledby="flights-title">
            <h2 id="flights-title">8. Flight considerations</h2>
            <ul>
              <li><strong>International</strong> — fly into Delhi or Mumbai. One stop from Toronto and Montreal via Europe or the Gulf (~15–18 h); one or two stops from Vancouver (~18–22 h).</li>
              <li><strong>Domestic</strong> — a short onward flight to Nagpur (Tadoba/Pench) or Jabalpur (Kanha/Bandhavgarh). We book these once your international flights are confirmed, with sensible connection buffers.</li>
              <li><strong>Timing</strong> — arrive a day before your first safari to absorb the 9.5–12.5 hour time difference. Don’t schedule a safari drive for your arrival day.</li>
            </ul>
          </section>

          <section class="cta" aria-labelledby="cta-title">
            <h2 id="cta-title">Ready to turn this into a plan?</h2>
            <p>Tell us your travel month, group size and arrival city. We’ll come back with a route, a lodge-tier comparison and a written price.</p>
            <a class="button dark" href="/customize-trip/">Open the safari enquiry form <span aria-hidden="true">→</span></a>
          </section>
        </div>
      </article>
    </div>
  </div>
</Layout>

<style is:global>
  @font-face{font-family:Edo;src:url('/fonts/edo.ttf') format('truetype');font-display:swap}
  @font-face{font-family:Avant;src:url('/fonts/ITCAvantGardeStd-Bk.woff2') format('woff2');font-display:swap;font-weight:400}
  @font-face{font-family:Avant;src:url('/fonts/ITCAvantGardeStd-Demi.woff2') format('woff2');font-display:swap;font-weight:600 800}
</style>

<style>
  .guide-root{
    --ink:#121711;--forest:#1d2a1e;--yellow:#fdcb08;--cream:#f7f1e4;--paper:#fffdf8;--muted:#676b62;--line:#dcd5c6;
    --shadow:0 22px 60px rgba(30,35,25,.12);--radius:22px;--max:900px;
    background:var(--paper);color:var(--ink);
    font-family:Avant,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased;
  }
  .guide-root :where(h1,h2,h3){line-height:1.14;margin:0;color:var(--ink)}
  :where(.guide-root a){color:inherit}
  .guide-root img{display:block;max-width:100%}
  .wrap{width:min(var(--max),calc(100% - 40px));margin-inline:auto}

  .hero{position:relative;min-height:480px;color:#fff;display:grid;align-items:end;overflow:hidden;background:#10150f}
  .hero .hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
  .hero:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(9,13,8,.9),rgba(9,13,8,.35) 70%)}
  .hero-inner{position:relative;z-index:2;padding:56px clamp(22px,3.4vw,54px) 52px;max-width:820px}
  .crumbs{display:flex;align-items:center;gap:9px;flex-wrap:wrap;font-size:.75rem;color:rgba(255,255,255,.68);margin-bottom:22px}
  .crumbs a{text-decoration:none}
  .eyebrow{display:flex;align-items:center;gap:10px;color:var(--yellow);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700}
  .eyebrow:before{content:"";width:30px;height:2px;background:var(--yellow)}
  .hero h1{font-size:clamp(2rem,4.6vw,3.4rem);color:#fff;max-width:20ch;letter-spacing:-.04em;margin-top:14px}
  .hero h1 em{color:var(--yellow);font-family:Edo,cursive;font-style:normal;font-weight:400}
  .dek{font-size:clamp(1rem,1.6vw,1.15rem);color:rgba(255,255,255,.82);max-width:640px;margin:20px 0 0}

  .layout{padding:60px 0 100px}
  article{min-width:0}
  article p{margin:0 0 1.1em;color:#383d36;font-size:1.02rem;line-height:1.68}
  .guide-root article h2{font-size:clamp(1.5rem,3vw,2.1rem);letter-spacing:-.03em;margin:44px 0 16px}
  .guide-root article h2:first-child{margin-top:0}
  .guide-root article h3{font-size:1.2rem;margin:0 0 10px}
  article ul{padding-left:1.35rem;color:#383d36}
  article li{padding-left:.35rem;margin:.5rem 0;line-height:1.6}
  article strong{color:var(--ink)}

  .contents{list-style:none;padding:0;margin:0 0 1.4em;display:grid;gap:8px}
  .contents li{position:relative;padding:12px 14px 12px 40px;background:var(--cream);border-radius:12px;font-size:.95rem}
  .contents li:before{content:"→";position:absolute;left:16px;color:#9c7900;font-weight:800}

  .gate{margin:36px 0;padding:30px;border:1px solid var(--line);border-radius:var(--radius);background:#151515;color:#efefed;box-shadow:var(--shadow)}
  .guide-root .gate h3{color:#fff;font-size:1.3rem}
  .gate-sub{color:#a9a9a4!important;font-size:.9rem!important;margin:8px 0 20px!important}
  .gate-form{display:grid;gap:14px}
  .gate-form label{display:grid;gap:6px;font-size:.72rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#8f8f88}
  .gate-form input,.gate-form select{width:100%;border:1px solid #3a3a3a;border-radius:10px;background:#0d0d0d;color:#efefed;padding:13px;font:inherit;font-size:.9rem;outline:0}
  .gate-form select:invalid{color:#777772}
  .gate-form input:focus,.gate-form select:focus{border-color:#827000;box-shadow:0 0 0 2px rgba(253,203,8,.1)}
  .gate-form option{background:#111;color:#efefed}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .honeypot{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;opacity:0}
  .gate-form button{height:50px;border:0;border-radius:999px;background:var(--yellow);color:#080808;font-weight:800;font-size:.9rem;cursor:pointer;margin-top:4px}
  .gate-form button:hover{filter:brightness(1.07)}
  .gate-fineprint{color:#9a9a94;font-size:.8rem;text-align:center;margin:2px 0 0}
  .gate-fineprint a{color:var(--yellow)}
  .form-status{display:none;margin:0;font-size:.85rem}
  .form-status.is-visible{display:block}
  [data-crm-form-error].is-visible{color:#ff8f6b}
  [data-crm-form-success].is-visible{color:var(--yellow)}

  .unlocked-badge{display:inline-block;margin-bottom:20px;padding:8px 16px;border-radius:999px;background:#e8f3e0;color:#2f5222;font-size:.8rem;font-weight:800}
  #guide-body section{margin-bottom:12px}

  .table-scroll{overflow-x:auto;margin:18px 0;border:1px solid var(--line);border-radius:16px;background:#fff}
  .table-scroll:focus{outline:3px solid rgba(253,203,8,.5);outline-offset:2px}
  table{width:100%;border-collapse:collapse;min-width:560px;font-size:.86rem}
  th{background:var(--forest);color:#fff;text-align:left;font-size:.7rem;letter-spacing:.05em;text-transform:uppercase}
  th,td{padding:13px 14px;vertical-align:top;border-bottom:1px solid var(--line)}
  tbody tr:last-child td{border-bottom:0}
  td:first-child{font-weight:700;color:var(--ink)}
  .pack{columns:2;column-gap:28px}
  .pack li{break-inside:avoid}

  .cta{position:relative;overflow:hidden;background:var(--yellow);border-radius:24px;padding:36px;margin-top:50px}
  .guide-root .cta h2{margin:0 0 12px}
  .cta p{color:#35300e}
  .button{display:inline-flex;align-items:center;gap:9px;padding:13px 21px;border-radius:999px;background:var(--ink);color:#fff;text-decoration:none;font-weight:700;font-size:.84rem;border:0}
  .button.dark:hover{background:#293229}

  @media(max-width:600px){
    .wrap{width:min(100% - 26px,var(--max))}
    .hero-inner{padding:40px 20px 40px}
    .grid2{grid-template-columns:1fr}
    .gate{padding:22px}
    .pack{columns:1}
  }
</style>

<script>
  (function () {
    const KEY = 'we_canada_guide_unlocked';
    const gate = document.getElementById('guide-gate');
    const body = document.getElementById('guide-body');
    const form = document.querySelector<HTMLFormElement>('.gate-form');
    if (!gate || !body) return;

    function unlock(scroll: boolean) {
      gate!.hidden = true;
      body!.hidden = false;
      if (scroll) body!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    try {
      if (localStorage.getItem(KEY) === '1') unlock(false);
    } catch {}

    form?.addEventListener('crm:success', () => {
      try { localStorage.setItem(KEY, '1'); } catch {}
      window.setTimeout(() => unlock(true), 400);
    });
  })();
</script>
