---
import Layout from '../../layouts/Layout.astro';
import tours from '../../data/tours.json';

export function getStaticPaths() {
  return tours.map((tour) => ({
    params: { slug: tour.slug },
    props: { tour },
  }));
}

const { tour } = Astro.props;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: tour.name,
  description: tour.description,
  image: new URL(tour.image, Astro.site).toString(),
  offers: {
    '@type': 'Offer',
    price: tour.price,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: Astro.url.toString(),
  },
};
---

<Layout
  title={tour.name}
  description={tour.shortDescription}
  image={tour.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="text-sm font-medium uppercase tracking-wide text-brand-gold dark:text-brand-amber">{tour.location}</p>
    <h1 class="mt-1 text-3xl font-bold sm:text-4xl">{tour.name}</h1>

    <img
      src={tour.image}
      alt={`${tour.name} — ${tour.location}`}
      width="1200"
      height="800"
      class="mt-6 w-full rounded-xl object-cover"
    />

    <div class="mt-6 flex flex-wrap gap-6 text-sm text-brand-carbon/70 dark:text-brand-ivory/70">
      <span><strong class="font-semibold">Duration:</strong> {tour.duration}</span>
      <span><strong class="font-semibold">From:</strong> ${tour.price}</span>
    </div>

    <p class="mt-6 text-brand-carbon/80 dark:text-brand-ivory/80">{tour.description}</p>

    <h2 class="mt-10 text-xl font-bold">Trip Highlights</h2>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-brand-carbon/80 dark:text-brand-ivory/80">
      {tour.highlights.map((highlight: string) => <li>{highlight}</li>)}
    </ul>

    <a
      href="/contact"
      class="mt-10 inline-block rounded-lg bg-brand-amber px-6 py-3 font-semibold text-brand-carbon transition-colors hover:bg-brand-gold"
    >
      Enquire About This Tour
    </a>
  </article>
</Layout>
