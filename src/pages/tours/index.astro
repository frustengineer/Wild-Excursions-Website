---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import TripPlannerModal from '../../components/TripPlannerModal.astro';
import { tours } from '../../data/tours';
import { testimonialsByJungle } from '../../data/testimonials';
import allFaqs from '../../data/faqs.json';
import tourHero46 from '../../../tour_jungle/dhole-grassland-itinerary.webp';
import tourHero48 from '../../../tour_jungle/forest-landscape-itinerary.webp';
import tourHero50 from '../../../tour_jungle/asian-elephants-horizon-itinerary.webp';
import tourHero51 from '../../../tour_jungle/wildlife-grassland-itinerary.webp';
import tripAdvisorLogo from '../../../trip_advisor.webp';
import wildExcursionsLogo from '../../../we.logo.webp';
import curatedWhyIcon from '../../../curated.webp';
import guideWhyIcon from '../../../tour-guide.webp';
import conservationWhyIcon from '../../../conservation.webp';
import safetyWhyIcon from '../../../safety.webp';

const jungleFullNames: Record<string, string> = {
  tadoba: 'Tadoba–Andhari Tiger Reserve',
  pench: 'Pench Tiger Reserve',
  kanha: 'Kanha Tiger Reserve',
  bandhavgarh: 'Bandhavgarh Tiger Reserve',
  panna: 'Panna Tiger Reserve',
  satpura: 'Satpura Tiger Reserve',
  'umred-karhandla': 'Umred–Karhandla Wildlife Sanctuary',
  tipeshwar: 'Tipeshwar Wildlife Sanctuary',
  'sanjay-dubri': 'Sanjay–Dubri Tiger Reserve',
  nagzira: 'Nawegaon–Nagzira Tiger Reserve',
  'jim-corbett': 'Jim Corbett National Park',
  ranthambore: 'Ranthambore Tiger Reserve',
  gir: 'Gir National Park',
  dudhwa: 'Dudhwa Tiger Reserve',
  pilibhit: 'Pilibhit Tiger Reserve',
  bandipur: 'Bandipur Tiger Reserve',
  bor: 'Bor Wildlife Sanctuary',
  'jawai-bera': 'Jawai–Bera Leopard Safari',
  jhalana: 'Jhalana Leopard Safari Park',
  kaziranga: 'Kaziranga National Park',
  kishanpur: 'Kishanpur Wildlife Sanctuary',
  manas: 'Manas National Park',
  rajaji: 'Rajaji Tiger Reserve',
  sunderban: 'Sundarban Tiger Reserve',
};

const heroDealSlugs = ['tadoba-tiger-safari', 'pench-tiger-safari', 'kanha-tiger-safari', 'bandhavgarh-tiger-safari'];
const heroDealImages = [tourHero46, tourHero48, tourHero51, tourHero50];
const heroDeals = heroDealSlugs.map((slug, index) => {
  const tour = tours.find((t) => t.slug === slug)!;
  const discountPct = Math.round(((tour.originalPrice - tour.price) / tour.originalPrice) * 100);
  return { image: heroDealImages[index], tour, discountPct };
});

const junglePriority = ['tadoba', 'pench', 'kanha', 'bandhavgarh', 'panna', 'satpura', 'umred-karhandla', 'tipeshwar', 'sanjay-dubri', 'nagzira', 'jim-corbett', 'ranthambore', 'gir', 'dudhwa', 'pilibhit'];

const uniqueJungles = Array.from(new Map(tours.map((t) => [t.jungle, t])).values()).map((representative) => {
  const jungleTours = tours.filter((t) => t.jungle === representative.jungle);
  return {
    jungle: representative.jungle,
    jungleLabel: representative.jungleLabel,
    region: representative.region,
    image: representative.image,
    tourCount: jungleTours.length,
    minPrice: Math.min(...jungleTours.map((t) => t.price)),
    avgRating: Math.round((jungleTours.reduce((sum, t) => sum + t.rating, 0) / jungleTours.length) * 10) / 10,
    reviewCount: jungleTours.reduce((sum, t) => sum + t.reviews, 0),
  };
}).sort((a, b) => {
  const ai = junglePriority.indexOf(a.jungle);
  const bi = junglePriority.indexOf(b.jungle);
  if (ai !== -1 || bi !== -1) return (ai === -1 ? junglePriority.length : ai) - (bi === -1 ? junglePriority.length : bi);
  return a.jungleLabel.localeCompare(b.jungleLabel);
});

const jungleRegions = ['All', 'Maharashtra', 'Madhya Pradesh', 'Rajasthan', 'Assam', 'Uttarakhand', 'Uttar Pradesh', 'Gujarat', 'West Bengal', 'Karnataka'] as const;

const whyCards = [
  {
    number: '01',
    title: 'Personally curated itineraries',
    desc: 'Every journey is shaped around your dates, interests, pace, and wildlife wish list.',
    icon: curatedWhyIcon,
  },
  {
    number: '02',
    title: 'Field-trained guides & drivers',
    desc: 'Travel with experienced local teams who understand animal behaviour, forest routes, and responsible sightings.',
    icon: guideWhyIcon,
  },
  {
    number: '03',
    title: 'Wildlife conservation first',
    desc: 'Our trips respect park rules, local communities, and the habitats that make every encounter possible.',
    icon: conservationWhyIcon,
  },
  {
    number: '04',
    title: 'Safety-led travel',
    desc: 'Verified stays, dependable vehicles, and careful on-ground planning keep your safari comfortable and secure.',
    icon: safetyWhyIcon,
  },
  {
    number: '05',
    title: '24/7 traveller support',
    desc: 'From your first question to your journey home, our team is available whenever you need assistance.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 13v-2a8 8 0 0 1 16 0v2" stroke-linecap="round"/><path d="M4 12h3v6H5a1 1 0 0 1-1-1v-5zm16 0h-3v6h2a1 1 0 0 0 1-1v-5z" stroke-linejoin="round"/><path d="M17 18c0 2-2 3-5 3" stroke-linecap="round"/></svg>',
  },
];

const allTestimonials = Object.values(testimonialsByJungle).flat();
const avgRating = 4.9;
const totalReviews = tours.reduce((sum, t) => sum + t.reviews, 0);

const minPrice = Math.min(...tours.map((t) => t.price));

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: uniqueJungles.map((j, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/tours/${j.jungle}/`, Astro.site).toString(),
    name: `${j.jungleLabel} Safari Tours`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Tours', item: new URL('/tours/', Astro.site).toString() },
  ],
};
---

<Layout
  title="Wildlife Safari Reserves"
  description={`Choose your reserve — Tadoba, Kanha, Bandhavgarh, Pench, Satpura, Panna, Ranthambore, and more. ${uniqueJungles.length} jungles, small-group tiger safaris with real naturalists, transparent pricing from ₹${minPrice.toLocaleString('en-IN')}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="tours-promo-bar fixed inset-x-3 z-50 mx-auto flex w-auto max-w-[1640px] sm:inset-x-6">
    <div class="tours-promo-marquee" aria-hidden="false">
      <p>Limited Time: Save &#8377;2,000 on your first booking &mdash; use code <strong>WILD2000</strong> &#127942;</p>
      <p aria-hidden="true">Limited Time: Save &#8377;2,000 on your first booking &mdash; use code <strong>WILD2000</strong> &#127942;</p>
    </div>
  </div>

  <section class="tours-hero-carousel relative overflow-hidden" data-hero-carousel>
    {heroDeals.map((deal, index) => (
      <Image
        src={deal.image}
        alt={index === 0 ? 'Wild Excursions safari' : ''}
        width={1920}
        height={1080}
        format="webp"
        quality={100}
        class:list={['tours-hero-slide', 'h-full w-full object-cover', { 'tours-hero-slide-bottom': index === 1 || index === 2, 'is-active': index === 0 }]}
        loading="lazy"
      />
    ))}
    <div class="tours-hero-scrim" aria-hidden="true"></div>

    <button type="button" class="tours-hero-arrow tours-hero-arrow-left" data-hero-prev aria-label="Previous slide">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button type="button" class="tours-hero-arrow tours-hero-arrow-right" data-hero-next aria-label="Next slide">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    {heroDeals.map((deal, index) => (
      <div class:list={['tours-hero-overlay', { 'is-active': index === 0 }]}>
        <p class="tours-hero-offer">Get up to <span class="tours-hero-offer-pct">{deal.discountPct}% OFF</span> on</p>
        <p class="tours-hero-title"><span class="tours-hero-title-amber">{deal.tour.jungleLabel}</span> Safari Packages</p>

        <div class="tours-hero-price-row">
          <span class="tours-hero-price-label">Starting at</span>
          <span class="tours-hero-price-strike">&#8377;{deal.tour.originalPrice.toLocaleString('en-IN')}</span>
          <span class="tours-hero-price">&#8377;{deal.tour.price.toLocaleString('en-IN')}</span>
          <span class="tours-hero-price-label">/ Person</span>
          <span class="tours-hero-badge">{deal.tour.bestSeason.toUpperCase()} SALE</span>
        </div>

        <a href="/contact/" class="tours-hero-cta">Connect With A Safari Expert</a>
      </div>
    ))}

    <div class="tours-hero-dots" data-hero-dots>
      {heroDeals.map((_, index) => (
        <span class:list={[{ 'is-active': index === 0 }]} data-dot-index={index}></span>
      ))}
    </div>
  </section>

  <section class="tours-trust bg-black px-4 py-6 sm:px-6 lg:px-10">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-4">
      <div class="tours-trust-badge">
        <span class="tours-trust-icon">
          <Image src={tripAdvisorLogo} alt="Tripadvisor" width={240} height={240} quality={100} format="png" class="h-full w-full rounded-full object-cover" loading="lazy" />
        </span>
        <span>
          <span class="tours-trust-rating">4.8/5</span>
          <span class="tours-trust-label">Trip Advisor</span>
        </span>
      </div>

      <div class="tours-trust-badge">
        <span class="tours-trust-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.85A11 11 0 0 0 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.05H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.95l3.66-2.85z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.05l3.66 2.85C6.71 7.3 9.14 5.38 12 5.38z" />
          </svg>
        </span>
        <span>
          <span class="tours-trust-rating">4.9/5</span>
          <span class="tours-trust-label">Google</span>
        </span>
      </div>

      <div class="tours-trust-badge">
        <span class="tours-trust-icon">
          <Image src={wildExcursionsLogo} alt="Wild Excursions" width={240} height={240} quality={100} format="png" class="h-full w-full rounded-full object-cover" loading="lazy" />
        </span>
        <span>
          <span class="tours-trust-rating">4.9/5</span>
          <span class="tours-trust-label">Wild Excursions</span>
        </span>
      </div>
    </div>
  </section>

  <section class="tours-hero bg-black px-4 pb-8 pt-16 text-brand-ivory sm:px-6 lg:px-10 lg:pb-10 lg:pt-24">
    <div class="relative mx-auto max-w-6xl">
      <h1 class="text-4xl font-black uppercase leading-[0.95] sm:text-5xl lg:text-6xl">Choose Your Reserve</h1>
      <p class="mt-4 text-sm leading-relaxed text-white/60 sm:text-base lg:whitespace-nowrap">
        Small-group tiger safaris across Central India's best reserves — real naturalists, transparent pricing, and a day-wise plan before you pay a rupee.
      </p>

      <div class="tours-coupon">
        <div class="tours-coupon-text">
          <p class="tours-coupon-label">Use this code when you enquire</p>
          <p class="tours-coupon-note">&#8377;2,000 off your first safari booking</p>
        </div>
        <button type="button" class="tours-coupon-code" data-coupon-copy data-coupon-value="WILD2000">
          <span data-coupon-code-text>WILD2000</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
            <rect x="7" y="7" width="10" height="10" rx="2" />
            <path d="M4 13V5a2 2 0 0 1 2-2h8" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <section class="bg-black px-4 pb-10 pt-2 text-brand-ivory sm:px-6 lg:px-10 lg:pt-4">
    <div class="mx-auto max-w-6xl">
      <p class="tours-intro" data-intro-text>
        Central India holds some of the last great tiger landscapes left anywhere — from the dry, open forests of{' '}
        <strong>Tadoba</strong> in Maharashtra to the sal-forest meadows of <strong>Kanha</strong>, the high-density
        core zones of <strong>Bandhavgarh</strong>, and the fort-studded lakes of <strong>Ranthambore</strong> in
        Rajasthan. Pick a reserve below to see every tour we run there — each one built by naturalists who work
        that specific zone season after season, in groups capped small enough that you're tracking, not just riding along.
      </p>
      <button type="button" class="tours-intro-toggle" data-intro-toggle>Read More</button>
    </div>
  </section>

  <section class="bg-black px-4 pb-6 text-brand-ivory sm:px-6 lg:px-10">
    <div class="mx-auto max-w-6xl">
      <div class="tours-filter-group">
        <p class="tours-filter-label">Region</p>
        <div class="tours-filter-row" data-region-filters>
          {jungleRegions.map((region) => (
            <button type="button" class="tours-chip" data-region={region} aria-pressed={region === 'All'}>{region}</button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-black px-4 pb-16 text-brand-ivory sm:px-6 lg:px-10 lg:pb-24">
    <div class="mx-auto max-w-6xl">
      <p class="tours-results-count" data-results-count>Showing {uniqueJungles.length} of {uniqueJungles.length} reserves</p>

      <div class="jungle-grid mt-4 grid gap-5 sm:grid-cols-2 xl:grid-cols-3" data-jungle-grid>
        {uniqueJungles.map((j) => (
          <div class="jungle-card group" data-region={j.region}>
            <div class="jungle-card-media">
              <a href={`/tours/${j.jungle}/`} class="absolute inset-0 block">
                <Image src={j.image} alt={`${j.jungleLabel} — ${j.region}`} width={1200} height={900} format="webp" quality={92} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              </a>
              <div class="jungle-card-scrim" aria-hidden="true"></div>
              <span class="jungle-card-region">{j.region}</span>
            </div>

            <div class="jungle-card-content">
              <div class="jungle-card-toprow">
                <span class="jungle-card-tours-pill">{j.tourCount} {j.tourCount === 1 ? 'Tour' : 'Tours'}</span>
                <span class="jungle-card-rating">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#fdcb08" class="h-3.5 w-3.5">
                    <path d="M10 1.5l2.6 5.3 5.9.9-4.25 4.1 1 5.9L10 14.9l-5.25 2.8 1-5.9L1.5 7.7l5.9-.9L10 1.5z" />
                  </svg>
                  {j.avgRating} <span class="jungle-card-review-count">({j.reviewCount})</span>
                </span>
              </div>

              <a href={`/tours/${j.jungle}/`} class="jungle-card-name">{jungleFullNames[j.jungle] ?? j.jungleLabel}</a>

              <div class="jungle-card-details">
                <span><strong>{j.region}</strong></span>
                <span class="jungle-card-details-dot">•</span>
                <span><strong>{j.tourCount}</strong> safari {j.tourCount === 1 ? 'plan' : 'plans'}</span>
              </div>

              <span class="jungle-card-offer">GUIDED SMALL-GROUP SAFARIS</span>

              <div class="jungle-card-price-row">
                <span class="jungle-card-price">&#8377;{j.minPrice.toLocaleString('en-IN')}</span>
                <span class="jungle-card-price-note">/ person onwards</span>
              </div>

              <div class="jungle-card-cta-row">
                <a href="tel:+917755958493" class="jungle-card-call" aria-label="Call Wild Excursions">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                    <path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L184.6 167c13.7-11.1 18.4-30 11.6-46.3l-40-96z"></path>
                  </svg>
                </a>
                <a href={`/tours/${j.jungle}/`} class="jungle-card-view">Explore Tours</a>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="tours-empty hidden" data-empty-state>No reserves match that filter yet — try clearing it.</p>
    </div>
  </section>

  <section class="bg-black px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
    <div class="tours-diwali-card mx-auto max-w-5xl">
      <div class="tours-diwali-left">
        <div class="tours-diwali-heading-row">
          <h2 class="tours-diwali-heading">Up to &#8377;5,000 OFF<br />on selected trips</h2>
          <span class="tours-diwali-badge">&#127775; DIWALI SPECIAL</span>
        </div>
        <p class="tours-diwali-sub">Connect with our destination experts to get exciting discounts.</p>
        <a href="/contact/" class="tours-diwali-cta">Know More About The Deal</a>
      </div>

      <div class="tours-diwali-right">
        <p class="tours-diwali-countdown-label">Hurry &mdash; sale ends in!</p>
        <div class="tours-diwali-countdown" data-diwali-countdown data-countdown-target="2026-11-08T23:59:59">
          <div class="tours-diwali-unit">
            <div class="tours-diwali-digits" data-diwali-days></div>
            <span class="tours-diwali-unit-label">Days</span>
          </div>
          <span class="tours-diwali-colon">:</span>
          <div class="tours-diwali-unit">
            <div class="tours-diwali-digits" data-diwali-hours></div>
            <span class="tours-diwali-unit-label">Hours</span>
          </div>
          <span class="tours-diwali-colon">:</span>
          <div class="tours-diwali-unit">
            <div class="tours-diwali-digits" data-diwali-minutes></div>
            <span class="tours-diwali-unit-label">Minutes</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-black px-4 py-10 sm:px-6 lg:px-10">
    <div class="why-section relative">
      <div class="why-eyebrow flex items-center gap-3">
        <span class="why-eyebrow-line" aria-hidden="true"></span>
        Why Wild Excursions
      </div>
      <h2 class="why-heading mt-4">Why travellers<br />choose us?</h2>

      <div class="why-grid mt-10 grid gap-5 sm:grid-cols-2 lg:mt-14 lg:grid-cols-5">
        {whyCards.map((card) => (
          <div class="why-card">
            <span class="why-card-number" aria-hidden="true">{card.number}</span>
            <span class="why-card-icon">
              {typeof card.icon === 'string'
                ? <Fragment set:html={card.icon} />
                : <Image src={card.icon} alt="" width={128} height={128} quality={100} format="webp" class="why-card-icon-image" />}
            </span>
            <h3 class="why-card-title">{card.title}</h3>
            <p class="why-card-desc">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-black px-4 py-16 text-brand-ivory sm:px-6 lg:px-10 lg:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="tours-eyebrow flex items-center gap-3">
        <span class="tours-eyebrow-line" aria-hidden="true"></span>
        Reviews from our travelers
      </div>
      <h2 class="tours-section-heading mt-4">What it's actually like</h2>

      <ReviewsSection rating={avgRating} reviewCount={totalReviews} testimonials={allTestimonials} galleryImage={uniqueJungles[0].image} />
    </div>
  </section>

  <section class="tours-faq bg-black px-4 py-16 text-brand-ivory sm:px-6 lg:px-10 lg:py-20">
    <div class="mx-auto max-w-3xl">
      <div class="tours-eyebrow flex items-center gap-3">
        <span class="tours-eyebrow-line" aria-hidden="true"></span>
        Have a question?
      </div>
      <h2 class="tours-section-heading mt-4">Frequently asked questions</h2>

      <div class="mt-8">
        <FaqAccordion faqs={allFaqs} />
      </div>
    </div>
  </section>

  <section class="tours-cta bg-black px-4 pb-16 text-center text-brand-ivory sm:px-6 lg:px-10 lg:pb-24">
    <div class="mx-auto max-w-2xl">
      <h2 class="tours-cta-heading">Not sure which reserve is right for you?</h2>
      <p class="mt-3 text-sm text-white/55">Tell us your dates and priorities, and we'll build a route around them.</p>
      <a href="/customize-trip/" class="tours-cta-btn mt-6 inline-block">Customize Your Trip</a>
    </div>
  </section>

  <script>
    function initDiwaliCountdown() {
      const root = document.querySelector<HTMLElement>('[data-diwali-countdown]');
      const daysEl = document.querySelector<HTMLElement>('[data-diwali-days]');
      const hoursEl = document.querySelector<HTMLElement>('[data-diwali-hours]');
      const minutesEl = document.querySelector<HTMLElement>('[data-diwali-minutes]');
      if (!root || !daysEl || !hoursEl || !minutesEl) return;

      const target = new Date(root.dataset.countdownTarget ?? '').getTime();
      if (Number.isNaN(target)) return;

      function renderDigits(container: HTMLElement, value: number) {
        const digits = String(value).padStart(2, '0').split('');
        container.innerHTML = digits.map((digit) => `<span class="tours-diwali-digit">${digit}</span>`).join('');
      }

      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          const section = root!.closest('section');
          if (section) section.style.display = 'none';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        renderDigits(daysEl!, days);
        renderDigits(hoursEl!, hours);
        renderDigits(minutesEl!, minutes);
      }

      tick();
      setInterval(tick, 30000);
    }

    initDiwaliCountdown();

    function initPromoCountdown() {
      const root = document.querySelector<HTMLElement>('[data-countdown-target]');
      const daysEl = document.querySelector<HTMLElement>('[data-countdown-days]');
      const hoursEl = document.querySelector<HTMLElement>('[data-countdown-hours]');
      const minutesEl = document.querySelector<HTMLElement>('[data-countdown-minutes]');
      if (!root || !daysEl || !hoursEl || !minutesEl) return;

      const target = new Date(root.dataset.countdownTarget ?? '').getTime();
      if (Number.isNaN(target)) return;

      function pad(value: number) {
        return String(value).padStart(2, '0');
      }

      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          root!.style.display = 'none';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        daysEl!.textContent = String(days);
        hoursEl!.textContent = pad(hours);
        minutesEl!.textContent = pad(minutes);
      }

      tick();
      setInterval(tick, 30000);
    }

    initPromoCountdown();

    function initHeroCarousel() {
      const root = document.querySelector<HTMLElement>('[data-hero-carousel]');
      if (!root) return;

      const slides = Array.from(root.querySelectorAll<HTMLElement>('.tours-hero-slide'));
      const overlays = Array.from(root.querySelectorAll<HTMLElement>('.tours-hero-overlay'));
      const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-dots] span'));
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-hero-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-hero-next]');
      if (!slides.length) return;

      let active = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      function show(index: number) {
        active = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === active));
        overlays.forEach((overlay, i) => overlay.classList.toggle('is-active', i === active));
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === active));
      }

      function start() {
        stop();
        timer = setInterval(() => show(active + 1), 5000);
      }

      function stop() {
        if (timer) clearInterval(timer);
        timer = null;
      }

      prevBtn?.addEventListener('click', () => {
        show(active - 1);
        start();
      });
      nextBtn?.addEventListener('click', () => {
        show(active + 1);
        start();
      });
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          show(i);
          start();
        });
      });

      start();
    }

    initHeroCarousel();

    function initCouponCopy() {
      const button = document.querySelector<HTMLButtonElement>('[data-coupon-copy]');
      const codeText = document.querySelector<HTMLElement>('[data-coupon-code-text]');
      if (!button || !codeText) return;

      const code = button.dataset.couponValue ?? '';
      let resetTimer: ReturnType<typeof setTimeout> | null = null;

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code);
        } catch {
          // Clipboard API unavailable — the code is still visible for the user to copy manually.
        }
        button.classList.add('is-copied');
        codeText.textContent = 'Copied!';
        if (resetTimer) clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          button.classList.remove('is-copied');
          codeText.textContent = code;
        }, 1800);
      });
    }

    initCouponCopy();

    function initToursIntroToggle() {
      const text = document.querySelector<HTMLElement>('[data-intro-text]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-intro-toggle]');
      if (!text || !toggle) return;

      toggle.addEventListener('click', () => {
        const expanded = text.classList.toggle('is-expanded');
        toggle.textContent = expanded ? 'Read Less' : 'Read More';
      });
    }

    initToursIntroToggle();

    function initJungleFilters() {
      const regionButtons = document.querySelectorAll<HTMLButtonElement>('[data-region-filters] .tours-chip');
      const items = document.querySelectorAll<HTMLElement>('[data-jungle-grid] .jungle-card');
      const resultsCount = document.querySelector<HTMLElement>('[data-results-count]');
      const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
      if (!items.length) return;

      function applyFilter(activeRegion: string) {
        let visible = 0;
        items.forEach((item) => {
          const show = activeRegion === 'All' || item.dataset.region === activeRegion;
          item.classList.toggle('hidden', !show);
          if (show) visible += 1;
        });
        if (resultsCount) resultsCount.textContent = `Showing ${visible} of ${items.length} reserves`;
        emptyState?.classList.toggle('hidden', visible !== 0);
      }

      regionButtons.forEach((button) => {
        button.addEventListener('click', () => {
          regionButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
          applyFilter(button.dataset.region ?? 'All');
        });
      });
    }

    initJungleFilters();
  </script>

  <TripPlannerModal delayMs={10000} source="tours_index_popup" />
</Layout>

