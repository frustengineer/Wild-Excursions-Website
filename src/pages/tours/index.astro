---
import Layout from '../../layouts/Layout.astro';
import TourCard from '../../components/TourCard.astro';
import tours from '../../data/tours.json';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: tours.map((tour, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/tours/${tour.slug}`, Astro.site).toString(),
    name: tour.name,
  })),
};
---

<Layout
  title="All Tours"
  description="Browse all Wild Excursions guided adventure tours — from Amazon rainforest treks to Patagonian glacier expeditions and Sahara desert safaris."
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold sm:text-4xl">All Tours</h1>
    <p class="mt-3 max-w-2xl text-brand-carbon/70 dark:text-brand-ivory/70">
      Small-group guided expeditions to some of the world's wildest places.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tours.map((tour) => <TourCard tour={tour} />)}
    </div>
  </section>
</Layout>
