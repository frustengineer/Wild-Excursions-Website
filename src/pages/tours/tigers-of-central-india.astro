<script>
  document.querySelectorAll('[data-whatsapp-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form as HTMLFormElement);
      const lines = [
        'Hello Wild Excursions, I would like a custom quote for the 14-Day Tigers of Central India itinerary.',
        `Name: ${data.get('name') || ''}`,
        `Email: ${data.get('email') || ''}`,
        `Phone: ${[data.get('phoneCountry'), data.get('phone')].filter(Boolean).join(' ')}`,
        `Travel month: ${data.get('travelMonth') || ''}`,
        `Group size: ${data.get('travellers') || ''}`,
        `Lodge tier: ${data.get('lodgeTier') || '—'}`,
        `Details: ${data.get('message') || '—'}`,
      ];
      window.open(`https://wa.me/917755958493?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
    });
  });
</script>
