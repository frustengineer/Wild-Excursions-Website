export function getStaticPaths() {
  return tours.flatMap((tour) => {
    const departures = generateDepartures(tour);
    return departures.map((departure) => ({
      params: { jungle: tour.jungle, slug: tour.slug, departure: departure.dateSlug },
      props: { tour, departure },
    }));
  });
}

const { tour, departure } = Astro.props;
const discountPct = Math.round(((tour.originalPrice - tour.price) / tour.originalPrice) * 100);
const isPortraitImage = tour.image.height > tour.image.width;
const testimonials = testimonialsByJungle[tour.jungle] ?? [];
const featuredFaqs = allFaqs.filter((faq) => faq.featured);
const parkFaqs = parkFaqsByJungle[tour.jungle] ?? [];
const displayFaqs = parkFaqs.length > 0 ? parkFaqs : featuredFaqs;

const totalReviewsAcrossSite = tours.reduce((sum, t) => sum + t.reviews, 0);
const roundedReviewCount = Math.floor(totalReviewsAcrossSite / 100) * 100;

const trustBadges = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6z" stroke-linejoin="round"/></svg>',
    title: '4.9/5',
    sub: 'Rated across TripAdvisor and Google.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5h16v10H8l-4 4V5z" stroke-linejoin="round"/><path d="M12 8l.9 1.8 2 .2-1.4 1.3.3 2-1.8-1-1.8 1 .3-2-1.4-1.3 2-.2z" stroke-linejoin="round"/></svg>',
    title: `${roundedReviewCount}+`,
    sub: 'Verified guest reviews across our safaris.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z" stroke-linejoin="round"/></svg>',
    title: 'Curated with love',
    sub: 'Handpicked stays and naturalist-led safaris.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2C10.5 19 5 13.5 4 6a2 2 0 0 1 2-3z" stroke-linejoin="round"/></svg>',
    title: '24/7 On-trip assistance',
    sub: 'We’re always there to help, pre, post, and on the trip.',
  },
];


const nearestHubs: Record<string, string> = {
  tadoba: 'Nagpur',
  tipeshwar: 'Nagpur',
  nagzira: 'Nagpur',
  kanha: 'Jabalpur',
  bandhavgarh: 'Jabalpur',
  satpura: 'Bhopal',
  panna: 'Khajuraho',
  ranthambore: 'Sawai Madhopur',
  'umred-karhandla': 'Nagpur',
  'jim-corbett': 'Ramnagar',
  kaziranga: 'Guwahati',
  dudhwa: 'Lucknow',
  kishanpur: 'Lucknow',
  pilibhit: 'Bareilly',
  rajaji: 'Haridwar',
  gir: 'Rajkot',
  manas: 'Guwahati',
  sunderban: 'Kolkata',
  jhalana: 'Jaipur',
  'jawai-bera': 'Jodhpur',
  bor: 'Nagpur',
  'sanjay-dubri': 'Rewa',
  bandipur: 'Mysuru',
};

function buildSampleItinerary(t: Tour, days: number) {
  const entries: NonNullable<Tour['itinerary']> = [];
  const resortLabel = 'your pre-booked resort';
  const hub = nearestHubs[t.jungle];
  const hubLabel = hub ? `${hub} Airport / Railway Station` : 'your nearest airport or railway station';

  for (let day = 1; day <= days; day += 1) {
    if (day === 1) {
      entries.push({
        day,
        title: `Arrival at ${t.jungleLabel} & Evening Safari`,
        details: [
          `Pick-up from ${hubLabel} at the given time in AC cabs.`,
          `Proceed towards ${t.jungleLabel} National Park.`,
          'Check-in to your pre-booked resort.',
          'Get ready for your 1st safari — an exhilarating evening jeep safari (Safari Timing: 2:00 PM – 6:00 PM).',
          'Return to the resort in the evening. Relax with high-tea and dinner.',
        ],
        meals: 'Lunch | High-Tea | Dinner',
        safaris: 1,
        transfer: { from: hubLabel, to: resortLabel },
        stay: { name: resortLabel },
      });
    } else if (day === days) {
      entries.push({
        day,
        title: 'Morning Safari & Departure',
        details: [
          'Wake up early and get ready for your final safari — a morning jeep safari (Safari Timing: 6:00 AM – 10:00 AM).',
          'Return to the resort, freshen up, and check out.',
          `Proceed to ${hubLabel} for your onward journey.`,
        ],
        meals: 'Breakfast',
        safaris: 1,
        transfer: { from: resortLabel, to: hubLabel },
      });
    } else {
      entries.push({
        day,
        title: `Full Day at ${t.jungleLabel} — Morning & Evening Safari`,
        details: [
          'Wake up early and get ready for your morning safari (Safari Timing: 6:00 AM – 10:00 AM), followed by breakfast.',
          'Relax at the resort through midday, with lunch between drives.',
          'Get ready for your evening safari — an exhilarating evening jeep safari (Safari Timing: 2:00 PM – 6:00 PM).',
          'Return to the resort in the evening. Relax with high-tea and dinner.',
        ],
        meals: 'Breakfast | Lunch | High-Tea | Dinner',
        safaris: 2,
      });
    }
  }

  return entries;
}

const baseDays = parseInt(tour.duration, 10) || 3;
const defaultDisplayDays = baseDays;

const itineraryVariants = [2, 3, 4, 5].map((days) => {
  const items = buildFixedTourItinerary(tour, days);
  return { days, items, isReal: true };
});
const currentItinerary = itineraryVariants.find((v) => v.days === defaultDisplayDays) ?? itineraryVariants[0];
const itineraryDays = currentItinerary.items;
const hasRealItinerary = currentItinerary.isReal;

const seasonThemes: Record<string, { icon: string; from: string; to: string; text: string }> = {
  Winter: { icon: '&#10052;&#65039;', from: '#3b82f6', to: '#93c5fd', text: '#171717' },
  Summer: { icon: '&#9728;&#65039;', from: '#c2410c', to: '#fbbf24', text: '#171717' },
  Monsoon: { icon: '&#127783;&#65039;', from: '#065f46', to: '#22c55e', text: '#ffffff' },
};
const seasonTheme = seasonThemes[tour.bestSeason] ?? { icon: '&#127775;', from: '#cfa100', to: '#fdcb08', text: '#171717' };

const displayPrice = departure.price;
const displayOriginalPrice = departure.originalPrice;
const durationDays = parseInt(tour.duration, 10) || 3;
const defaultDurationLabel = `${durationDays}D/${durationDays - 1}N`;
const departureSafariCount = (durationDays - 1) * 2;
const fixedTourSafariCount = tour.itinerary?.reduce((total, day) => total + day.safaris, 0) || departureSafariCount;

const tripIcons = {
