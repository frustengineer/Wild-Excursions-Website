  <script>
    import Swiper from 'swiper';
    import { Autoplay, Pagination } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/pagination';

    function initHeroSlider() {
      const el = document.querySelector<HTMLElement>('.tour-post-hero-slider');
      if (!el) return;

      new Swiper(el, {
        modules: [Autoplay, Pagination],
        loop: true,
        autoplay: {
          delay: 4000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        pagination: {
          el: '.tour-post-hero-pagination',
          clickable: true,
        },
      });
    }

    initHeroSlider();

    document.querySelectorAll<HTMLElement>('.tour-post-wildlife-slider').forEach((el) => {
      new Swiper(el, {
        modules: [Autoplay],
        loop: true,
        allowTouchMove: false,
        autoplay: { delay: 2500, disableOnInteraction: false },
      });
    });

    function initItineraryHeroSlider() {
      const hero = document.querySelector<HTMLElement>('[data-hero-slider]');
      const track = hero?.querySelector<HTMLElement>('[data-hero-track]');
      const prevBtn = hero?.querySelector<HTMLElement>('[data-hero-prev]');
      const nextBtn = hero?.querySelector<HTMLElement>('[data-hero-next]');
      const dots = hero?.querySelectorAll<HTMLElement>('[data-hero-dot]');
      if (!hero || !track || !prevBtn || !nextBtn || !dots || !dots.length) return;

      const total = dots.length;
      let current = 0;
      let isVisible = false;
      let autoplayTimer: number | undefined;

      const render = () => {
        track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
      };

      const stopAutoplay = () => window.clearInterval(autoplayTimer);
      const startAutoplay = () => {
        stopAutoplay();
        if (total < 2 || !isVisible || document.hidden) return;
        autoplayTimer = window.setInterval(() => {
          current = (current + 1) % total;
          render();
        }, 2000);
      };

      prevBtn.addEventListener('click', () => {
        current = current === 0 ? total - 1 : current - 1;
        render();
        startAutoplay();
      });

      nextBtn.addEventListener('click', () => {
        current = current === total - 1 ? 0 : current + 1;
        render();
        startAutoplay();
      });

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          current = i;
          render();
          startAutoplay();
        });
      });

      hero.addEventListener('pointerenter', stopAutoplay);
      hero.addEventListener('pointerleave', startAutoplay);
      hero.addEventListener('pointerdown', stopAutoplay);
      hero.addEventListener('pointerup', startAutoplay);
      hero.addEventListener('pointercancel', startAutoplay);
      document.addEventListener('visibilitychange', startAutoplay);

      new IntersectionObserver(([entry]) => {
        isVisible = entry.isIntersecting;
        if (isVisible) startAutoplay();
        else stopAutoplay();
      }, { threshold: 0.25 }).observe(hero);
    }

    initItineraryHeroSlider();

    function initDiwaliCountdown() {
      const root = document.querySelector<HTMLElement>('[data-diwali-countdown]');
      const daysEl = document.querySelector<HTMLElement>('[data-diwali-days]');
      const hoursEl = document.querySelector<HTMLElement>('[data-diwali-hours]');
      const minutesEl = document.querySelector<HTMLElement>('[data-diwali-minutes]');
      if (!root || !daysEl || !hoursEl || !minutesEl) return;

      const target = new Date(root.dataset.countdownTarget ?? '').getTime();
      if (Number.isNaN(target)) return;

      function renderDigits(container: HTMLElement, value: number) {
        const digits = String(value).padStart(2, '0').split('');
        container.innerHTML = digits.map((digit) => `<span class="tour-post-diwali-digit">${digit}</span>`).join('');
      }

      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          const card = root!.closest('.tour-post-diwali-card');
          if (card) (card as HTMLElement).style.display = 'none';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        renderDigits(daysEl!, days);
        renderDigits(hoursEl!, hours);
        renderDigits(minutesEl!, minutes);
      }

      tick();
      setInterval(tick, 30000);
    }

    initDiwaliCountdown();

    function initPromoCountdown() {
      const root = document.querySelector<HTMLElement>('[data-countdown-target]');
      const daysEl = document.querySelector<HTMLElement>('[data-countdown-days]');
      const hoursEl = document.querySelector<HTMLElement>('[data-countdown-hours]');
      const minutesEl = document.querySelector<HTMLElement>('[data-countdown-minutes]');
      if (!root || !daysEl || !hoursEl || !minutesEl) return;

      const target = new Date(root.dataset.countdownTarget ?? '').getTime();
      if (Number.isNaN(target)) return;

      function pad(value: number) {
        return String(value).padStart(2, '0');
      }

      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          root!.style.display = 'none';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        daysEl!.textContent = String(days);
        hoursEl!.textContent = pad(hours);
        minutesEl!.textContent = pad(minutes);
      }

      tick();
      setInterval(tick, 30000);
    }

    initPromoCountdown();

    function initTourEnquireForm() {
      const form = document.querySelector<HTMLFormElement>('[data-tour-enquire-form]');
      const success = document.querySelector<HTMLElement>('[data-tour-form-success]');
      if (!form || !success) return;

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        success.classList.add('is-visible');
        form.reset();
      });
    }

    initTourEnquireForm();

    function initDescriptionToggle() {
      const block = document.querySelector<HTMLElement>('[data-description-block]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-description-toggle]');
      if (!block || !toggle) return;

      toggle.addEventListener('click', () => {
        const expanded = block.classList.toggle('is-expanded');
        toggle.textContent = expanded ? 'Read Less' : 'Read More';
      });
    }

    initDescriptionToggle();

    function initRelatedSliders() {
      document.querySelectorAll<HTMLElement>('[data-related-slider]').forEach((slider) => {
        const track = slider.querySelector<HTMLElement>('[data-related-track]');
        const previous = slider.querySelector<HTMLButtonElement>('[data-related-prev]');
        const next = slider.querySelector<HTMLButtonElement>('[data-related-next]');
        if (!track) return;

        const move = (direction: number) => {
          const slide = track.querySelector<HTMLElement>('.tour-post-related-slide');
          const gap = Number.parseFloat(getComputedStyle(track).gap) || 20;
          track.scrollBy({ left: direction * ((slide?.offsetWidth ?? track.clientWidth * 0.82) + gap), behavior: 'smooth' });
        };

        previous?.addEventListener('click', () => move(-1));
        next?.addEventListener('click', () => move(1));
      });
    }

    initRelatedSliders();

    function initCallbackForm() {
      const toggle = document.querySelector<HTMLButtonElement>('[data-callback-toggle]');
      const dialog = document.querySelector<HTMLDialogElement>('[data-callback-dialog]');
      const close = dialog?.querySelector<HTMLButtonElement>('[data-callback-close]');
      const form = dialog?.querySelector<HTMLFormElement>('[data-callback-form]');
      const success = form?.querySelector<HTMLElement>('[data-callback-success]');
      if (!toggle || !dialog || !form) return;

      toggle.addEventListener('click', () => dialog.showModal());
      close?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        success?.classList.add('is-visible');
        form.reset();
      });
    }

    initCallbackForm();


    function initItineraryEnquiry() {
      const dialog = document.querySelector<HTMLDialogElement>('[data-itinerary-enquiry-dialog]');
      const open = document.querySelector<HTMLButtonElement>('[data-open-itinerary-enquiry]');
      const close = dialog?.querySelector<HTMLButtonElement>('[data-close-itinerary-enquiry]');
      const form = dialog?.querySelector<HTMLFormElement>('[data-itinerary-enquiry-form]');
      const success = dialog?.querySelector<HTMLElement>('[data-itinerary-enquiry-success]');
      if (!dialog || !open) return;
      open.addEventListener('click', () => dialog.showModal());
      close?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      form?.addEventListener('submit', (event) => { event.preventDefault(); success?.classList.add('is-visible'); form.reset(); });
    }

    initItineraryEnquiry();
  </script>

  <TripPlannerModal delayMs={10000} source="departure_itinerary_popup" />
