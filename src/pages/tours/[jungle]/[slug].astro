---
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import TourCard from '../../../components/TourCard.astro';
import ReviewsSection from '../../../components/ReviewsSection.astro';
import { tours, type Tour } from '../../../data/tours';
import allFaqs from '../../../data/faqs.json';
import { testimonialsByJungle } from '../../../data/testimonials';
import { parkFaqsByJungle } from '../../../data/parkFaqs';
import { generateDepartures } from '../../../utils/departures';

export function getStaticPaths() {
  return tours.map((tour) => ({
    params: { jungle: tour.jungle, slug: tour.slug },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const discountPct = Math.round(((tour.originalPrice - tour.price) / tour.originalPrice) * 100);
const isPortraitImage = tour.image.height > tour.image.width;
const testimonials = Object.values(testimonialsByJungle).flat();
const featuredFaqs = allFaqs.filter((faq) => faq.featured);
const parkFaqs = parkFaqsByJungle[tour.jungle] ?? [];
const displayFaqs = parkFaqs.length > 0 ? parkFaqs : featuredFaqs;

const totalReviewsAcrossSite = tours.reduce((sum, t) => sum + t.reviews, 0);
const roundedReviewCount = Math.floor(totalReviewsAcrossSite / 100) * 100;

const trustBadges = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6z" stroke-linejoin="round"/></svg>',
    title: '4.9/5',
    sub: 'Rated across TripAdvisor and Google.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5h16v10H8l-4 4V5z" stroke-linejoin="round"/><path d="M12 8l.9 1.8 2 .2-1.4 1.3.3 2-1.8-1-1.8 1 .3-2-1.4-1.3 2-.2z" stroke-linejoin="round"/></svg>',
    title: `${roundedReviewCount}+`,
    sub: 'Verified guest reviews across our safaris.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z" stroke-linejoin="round"/></svg>',
    title: 'Curated with love',
    sub: 'Handpicked stays and naturalist-led safaris.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2C10.5 19 5 13.5 4 6a2 2 0 0 1 2-3z" stroke-linejoin="round"/></svg>',
    title: '24/7 On-trip assistance',
    sub: 'We’re always there to help, pre, post, and on the trip.',
  },
];


const nearestHubs: Record<string, string> = {
  tadoba: 'Nagpur',
  tipeshwar: 'Nagpur',
  nagzira: 'Nagpur',
  kanha: 'Jabalpur',
  bandhavgarh: 'Jabalpur',
  satpura: 'Bhopal',
  panna: 'Khajuraho',
  ranthambore: 'Sawai Madhopur',
};

function buildSampleItinerary(t: Tour, days: number) {
  const entries: NonNullable<Tour['itinerary']> = [];
  const resortLabel = 'your pre-booked resort';
  const hub = nearestHubs[t.jungle];
  const hubLabel = hub ? `${hub} Airport / Railway Station` : 'your nearest airport or railway station';

  for (let day = 1; day <= days; day += 1) {
    if (day === 1) {
      entries.push({
        day,
        title: `Arrival at ${t.jungleLabel} & Evening Safari`,
        details: [
          `Pick-up from ${hubLabel} at the given time in AC cabs.`,
          `Proceed towards ${t.jungleLabel} National Park.`,
          'Check-in to your pre-booked resort.',
          'Get ready for your 1st safari — an exhilarating evening jeep safari (Safari Timing: 2:00 PM – 6:00 PM).',
          'Return to the resort in the evening. Relax with high-tea and dinner.',
        ],
        meals: 'Lunch | High-Tea | Dinner',
        safaris: 1,
        transfer: { from: hubLabel, to: resortLabel },
        stay: { name: resortLabel },
      });
    } else if (day === days) {
      entries.push({
        day,
        title: 'Morning Safari & Departure',
        details: [
          'Wake up early and get ready for your final safari — a morning jeep safari (Safari Timing: 6:00 AM – 10:00 AM).',
          'Return to the resort, freshen up, and check out.',
          `Proceed to ${hubLabel} for your onward journey.`,
        ],
        meals: 'Breakfast',
        safaris: 1,
        transfer: { from: resortLabel, to: hubLabel },
      });
    } else {
      entries.push({
        day,
        title: `Full Day at ${t.jungleLabel} — Morning & Evening Safari`,
        details: [
          'Wake up early and get ready for your morning safari (Safari Timing: 6:00 AM – 10:00 AM), followed by breakfast.',
          'Relax at the resort through midday, with lunch between drives.',
          'Get ready for your evening safari — an exhilarating evening jeep safari (Safari Timing: 2:00 PM – 6:00 PM).',
          'Return to the resort in the evening. Relax with high-tea and dinner.',
        ],
        meals: 'Breakfast | Lunch | High-Tea | Dinner',
        safaris: 2,
      });
    }
  }

  return entries;
}

const baseDays = parseInt(tour.duration, 10) || 3;
const defaultDisplayDays = 3;

const itineraryVariants = [2, 3, 4, 5].map((days) => {
  const isReal = days === baseDays && Boolean(tour.itinerary && tour.itinerary.length > 0);
  const items = isReal ? (tour.itinerary as NonNullable<Tour['itinerary']>) : buildSampleItinerary(tour, days);
  return { days, items, isReal };
});
const currentItinerary = itineraryVariants.find((v) => v.days === defaultDisplayDays) ?? itineraryVariants[0];
const itineraryDays = currentItinerary.items;
const hasRealItinerary = currentItinerary.isReal;

const seasonThemes: Record<string, { icon: string; from: string; to: string; text: string }> = {
  Winter: { icon: '&#10052;&#65039;', from: '#3b82f6', to: '#93c5fd', text: '#171717' },
  Summer: { icon: '&#9728;&#65039;', from: '#c2410c', to: '#fbbf24', text: '#171717' },
  Monsoon: { icon: '&#127783;&#65039;', from: '#065f46', to: '#22c55e', text: '#ffffff' },
};
const seasonTheme = seasonThemes[tour.bestSeason] ?? { icon: '&#127775;', from: '#cfa100', to: '#fdcb08', text: '#171717' };

const fixedCost = tour.price * 0.4;
const perDayCost = (tour.price * 0.6) / baseDays;
const fixedCostOriginal = tour.originalPrice * 0.4;
const perDayCostOriginal = (tour.originalPrice * 0.6) / baseDays;
const durationOptions = [2, 3, 4, 5].map((days) => {
  const price = Math.round((fixedCost + perDayCost * days) / 100) * 100;
  const originalPrice = Math.round((fixedCostOriginal + perDayCostOriginal * days) / 100) * 100;
  const rating = Math.max(4, Math.round((tour.rating - Math.abs(days - 3) * 0.1) * 10) / 10);
  const safariCount = (days - 1) * 2;
  return {
    days,
    price,
    originalPrice,
    savings: originalPrice - price,
    rating,
    safariCount,
    isCurrent: days === defaultDisplayDays,
  };
});

const currentDurationOption = durationOptions.find((option) => option.isCurrent) ?? durationOptions[0];

const SAFARI_UNIT_PRICE = 6500;
const initialSafariCost = currentDurationOption.safariCount * SAFARI_UNIT_PRICE;
const displayPrice = currentDurationOption.price + initialSafariCost;
const displayOriginalPrice = currentDurationOption.originalPrice + initialSafariCost;
const defaultDurationLabel = `${defaultDisplayDays}D/${defaultDisplayDays - 1}N`;


const stayOffsets: Record<string, number> = { Deluxe: -5000, 'Semi-Luxury': 0, Luxury: 5000 };

const tripIcons = {
  transfer:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 13l1.5-4.5A2 2 0 0 1 6.4 7h11.2a2 2 0 0 1 1.9 1.5L21 13" stroke-linecap="round" stroke-linejoin="round"/><rect x="3" y="13" width="18" height="5" rx="1.5"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="16.5" cy="18.5" r="1.5"/></svg>',
  stay:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 11l8-7 8 7" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 10v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-9" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  food:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3v7a2 2 0 0 0 4 0V3M9 10v11" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 3c-1.5 0-2.5 2-2.5 4.5S14.5 12 16 12v9" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  safari:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="7" cy="16" r="3"/><circle cx="17" cy="16" r="3"/><path d="M9.5 14l1-6a2 2 0 0 1 2-1.5h1a2 2 0 0 1 2 1.5l1 6" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 8h4" stroke-linecap="round"/></svg>',
};
const stayCategories = ['Deluxe', 'Semi-Luxury', 'Luxury'];
const defaultStayCategory = 'Semi-Luxury';

const serviceIcons = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 16v-4l2-5h10l3 5h1a2 2 0 0 1 2 2v2" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 16h16" stroke-linecap="round"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>',
    label: 'Transfers Included',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3.5 11l8.5-7 8.5 7" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 9.5V20a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V9.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 21v-6h4v6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    label: 'Stay Included',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6.5 3v7a2.5 2.5 0 0 0 5 0V3M9 10v11" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 3c-1.4 1.4-2 3-2 5s.6 3.6 2 5v8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    label: 'Meals Included',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6.5" cy="14" r="3.5"/><circle cx="17.5" cy="14" r="3.5"/><path d="M10 14h4M8 10l2-6h4l2 6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    label: 'Naturalist Guide Included',
  },
];

const inclusions = [
  'Accommodation on a triple-sharing basis in AC rooms',
  'All meals — breakfast, lunch, high-tea, and dinner — during your stay',
  ...tour.highlights.filter((h) => /jeep|drive|safari|walking|boat/i.test(h)),
  'Roundtrip airport or station transfers and all local gate transfers in AC cabs',
  'All forest permits, gypsy fee, driver fee, and guide charges',
  'Applicable 5% GST',
];

const exclusions = [
  'Camera or lens charges, if any',
  'Tips to guides and drivers',
  'Extra orders of meals, snacks, or drinks',
  'Any train or flight tickets to and from your home city',
  'Cost differences arising from mishaps, political unrest, natural calamities, or changes in forest fees or permits',
  'Anything not mentioned in the list of inclusions',
];

const thingsToCarry = [
  'Original ID proof — Aadhaar, PAN, Driving License, or Passport',
  'Prescription medicines, a basic first-aid kit, insect repellent, and sunscreen',
  'Light, comfortable clothing in neutral colors — khaki, beige, olive green',
  'A light jacket or sweater for early morning and evening safaris',
  'Sports shoes or other comfortable, sturdy footwear',
  'Sunglasses and a scarf or balaclava',
  'Camera, lenses, memory cards, charger, and spare batteries',
  'A bean bag or monopod for camera stability',
  'Binoculars for wildlife viewing',
  'A torch or flashlight for use after dark',
];

const knowBeforeYouGo = [
  "Connectivity: mobile network is patchy inside most reserves. Let people know you'll be off-grid for the length of each drive.",
  'Gate timings: entry and exit times are set and enforced by the forest department, not by us. Arrive at the meeting point on time so the whole group isn\'t held up.',
  "On the road: safari tracks are unpaved and can be bumpy for a few hours at a stretch. It's a real jeep safari, not a sightseeing coach.",
  'Rates: quoted pricing can change with the season or a change in group size — always confirmed with you before you pay anything.',
  'Wildlife sightings are never guaranteed — our naturalists and drivers use their experience to give you the best possible chance.',
  'Cancellations & rescheduling: refunds are based on how far ahead of departure you cancel, from 100% (120+ days out) down to no refund inside 30 days. Full terms are on our Terms & Conditions page.',
];

const relatedSuggestions = [
  ...generateDepartures(tour).slice(0, 3).map((departure) => ({ tour, departure })),
  ...tours.filter((candidate) => candidate.jungle !== tour.jungle).slice(0, 5).map((relatedTour) => ({ tour: relatedTour })),
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: tour.name,
  description: tour.description,
  image: new URL(tour.image.src, Astro.site).toString(),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: tour.rating,
    reviewCount: tour.reviews,
  },
  offers: {
    '@type': 'Offer',
    price: tour.price,
    priceCurrency: 'INR',
    availability: 'https://schema.org/InStock',
    url: Astro.url.toString(),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Tours', item: new URL('/tours', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: tour.jungleLabel, item: new URL(`/tours/${tour.jungle}`, Astro.site).toString() },
    { '@type': 'ListItem', position: 4, name: tour.name, item: Astro.url.toString() },
  ],
};
---

<Layout title={tour.name} description={tour.shortDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="tours-promo-bar fixed inset-x-3 z-50 mx-auto flex w-auto max-w-[1640px] sm:inset-x-6">
    <p>Limited Time: Save &#8377;2,000 on your first booking &mdash; use code <strong>WILD2000</strong> &#127942;</p>
    <div class="tours-promo-countdown" data-countdown-target="2026-08-14T23:59:59">
      <span data-countdown-days>10</span>days : <span data-countdown-hours>04</span>hrs : <span data-countdown-minutes>36</span>min
    </div>
  </div>

  <article class="tour-post bg-black pb-24 text-brand-ivory lg:pb-16">
    <div class="px-4 sm:px-6 sm:pt-6 lg:px-10 lg:pt-8">
      <div class="mx-auto max-w-6xl">
        <a href="/tours" class="tour-post-crumb">Tours</a><span class="tour-post-crumb-sep">/</span><a href={`/tours/${tour.jungle}`} class="tour-post-crumb">{tour.jungleLabel}</a><span class="tour-post-crumb-sep">/</span><span class="tour-post-crumb-current">{tour.name}</span>
      </div>
    </div>

    <div class="px-4 sm:px-6 lg:px-10">
      <div class="mx-auto max-w-6xl">
        <div class="tour-post-gallery" data-lightbox-group>
          <div class="tour-post-gallery-main">
            <div class="tour-post-hero-slider swiper">
              <div class="swiper-wrapper">
                {[0, 1, 2].map((i) => (
                  <div class="swiper-slide">
                    <Image src={tour.image} alt={`${tour.name} — ${tour.region}`} width={1200} height={900} format="webp" quality={85} class:list={['h-full w-full object-cover', { 'object-top': isPortraitImage }]} loading={i === 0 ? 'eager' : 'lazy'} />
                  </div>
                ))}
              </div>
              <div class="tour-post-hero-pagination"></div>
            </div>

            <div class="tour-post-gallery-mobile-thumbs">
              <div class="tour-post-gallery-mobile-thumb">
                <Image src={tour.image} alt="" width={160} height={160} format="webp" quality={70} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
              </div>
              <div class="tour-post-gallery-mobile-thumb">
                <Image src={tour.image} alt="" width={160} height={160} format="webp" quality={70} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
              </div>
              <button type="button" class="tour-post-gallery-mobile-thumb tour-post-gallery-mobile-thumb--more" data-open-lightbox aria-label={`View all ${tour.reviews} photos`}>
                <Image src={tour.image} alt="" width={160} height={160} format="webp" quality={70} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
                <span>View All</span>
              </button>
            </div>
          </div>
          <div class="tour-post-gallery-side">
            <div class="tour-post-gallery-tile">
              <Image src={tour.image} alt="" width={500} height={400} format="webp" quality={78} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
              <span>{tour.jungleLabel}</span>
            </div>
            <div class="tour-post-gallery-tile">
              <Image src={tour.image} alt="" width={500} height={400} format="webp" quality={78} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
              <span>Stay</span>
            </div>
            <div class="tour-post-gallery-tile">
              <Image src={tour.image} alt="" width={500} height={400} format="webp" quality={78} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
              <span>Sightseeing</span>
            </div>
            <div class="tour-post-gallery-tile tour-post-gallery-tile--more">
              <Image src={tour.image} alt="" width={500} height={400} format="webp" quality={78} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
              <button type="button" class="tour-post-gallery-more-btn" data-open-lightbox>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><rect x="2.5" y="4" width="15" height="12" rx="2" /><circle cx="7" cy="9" r="1.5" /><path d="M2.5 14l4-4 3 3 3.5-3.5 4 4.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                View All Images
              </button>
            </div>
          </div>
        </div>

        <div class="tour-post-layout mt-6 lg:mt-8">
          <div class="tour-post-body">
            <p class="tour-post-meta">{tour.jungleLabel} &middot; {tour.region}</p>
            <h1 class="tour-post-title mt-2">{tour.name}</h1>

            <div class="tour-post-quickfacts mt-3">
              <span class="tour-post-duration-badge" data-duration-display>{defaultDurationLabel}</span>
              <span class="tour-post-hero-rating">&#9733; <span data-rating-display>{currentDurationOption.rating}</span> <span>({tour.reviews} reviews)</span></span>
            </div>

            <div class="tour-post-services mt-6">
              {serviceIcons.map((s) => (
                <span class="tour-post-service">
                  <span set:html={s.icon} /> <span>{s.label}</span>
                </span>
              ))}
            </div>

            <div class="tour-post-duration-picker mt-6">
              <p class="tour-post-duration-picker-heading">Choose Trip Duration</p>
              <div class="tour-post-duration-options">
                {durationOptions.map((option) => (
                  <div
                    class:list={['tour-post-duration-card', { 'is-current': option.isCurrent }]}
                    data-duration-days={option.days}
                    data-duration-price={option.price}
                    data-duration-original={option.originalPrice}
                    data-duration-savings={option.savings}
                    data-duration-rating={option.rating}
                    data-duration-safari={option.safariCount}
                  >
                    <div class="tour-post-duration-img">
                      <Image src={tour.image} alt="" width={300} height={220} format="webp" quality={70} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
                      <span>{option.days} days</span>
                    </div>
                    <p class="tour-post-duration-label">Starting From</p>
                    <p class="tour-post-duration-price">&#8377;{option.price.toLocaleString('en-IN')}</p>
                  </div>
                ))}
              </div>
              <p class="tour-post-duration-note">Estimated pricing — confirm exact details when you enquire.</p>
            </div>

            <div class="tour-post-stay-picker mt-6">
              <p class="tour-post-duration-picker-heading">Stay Category</p>
              <div class="tour-post-stay-options" data-stay-options>
                {stayCategories.map((category) => (
                  <button
                    type="button"
                    class:list={['tour-post-stay-chip', { 'is-current': category === defaultStayCategory }]}
                    data-stay-category={category}
                    data-stay-offset={stayOffsets[category]}
                  >
                    {category}
                    <span class="tour-post-stay-check">&#10003;</span>
                  </button>
                ))}
              </div>
              <p class="tour-post-duration-note">Prices shown are estimated — confirm exact details for the original price when you enquire.</p>
            </div>

            <div class="tour-post-safari-picker mt-6">
              <p class="tour-post-duration-picker-heading">No. of Jeep Safaris</p>
              <div class="tour-post-stay-options" data-safari-options>
                {Array.from({ length: currentDurationOption.safariCount }, (_, i) => i + 1).map((n) => (
                  <button
                    type="button"
                    class:list={['tour-post-stay-chip', 'tour-post-safari-chip', { 'is-current': n === currentDurationOption.safariCount }]}
                    data-safari-count={n}
                  >
                    {n} Jeep Safari{n > 1 ? 's' : ''}
                    <span class="tour-post-stay-check">&#10003;</span>
                  </button>
                ))}
              </div>
              <p class="tour-post-duration-note" data-safari-note>Choose how many jeep safaris you'd like — up to {currentDurationOption.safariCount} on this trip length. Each safari is &#8377;6,500.</p>
            </div>

            <div class="tour-post-description-block mt-6" data-description-block>
              <p class="tour-post-excerpt">{tour.shortDescription}</p>

              <p class="mt-6">{tour.description}</p>
            </div>
            <button type="button" class="tour-post-description-toggle" data-description-toggle>Read More</button>

