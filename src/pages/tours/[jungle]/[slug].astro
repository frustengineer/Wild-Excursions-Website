  <dialog class="tour-post-enquiry-dialog" data-itinerary-enquiry-dialog>
    <span class="tour-post-enquiry-handle" aria-hidden="true"></span>
    <button type="button" class="tour-post-enquiry-close" data-close-itinerary-enquiry aria-label="Close enquiry form">×</button>
    <h2>Connect with a Travel Expert</h2>
    <p>Share your trip preferences and our safari expert will contact you.</p>
    <div class="tour-post-enquiry-summary"><strong>{tour.name}</strong><span><b data-price-display>&#8377;<span data-price-value>{displayPrice.toLocaleString('en-IN')}</span></b> estimated package</span></div>
    <form method="post" data-itinerary-enquiry-form>
      <input name="name" type="text" placeholder="Full Name *" required />
      <input name="email" type="email" placeholder="Email *" required />
      <div class="tour-post-enquiry-phone"><span>+91</span><input name="phone" type="tel" placeholder="Your Phone" pattern="[0-9]{10}" required /></div>
      <div class="tour-post-enquiry-row"><input name="date" type="date" aria-label="Preferred travel date" required /><input name="travellers" type="number" min="1" placeholder="Travellers *" required /></div>
      <button type="submit">Connect with an Expert</button>
      <p class="tour-post-enquiry-success" data-itinerary-enquiry-success>Thanks — our safari expert will call you shortly.</p>
    </form>
    <div class="tour-post-enquiry-trust"><span></span><b>Trusted by Travellers</b><span></span></div>
    <div class="tour-post-enquiry-badges">
      <div><span class="tour-post-enquiry-logo"><Image src={tripAdvisorLogo} alt="Tripadvisor" width={160} height={160} quality={100} format="png" /></span><b>4.8/5</b><small>TRIP ADVISOR</small></div>
      <div><svg class="trust-google" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" /><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.85A11 11 0 0 0 12 23z" /><path fill="#FBBC05" d="M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.05H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.95l3.66-2.85z" /><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.05l3.66 2.85C6.71 7.3 9.14 5.38 12 5.38z" /></svg><b>4.9/5</b><small>GOOGLE</small></div>
      <div><span class="tour-post-enquiry-logo"><Image src={wildExcursionsLogo} alt="Wild Excursions" width={160} height={160} quality={100} format="png" /></span><b>4.9/5</b><small>WILD EXCURSIONS</small></div>
    </div>
  </dialog>

  <script>
    import Swiper from 'swiper';
    import { Autoplay, Pagination } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/pagination';

    function initHeroSlider() {
      const el = document.querySelector<HTMLElement>('.tour-post-hero-slider');
      if (!el) return;

      new Swiper(el, {
        modules: [Autoplay, Pagination],
        loop: true,
        autoplay: {
          delay: 4000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        pagination: {
          el: '.tour-post-hero-pagination',
          clickable: true,
        },
      });
    }

    initHeroSlider();

    document.querySelectorAll<HTMLElement>('.tour-post-wildlife-slider').forEach((el) => {
      new Swiper(el, {
        modules: [Autoplay],
        loop: true,
        allowTouchMove: false,
        autoplay: { delay: 2500, disableOnInteraction: false },
      });
    });

    function initTripPickers() {
      const durationCards = document.querySelectorAll<HTMLElement>('.tour-post-duration-card');
      const stayChips = document.querySelectorAll<HTMLElement>('[data-stay-options] .tour-post-stay-chip');
      const safariOptionsEl = document.querySelector<HTMLElement>('[data-safari-options]');
      if (!durationCards.length && !stayChips.length) return;

      const priceValueEls = document.querySelectorAll<HTMLElement>('[data-price-value]');
      const originalEls = document.querySelectorAll<HTMLElement>('[data-price-original-display]');
      const priceVeils = document.querySelectorAll<HTMLElement>('[data-price-veil]');
      const priceTriggers = document.querySelectorAll<HTMLElement>('[data-get-price-trigger]');
      const saveBadgeEl = document.querySelector<HTMLElement>('[data-save-badge-display]');
      const durationEl = document.querySelector<HTMLElement>('[data-duration-display]');
      const ratingEls = document.querySelectorAll<HTMLElement>('[data-rating-display]');

      const formatINR = (value: number) => `₹${value.toLocaleString('en-IN')}`;
      const jungle = document.querySelector<HTMLElement>('[data-tour-jungle]')?.dataset.tourJungle ?? '';
      const safariRatesByJungle: Record<string, [number, number]> = {
        kaziranga: [7000, 8000], tadoba: [8000, 9000], tipeshwar: [6500, 7500],
        'umred-karhandla': [6500, 7500], nagzira: [6500, 7500], bor: [6500, 7500],
        kanha: [9000, 10000], bandhavgarh: [9000, 10000], panna: [9000, 10000], pench: [9000, 10000],
        satpura: [9000, 10000], 'sanjay-dubri': [9000, 10000], 'jim-corbett': [9000, 10000], ranthambore: [12000, 14000],
      };
      const safariRates = safariRatesByJungle[jungle] ?? [7000, 8000];
      // Per-occupancy resort rates (per person, per night) from the customised tour rate
      // sheet — rooms are double-occupancy; an odd adult out or a child aged 6-12 is an
      // extra bed in an existing room rather than a whole additional room. Kids under 6
      // are complimentary.
      const OCCUPANCY_RATES: Record<string, { single: number; double: number; extraAdult: number; kids6to12: number }> = {
        Deluxe: { single: 4800, double: 6000, extraAdult: 2500, kids6to12: 2000 },
        'Semi-Luxury': { single: 7000, double: 9000, extraAdult: 3000, kids6to12: 2250 },
        Luxury: { single: 14200, double: 18800, extraAdult: 5800, kids6to12: 4200 },
      };
      const dateInputs = document.querySelectorAll<HTMLInputElement>('input[name="date"]');
      const travellerInputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name="travellers"]');
      const pricingDate = document.querySelector<HTMLInputElement>('[data-pricing-date]');
      const pricingTravellers = document.querySelector<HTMLInputElement>('[data-pricing-travellers]');
      const guestSelector = document.querySelector<HTMLElement>('[data-guest-selector]');
      const guestTrigger = guestSelector?.querySelector<HTMLButtonElement>('[data-guest-trigger]');
      const guestPanel = guestSelector?.querySelector<HTMLElement>('[data-guest-panel]');
      const guestSummary = guestSelector?.querySelector<HTMLElement>('[data-guest-summary]');
      const guestCounts: Record<string, number> = { adults: 0, children: 0, infants: 0 };
      const safariCountLabel = document.querySelector<HTMLElement>('[data-safari-count-label]');
      const inclusionSafariCountLabel = document.querySelector<HTMLElement>('[data-inclusion-safari-count]');
      const transferChips = document.querySelectorAll<HTMLElement>('[data-transfer-options] .tour-post-stay-chip');

      // Nothing is pre-selected — every picker (duration, stay, safaris, transfers)
      // starts blank and the visitor must choose explicitly before a price shows.
      const currentDurationCard = document.querySelector<HTMLElement>('.tour-post-duration-card.is-current');
      const currentStayChip = document.querySelector<HTMLElement>('[data-stay-options] .tour-post-stay-chip.is-current');
      const currentSafariChip = document.querySelector<HTMLElement>('[data-safari-options] .tour-post-safari-chip.is-current');

      const state: {
        durationDays: number;
        estimatedPrice: number;
        stayRate: number;
        stayCategory: string;
        safariCount: number;
        travelDate: string;
        travellers: number;
        adults: number;
        children: number;
        infants: number;
        needsTransfer: boolean | null;
      } = {
        durationDays: Number(currentDurationCard?.dataset.durationDays ?? 0),
        estimatedPrice: Number(currentDurationCard?.dataset.durationPrice ?? 0),
        stayRate: Number(currentStayChip?.dataset.stayOffset ?? 0),
        stayCategory: currentStayChip?.dataset.stayCategory ?? '',
        safariCount: Number(currentSafariChip?.dataset.safariCount ?? 0),
        travelDate: '',
        travellers: 0,
        adults: 0,
        children: 0,
        infants: 0,
        needsTransfer: null,
      };

      const render = () => {
        if (state.safariCount > 0) {
          if (safariCountLabel) safariCountLabel.textContent = `${state.safariCount} Jeep Safari`;
          if (inclusionSafariCountLabel) inclusionSafariCountLabel.textContent = `${state.safariCount} thrilling jeep safari${state.safariCount === 1 ? '' : 's'} in premium zones with experienced guides and drivers.`;
        }

        if (
          !state.travelDate ||
          !state.travellers ||
          state.adults < 1 ||
          !state.durationDays ||
          !state.stayCategory ||
          !state.safariCount ||
          state.needsTransfer === null
        ) {
          priceValueEls.forEach((el) => { el.textContent = '—'; });
          originalEls.forEach((el) => { el.hidden = true; });
          if (saveBadgeEl) saveBadgeEl.hidden = true;
          priceVeils.forEach((el) => el.classList.remove('has-price'));
          priceTriggers.forEach((el) => el.classList.remove('is-visible'));
          return;
        }
        const nights = Math.max(1, state.durationDays - 1);
        const rates = OCCUPANCY_RATES[state.stayCategory] ?? OCCUPANCY_RATES['Semi-Luxury'];
        let roomCost;
        let roomsUsed;
        let extraAdults = 0;
        if (state.adults <= 1) {
          roomsUsed = 1;
          roomCost = rates.single;
        } else {
          roomsUsed = Math.floor(state.adults / 2);
          extraAdults = state.adults % 2;
          roomCost = roomsUsed * rates.double + extraAdults * rates.extraAdult;
        }
        const kidsCost = state.children * rates.kids6to12;
        const resortCost = (roomCost + kidsCost) * nights;
        // A gypsy seats 6 — adults + kids 6-12 count as a seat — plus up to 2 extra kids
        // aged 6 or under who don't take a counted seat. Larger groups need more than one.
        const seatedPassengers = state.adults + state.children;
        const vehiclesForSeats = Math.ceil(seatedPassengers / 6);
        const vehiclesForInfants = Math.ceil(state.infants / 2);
        const gypsiesNeeded = Math.max(1, vehiclesForSeats, vehiclesForInfants);

        // Transfer fleet: an Innova has the same 6-seat + 2-under-6 capacity as a gypsy.
        // Once the group overflows a full Innova, a single leftover adult — or any number
        // of leftover kids (6-12) alone — still fits in one Sedan; but 2+ leftover adults
        // need a whole extra Innova instead of a Sedan.
        let innovaCount = 0;
        let sedanCount = 0;
        if (state.travellers > 3) {
          const fullInnovas = Math.floor(seatedPassengers / 6);
          const remainder = seatedPassengers % 6;
          const remainderAdults = Math.max(0, state.adults - fullInnovas * 6);
          innovaCount = fullInnovas;
          if (remainder > 0) {
            if (remainderAdults >= 2) innovaCount += 1;
            else sedanCount += 1;
          }
          if (innovaCount === 0 && sedanCount === 0) innovaCount = 1;
          const vehiclesSoFar = innovaCount + sedanCount;
          if (state.infants > vehiclesSoFar * 2) {
            innovaCount += Math.ceil((state.infants - vehiclesSoFar * 2) / 2);
          }
        } else {
          sedanCount = 1;
        }
        const transferCost = state.needsTransfer
          ? (innovaCount * 5800 + sedanCount * 4000) * state.durationDays
          : 0;
        const startDate = state.travelDate ? new Date(`${state.travelDate}T12:00:00`) : null;
        let safariCost = 0;
        for (let i = 0; i < state.safariCount; i += 1) {
          // Matches the day-wise itinerary: check-in day (day 1) only fits 1 safari,
          // every day after that fits 2 (morning + evening).
          const dayOffset = i === 0 ? 0 : 1 + Math.floor((i - 1) / 2);
          const safariDate = startDate ? new Date(startDate) : null;
          safariDate?.setDate(startDate!.getDate() + dayOffset);
          const weekend = safariDate ? [0, 5, 6].includes(safariDate.getDay()) : false;
          safariCost += safariRates[weekend ? 1 : 0] * gypsiesNeeded;
        }
        const subtotal = resortCost + safariCost + transferCost;
        const price = Math.round(subtotal * 1.05);

        priceValueEls.forEach((el) => { el.textContent = price.toLocaleString('en-IN'); });
        originalEls.forEach((el) => { el.hidden = true; });
        if (saveBadgeEl) saveBadgeEl.hidden = true;
        if (!document.documentElement.classList.contains('price-unlocked')) {
          priceVeils.forEach((el) => el.classList.add('has-price'));
          priceTriggers.forEach((el) => el.classList.add('is-visible'));
        }
      };

      const syncItinerarySafaris = (selectedTotal: number) => {
        const visibleVariant = document.querySelector<HTMLElement>('.tour-post-itinerary-variant:not([hidden])');
        if (!visibleVariant) return;

        let remaining = selectedTotal;
        visibleVariant.querySelectorAll<HTMLElement>('[data-itinerary-day]').forEach((dayEl) => {
          const badge = dayEl.querySelector<HTMLElement>('[data-day-safari-badge]');
          const label = dayEl.querySelector<HTMLElement>('[data-day-safari-label]');
          if (!badge || !label) return;

          const dayMax = Number(badge.dataset.daySafariMax ?? 0);
          const active = Math.max(0, Math.min(dayMax, remaining));
          remaining -= active;

          badge.hidden = active === 0;
          const daySafariLabel = jungle === 'sunderban' ? 'Boat Safari' : 'Jeep Safari';
          label.textContent = active > 1 ? `${daySafariLabel} ×${active}` : daySafariLabel;
        });
      };

      const bindSafariChip = (chip: HTMLElement, chips: NodeListOf<HTMLElement>) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.toggle('is-current', c === chip));

          const { safariCount } = chip.dataset;
          if (safariCount === undefined) return;

          state.safariCount = Number(safariCount);
          syncItinerarySafaris(Number(safariCount));
          render();
        });
      };

      const safariChipTemplate = safariOptionsEl?.querySelector<HTMLElement>('.tour-post-safari-chip') ?? null;

      const renderSafariOptions = (max: number) => {
        if (!safariOptionsEl || !safariChipTemplate) return;
        safariOptionsEl.innerHTML = '';
        const chips: HTMLElement[] = [];
        for (let n = 1; n <= max; n += 1) {
          const chip = safariChipTemplate.cloneNode(true) as HTMLElement;
          chip.dataset.safariCount = String(n);
          chip.classList.remove('is-current');
          const textNode = chip.firstChild;
          if (textNode) textNode.textContent = `${n} Jeep Safari${n > 1 ? 's' : ''}`;
          safariOptionsEl.appendChild(chip);
          chips.push(chip);
        }
        const chipList = safariOptionsEl.querySelectorAll<HTMLElement>('.tour-post-safari-chip');
        chips.forEach((chip) => bindSafariChip(chip, chipList));
      };

      const itineraryVariantEls = document.querySelectorAll<HTMLElement>('[data-itinerary-variant]');

      durationCards.forEach((card) => {
        card.addEventListener('click', () => {
          durationCards.forEach((c) => c.classList.toggle('is-current', c === card));

          const { durationDays, durationPrice, durationOriginal, durationRating, durationSafari } = card.dataset;
          if (!durationDays || !durationPrice || !durationOriginal || !durationRating || !durationSafari) return;

          state.durationDays = Number(durationDays);
          state.estimatedPrice = Number(durationPrice);
          // Changing the duration invalidates any previously chosen safari count —
          // require the visitor to pick again from the newly available range.
          state.safariCount = 0;

          const days = Number(durationDays);
          const rating = Number(durationRating);
          if (durationEl) durationEl.textContent = `${days}D/${days - 1}N`;
          ratingEls.forEach((el) => { el.textContent = rating.toFixed(1); });
          renderSafariOptions(Number(durationSafari));

          itineraryVariantEls.forEach((variant) => {
            variant.hidden = Number(variant.dataset.itineraryVariant) !== days;
          });
          syncItinerarySafaris(0);

          render();
        });
      });

      document.querySelectorAll<HTMLElement>('[data-safari-options] .tour-post-safari-chip').forEach((chip) => {
        bindSafariChip(chip, document.querySelectorAll<HTMLElement>('[data-safari-options] .tour-post-safari-chip'));
      });

      stayChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          stayChips.forEach((c) => c.classList.toggle('is-current', c === chip));

          const { stayOffset, stayCategory } = chip.dataset;
          if (stayOffset === undefined) return;

          state.stayRate = Number(stayOffset);
          if (stayCategory) state.stayCategory = stayCategory;
          render();
        });
      });

      transferChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          transferChips.forEach((c) => c.classList.toggle('is-current', c === chip));

          state.needsTransfer = chip.dataset.transferNeeded === 'yes';
          render();
        });
      });

      dateInputs.forEach((input) => input.addEventListener('change', () => {
        state.travelDate = input.value;
        dateInputs.forEach((other) => { if (other !== input) other.value = input.value; });
        if (pricingDate) pricingDate.value = input.value;
        render();
      }));

      travellerInputs.forEach((input) => input.addEventListener('change', () => {
        state.travellers = Math.max(0, Number.parseInt(input.value, 10) || 0);
        // These simpler enquiry-form fields don't collect an adult/kids breakdown, so
        // treat the flat count as all adults for estimation purposes.
        state.adults = state.travellers;
        state.children = 0;
        state.infants = 0;
        if (pricingTravellers) pricingTravellers.value = String(Math.min(state.travellers, 8));
        render();
      }));

      pricingDate?.addEventListener('change', () => {
        state.travelDate = pricingDate.value;
        dateInputs.forEach((input) => { input.value = pricingDate.value; });
        render();
      });

      pricingDate?.addEventListener('click', () => {
        if (typeof pricingDate.showPicker === 'function') pricingDate.showPicker();
      });

      pricingTravellers?.addEventListener('change', () => {
        state.travellers = Number(pricingTravellers.value) || 0;
        travellerInputs.forEach((input) => {
          if (input instanceof HTMLInputElement) input.value = String(state.travellers);
          else input.value = state.travellers >= 5 ? '5+' : String(state.travellers);
        });
        render();
      });

      const updateGuests = () => {
        Object.entries(guestCounts).forEach(([key, count]) => {
          const output = guestSelector?.querySelector<HTMLOutputElement>(`[data-guest-count="${key}"]`);
          if (output) output.value = String(count);
        });
        const total = Object.values(guestCounts).reduce((sum, count) => sum + count, 0);
        if (guestSummary) guestSummary.textContent = total ? `${total} traveller${total === 1 ? '' : 's'}` : 'Select travellers';
        state.adults = guestCounts.adults;
        state.children = guestCounts.children;
        state.infants = guestCounts.infants;
        if (pricingTravellers) {
          pricingTravellers.value = total ? String(total) : '';
          pricingTravellers.dispatchEvent(new Event('change', { bubbles: true }));
        }
      };

      guestTrigger?.addEventListener('click', () => {
        const open = guestTrigger.getAttribute('aria-expanded') === 'true';
        guestTrigger.setAttribute('aria-expanded', String(!open));
        if (guestPanel) guestPanel.hidden = open;
      });

      guestSelector?.querySelectorAll<HTMLButtonElement>('[data-guest-plus], [data-guest-minus]').forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.dataset.guestPlus ?? button.dataset.guestMinus;
          if (!key) return;
          guestCounts[key] = Math.max(0, Math.min(12, guestCounts[key] + (button.dataset.guestPlus ? 1 : -1)));
          updateGuests();
        });
      });

      document.addEventListener('click', (event) => {
        if (!guestSelector || !guestTrigger || !guestPanel || guestSelector.contains(event.target as Node)) return;
        guestPanel.hidden = true;
        guestTrigger.setAttribute('aria-expanded', 'false');
      });

      guestTrigger?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && guestPanel) {
          guestPanel.hidden = true;
          guestTrigger.setAttribute('aria-expanded', 'false');
        }
      });

      render();
    }

    initTripPickers();

    function initPricingDateCalendar() {
      const selector = document.querySelector<HTMLElement>('[data-pricing-date-selector]');
      const trigger = selector?.querySelector<HTMLButtonElement>('[data-pricing-date-trigger]');
      const panel = selector?.querySelector<HTMLElement>('[data-pricing-date-panel]');
      const summary = selector?.querySelector<HTMLElement>('[data-pricing-date-summary]');
      const hiddenInput = selector?.querySelector<HTMLInputElement>('[data-pricing-date]');
      const monthLabel = selector?.querySelector<HTMLElement>('[data-pricing-date-month-label]');
      const grid = selector?.querySelector<HTMLElement>('[data-pricing-date-grid]');
      const prevBtn = selector?.querySelector<HTMLButtonElement>('[data-pricing-date-prev]');
      const nextBtn = selector?.querySelector<HTMLButtonElement>('[data-pricing-date-next]');
      if (!selector || !trigger || !panel || !summary || !hiddenInput || !monthLabel || !grid || !prevBtn || !nextBtn) return;

      const today = new Date();
      today.setHours(0, 0, 0, 0);
      let viewYear = today.getFullYear();
      let viewMonth = today.getMonth();
      let selected: Date | null = null;

      const toISO = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const formatLabel = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

      const renderCalendar = () => {
        monthLabel.textContent = new Date(viewYear, viewMonth, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
        grid.innerHTML = '';
        const firstWeekday = new Date(viewYear, viewMonth, 1).getDay();
        const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

        for (let i = 0; i < firstWeekday; i++) grid.appendChild(document.createElement('span'));

        for (let day = 1; day <= daysInMonth; day++) {
          const cellDate = new Date(viewYear, viewMonth, day);
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = String(day);
          button.dataset.dateIso = toISO(cellDate);
          if (cellDate < today) button.disabled = true;
          if (selected && toISO(cellDate) === toISO(selected)) button.classList.add('is-selected');
          grid.appendChild(button);
        }
      };

      trigger.addEventListener('click', () => {
        const open = trigger.getAttribute('aria-expanded') === 'true';
        trigger.setAttribute('aria-expanded', String(!open));
        panel.hidden = open;
        if (!open) renderCalendar();
      });

      prevBtn.addEventListener('click', () => {
        viewMonth -= 1;
        if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
        renderCalendar();
      });

      nextBtn.addEventListener('click', () => {
        viewMonth += 1;
        if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
        renderCalendar();
      });

      grid.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-date-iso]');
        if (!button || button.disabled) return;
        selected = new Date(`${button.dataset.dateIso}T00:00:00`);
        hiddenInput.value = button.dataset.dateIso ?? '';
        summary.textContent = formatLabel(selected);
        hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
        renderCalendar();
        panel.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      });

      document.addEventListener('click', (event) => {
        if (event.composedPath().includes(selector)) return;
        panel.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      });
    }

    initPricingDateCalendar();

    function initItineraryHeroSlider() {
      const hero = document.querySelector<HTMLElement>('[data-hero-slider]');
      const track = hero?.querySelector<HTMLElement>('[data-hero-track]');
      const prevBtn = hero?.querySelector<HTMLElement>('[data-hero-prev]');
      const nextBtn = hero?.querySelector<HTMLElement>('[data-hero-next]');
      const dots = hero?.querySelectorAll<HTMLElement>('[data-hero-dot]');
      if (!hero || !track || !prevBtn || !nextBtn || !dots || !dots.length) return;

      const total = dots.length;
      let current = 0;
      let isVisible = false;
      let autoplayTimer: number | undefined;

      const render = () => {
        track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
      };

      const stopAutoplay = () => window.clearInterval(autoplayTimer);
      const startAutoplay = () => {
        stopAutoplay();
        if (total < 2 || !isVisible || document.hidden) return;
        autoplayTimer = window.setInterval(() => {
          current = (current + 1) % total;
          render();
        }, 2000);
      };

      prevBtn.addEventListener('click', () => {
        current = current === 0 ? total - 1 : current - 1;
        render();
        startAutoplay();
      });

      nextBtn.addEventListener('click', () => {
        current = current === total - 1 ? 0 : current + 1;
        render();
        startAutoplay();
      });

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          current = i;
          render();
          startAutoplay();
        });
      });

      hero.addEventListener('pointerenter', stopAutoplay);
      hero.addEventListener('pointerleave', startAutoplay);
      hero.addEventListener('pointerdown', stopAutoplay);
      hero.addEventListener('pointerup', startAutoplay);
      hero.addEventListener('pointercancel', startAutoplay);
      document.addEventListener('visibilitychange', startAutoplay);

      new IntersectionObserver(([entry]) => {
        isVisible = entry.isIntersecting;
        if (isVisible) startAutoplay();
        else stopAutoplay();
      }, { threshold: 0.25 }).observe(hero);
    }

    initItineraryHeroSlider();

    function initDiwaliCountdown() {
      const root = document.querySelector<HTMLElement>('[data-diwali-countdown]');
      const daysEl = document.querySelector<HTMLElement>('[data-diwali-days]');
      const hoursEl = document.querySelector<HTMLElement>('[data-diwali-hours]');
      const minutesEl = document.querySelector<HTMLElement>('[data-diwali-minutes]');
      if (!root || !daysEl || !hoursEl || !minutesEl) return;

      const target = new Date(root.dataset.countdownTarget ?? '').getTime();
      if (Number.isNaN(target)) return;

      function renderDigits(container: HTMLElement, value: number) {
        const digits = String(value).padStart(2, '0').split('');
        container.innerHTML = digits.map((digit) => `<span class="tour-post-diwali-digit">${digit}</span>`).join('');
      }

      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          const card = root!.closest('.tour-post-diwali-card');
          if (card) (card as HTMLElement).style.display = 'none';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        renderDigits(daysEl!, days);
        renderDigits(hoursEl!, hours);
        renderDigits(minutesEl!, minutes);
      }

      tick();
      setInterval(tick, 30000);
    }

    initDiwaliCountdown();

    function initPromoCountdown() {
      const root = document.querySelector<HTMLElement>('[data-countdown-target]');
      const daysEl = document.querySelector<HTMLElement>('[data-countdown-days]');
      const hoursEl = document.querySelector<HTMLElement>('[data-countdown-hours]');
      const minutesEl = document.querySelector<HTMLElement>('[data-countdown-minutes]');
      if (!root || !daysEl || !hoursEl || !minutesEl) return;

      const target = new Date(root.dataset.countdownTarget ?? '').getTime();
      if (Number.isNaN(target)) return;

      function pad(value: number) {
        return String(value).padStart(2, '0');
      }

      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          root!.style.display = 'none';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        daysEl!.textContent = String(days);
        hoursEl!.textContent = pad(hours);
        minutesEl!.textContent = pad(minutes);
      }

      tick();
      setInterval(tick, 30000);
    }

    initPromoCountdown();

    function initTourEnquireForm() {
      const form = document.querySelector<HTMLFormElement>('[data-tour-enquire-form]');
      const success = document.querySelector<HTMLElement>('[data-tour-form-success]');
      if (!form || !success) return;

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        success.classList.add('is-visible');
        form.reset();
      });
    }

    initTourEnquireForm();

    function initDescriptionToggle() {
      const block = document.querySelector<HTMLElement>('[data-description-block]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-description-toggle]');
      if (!block || !toggle) return;

      toggle.addEventListener('click', () => {
        const expanded = block.classList.toggle('is-expanded');
        toggle.textContent = expanded ? 'Read Less' : 'Read More';
      });
    }

    initDescriptionToggle();

    function initRelatedSliders() {
      document.querySelectorAll<HTMLElement>('[data-related-slider]').forEach((slider) => {
        const track = slider.querySelector<HTMLElement>('[data-related-track]');
        const previous = slider.querySelector<HTMLButtonElement>('[data-related-prev]');
        const next = slider.querySelector<HTMLButtonElement>('[data-related-next]');
        if (!track) return;

        const move = (direction: number) => {
          const slide = track.querySelector<HTMLElement>('.tour-post-related-slide');
          const gap = Number.parseFloat(getComputedStyle(track).gap) || 20;
          track.scrollBy({ left: direction * ((slide?.offsetWidth ?? track.clientWidth * 0.82) + gap), behavior: 'smooth' });
        };

        previous?.addEventListener('click', () => move(-1));
        next?.addEventListener('click', () => move(1));
      });
    }

    initRelatedSliders();

    function initCallbackForm() {
      const toggle = document.querySelector<HTMLButtonElement>('[data-callback-toggle]');
      const dialog = document.querySelector<HTMLDialogElement>('[data-callback-dialog]');
      const close = dialog?.querySelector<HTMLButtonElement>('[data-callback-close]');
      const form = dialog?.querySelector<HTMLFormElement>('[data-callback-form]');
      const success = form?.querySelector<HTMLElement>('[data-callback-success]');
      const getPriceTriggers = document.querySelectorAll<HTMLButtonElement>('[data-get-price-trigger]');
      if (!dialog || !form) return;

      toggle?.addEventListener('click', () => dialog.showModal());
      getPriceTriggers.forEach((trigger) => trigger.addEventListener('click', () => dialog.showModal()));
      close?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        success?.classList.add('is-visible');
        form.reset();
        document.documentElement.classList.add('price-unlocked');
        getPriceTriggers.forEach((trigger) => trigger.classList.remove('is-visible'));
        window.setTimeout(() => dialog.close(), 1200);
      });
    }

    initCallbackForm();


    function initItineraryEnquiry() {
      const dialog = document.querySelector<HTMLDialogElement>('[data-itinerary-enquiry-dialog]');
      const open = document.querySelector<HTMLButtonElement>('[data-open-itinerary-enquiry]');
      const close = dialog?.querySelector<HTMLButtonElement>('[data-close-itinerary-enquiry]');
      const form = dialog?.querySelector<HTMLFormElement>('[data-itinerary-enquiry-form]');
      const success = dialog?.querySelector<HTMLElement>('[data-itinerary-enquiry-success]');
      if (!dialog || !open) return;
      open.addEventListener('click', () => dialog.showModal());
      close?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      form?.addEventListener('submit', (event) => { event.preventDefault(); success?.classList.add('is-visible'); form.reset(); });
    }

    initItineraryEnquiry();
  </script>

