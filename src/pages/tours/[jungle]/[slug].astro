---
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import TripPlannerModal from '../../../components/TripPlannerModal.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import TourCard from '../../../components/TourCard.astro';
import ReviewsSection from '../../../components/ReviewsSection.astro';
import { tours, type Tour } from '../../../data/tours';
import allFaqs from '../../../data/faqs.json';
import { testimonialsByJungle } from '../../../data/testimonials';
import { parkFaqsByJungle } from '../../../data/parkFaqs';
import { generateDepartures } from '../../../utils/departures';
import { buildFixedTourItinerary } from '../../../utils/fixedTourItinerary';
import { getBatchGalleryImages, getCardGalleryImage } from '../../../utils/galleryAssignment';
import { getJungleHomeImages, getJungleWildlifePool, getJungleWildlifeGalleryPool, getTourJungleWildlifePool } from '../../../utils/homeGallery';
import sightseeingImage from '../../../../home_images/bengal-tiger-wildlife-30.webp';
import leopardSightseeingImage from '../../../../home_images/indian-leopard-wildlife-02.webp';
import stayImage from '../../../../home_images/wild-excursions-jungle-resort.webp';
import transferImage from '../../../../home_images/wild-excursions-transfer-cab.webp';
import foodImage from '../../../../home_images/wild-excursions-food-thali.webp';
import safariImage from '../../../../home_images/wild-excursions-jeep-safari.webp';
import wildlifeGallery25 from '../../../../home_images/rhesus-macaque-wildlife-02.webp';
import wildlifeGallery22 from '../../../../home_images/sarus-crane-wildlife-02.webp';
import wildlifeGallery14 from '../../../../home_images/indian-wild-dog-dhole-02.webp';
import wildlifeWildDogs from '../../../../home_images/indian-wild-dog-dhole-01.webp';
import groupBannerImage from '../../../../tour_jungle/Firefly (1) (2).webp';
import tripAdvisorLogo from '../../../../trip_advisor.webp';
import wildExcursionsLogo from '../../../../we.logo.webp';

export function getStaticPaths() {
  return tours.map((tour) => ({
    params: { jungle: tour.jungle, slug: tour.slug },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const discountPct = Math.round(((tour.originalPrice - tour.price) / tour.originalPrice) * 100);
const isPortraitImage = tour.image.height > tour.image.width;
// Jawai Bera and Jhalana have no tigers — the sitewide gallery tile below defaults to a
// tiger-sighting photo, so swap it for a genuine leopard shot on these two.
const isLeopardOnlyJungle = tour.jungle === 'jawai-bera' || tour.jungle === 'jhalana';
const testimonials = testimonialsByJungle[tour.jungle] ?? [];
const featuredFaqs = allFaqs.filter((faq) => faq.featured);
const parkFaqs = parkFaqsByJungle[tour.jungle] ?? [];
const displayFaqs = parkFaqs.length > 0 ? parkFaqs : featuredFaqs;

const totalReviewsAcrossSite = tours.reduce((sum, t) => sum + t.reviews, 0);
const roundedReviewCount = Math.floor(totalReviewsAcrossSite / 100) * 100;

const trustBadges = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6z" stroke-linejoin="round"/></svg>',
    title: '4.9/5',
    sub: 'Rated across TripAdvisor and Google.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5h16v10H8l-4 4V5z" stroke-linejoin="round"/><path d="M12 8l.9 1.8 2 .2-1.4 1.3.3 2-1.8-1-1.8 1 .3-2-1.4-1.3 2-.2z" stroke-linejoin="round"/></svg>',
    title: `${roundedReviewCount}+`,
    sub: 'Verified guest reviews across our safaris.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z" stroke-linejoin="round"/></svg>',
    title: 'Curated with love',
    sub: 'Handpicked stays and naturalist-led safaris.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2C10.5 19 5 13.5 4 6a2 2 0 0 1 2-3z" stroke-linejoin="round"/></svg>',
    title: '24/7 On-trip assistance',
    sub: 'We’re always there to help, pre, post, and on the trip.',
  },
];


const nearestHubs: Record<string, string> = {
  tadoba: 'Nagpur',
  tipeshwar: 'Nagpur',
  nagzira: 'Nagpur',
  kanha: 'Jabalpur',
  bandhavgarh: 'Jabalpur',
  satpura: 'Bhopal',
  panna: 'Khajuraho',
  ranthambore: 'Sawai Madhopur',
  'umred-karhandla': 'Nagpur',
  'jim-corbett': 'Ramnagar',
  kaziranga: 'Guwahati',
  dudhwa: 'Lucknow',
  kishanpur: 'Lucknow',
  pilibhit: 'Bareilly',
  rajaji: 'Haridwar',
  gir: 'Rajkot',
  manas: 'Guwahati',
  sunderban: 'Kolkata',
  jhalana: 'Jaipur',
  'jawai-bera': 'Jodhpur',
  bor: 'Nagpur',
  'sanjay-dubri': 'Rewa',
  bandipur: 'Mysuru',
};

function buildSampleItinerary(t: Tour, days: number) {
  const entries: NonNullable<Tour['itinerary']> = [];
  const resortLabel = 'your pre-booked resort';
  const hub = nearestHubs[t.jungle];
  const hubLabel = hub ? `${hub} Airport / Railway Station` : 'your nearest airport or railway station';

  for (let day = 1; day <= days; day += 1) {
    if (day === 1) {
      entries.push({
        day,
        title: `Arrival at ${t.jungleLabel} & Evening Safari`,
        details: [
          `Pick-up from ${hubLabel} at the given time in AC cabs.`,
          `Proceed towards ${t.jungleLabel} National Park.`,
          'Check-in to your pre-booked resort.',
          'Get ready for your 1st safari — an exhilarating evening jeep safari (Safari Timing: 2:00 PM – 6:00 PM).',
          'Return to the resort in the evening. Relax with high-tea and dinner.',
        ],
        meals: 'Lunch | High-Tea | Dinner',
        safaris: 1,
        transfer: { from: hubLabel, to: resortLabel },
        stay: { name: resortLabel },
      });
    } else if (day === days) {
      entries.push({
        day,
        title: 'Morning Safari & Departure',
        details: [
          'Wake up early and get ready for your final safari — a morning jeep safari (Safari Timing: 6:00 AM – 10:00 AM).',
          'Return to the resort, freshen up, and check out.',
          `Proceed to ${hubLabel} for your onward journey.`,
        ],
        meals: 'Breakfast',
        safaris: 1,
        transfer: { from: resortLabel, to: hubLabel },
      });
    } else {
      entries.push({
        day,
        title: `Full Day at ${t.jungleLabel} — Morning & Evening Safari`,
        details: [
          'Wake up early and get ready for your morning safari (Safari Timing: 6:00 AM – 10:00 AM), followed by breakfast.',
          'Relax at the resort through midday, with lunch between drives.',
          'Get ready for your evening safari — an exhilarating evening jeep safari (Safari Timing: 2:00 PM – 6:00 PM).',
          'Return to the resort in the evening. Relax with high-tea and dinner.',
        ],
        meals: 'Breakfast | Lunch | High-Tea | Dinner',
        safaris: 2,
      });
    }
  }

  return entries;
}

const baseDays = parseInt(tour.duration, 10) || 3;
const defaultDisplayDays = 3;

const itineraryVariants = [2, 3, 4, 5].map((days) => {
  const items = buildFixedTourItinerary(tour, days);
  return { days, items, isReal: true };
});
const currentItinerary = itineraryVariants.find((v) => v.days === defaultDisplayDays) ?? itineraryVariants[0];
const itineraryDays = currentItinerary.items;
const hasRealItinerary = currentItinerary.isReal;

const seasonThemes: Record<string, { icon: string; from: string; to: string; text: string }> = {
  Winter: { icon: '&#10052;&#65039;', from: '#3b82f6', to: '#93c5fd', text: '#171717' },
  Summer: { icon: '&#9728;&#65039;', from: '#c2410c', to: '#fbbf24', text: '#171717' },
  Monsoon: { icon: '&#127783;&#65039;', from: '#065f46', to: '#22c55e', text: '#ffffff' },
};
const seasonTheme = seasonThemes[tour.bestSeason] ?? { icon: '&#127775;', from: '#cfa100', to: '#fdcb08', text: '#171717' };

const safariRatesByJungle: Record<string, [number, number]> = {
  kaziranga: [7000, 8000],
  tadoba: [8000, 9000],
  tipeshwar: [6500, 7500],
  'umred-karhandla': [6500, 7500],
  nagzira: [6500, 7500],
  bor: [6500, 7500],
  kanha: [9000, 10000],
  bandhavgarh: [9000, 10000],
  panna: [9000, 10000],
  pench: [9000, 10000],
  satpura: [9000, 10000],
  'sanjay-dubri': [9000, 10000],
  'jim-corbett': [9000, 10000],
  ranthambore: [12000, 14000],
};
const defaultSafariRate = safariRatesByJungle[tour.jungle]?.[0] ?? 7000;
const DEFAULT_RESORT_RATE = 9000;
const DEFAULT_TRANSFER_RATE = 4000;
const durationOptions = [2, 3, 4, 5].map((days) => {
  const safariCount = (days - 1) * 2;
  const price = DEFAULT_RESORT_RATE * (days - 1) + defaultSafariRate * safariCount + DEFAULT_TRANSFER_RATE * days;
  const originalPrice = price;
  const rating = Math.max(4, Math.round((tour.rating - Math.abs(days - 3) * 0.1) * 10) / 10);
  return {
    days,
    price,
    originalPrice,
    savings: originalPrice - price,
    rating,
    safariCount,
    isCurrent: days === defaultDisplayDays,
  };
});

const currentDurationOption = durationOptions.find((option) => option.isCurrent) ?? durationOptions[0];

const displayPrice = currentDurationOption.price;
const displayOriginalPrice = currentDurationOption.originalPrice;
const defaultDurationLabel = `${defaultDisplayDays}D/${defaultDisplayDays - 1}N`;


const stayOffsets: Record<string, number> = { Deluxe: 6000, 'Semi-Luxury': 9000, Luxury: 18800 };

const tripIcons = {
  transfer: '<span class="icon-png icon-png--transfer"></span>',
  stay: '<span class="icon-png icon-png--stay"></span>',
  food: '<span class="icon-png icon-png--food"></span>',
  safari: '<span class="icon-png icon-png--jeep"></span>',
};
const stayCategories = ['Deluxe', 'Semi-Luxury', 'Luxury'];
const defaultStayCategory = 'Semi-Luxury';
// Sunderban is a mangrove delta with no jeep tracks — every safari there is a guided
// boat safari through the tidal creeks, not a jeep drive.
const daySafariLabel = tour.jungle === 'sunderban' ? 'Boat Safari' : 'Jeep Safari';

const serviceIcons = [
  {
    icon: '<span class="icon-png icon-png--transfer"></span>',
    label: 'Transfers Included',
  },
  {
    icon: '<span class="icon-png icon-png--stay"></span>',
    label: 'Stay Included',
  },
  {
    icon: '<span class="icon-png icon-png--food"></span>',
    label: 'Meals Included',
  },
  {
    icon: '<span class="icon-png icon-png--jeep"></span>',
    label: `${currentDurationOption.safariCount} Jeep Safari`,
    isSafariCount: true,
  },
];

const inclusions = [
  'Accommodation at a semi-luxury resort on a double-sharing basis in AC rooms.',
  'All meals (breakfast, lunch, high-tea, and dinner) during your stay.',
  `${currentDurationOption.safariCount} thrilling jeep safaris in premium zones with experienced guides and drivers.`,
  'Roundtrip transfers to Nagpur Airport / Railway Station and all local gate transfers in comfortable AC cabs.',
  'All forest permits, gypsy fees, driver fees, and guide charges.',
  'Applicable 5% GST as imposed by the Government of India.',
];

const exclusions = [
  'Lens / camera charges (if any).',
  'Tips to guides and drivers.',
  'Extra orders of meals, snacks, hard drinks, or cold drinks.',
  'Any train or airfare tickets to and from your home city.',
  'Difference in cost arising due to mishaps, political unrest, natural calamities, or sudden changes in forest fees, permits, etc.',
  'Anything not mentioned in the list of inclusions.',
];

const cancellationPolicy = [
  'All cancellation requests must be sent via email to info@wildexcursions.in.',
  'Cancellation fees apply based on the proximity to the tour start date.',
  'Participants are responsible for any non-refundable expenses incurred, such as visa fees or flight tickets.',
  '120 days or more before departure: 100% of the total amount will be refunded.',
  '60 days or more before departure: 75% of the total amount will be refunded.',
  '45–60 days before departure: 50% of the total amount will be refunded.',
  '30–45 days before departure: 25% of the total amount will be refunded.',
  'Within 30 days of departure or no-show: 0% refund.',
  'Refunds will be based on the total tour cost and processed within 7–8 working days.',
  'Any bank or transaction fees incurred during the refund process will be deducted from the refund amount.',
  'All applicable refunds will be made to the respective bank details provided by the participants.',
  'Full Refund: You will receive a full refund of all trip payments made to Wild Excursions when applicable under the policy above.',
  'Rebooking: You may rebook your trip for a future departure date with no change fees.',
];

const thingsToCarry = [
  'Original ID proof — Aadhaar, PAN, Driving License, or Passport',
  'Prescription medicines, a basic first-aid kit, insect repellent, and sunscreen',
  'Light, comfortable clothing in neutral colors — khaki, beige, olive green',
  'A light jacket or sweater for early morning and evening safaris',
  'Sports shoes or other comfortable, sturdy footwear',
  'Sunglasses and a scarf or balaclava',
  'Camera, lenses, memory cards, charger, and spare batteries',
  'A bean bag or monopod for camera stability',
  'Binoculars for wildlife viewing',
  'A torch or flashlight for use after dark',
];

const knowBeforeYouGo = [
  "Connectivity: mobile network is patchy inside most reserves. Let people know you'll be off-grid for the length of each drive.",
  'Gate timings: entry and exit times are set and enforced by the forest department, not by us. Arrive at the meeting point on time so the whole group isn\'t held up.',
  "On the road: safari tracks are unpaved and can be bumpy for a few hours at a stretch. It's a real jeep safari, not a sightseeing coach.",
  'Rates: quoted pricing can change with the season or a change in group size — always confirmed with you before you pay anything.',
  'Wildlife sightings are never guaranteed — our naturalists and drivers use their experience to give you the best possible chance.',
  'Cancellations & rescheduling: refunds are based on how far ahead of departure you cancel, from 100% (120+ days out) down to no refund inside 30 days. Full terms are on our Terms & Conditions page.',
];

const relatedSuggestions = [
  ...generateDepartures(tour).slice(0, 3).map((departure) => ({ tour, departure })),
  ...tours.filter((candidate) => candidate.jungle !== tour.jungle).slice(0, 5).map((relatedTour) => ({ tour: relatedTour })),
];

const wildlifeGalleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../../assets/wildlife-gallery/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const wildlifeGalleryPool = Object.entries(wildlifeGalleryModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
const relatedSuggestionImages = relatedSuggestions.map((suggestion) => {
  const pool = getJungleWildlifePool(suggestion.tour.jungle, suggestion.tour.slug).map((photo) => photo.image);
  return getCardGalleryImage(pool.length ? pool : wildlifeGalleryPool, suggestion.tour.jungle, suggestion.tour.slug, suggestion.departure?.dateSlug);
});

function buildItineraryPhotoPlan(items: { day: number }[], jungleSlug: string, seed: string) {
  const totalDays = items.length;
  const wildlifePool = getJungleWildlifePool(jungleSlug, seed);
  let poolIndex = 0;
  const nextWildlifePhoto = () => {
    if (wildlifePool.length === 0) return { image: sightseeingImage, alt: 'Jeep safari', crop: false };
    const photo = wildlifePool[poolIndex % wildlifePool.length];
    poolIndex += 1;
    return { ...photo, crop: false };
  };

  return items.map((day) => {
    const isFirstDay = day.day === 1;
    const categories = [
      { included: day.day === 1 || day.day === totalDays, image: transferImage, alt: 'AC cab transfer' },
      { included: day.day !== totalDays, image: stayImage, alt: 'Resort stay' },
      { included: true, image: foodImage, alt: 'Meals included' },
      { included: true, image: safariImage, alt: 'Jeep safari' },
    ].filter((item) => item.included);

    // The real inclusion photos only repeat what's already shown on day 1, so from day 2
    // onward we swap them for jungle-accurate wildlife shots — never repeating a photo or
    // species within the same itinerary — instead of showing the same photo again. The
    // branded inclusion photos aren't natively 4:3 like the wildlife stock shots, so they're
    // cropped to match rather than left at their odd native ratios.
    const photos = categories.map((item) => (isFirstDay ? { image: item.image, alt: item.alt, crop: true } : nextWildlifePhoto()));

    while (photos.length < 4) {
      photos.push(nextWildlifePhoto());
    }

    return photos;
  });
}
const itineraryPhotoPlans = new Map(
  itineraryVariants.map((variant) => [variant.days, buildItineraryPhotoPlan(variant.items, tour.jungle, `${tour.slug}-${variant.days}`)])
);
const tourJungleWildlifeImages = getTourJungleWildlifePool(tour.jungle, `${tour.slug}-itinerary-hero`).map((photo) => photo.image);
const jungleWildlifeGalleryImages = getJungleWildlifeGalleryPool(tour.jungle, `${tour.slug}-itinerary-hero`).map((photo) => photo.image);
const itineraryHeroImagePool = tourJungleWildlifeImages.length
  ? tourJungleWildlifeImages
  : jungleWildlifeGalleryImages.length
    ? jungleWildlifeGalleryImages
    : wildlifeGalleryPool;
const itineraryHeroImages = itineraryDays.map((_, i) => itineraryHeroImagePool[i % itineraryHeroImagePool.length]);
const jungleHomeImages = getJungleHomeImages(tour.jungle);
const tourWildlifeImages = getJungleWildlifePool(tour.jungle, tour.slug).map((photo) => photo.image);
const heroSwiperImages = jungleHomeImages.length >= 3
  ? jungleHomeImages
  : getBatchGalleryImages(
      tourWildlifeImages.length ? tourWildlifeImages : wildlifeGalleryPool,
      [0, 1, 2].map((i) => ({ jungleSlug: tour.jungle, tourSlug: tour.slug, departureDateSlug: `hero-swiper-${i}` }))
    );
const durationCardImages = getBatchGalleryImages(
  tourWildlifeImages.length ? tourWildlifeImages : wildlifeGalleryPool,
  durationOptions.map((option) => ({
    jungleSlug: tour.jungle,
    tourSlug: tour.slug,
    departureDateSlug: `duration-${option.days}-days`,
  }))
);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: tour.name,
  description: tour.description,
  image: new URL(tour.image.src, Astro.site).toString(),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: tour.rating,
    reviewCount: tour.reviews,
    bestRating: 5,
    worstRating: 1,
  },
  offers: {
    '@type': 'Offer',
    price: tour.price,
    priceCurrency: 'INR',
    availability: 'https://schema.org/InStock',
    url: Astro.url.toString(),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Tours', item: new URL('/tours/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: tour.jungleLabel, item: new URL(`/tours/${tour.jungle}/`, Astro.site).toString() },
    { '@type': 'ListItem', position: 4, name: tour.name, item: Astro.url.toString() },
  ],
};
---

<Layout title={tour.name} description={tour.shortDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="tours-promo-bar fixed inset-x-3 z-50 mx-auto flex w-auto max-w-[1640px] sm:inset-x-6">
    <div class="tours-promo-marquee" aria-hidden="false">
      <p>Limited Time: Save &#8377;2,000 on your first booking &mdash; use code <strong>WILD2000</strong> &#127942;</p>
      <p aria-hidden="true">Limited Time: Save &#8377;2,000 on your first booking &mdash; use code <strong>WILD2000</strong> &#127942;</p>
    </div>
  </div>

  <article class="tour-post bg-black pb-24 text-brand-ivory lg:pb-16" data-tour-jungle={tour.jungle}>
    <div class="px-4 sm:px-6 sm:pt-6 lg:px-10 lg:pt-8">
      <div class="mx-auto max-w-6xl">
        <a href="/tours/" class="tour-post-crumb">Tours</a><span class="tour-post-crumb-sep">/</span><a href={`/tours/${tour.jungle}/`} class="tour-post-crumb">{tour.jungleLabel}</a><span class="tour-post-crumb-sep">/</span><span class="tour-post-crumb-current">{tour.name}</span>
      </div>
    </div>

    <div class="px-4 sm:px-6 lg:px-10">
      <div class="mx-auto max-w-6xl">
        <div class="tour-post-gallery" data-lightbox-group>
          <div class="tour-post-gallery-main">
            <div class="tour-post-hero-slider swiper">
              <div class="swiper-wrapper">
                {heroSwiperImages.map((img, i) => (
                  <div class="swiper-slide">
                    <Image src={img} alt={`${tour.name} — ${tour.region}`} width={img.width} height={img.height} format="webp" quality={100} class:list={['h-full w-full object-cover', { 'object-top': img.height > img.width }]} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
                  </div>
                ))}
              </div>
              <div class="tour-post-hero-pagination"></div>
            </div>

            <div class="tour-post-gallery-mobile-thumbs">
              <button type="button" class="tour-post-gallery-mobile-thumb tour-post-gallery-mobile-thumb--more" data-open-lightbox aria-label="View more photos">
                <Image src={heroSwiperImages[1] ?? heroSwiperImages[0]} alt="More tour photos" width={(heroSwiperImages[1] ?? heroSwiperImages[0]).width} height={(heroSwiperImages[1] ?? heroSwiperImages[0]).height} format="webp" quality={100} class="h-full w-full object-cover" loading="lazy" />
                <span>View All</span>
              </button>
            </div>
          </div>
          <div class="tour-post-gallery-side">
            <div class="tour-post-gallery-tile">
              <Image src={tour.image} alt="" width={500} height={400} format="webp" quality={78} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
              <span>{tour.jungleLabel}</span>
            </div>
            <div class="tour-post-gallery-tile">
              <Image src={stayImage} alt="Wild Excursions jungle resort" width={stayImage.width} height={stayImage.height} format="webp" quality={100} class="h-full w-full object-cover" loading="lazy" />
              <span>Stay</span>
            </div>
            <div class="tour-post-gallery-tile">
              {isLeopardOnlyJungle
                ? <Image src={leopardSightseeingImage} alt="Leopard spotted on a jungle safari" width={leopardSightseeingImage.width} height={leopardSightseeingImage.height} format="webp" quality={100} class="h-full w-full object-cover" loading="lazy" />
                : <Image src={sightseeingImage} alt="Safari jeep tourists during a tiger sighting" width={sightseeingImage.width} height={sightseeingImage.height} format="webp" quality={100} class="h-full w-full object-cover" loading="lazy" />}
              <span>Sightseeing</span>
            </div>
            <div class="tour-post-gallery-tile">
              <div class="tour-post-wildlife-slider swiper">
                <div class="swiper-wrapper">
                  {[
                    { image: wildlifeGallery25, alt: 'Wildlife in the forest' },
                    { image: wildlifeGallery22, alt: 'Wildlife in the forest' },
