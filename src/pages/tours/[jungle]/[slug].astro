  <script>
    import Swiper from 'swiper';
    import { Pagination } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/pagination';

    function initHeroSlider() {
      const el = document.querySelector<HTMLElement>('.tour-post-hero-slider');
      if (!el) return;

      new Swiper(el, {
        modules: [Pagination],
        loop: true,
        pagination: {
          el: '.tour-post-hero-pagination',
          clickable: true,
        },
      });
    }

    initHeroSlider();

    function initTripPickers() {
      const durationCards = document.querySelectorAll<HTMLElement>('.tour-post-duration-card');
      const stayChips = document.querySelectorAll<HTMLElement>('[data-stay-options] .tour-post-stay-chip');
      const safariOptionsEl = document.querySelector<HTMLElement>('[data-safari-options]');
      const safariNoteEl = document.querySelector<HTMLElement>('[data-safari-note]');
      if (!durationCards.length && !stayChips.length) return;

      const priceEls = document.querySelectorAll<HTMLElement>('[data-price-display]');
      const originalEls = document.querySelectorAll<HTMLElement>('[data-price-original-display]');
      const saveBadgeEl = document.querySelector<HTMLElement>('[data-save-badge-display]');
      const durationEl = document.querySelector<HTMLElement>('[data-duration-display]');
      const ratingEls = document.querySelectorAll<HTMLElement>('[data-rating-display]');

      const formatINR = (value: number) => `₹${value.toLocaleString('en-IN')}`;
      const SAFARI_UNIT_PRICE = 6500;

      const currentDurationCard = document.querySelector<HTMLElement>('.tour-post-duration-card.is-current') ?? durationCards[0];
      const currentStayChip = document.querySelector<HTMLElement>('[data-stay-options] .tour-post-stay-chip.is-current') ?? stayChips[0];
      const currentSafariChip = document.querySelector<HTMLElement>('[data-safari-options] .tour-post-safari-chip.is-current');

      const state = {
        price: Number(currentDurationCard?.dataset.durationPrice ?? 0),
        original: Number(currentDurationCard?.dataset.durationOriginal ?? 0),
        stayOffset: Number(currentStayChip?.dataset.stayOffset ?? 0),
        safariOffset: Number(currentSafariChip?.dataset.safariCount ?? currentDurationCard?.dataset.durationSafari ?? 0) * SAFARI_UNIT_PRICE,
      };

      const render = () => {
        const price = state.price + state.stayOffset + state.safariOffset;
        const original = state.original + state.stayOffset + state.safariOffset;
        const savings = original - price;

        priceEls.forEach((el) => { el.textContent = formatINR(price); });
        originalEls.forEach((el) => { el.textContent = formatINR(original); });
        if (saveBadgeEl) saveBadgeEl.textContent = `SAVE ${formatINR(savings)}`;
      };

      const syncItinerarySafaris = (selectedTotal: number) => {
        const visibleVariant = document.querySelector<HTMLElement>('.tour-post-itinerary-variant:not([hidden])');
        if (!visibleVariant) return;

        let remaining = selectedTotal;
        visibleVariant.querySelectorAll<HTMLElement>('[data-itinerary-day]').forEach((dayEl) => {
          const badge = dayEl.querySelector<HTMLElement>('[data-day-safari-badge]');
          const label = dayEl.querySelector<HTMLElement>('[data-day-safari-label]');
          if (!badge || !label) return;

          const dayMax = Number(badge.dataset.daySafariMax ?? 0);
          const active = Math.max(0, Math.min(dayMax, remaining));
          remaining -= active;

          badge.hidden = active === 0;
          label.textContent = active > 1 ? `Jeep Safari ×${active}` : 'Jeep Safari';
        });
      };

      const bindSafariChip = (chip: HTMLElement, chips: NodeListOf<HTMLElement>) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.toggle('is-current', c === chip));

          const { safariCount } = chip.dataset;
          if (safariCount === undefined) return;

          state.safariOffset = Number(safariCount) * SAFARI_UNIT_PRICE;
          syncItinerarySafaris(Number(safariCount));
          render();
        });
      };

      const safariChipTemplate = safariOptionsEl?.querySelector<HTMLElement>('.tour-post-safari-chip') ?? null;

      const renderSafariOptions = (max: number) => {
        if (!safariOptionsEl || !safariChipTemplate) return;
        safariOptionsEl.innerHTML = '';
        const chips: HTMLElement[] = [];
        for (let n = 1; n <= max; n += 1) {
          const chip = safariChipTemplate.cloneNode(true) as HTMLElement;
          chip.dataset.safariCount = String(n);
          chip.classList.toggle('is-current', n === max);
          const textNode = chip.firstChild;
          if (textNode) textNode.textContent = `${n} Jeep Safari${n > 1 ? 's' : ''}`;
          safariOptionsEl.appendChild(chip);
          chips.push(chip);
        }
        const chipList = safariOptionsEl.querySelectorAll<HTMLElement>('.tour-post-safari-chip');
        chips.forEach((chip) => bindSafariChip(chip, chipList));
        if (safariNoteEl) safariNoteEl.textContent = `Choose how many jeep safaris you'd like — up to ${max} on this trip length. Each safari is ₹6,500.`;
      };

      const itineraryVariantEls = document.querySelectorAll<HTMLElement>('[data-itinerary-variant]');

      durationCards.forEach((card) => {
        card.addEventListener('click', () => {
          durationCards.forEach((c) => c.classList.toggle('is-current', c === card));

          const { durationDays, durationPrice, durationOriginal, durationRating, durationSafari } = card.dataset;
          if (!durationDays || !durationPrice || !durationOriginal || !durationRating || !durationSafari) return;

          state.price = Number(durationPrice);
          state.original = Number(durationOriginal);
          state.safariOffset = Number(durationSafari) * SAFARI_UNIT_PRICE;

          const days = Number(durationDays);
          const rating = Number(durationRating);
          if (durationEl) durationEl.textContent = `${days}D/${days - 1}N`;
          ratingEls.forEach((el) => { el.textContent = rating.toFixed(1); });
          renderSafariOptions(Number(durationSafari));

          itineraryVariantEls.forEach((variant) => {
            variant.hidden = Number(variant.dataset.itineraryVariant) !== days;
          });
          syncItinerarySafaris(Number(durationSafari));

          render();
        });
      });

      document.querySelectorAll<HTMLElement>('[data-safari-options] .tour-post-safari-chip').forEach((chip) => {
        bindSafariChip(chip, document.querySelectorAll<HTMLElement>('[data-safari-options] .tour-post-safari-chip'));
      });

      stayChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          stayChips.forEach((c) => c.classList.toggle('is-current', c === chip));

          const { stayOffset } = chip.dataset;
          if (stayOffset === undefined) return;

          state.stayOffset = Number(stayOffset);
          render();
        });
      });
    }

    initTripPickers();

    function initItineraryHeroSlider() {
      const hero = document.querySelector<HTMLElement>('[data-hero-slider]');
      const track = hero?.querySelector<HTMLElement>('[data-hero-track]');
      const prevBtn = hero?.querySelector<HTMLElement>('[data-hero-prev]');
      const nextBtn = hero?.querySelector<HTMLElement>('[data-hero-next]');
      const dots = hero?.querySelectorAll<HTMLElement>('[data-hero-dot]');
      if (!hero || !track || !prevBtn || !nextBtn || !dots || !dots.length) return;

      const total = dots.length;
      let current = 0;

      const render = () => {
        track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
      };

      prevBtn.addEventListener('click', () => {
        current = current === 0 ? total - 1 : current - 1;
        render();
      });

      nextBtn.addEventListener('click', () => {
        current = current === total - 1 ? 0 : current + 1;
        render();
      });

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          current = i;
          render();
        });
      });
    }

    initItineraryHeroSlider();

    function initDiwaliCountdown() {
      const root = document.querySelector<HTMLElement>('[data-diwali-countdown]');
      const daysEl = document.querySelector<HTMLElement>('[data-diwali-days]');
      const hoursEl = document.querySelector<HTMLElement>('[data-diwali-hours]');
      const minutesEl = document.querySelector<HTMLElement>('[data-diwali-minutes]');
      if (!root || !daysEl || !hoursEl || !minutesEl) return;

      const target = new Date(root.dataset.countdownTarget ?? '').getTime();
      if (Number.isNaN(target)) return;

      function renderDigits(container: HTMLElement, value: number) {
        const digits = String(value).padStart(2, '0').split('');
        container.innerHTML = digits.map((digit) => `<span class="tour-post-diwali-digit">${digit}</span>`).join('');
      }

      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          const card = root!.closest('.tour-post-diwali-card');
          if (card) (card as HTMLElement).style.display = 'none';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        renderDigits(daysEl!, days);
        renderDigits(hoursEl!, hours);
        renderDigits(minutesEl!, minutes);
      }

      tick();
      setInterval(tick, 30000);
    }

    initDiwaliCountdown();

    function initPromoCountdown() {
      const root = document.querySelector<HTMLElement>('[data-countdown-target]');
      const daysEl = document.querySelector<HTMLElement>('[data-countdown-days]');
      const hoursEl = document.querySelector<HTMLElement>('[data-countdown-hours]');
      const minutesEl = document.querySelector<HTMLElement>('[data-countdown-minutes]');
      if (!root || !daysEl || !hoursEl || !minutesEl) return;

      const target = new Date(root.dataset.countdownTarget ?? '').getTime();
      if (Number.isNaN(target)) return;

      function pad(value: number) {
        return String(value).padStart(2, '0');
      }

      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          root!.style.display = 'none';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        daysEl!.textContent = String(days);
        hoursEl!.textContent = pad(hours);
        minutesEl!.textContent = pad(minutes);
      }

      tick();
      setInterval(tick, 30000);
    }

    initPromoCountdown();

    function initTourEnquireForm() {
      const form = document.querySelector<HTMLFormElement>('[data-tour-enquire-form]');
      const success = document.querySelector<HTMLElement>('[data-tour-form-success]');
      if (!form || !success) return;

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        success.classList.add('is-visible');
        form.reset();
      });
    }

    initTourEnquireForm();

    function initDescriptionToggle() {
      const block = document.querySelector<HTMLElement>('[data-description-block]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-description-toggle]');
      if (!block || !toggle) return;

      toggle.addEventListener('click', () => {
        const expanded = block.classList.toggle('is-expanded');
        toggle.textContent = expanded ? 'Read Less' : 'Read More';
      });
    }

    initDescriptionToggle();

    function initRelatedSliders() {
      document.querySelectorAll<HTMLElement>('[data-related-slider]').forEach((slider) => {
        const track = slider.querySelector<HTMLElement>('[data-related-track]');
        const previous = slider.querySelector<HTMLButtonElement>('[data-related-prev]');
        const next = slider.querySelector<HTMLButtonElement>('[data-related-next]');
        if (!track) return;

        const move = (direction: number) => {
          const slide = track.querySelector<HTMLElement>('.tour-post-related-slide');
          const gap = Number.parseFloat(getComputedStyle(track).gap) || 20;
          track.scrollBy({ left: direction * ((slide?.offsetWidth ?? track.clientWidth * 0.82) + gap), behavior: 'smooth' });
        };

        previous?.addEventListener('click', () => move(-1));
        next?.addEventListener('click', () => move(1));
      });
    }

    initRelatedSliders();

    function initItineraryEnquiry() {
      const dialog = document.querySelector<HTMLDialogElement>('[data-itinerary-enquiry-dialog]');
      const open = document.querySelector<HTMLButtonElement>('[data-open-itinerary-enquiry]');
      const close = dialog?.querySelector<HTMLButtonElement>('[data-close-itinerary-enquiry]');
      const form = dialog?.querySelector<HTMLFormElement>('[data-itinerary-enquiry-form]');
      const success = dialog?.querySelector<HTMLElement>('[data-itinerary-enquiry-success]');
      if (!dialog || !open) return;
      open.addEventListener('click', () => dialog.showModal());
      close?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      form?.addEventListener('submit', (event) => { event.preventDefault(); success?.classList.add('is-visible'); form.reset(); });
    }

    initItineraryEnquiry();
  </script>
</Layout>

