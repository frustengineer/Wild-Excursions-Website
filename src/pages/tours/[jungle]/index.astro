---
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import TourCard from '../../../components/TourCard.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import ReviewsSection from '../../../components/ReviewsSection.astro';
import { tours, type Tour } from '../../../data/tours';
import { generateDepartures, type Departure } from '../../../utils/departures';
import { parkFaqsByJungle } from '../../../data/parkFaqs';
import { testimonialsByJungle, type Testimonial } from '../../../data/testimonials';
import allFaqs from '../../../data/faqs.json';

export function getStaticPaths() {
  const representatives = Array.from(new Map(tours.map((t) => [t.jungle, t])).values());

  return representatives.map((representative) => {
    const jungleTours = tours.filter((t) => t.jungle === representative.jungle);
    return {
      params: { jungle: representative.jungle },
      props: { representative, jungleTours },
    };
  });
}

const { representative, jungleTours } = Astro.props;
const { jungle, jungleLabel, region } = representative;

const heroDeals = jungleTours.map((tour) => {
  const discountPct = Math.round(((tour.originalPrice - tour.price) / tour.originalPrice) * 100);
  return { image: tour.image, tour, discountPct };
});

const minPrice = Math.min(...jungleTours.map((t) => t.price));
const avgRating = Math.round((jungleTours.reduce((sum, t) => sum + t.rating, 0) / jungleTours.length) * 10) / 10;
const totalReviews = jungleTours.reduce((sum, t) => sum + t.reviews, 0);

interface DurationGroup {
  duration: string;
  label: string;
  sub: string;
  tour: Tour;
  departures: Departure[];
}

const DURATION_GROUPS_CONFIG: { duration: string; label: string; sub: string }[] = [
  { duration: '2 days & 1 night', label: '2 Days & 1 Night', sub: 'A quick escape — two jeep safaris, perfect for a weekend dash.' },
  { duration: '3 days & 2 nights', label: '3 Days & 2 Nights', sub: 'Our most popular format — four safaris and real breathing room.' },
  { duration: '4 days & 3 nights', label: '4 Days & 3 Nights', sub: 'More time to rotate zones and actually settle in.' },
  { duration: '5 days & 4 nights', label: '5 Days & 4 Nights', sub: 'Go deep on one reserve instead of rushing between several.' },
];

const durationGroups: DurationGroup[] = DURATION_GROUPS_CONFIG.map((cfg) => {
  const tour = jungleTours.find((t) => t.duration === cfg.duration);
  if (!tour) return null;
  return { ...cfg, tour, departures: generateDepartures(tour) };
}).filter((g): g is DurationGroup => g !== null);

const FILTER_MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const dateFilters = Array.from(new Set(durationGroups.flatMap((g) => g.departures.map((d) => d.monthKey))))
  .sort((a, b) => {
    const [ay, am] = a.split('-').map(Number);
    const [by, bm] = b.split('-').map(Number);
    return ay - by || am - bm;
  })
  .map((key) => {
    const [year, monthIdx] = key.split('-').map(Number);
    return { value: key, label: `${FILTER_MONTH_NAMES[monthIdx]} ${year}` };
  });

const durationFilters = durationGroups.map((g) => ({ value: g.duration, label: g.label }));

const budgetFilters: { label: string; min?: number; max?: number }[] = [
  { label: 'Under ₹15,000', max: 15000 },
  { label: '₹15,000 – ₹20,000', min: 15000, max: 20000 },
  { label: 'Over ₹20,000', min: 20000 },
];

const whyCards = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 16v-4l2-5h10l3 5h1a2 2 0 0 1 2 2v2" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 16h16" stroke-linecap="round"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>',
    title: 'We sit in the jeep',
    desc: 'Not a call-centre. The people planning your trip drive these zones every season.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3.5l2.6 5.3 5.9.9-4.25 4.1 1 5.9L12 16.9l-5.25 2.8 1-5.9L3.5 9.7l5.9-.9L12 3.5z" stroke-linejoin="round"/></svg>',
    title: 'Honest zone advice',
    desc: "We'll tell you when a premium zone isn't worth the premium that week.",
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6.5 3h8l4 4v13a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" stroke-linejoin="round"/><path d="M14 3v4h4M8.5 12h7M8.5 15.5h7M8.5 8.5h3.5" stroke-linecap="round"/></svg>',
    title: 'Day-wise before you pay',
    desc: 'A full hour-by-hour PDF itinerary in your inbox, before any deposit.',
  },
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3.5 11l8.5-7 8.5 7" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 9.5V20a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V9.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 21v-6h4v6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    title: "Resorts we've slept in",
    desc: 'Every property on our list has been checked in person, not booked off a photo.',
  },
];

const reviewColors = ['#34d399', '#fbbf24', '#818cf8', '#f472b6', '#38bdf8', '#fb923c', '#a78bfa'];
const allTestimonials: Testimonial[] = Object.values(testimonialsByJungle).flat();
const jungleTestimonials = allTestimonials.filter((t) => t.tourSlug && jungleTours.some((tour) => tour.slug === t.tourSlug));
const reviewsForSection = jungleTestimonials.length > 0 ? jungleTestimonials : allTestimonials;
const displayTestimonials = reviewsForSection.slice(0, 4);

const parkFaqs = parkFaqsByJungle[jungle] ?? [];
const featuredFaqs = allFaqs.filter((faq) => faq.featured);
const displayFaqs = parkFaqs.length > 0 ? parkFaqs : featuredFaqs;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: jungleTours.map((tour, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/tours/${tour.jungle}/${tour.slug}`, Astro.site).toString(),
    name: tour.name,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Tours', item: new URL('/tours', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: jungleLabel, item: Astro.url.toString() },
  ],
};
---

<Layout
  title={`${jungleLabel} Safari Tours`}
  description={`Browse all ${jungleLabel} safari tour packages from Wild Excursions — ${region}, starting at ₹${minPrice.toLocaleString('en-IN')} per person. Small groups, real naturalists, transparent pricing.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="tours-promo-bar fixed inset-x-3 z-50 mx-auto flex w-auto max-w-[1640px] sm:inset-x-6">
    <p>Limited Time: Save &#8377;2,000 on your first booking &mdash; use code <strong>WILD2000</strong> &#127942;</p>
    <div class="tours-promo-countdown" data-countdown-target="2026-08-14T23:59:59">
      <span data-countdown-days>10</span>days : <span data-countdown-hours>04</span>hrs : <span data-countdown-minutes>36</span>min
    </div>
  </div>

  <section class="tours-hero-carousel relative overflow-hidden" data-hero-carousel>
    {heroDeals.map((deal, index) => (
      <Image
        src={deal.image}
        alt={index === 0 ? `${jungleLabel} safari` : ''}
        width={1920}
        height={1080}
        format="webp"
        quality={80}
        class:list={['tours-hero-slide', 'h-full w-full object-cover', { 'object-top': deal.image.height > deal.image.width, 'is-active': index === 0 }]}
        loading={index === 0 ? 'eager' : 'lazy'}
      />
    ))}
    <div class="tours-hero-scrim" aria-hidden="true"></div>

    <button type="button" class="tours-hero-arrow tours-hero-arrow-left" data-hero-prev aria-label="Previous slide">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button type="button" class="tours-hero-arrow tours-hero-arrow-right" data-hero-next aria-label="Next slide">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    {heroDeals.map((deal, index) => (
      <div class:list={['tours-hero-overlay', { 'is-active': index === 0 }]}>
        <p class="tours-hero-offer">Get up to <span class="tours-hero-offer-pct">{deal.discountPct}% OFF</span> on</p>
        <p class="tours-hero-title"><span class="tours-hero-title-amber">{deal.tour.name}</span></p>

        <div class="tours-hero-price-row">
          <span class="tours-hero-price-label">Starting at</span>
          <span class="tours-hero-price-strike">&#8377;{deal.tour.originalPrice.toLocaleString('en-IN')}</span>
          <span class="tours-hero-price">&#8377;{deal.tour.price.toLocaleString('en-IN')}</span>
          <span class="tours-hero-price-label">/ Person</span>
          <span class="tours-hero-badge">{deal.tour.bestSeason.toUpperCase()} SALE</span>
        </div>

        <a href={`/tours/${deal.tour.jungle}/${deal.tour.slug}`} class="tours-hero-cta">View This Tour</a>
      </div>
    ))}

    <div class="tours-hero-dots" data-hero-dots>
      {heroDeals.map((_, index) => (
        <span class:list={[{ 'is-active': index === 0 }]} data-dot-index={index}></span>
      ))}
    </div>
  </section>

  <section class="tours-trust bg-black px-4 py-6 sm:px-6 lg:px-10">
    <div class="tours-trust-row mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-4">
      <div class="tours-trust-badge">
        <span class="tours-trust-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
            <circle cx="7.5" cy="13.5" r="3.5" />
            <circle cx="16.5" cy="13.5" r="3.5" />
            <path d="M7.5 10a5 5 0 0 1 9 0M4 8h1.5M18.5 8H20M12 6.5V10" stroke-linecap="round" />
            <circle cx="7.5" cy="13.5" r="1" fill="currentColor" stroke="none" />
            <circle cx="16.5" cy="13.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </span>
        <span>
          <span class="tours-trust-rating">4.9/5</span>
          <span class="tours-trust-label">Trip Advisor</span>
        </span>
      </div>

      <div class="tours-trust-badge">
        <span class="tours-trust-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.85A11 11 0 0 0 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.05H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.95l3.66-2.85z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.05l3.66 2.85C6.71 7.3 9.14 5.38 12 5.38z" />
          </svg>
        </span>
        <span>
          <span class="tours-trust-rating">4.9/5</span>
          <span class="tours-trust-label">Google</span>
        </span>
      </div>

      <div class="tours-trust-badge">
        <span class="tours-trust-icon">&#9733;</span>
        <span>
          <span class="tours-trust-rating">{avgRating}/5</span>
          <span class="tours-trust-label">{totalReviews} {jungleLabel} Reviews</span>
        </span>
      </div>
    </div>
  </section>

  <section class="tours-hero bg-black px-4 pb-8 pt-16 text-brand-ivory sm:px-6 lg:px-10 lg:pb-10 lg:pt-24">
    <div class="relative mx-auto max-w-6xl">
      <nav class="jungle-crumb">
        <a href="/tours">Tours</a><span>/</span><span class="jungle-crumb-current">{jungleLabel}</span>
      </nav>

      <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-brand-amber">{jungleTours.length} {jungleTours.length === 1 ? 'Tour' : 'Tours'} &middot; {region}</p>
      <h1 class="mt-3 text-4xl font-black uppercase leading-[0.95] sm:text-5xl lg:text-6xl">{jungleLabel} Safari Tours</h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-white/60 sm:text-base">
        {representative.shortDescription}
      </p>

      <div class="tours-coupon">
        <div class="tours-coupon-text">
          <p class="tours-coupon-label">Use this code when you enquire</p>
          <p class="tours-coupon-note">&#8377;2,000 off your first safari booking</p>
        </div>
        <button type="button" class="tours-coupon-code" data-coupon-copy data-coupon-value="WILD2000">
          <span data-coupon-code-text>WILD2000</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
            <rect x="7" y="7" width="10" height="10" rx="2" />
            <path d="M4 13V5a2 2 0 0 1 2-2h8" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <section class="bg-black px-4 pb-10 pt-2 text-brand-ivory sm:px-6 lg:px-10 lg:pt-4">
    <div class="mx-auto max-w-6xl">
      <p class="tours-intro" data-intro-text>
        {representative.description}
      </p>
      <button type="button" class="tours-intro-toggle" data-intro-toggle>Read More</button>
    </div>
  </section>

  {displayTestimonials.length > 0 && (
    <section class="jungle-love-section bg-black px-4 pb-16 text-brand-ivory sm:px-6 lg:px-10">
      <div class="mx-auto max-w-6xl">
        <h2 class="jungle-love-heading">People Love Our <span class="jungle-love-highlight">{jungleLabel}</span> Tours</h2>

        <div class="jungle-love-stars-arc" aria-hidden="true">
          <span class="jungle-love-star">&#9733;</span>
          <span class="jungle-love-star">&#9733;</span>
          <span class="jungle-love-star">&#9733;</span>
          <span class="jungle-love-star">&#9733;</span>
          <span class="jungle-love-star">&#9733;</span>
        </div>

        <p class="jungle-love-score">{avgRating}</p>
        <p class="jungle-love-reviews-count">{totalReviews} {jungleLabel} Reviews</p>

        <div class="jungle-love-cards-track">
          {displayTestimonials.map((t) => (
            <div class="jungle-love-card">
              <div class="jungle-love-card-top">
                <img src={t.avatar.src} alt={t.name} class="jungle-love-card-avatar" />
                <div>
                  <p class="jungle-love-card-name">{t.name}</p>
                  <span class="jungle-love-card-rating">&#9733; {avgRating}</span>
                </div>
              </div>
              <p class="jungle-love-card-quote">{t.quote}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="mobile-filter-bar lg:hidden" data-mobile-filter-bar>
    <button type="button" class="mobile-filter-bar-btn" data-open-expert-dialog>
      <span>Send Enquiry</span>
    </button>
    <a href="tel:+917755958493" class="mobile-filter-bar-call" aria-label="Call us">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="#0b0b0b" class="h-5 w-5" aria-hidden="true">
        <path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L184.6 167c13.7-11.1 18.4-30 11.6-46.3l-40-96z"></path>
      </svg>
    </a>
  </div>

  <dialog data-expert-dialog class="expert-dialog fixed inset-x-0 bottom-0 top-auto m-0 max-h-[85vh] w-full max-w-none overflow-y-auto rounded-t-3xl border-none bg-white p-0 text-brand-carbon shadow-2xl">
    <span class="expert-dialog-handle" aria-hidden="true"></span>
    <div class="relative p-6 sm:p-7">
      <button type="button" data-expert-dialog-close class="absolute right-5 top-5 grid h-9 w-9 place-items-center rounded-full border border-black/15 text-black/70 transition-colors hover:border-black hover:text-black" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
        </svg>
      </button>

      <h2 class="expert-dialog-heading pr-10">Connect with a Travel Expert</h2>
      <p class="expert-dialog-sub">Verify Your Phone Number to Continue</p>

      <form class="expert-dialog-form mt-6" data-expert-dialog-form>
        <div class="expert-dialog-phone">
          <span class="expert-dialog-phone-code">+91</span>
          <input type="tel" name="phone" placeholder="Your Phone" required pattern="[0-9]{10}" class="expert-dialog-phone-input" />
        </div>
        <button type="submit" class="expert-dialog-submit">Connect with an Expert</button>
        <p class="expert-dialog-success" data-expert-dialog-success>Thanks — we'll call you back shortly.</p>
      </form>

      <div class="expert-dialog-trust">
        <span></span>
        <p>Trusted by Travellers</p>
        <span></span>
      </div>

      <div class="expert-dialog-badges">
        <div class="expert-dialog-badge">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#00af87" stroke-width="1.6" class="h-6 w-6">
            <circle cx="7.5" cy="13.5" r="3.5" />
            <circle cx="16.5" cy="13.5" r="3.5" />
            <path d="M7.5 10a5 5 0 0 1 9 0M4 8h1.5M18.5 8H20M12 6.5V10" stroke-linecap="round" />
            <circle cx="7.5" cy="13.5" r="1" fill="#00af87" stroke="none" />
            <circle cx="16.5" cy="13.5" r="1" fill="#00af87" stroke="none" />
          </svg>
          <span class="expert-dialog-badge-rating">4.9/5</span>
          <span class="expert-dialog-badge-label">Trip Advisor</span>
        </div>

        <div class="expert-dialog-badge">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.85A11 11 0 0 0 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.05H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.95l3.66-2.85z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.05l3.66 2.85C6.71 7.3 9.14 5.38 12 5.38z" />
          </svg>
          <span class="expert-dialog-badge-rating">4.9/5</span>
          <span class="expert-dialog-badge-label">Google</span>
        </div>

        <div class="expert-dialog-badge">
          <span class="expert-dialog-badge-star">&#9733;</span>
          <span class="expert-dialog-badge-rating">{avgRating}/5</span>
          <span class="expert-dialog-badge-label">Wild Excursions</span>
        </div>
      </div>
    </div>
  </dialog>

  <section id="departures" class="bg-black px-4 pb-16 text-brand-ivory sm:px-6 lg:px-10 lg:pb-24" data-duration-groups-section>
    <div class="mx-auto max-w-6xl lg:grid lg:grid-cols-[16rem_1fr] lg:items-start lg:gap-8">
      <aside class="tours-filters-sidebar mb-8 lg:mb-0">
        <div class="tours-filters-card">
          <div class="tours-filters-heading">
            <span>Filters</span>
            <button type="button" class="tours-filters-clear" data-clear-filters>Clear all</button>
          </div>

          <details class="tours-filter-dropdown">
            <summary>Travel Date</summary>
            <div class="tours-filter-options" data-date-filters>
              {dateFilters.map((f) => (
                <label class="tours-filter-option">
                  <input type="checkbox" value={f.value} />
                  <span>{f.label}</span>
                </label>
              ))}
            </div>
          </details>

          <details class="tours-filter-dropdown">
            <summary>Duration</summary>
            <div class="tours-filter-options" data-duration-filters>
              {durationFilters.map((f) => (
                <label class="tours-filter-option">
