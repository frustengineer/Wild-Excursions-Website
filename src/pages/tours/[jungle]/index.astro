  <script>
    function initDiwaliCountdown() {
      const root = document.querySelector<HTMLElement>('[data-diwali-countdown]');
      const daysEl = document.querySelector<HTMLElement>('[data-diwali-days]');
      const hoursEl = document.querySelector<HTMLElement>('[data-diwali-hours]');
      const minutesEl = document.querySelector<HTMLElement>('[data-diwali-minutes]');
      if (!root || !daysEl || !hoursEl || !minutesEl) return;

      const target = new Date(root.dataset.countdownTarget ?? '').getTime();
      if (Number.isNaN(target)) return;

      function renderDigits(container: HTMLElement, value: number) {
        const digits = String(value).padStart(2, '0').split('');
        container.innerHTML = digits.map((digit) => `<span class="tours-diwali-digit">${digit}</span>`).join('');
      }

      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          const section = root!.closest('section');
          if (section) section.style.display = 'none';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        renderDigits(daysEl!, days);
        renderDigits(hoursEl!, hours);
        renderDigits(minutesEl!, minutes);
      }

      tick();
      setInterval(tick, 30000);
    }

    initDiwaliCountdown();

    function initPromoCountdown() {
      const root = document.querySelector<HTMLElement>('[data-countdown-target]');
      const daysEl = document.querySelector<HTMLElement>('[data-countdown-days]');
      const hoursEl = document.querySelector<HTMLElement>('[data-countdown-hours]');
      const minutesEl = document.querySelector<HTMLElement>('[data-countdown-minutes]');
      if (!root || !daysEl || !hoursEl || !minutesEl) return;

      const target = new Date(root.dataset.countdownTarget ?? '').getTime();
      if (Number.isNaN(target)) return;

      function pad(value: number) {
        return String(value).padStart(2, '0');
      }

      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          root!.style.display = 'none';
          return;
        }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const minutes = Math.floor((diff / (1000 * 60)) % 60);
        daysEl!.textContent = String(days);
        hoursEl!.textContent = pad(hours);
        minutesEl!.textContent = pad(minutes);
      }

      tick();
      setInterval(tick, 30000);
    }

    initPromoCountdown();

    function initHeroCarousel() {
      const root = document.querySelector<HTMLElement>('[data-hero-carousel]');
      if (!root) return;

      const slides = Array.from(root.querySelectorAll<HTMLElement>('.tours-hero-slide'));
      const overlays = Array.from(root.querySelectorAll<HTMLElement>('.tours-hero-overlay'));
      const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-dots] span'));
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-hero-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-hero-next]');
      if (!slides.length) return;

      let active = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      function show(index: number) {
        active = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === active));
        overlays.forEach((overlay, i) => overlay.classList.toggle('is-active', i === active));
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === active));
      }

      function start() {
        stop();
        timer = setInterval(() => show(active + 1), 5000);
      }

      function stop() {
        if (timer) clearInterval(timer);
        timer = null;
      }

      prevBtn?.addEventListener('click', () => {
        show(active - 1);
        start();
      });
      nextBtn?.addEventListener('click', () => {
        show(active + 1);
        start();
      });
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          show(i);
          start();
        });
      });

      start();
    }

    initHeroCarousel();

    function initCouponCopy() {
      const button = document.querySelector<HTMLButtonElement>('[data-coupon-copy]');
      const codeText = document.querySelector<HTMLElement>('[data-coupon-code-text]');
      if (!button || !codeText) return;

      const code = button.dataset.couponValue ?? '';
      let resetTimer: ReturnType<typeof setTimeout> | null = null;

      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code);
        } catch {
          // Clipboard API unavailable — the code is still visible for the user to copy manually.
        }
        button.classList.add('is-copied');
        codeText.textContent = 'Copied!';
        if (resetTimer) clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          button.classList.remove('is-copied');
          codeText.textContent = code;
        }, 1800);
      });
    }

    initCouponCopy();

    function initToursIntroToggle() {
      const text = document.querySelector<HTMLElement>('[data-intro-text]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-intro-toggle]');
      if (!text || !toggle) return;

      toggle.addEventListener('click', () => {
        const expanded = text.classList.toggle('is-expanded');
        toggle.textContent = expanded ? 'Read Less' : 'Read More';
      });
    }

    initToursIntroToggle();

    function initTourFilters() {
      const PAGE_FIRST = 3;
      const PAGE_NEXT = 6;
      const dateBoxes = document.querySelectorAll<HTMLInputElement>('[data-date-filters] input');
      const durationBoxes = document.querySelectorAll<HTMLInputElement>('[data-duration-filters] input');
      const budgetBoxes = document.querySelectorAll<HTMLInputElement>('[data-budget-filters] input');
      const clearButton = document.querySelector<HTMLButtonElement>('[data-clear-filters]');
      const groups = document.querySelectorAll<HTMLElement>('[data-duration-group]');
      const resultsCount = document.querySelector<HTMLElement>('[data-results-count]');
      const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
      if (!groups.length) return;

      const requestedMonth = new URLSearchParams(window.location.search).get('month')?.toLowerCase();
      const monthNames = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];
      const requestedMonthIndex = requestedMonth ? monthNames.indexOf(requestedMonth) : -1;
      let selectedMonthKey = '';

      const revealedByGroup = new Map<HTMLElement, number>();

      function checkedValues(boxes: NodeListOf<HTMLInputElement>) {
        return Array.from(boxes).filter((box) => box.checked);
      }

      function applyFilters(resetPaging: boolean) {
        const dates = checkedValues(dateBoxes).map((b) => b.value);
        const durations = checkedValues(durationBoxes).map((b) => b.value);
        const budgets = checkedValues(budgetBoxes);

        let totalVisible = 0;

        groups.forEach((group) => {
          const groupDuration = group.dataset.duration ?? '';
          const durationMatches = durations.length === 0 || durations.includes(groupDuration);
          const moreRow = group.querySelector<HTMLElement>('[data-duration-more-row]');

          if (!durationMatches) {
            group.classList.add('hidden');
            return;
          }

          if (resetPaging) revealedByGroup.set(group, PAGE_FIRST);
          const revealed = revealedByGroup.get(group) ?? PAGE_FIRST;

          const items = group.querySelectorAll<HTMLElement>('.duration-slider-item');
          let groupVisible = 0;
          let matchedCount = 0;

          items.forEach((item) => {
            const matchesDate = dates.length === 0 || dates.includes(item.dataset.months ?? '');
            const price = Number(item.dataset.price ?? 0);
            const matchesBudget =
              budgets.length === 0 ||
              budgets.some((box) => {
                const min = box.dataset.min ? Number(box.dataset.min) : -Infinity;
                const max = box.dataset.max ? Number(box.dataset.max) : Infinity;
                return price >= min && price <= max;
              });
            const matches = matchesDate && matchesBudget;
            item.classList.toggle('hidden', !matches);
            if (!matches) return;

            matchedCount += 1;
            const withinPage = matchedCount <= revealed;
            item.classList.toggle('is-paginated-hidden', !withinPage);
            if (withinPage) groupVisible += 1;
          });

          if (moreRow) moreRow.style.display = matchedCount > revealed ? '' : 'none';

          group.classList.toggle('hidden', matchedCount === 0);
          totalVisible += groupVisible;
        });

        if (resultsCount) resultsCount.textContent = `Showing ${totalVisible} tour departures`;
        emptyState?.classList.toggle('hidden', totalVisible !== 0);
      }

      groups.forEach((group) => {
        const moreBtn = group.querySelector<HTMLButtonElement>('[data-duration-more]');
        moreBtn?.addEventListener('click', () => {
          revealedByGroup.set(group, (revealedByGroup.get(group) ?? PAGE_FIRST) + PAGE_NEXT);
          applyFilters(false);
        });
      });

      [...dateBoxes, ...durationBoxes, ...budgetBoxes].forEach((box) => {
        box.addEventListener('change', () => applyFilters(true));
      });

      clearButton?.addEventListener('click', () => {
        [...dateBoxes, ...durationBoxes, ...budgetBoxes].forEach((box) => {
          box.checked = false;
        });
        applyFilters(true);
      });

      if (requestedMonthIndex >= 0 && dateBoxes.length) {
        const availableBoxes = Array.from(dateBoxes).sort((a, b) => Number(a.value.split('-')[1]) - Number(b.value.split('-')[1]));
        const selectedBox = availableBoxes.find((box) => Number(box.value.split('-')[1]) === requestedMonthIndex)
          ?? availableBoxes.find((box) => Number(box.value.split('-')[1]) > requestedMonthIndex)
          ?? availableBoxes[availableBoxes.length - 1];
        if (selectedBox) {
          selectedBox.checked = true;
          selectedMonthKey = selectedBox.value;
        }
      }

      applyFilters(true);

      if (selectedMonthKey) {
        const scrollToSelectedMonth = () => {
          const matchingCard = Array.from(document.querySelectorAll<HTMLElement>('.duration-slider-item'))
            .find((item) => item.dataset.months === selectedMonthKey && !item.classList.contains('hidden'));
          const matchingGroup = matchingCard?.closest<HTMLElement>('[data-duration-group]');
          matchingGroup?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        if (document.readyState === 'complete') {
          window.setTimeout(scrollToSelectedMonth, 120);
        } else {
          window.addEventListener('load', () => window.setTimeout(scrollToSelectedMonth, 120), { once: true });
        }
      }
    }

    initTourFilters();

    function initSimplePagination() {
      const PAGE_FIRST = 3;
      const PAGE_NEXT = 6;
      const wraps = document.querySelectorAll<HTMLElement>('[data-simple-paginate]');

      wraps.forEach((wrap) => {
        const items = wrap.querySelectorAll<HTMLElement>('.duration-slider-item');
        const moreRow = wrap.querySelector<HTMLElement>('[data-duration-more-row]');
        const moreBtn = wrap.querySelector<HTMLButtonElement>('[data-duration-more]');
        if (!items.length || !moreRow || !moreBtn) return;

        let revealed = PAGE_FIRST;

        function apply() {
          items.forEach((item, i) => {
            item.classList.toggle('is-paginated-hidden', i >= revealed);
          });
          moreRow.style.display = items.length > revealed ? '' : 'none';
        }

        moreBtn.addEventListener('click', () => {
          revealed += PAGE_NEXT;
          apply();
        });

        apply();
      });
    }

    initSimplePagination();

    function initMobileFilterBarReveal() {
      const bar = document.querySelector<HTMLElement>('[data-mobile-filter-bar]');
      const grid = document.querySelector<HTMLElement>('[data-duration-groups-section]');
      if (!bar || !grid) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              bar.classList.add('is-visible');
              observer.disconnect();
            }
          });
        },
        { threshold: 0.1 }
      );

      observer.observe(grid);
    }

    initMobileFilterBarReveal();

    function initExpertDialog() {
      const dialog = document.querySelector<HTMLDialogElement>('[data-expert-dialog]');
      const openBtn = document.querySelector<HTMLButtonElement>('[data-open-expert-dialog]');
      const closeBtn = document.querySelector<HTMLButtonElement>('[data-expert-dialog-close]');
      const form = document.querySelector<HTMLFormElement>('[data-expert-dialog-form]');
      const success = document.querySelector<HTMLElement>('[data-expert-dialog-success]');
      if (!dialog || !openBtn) return;

      openBtn.addEventListener('click', () => dialog.showModal());
      closeBtn?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('cancel', (event) => event.preventDefault());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        success?.classList.add('is-visible');
        form.reset();
        setTimeout(() => dialog.close(), 1800);
      });

      dialog.addEventListener('close', () => {
        success?.classList.remove('is-visible');
      });
    }

    initExpertDialog();
  </script>
</Layout>

