---
import { Image, getImage } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import TripPlannerModal from '../../../components/TripPlannerModal.astro';
import TourCard from '../../../components/TourCard.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import ReviewsSection from '../../../components/ReviewsSection.astro';
import { tours, type Tour } from '../../../data/tours';
import { generateDepartures, type Departure } from '../../../utils/departures';
import { parkFaqsByJungle } from '../../../data/parkFaqs';
import { testimonialsByJungle, type Testimonial } from '../../../data/testimonials';
import allFaqs from '../../../data/faqs.json';
import tadobaHero from '../../../../tour_jungle/tiger2.webp';
import penchHero from '../../../../tour_jungle/pench_tour_hero-v2.webp';
import bandhavgarhHero from '../../../../tour_jungle/bandhavgarh.webp';
import bandipurHero from '../../../../tour_jungle/bandipur.webp';
import borHero from '../../../../tour_jungle/bor.webp';
import dudhwaHero from '../../../../tour_jungle/dudhwa.webp';
import girHero from '../../../../tour_jungle/gir.webp';
import jawaiBeraHero from '../../../../tour_jungle/jawai-bera.webp';
import jhalanaHero from '../../../../tour_jungle/jhalana.webp';
import jimCorbettHero from '../../../../tour_jungle/jim_corbett.webp';
import kanhaHero from '../../../../tour_jungle/kanha.webp';
import nagziraHero from '../../../../tour_jungle/nagzira.webp';
import pannaHero from '../../../../tour_jungle/panna.webp';
import pilibhitHero from '../../../../tour_jungle/pilibhit.webp';
import rajajiHero from '../../../../tour_jungle/rajaji.webp';
import ranthamboreHero from '../../../../tour_jungle/ranthombore.webp';
import sanjayDubriHero from '../../../../tour_jungle/sanjar-dubri.webp';
import satpuraHero from '../../../../tour_jungle/satpura.webp';
import sunderbanHero from '../../../../tour_jungle/sunderban.webp';
import tipeshwarHero from '../../../../tour_jungle/tipeshwar.webp';
import umredKarhandlaHero from '../../../../tour_jungle/umred.webp';
import jungleHero53 from '../../../../tour_jungle/stock.png';
import mobilePenchHero from '../../../assets/wildlife-gallery/indian-leopard-wildlife-gallery-41.webp';
import mobileTadobaHero from '../../../assets/wildlife-gallery/bengal-tiger-family-wildlife-gallery-21.webp';
import mobileKanhaHero from '../../../assets/wildlife-gallery/golden-jackal-pair-wildlife-gallery-61.webp';
import mobileTiger01Hero from '../../../assets/wildlife-gallery/bengal-tiger-wildlife-gallery-01.webp';
import mobileManasHero from '../../../assets/wildlife-gallery/bengal-tiger-wildlife-gallery-49.webp';
import mobileTiger80Hero from '../../../assets/wildlife-gallery/bengal-tiger-wildlife-gallery-80.webp';
import mobileTiger75Hero from '../../../assets/wildlife-gallery/bengal-tiger-wildlife-gallery-75.webp';
import mobileNagziraHero from '../../../assets/wildlife-gallery/bengal-tiger-wildlife-gallery-58.webp';
import mobileJimCorbettHero from '../../../assets/wildlife-gallery/bengal-tiger-wildlife-gallery-06.webp';
import mobileRanthamboreHero from '../../../assets/wildlife-gallery/bengal-tiger-wildlife-gallery-72.webp';
import mobileGirHero from '../../../assets/wildlife-gallery/asiatic-lion-cub-wildlife-gallery-02.webp';
import mobileDudhwaHero from '../../../assets/wildlife-gallery/fish-eagle-wildlife-gallery-89.webp';
import mobilePilibhitHero from '../../../assets/wildlife-gallery/sambar-deer-wildlife-gallery-57.webp';
import mobileBandipurHero from '../../../assets/wildlife-gallery/yellow-throated-bulbul-wildlife-gallery-77.webp';
import mobileBorHero from '../../../assets/wildlife-gallery/spotted-deer-wildlife-gallery-70.webp';
import mobileJawaiHero from '../../../assets/wildlife-gallery/gray-langur-wildlife-gallery-78.webp';
import mobileJhalanaHero from '../../../assets/wildlife-gallery/bengal-tiger-wildlife-gallery-35.webp';
import curatedWhyIcon from '../../../../curated.webp';
import guideWhyIcon from '../../../../tour-guide.webp';
import conservationWhyIcon from '../../../../conservation.webp';
import safetyWhyIcon from '../../../../safety.webp';
import tripAdvisorLogo from '../../../../trip_advisor.webp';
import wildExcursionsLogo from '../../../../we.logo.webp';

export function getStaticPaths() {
  const representatives = Array.from(new Map(tours.map((t) => [t.jungle, t])).values());

  return representatives.map((representative) => {
    const jungleTours = tours.filter((t) => t.jungle === representative.jungle);
    return {
      params: { jungle: representative.jungle },
      props: { representative, jungleTours },
    };
  });
}

const { representative, jungleTours } = Astro.props;
const { jungle, jungleLabel, region } = representative;
const leopardOnlyJungles = ['jawai-bera', 'jhalana'];

const jungleHeroBySlug: Record<string, typeof tadobaHero> = {
  bandhavgarh: bandhavgarhHero,
  bandipur: bandipurHero,
  bor: borHero,
  dudhwa: dudhwaHero,
  gir: girHero,
  'jawai-bera': jawaiBeraHero,
  jhalana: jhalanaHero,
  'jim-corbett': jimCorbettHero,
  kanha: kanhaHero,
  kaziranga: dudhwaHero,
  kishanpur: satpuraHero,
  manas: pannaHero,
  nagzira: nagziraHero,
  panna: pannaHero,
  pilibhit: pilibhitHero,
  rajaji: rajajiHero,
  ranthambore: ranthamboreHero,
  'sanjay-dubri': sanjayDubriHero,
  satpura: satpuraHero,
  sunderban: sunderbanHero,
  tipeshwar: tipeshwarHero,
  'umred-karhandla': umredKarhandlaHero,
};

const mobileJungleHeroBySlug: Record<string, typeof tadobaHero> = {
  bandipur: mobileBandipurHero,
  bor: mobileBorHero,
  dudhwa: mobileDudhwaHero,
  gir: mobileGirHero,
  'jawai-bera': mobileJawaiHero,
  jhalana: mobileJhalanaHero,
  'jim-corbett': mobileJimCorbettHero,
  kanha: mobileKanhaHero,
  manas: mobileManasHero,
  nagzira: mobileNagziraHero,
  panna: mobileTiger01Hero,
  pench: mobilePenchHero,
  pilibhit: mobilePilibhitHero,
  ranthambore: mobileRanthamboreHero,
  'sanjay-dubri': mobileTiger75Hero,
  satpura: mobileKanhaHero,
  tadoba: mobileTadobaHero,
  'umred-karhandla': mobileTiger80Hero,
};

const namedJungleHero = jungleHeroBySlug[jungle];
const jungleHeroImages = jungle === 'tadoba'
  ? [tadobaHero]
  : jungle === 'pench'
    ? [penchHero]
    : namedJungleHero
      ? [namedJungleHero]
      : [jungleHero53];
const mobileHeroImage = mobileJungleHeroBySlug[jungle];
const mobileHeroSources = mobileHeroImage
  ? await Promise.all(
      [480, 720, 960].map((width) =>
        getImage({ src: mobileHeroImage, width, format: 'avif', quality: 65 })
      )
    )
  : [];
const mobileHeroSrcset = mobileHeroSources
  .map((source) => source.src + ' ' + source.attributes.width + 'w')
  .join(', ');
const heroDeals = jungleHeroImages.slice(0, 1).map((image, index) => {
  const tour = jungleTours[index % jungleTours.length];
  const discountPct = Math.round(((tour.originalPrice - tour.price) / tour.originalPrice) * 100);
  return { image, tour, discountPct, mobileHeroSrcset };
});

const minPrice = Math.min(...jungleTours.map((t) => t.price));
const avgRating = Math.round((jungleTours.reduce((sum, t) => sum + t.rating, 0) / jungleTours.length) * 10) / 10;
const totalReviews = jungleTours.reduce((sum, t) => sum + t.reviews, 0);

interface DurationGroup {
  duration: string;
  label: string;
  sub: string;
  tour: Tour;
  departures: Departure[];
}

const DURATION_GROUPS_CONFIG: { duration: string; label: string; sub: string }[] = [
  { duration: '2 days & 1 night', label: '2 Days & 1 Night Packages', sub: 'A quick escape — two jeep safaris, perfect for a weekend dash.' },
  { duration: '3 days & 2 nights', label: '3 Days & 2 Nights Packages', sub: 'Our most popular format — four safaris and real breathing room.' },
  { duration: '4 days & 3 nights', label: '4 Days & 3 Nights Packages', sub: 'More time to rotate zones and actually settle in.' },
  { duration: '5 days & 4 nights', label: '5 Days & 4 Nights Packages', sub: 'Go deep on one reserve instead of rushing between several.' },
];

const durationGroups: DurationGroup[] = DURATION_GROUPS_CONFIG.map((cfg) => {
  const tour = jungleTours.find((t) => t.duration === cfg.duration);
  if (!tour) return null;
  return { ...cfg, tour, departures: generateDepartures(tour) };
}).filter((g): g is DurationGroup => g !== null);

const INITIAL_DEPARTURES_PER_GROUP = 4;
const DEPARTURE_BATCH_SIZE = 6;

function chunkDepartures(departures: Departure[]): Departure[][] {
  const pages: Departure[][] = [];
  for (let index = 0; index < departures.length; index += DEPARTURE_BATCH_SIZE) {
    pages.push(departures.slice(index, index + DEPARTURE_BATCH_SIZE));
  }
  return pages;
}

const FILTER_MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const dateFilters = Array.from(new Set(durationGroups.flatMap((g) => g.departures.map((d) => d.monthKey))))
  .sort((a, b) => {
    const [ay, am] = a.split('-').map(Number);
    const [by, bm] = b.split('-').map(Number);
    return ay - by || am - bm;
  })
  .map((key) => {
    const [year, monthIdx] = key.split('-').map(Number);
    return { value: key, label: `${FILTER_MONTH_NAMES[monthIdx]} ${year}` };
  });

const durationFilters = durationGroups.map((g) => ({ value: g.duration, label: g.label }));

const budgetFilters: { label: string; min?: number; max?: number }[] = [
  { label: 'Under ₹15,000', max: 15000 },
  { label: '₹15,000 – ₹20,000', min: 15000, max: 20000 },
  { label: 'Over ₹20,000', min: 20000 },
];

const whyCards = [
  {
    number: '01',
    title: 'Personally curated itineraries',
    desc: 'Every journey is shaped around your dates, interests, pace, and wildlife wish list.',
    icon: curatedWhyIcon,
  },
  {
    number: '02',
    title: 'Field-trained guides & drivers',
    desc: 'Travel with experienced local teams who understand animal behaviour, forest routes, and responsible sightings.',
    icon: guideWhyIcon,
  },
  {
    number: '03',
    title: 'Wildlife conservation first',
    desc: 'Our trips respect park rules, local communities, and the habitats that make every encounter possible.',
    icon: conservationWhyIcon,
  },
  {
    number: '04',
    title: 'Safety-led travel',
    desc: 'Verified stays, dependable vehicles, and careful on-ground planning keep your safari comfortable and secure.',
    icon: safetyWhyIcon,
  },
  {
    number: '05',
    title: '24/7 traveller support',
    desc: 'From your first question to your journey home, our team is available whenever you need assistance.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 13v-2a8 8 0 0 1 16 0v2" stroke-linecap="round"/><path d="M4 12h3v6H5a1 1 0 0 1-1-1v-5zm16 0h-3v6h2a1 1 0 0 0 1-1v-5z" stroke-linejoin="round"/><path d="M17 18c0 2-2 3-5 3" stroke-linecap="round"/></svg>',
  },
];

const reviewColors = ['#34d399', '#fbbf24', '#818cf8', '#f472b6', '#38bdf8', '#fb923c', '#a78bfa'];
const allTestimonials: Testimonial[] = Object.values(testimonialsByJungle).flat();
const jungleTestimonials = allTestimonials.filter((t) => t.tourSlug && jungleTours.some((tour) => tour.slug === t.tourSlug));
// Falling back to the sitewide pool means showing another park's review verbatim (tiger
// sightings, a different tour name) — fine for tiger reserves since most reviews are
// tiger-trip reviews, but visibly wrong on Jawai/Jhalana, which have no tigers at all.
const reviewsForSection = jungleTestimonials.length > 0 ? jungleTestimonials : (leopardOnlyJungles.includes(jungle) ? [] : allTestimonials);
const displayTestimonials = reviewsForSection.slice(0, 4);

const parkFaqs = parkFaqsByJungle[jungle] ?? [];
const featuredFaqs = allFaqs.filter((faq) => faq.featured);
const displayFaqs = parkFaqs.length > 0 ? parkFaqs : featuredFaqs;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: jungleTours.map((tour, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/tours/${tour.jungle}/${tour.slug}/`, Astro.site).toString(),
    name: tour.name,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Tours', item: new URL('/tours/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: jungleLabel, item: Astro.url.toString() },
  ],
};
---

<Layout
  title={`${jungleLabel} Safari Tours`}
  description={`Browse all ${jungleLabel} safari tour packages from Wild Excursions — ${region}, starting at ₹${minPrice.toLocaleString('en-IN')} per person. Small groups, real naturalists, transparent pricing.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="tours-promo-bar fixed inset-x-3 z-50 mx-auto flex w-auto max-w-[1640px] sm:inset-x-6">
    <div class="tours-promo-marquee" aria-hidden="false">
      <p>Limited Time: Save &#8377;2,000 on your first safari booking &mdash; use code <strong>WILD2000</strong> &#127942;</p>
      <p aria-hidden="true">Limited Time: Save &#8377;2,000 on your first safari booking &mdash; use code <strong>WILD2000</strong> &#127942;</p>
    </div>
  </div>

  <section class="tours-hero-carousel relative overflow-hidden" data-hero-carousel>
    {heroDeals.map((deal, index) => (
      <picture>
        {deal.mobileHeroSrcset && (
          <source media='(max-width: 639px)' srcset={deal.mobileHeroSrcset} sizes='100vw' type='image/avif' />
        )}
      <Image
        src={deal.image}
        alt={index === 0 ? `${jungleLabel} safari` : ''}
        layout="full-width"
        width={1920}
        height={1080}
        sizes="100vw"
        format="webp"
        quality={jungle === 'tadoba' ? 100 : 78}
          class:list={['tours-hero-slide', 'h-full w-full object-cover', { 'object-top': deal.image.height > deal.image.width, 'tours-hero-slide--tadoba': jungle === 'tadoba', 'tours-hero-slide--bandhavgarh': jungle === 'bandhavgarh', 'tours-hero-slide--rajaji': jungle === 'rajaji', 'tours-hero-slide--ranthambore': jungle === 'ranthambore', 'is-active': index === 0 }]}
        loading={index === 0 ? 'eager' : 'lazy'}
        fetchpriority={index === 0 ? 'high' : 'auto'}
      />
      </picture>
    ))}
    <div class="tours-hero-scrim" aria-hidden="true"></div>

    {heroDeals.map((deal, index) => (
      <div class:list={['tours-hero-overlay', { 'is-active': index === 0 }]}>
        <p class="tours-hero-offer">Get up to <span class="tours-hero-offer-pct">{deal.discountPct}% OFF</span> on</p>
        <p class="tours-hero-title">
          <span class="tours-hero-title-amber">{jungleLabel.toUpperCase()}</span>
          <span class="tours-hero-title-white"> Tour Packages</span>
        </p>

        <div class="tours-hero-price-row">
          <span class="tours-hero-price-label">Starting at</span>
          <span class="tours-hero-price-strike">INR {deal.tour.originalPrice.toLocaleString('en-IN')}</span>
          <span class="tours-hero-price">INR {deal.tour.price.toLocaleString('en-IN')}</span>
          <span class="tours-hero-price-label">/Adult</span>
          <span class="tours-hero-badge">{deal.tour.bestSeason.toUpperCase()} SALE</span>
        </div>

        <a href="/customize-trip/" class="tours-hero-cta">Connect With An Expert</a>
      </div>
    ))}

  </section>

  <section class="tours-trust bg-black px-4 py-6 sm:px-6 lg:px-10">
    <div class="tours-trust-row mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-4">
      <div class="tours-trust-badge">
        <span class="tours-trust-icon">
          <Image layout="fixed" src={tripAdvisorLogo} alt="Tripadvisor" width={240} height={240} quality={100} format="png" class="h-full w-full rounded-full object-cover" loading="lazy" />
        </span>
        <span>
          <span class="tours-trust-rating">4.8/5</span>
          <span class="tours-trust-label">Trip Advisor</span>
        </span>
      </div>

      <div class="tours-trust-badge">
        <span class="tours-trust-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.85A11 11 0 0 0 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.05H2.18A11 11 0 0 0 1 12c0 1.77.43 3.45 1.18 4.95l3.66-2.85z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.05l3.66 2.85C6.71 7.3 9.14 5.38 12 5.38z" />
          </svg>
        </span>
        <span>
          <span class="tours-trust-rating">4.9/5</span>
          <span class="tours-trust-label">Google</span>
        </span>
      </div>

      <div class="tours-trust-badge">
        <span class="tours-trust-icon">
          <Image layout="fixed" src={wildExcursionsLogo} alt="Wild Excursions" width={240} height={240} quality={100} format="png" class="h-full w-full rounded-full object-cover" loading="lazy" />
        </span>
        <span>
          <span class="tours-trust-rating">{avgRating}/5</span>
          <span class="tours-trust-label">{jungleLabel} Reviews</span>
        </span>
      </div>
    </div>
  </section>

  <section class="tours-hero bg-black px-4 pb-8 pt-16 text-brand-ivory sm:px-6 lg:px-10 lg:pb-10 lg:pt-24">
    <div class="relative mx-auto max-w-6xl">
      <nav class="jungle-crumb">
        <a href="/tours/">Tours</a><span>/</span><span class="jungle-crumb-current">{jungleLabel}</span>
      </nav>

      <h1 class="text-4xl font-black uppercase leading-[0.95] sm:text-5xl lg:text-6xl">{jungleLabel} Safari Tours</h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-white/60 sm:text-base">
        {representative.shortDescription}
      </p>

      <div class="tours-coupon">
        <div class="tours-coupon-text">
          <p class="tours-coupon-label">Use this code when you enquire</p>
          <p class="tours-coupon-note">&#8377;2,000 off your first safari booking</p>
        </div>
        <button type="button" class="tours-coupon-code" data-coupon-copy data-coupon-value="WILD2000">
          <span data-coupon-code-text>WILD2000</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4" aria-hidden="true">
            <rect x="7" y="7" width="10" height="10" rx="2" />
            <path d="M4 13V5a2 2 0 0 1 2-2h8" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <section class="bg-black px-4 pb-10 pt-2 text-brand-ivory sm:px-6 lg:px-10 lg:pt-4">
    <div class="mx-auto max-w-6xl">
      <p class="tours-intro" data-intro-text>
        {representative.description}
      </p>
      <button type="button" class="tours-intro-toggle" data-intro-toggle>Read More</button>
      {jungle === 'tadoba' && (
        <p class="mt-4 text-sm text-white/60">
          See our full <a href="/tadoba-jungle-safari-booking" class="font-semibold text-brand-amber underline">Tadoba jungle safari booking guide</a> for zones, gates, timings and package pricing in one place.
        </p>
      )}
    </div>
  </section>

  {displayTestimonials.length > 0 && (
    <section class="jungle-love-section bg-black px-4 pb-16 text-brand-ivory sm:px-6 lg:px-10">
      <div class="mx-auto max-w-6xl">
        <h2 class="jungle-love-heading">People Love Our <span class="jungle-love-highlight">{jungleLabel}</span> Tours</h2>

        <div class="jungle-love-stars-arc" aria-hidden="true">
          <span class="jungle-love-star">&#9733;</span>
          <span class="jungle-love-star">&#9733;</span>
          <span class="jungle-love-star">&#9733;</span>
          <span class="jungle-love-star">&#9733;</span>
          <span class="jungle-love-star">&#9733;</span>
        </div>

        <p class="jungle-love-score">{avgRating}</p>
        <p class="jungle-love-reviews-count">{totalReviews} {jungleLabel} Reviews</p>

        <div class="jungle-love-cards-track" data-review-carousel>
          {displayTestimonials.map((t) => (
            <div class="jungle-love-card">
              <div class="jungle-love-card-top">
                <img src={t.avatar.src} alt={t.name} class="jungle-love-card-avatar" loading="lazy" />
                <div>
                  <p class="jungle-love-card-name">{t.name}</p>
                  <span class="jungle-love-card-rating">&#9733; {avgRating}</span>
                </div>
              </div>
              <p class="jungle-love-card-quote">{t.quote}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="mobile-filter-bar lg:hidden" data-mobile-filter-bar>
    <button type="button" class="mobile-filter-bar-btn" data-open-expert-dialog>
      <span>Send Enquiry</span>
    </button>
  </div>

  <dialog data-expert-dialog class="expert-dialog fixed inset-x-0 bottom-0 top-auto m-0 max-h-[85vh] w-full max-w-none overflow-y-auto rounded-t-3xl border-none bg-white p-0 text-brand-carbon shadow-2xl">
    <span class="expert-dialog-handle" aria-hidden="true"></span>
    <div class="relative p-6 sm:p-7">
      <button type="button" data-expert-dialog-close class="absolute right-5 top-5 grid h-9 w-9 place-items-center rounded-full border border-black/15 text-black/70 transition-colors hover:border-black hover:text-black" aria-label="Close">
