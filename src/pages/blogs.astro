---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { articles } from '../data/articles';
---

<Layout
  title="Blogs"
  description="Stories, guides, and safari notes from Wild Excursions — tiger tracking tips, seasonal sighting advice, and life in India's jungles."
>
  <section class="blogs-page bg-black px-4 py-16 text-brand-ivory sm:px-6 lg:px-10 lg:py-24">
    <div class="mx-auto max-w-4xl">
      <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-brand-amber">From the field</p>
      <h1 class="mt-3 text-4xl font-black uppercase leading-[0.95] sm:text-5xl">Blogs</h1>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-white/55">
        Notes from our naturalists and travelers — tracking tips, seasonal sighting advice, and life on safari.
      </p>

      <section class="clarity-library mt-10" aria-labelledby="planning-library-title">
        <div class="clarity-library-heading">
          <p>Safari planning library</p>
          <h2 id="planning-library-title">Start with a straight answer</h2>
        </div>
        <div class="clarity-library-grid">
          <a href="/top-wildlife-tour-operators-india/"><span>01</span><strong>How to choose a wildlife operator</strong><small>Permits, zones, inclusions, ethics and red flags</small></a>
          <a href="/family-wildlife-safari-india/"><span>02</span><strong>Best safaris for families &amp; kids</strong><small>Compare parks, pacing, access and comfort</small></a>
          <a href="/jungle-safari-safety-rules-india/"><span>03</span><strong>Safari safety &amp; etiquette</strong><small>Clear rules for vehicles, wildlife and photography</small></a>
          <a href="/best-wildlife-national-parks-india/"><span>04</span><strong>Which wildlife park should you choose?</strong><small>Match species, landscape and safari style</small></a>
        </div>
      </section>

      <div class="blog-list mt-12 lg:mt-16">
        {articles.map((article) => (
          <a href={`/blogs/${article.slug}/`} class="blog-list-item">
            <span class="blog-list-media">
              <Image src={article.image} alt={article.title} width={480} height={360} format="webp" quality={82} class="h-full w-full object-cover" loading="lazy" />
            </span>
            <span class="blog-list-content">
              <span class="blog-list-date">{article.date} &middot; {article.readTime}</span>
              <span class="blog-list-title">{article.title}</span>
              <span class="blog-list-excerpt">{article.excerpt}</span>
              <span class="blog-list-readmore">Read more &rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .clarity-library{border:1px solid rgba(253,203,8,.28);border-radius:1.25rem;background:linear-gradient(145deg,rgba(253,203,8,.1),rgba(255,255,255,.025));padding:1.25rem}.clarity-library-heading p{color:#fdcb08;font-size:.68rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.clarity-library-heading h2{margin-top:.35rem;font-size:clamp(1.5rem,4vw,2.2rem);font-weight:900;letter-spacing:-.03em}.clarity-library-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin-top:1.25rem}.clarity-library-grid a{display:grid;grid-template-columns:auto 1fr;column-gap:.75rem;align-items:start;border:1px solid rgba(255,255,255,.1);border-radius:.9rem;background:rgba(0,0,0,.28);padding:1rem;transition:border-color .2s,transform .2s}.clarity-library-grid a:hover{border-color:rgba(253,203,8,.55);transform:translateY(-2px)}.clarity-library-grid span{grid-row:1/3;color:#fdcb08;font-size:.7rem;font-weight:900}.clarity-library-grid strong{color:#fffbed;font-size:.9rem;line-height:1.25}.clarity-library-grid small{margin-top:.3rem;color:rgba(255,251,235,.48);font-size:.73rem;line-height:1.4}@media(max-width:640px){.clarity-library-grid{grid-template-columns:1fr}}

  .blog-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(255, 251, 235, 0.1);
  }

  .blog-list-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(255, 251, 235, 0.1);
    transition: opacity 0.2s ease;
  }

  .blog-list-item:hover {
    opacity: 0.85;
  }

  .blog-list-media {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 0.85rem;
    flex-shrink: 0;
  }

  .blog-list-content {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .blog-list-date {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(253, 203, 8, 0.85);
  }

  .blog-list-title {
    margin-top: 0.5rem;
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.3;
    color: #ffffff;
  }

  .blog-list-excerpt {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: rgba(255, 251, 235, 0.55);
  }

  .blog-list-readmore {
    margin-top: 0.85rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #fdcb08;
  }

  @media (min-width: 640px) {
    .blog-list-item {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
      padding: 2rem 0;
    }

    .blog-list-media {
      width: 14rem;
      aspect-ratio: 4 / 3;
    }

    .blog-list-title {
      font-size: 1.35rem;
    }

    .blog-list-excerpt {
      max-width: 34rem;
    }
  }

  @media (min-width: 1024px) {
    .blog-list-item {
      gap: 2.5rem;
      padding: 2.25rem 0;
    }

    .blog-list-media {
      width: 17rem;
    }

    .blog-list-title {
      font-size: 1.5rem;
    }

    .blog-list-excerpt {
      font-size: 0.95rem;
      max-width: 40rem;
    }
  }
</style>
