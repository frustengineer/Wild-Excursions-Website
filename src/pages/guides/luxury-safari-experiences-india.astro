---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { COUNTRY_CODES } from '../../data/countryCodes';
import heroImage from '../../../stock/luxury-safari-experiences-hero.webp';
import authorImage from '../../../hardik.webp';

const pageUrl = new URL('/guides/luxury-safari-experiences-india/', Astro.site).toString();
const orgId = new URL('/#organization', Astro.site).toString();
const authorId = new URL('/about/#hardik-patel', Astro.site).toString();

const faqs = [
  {
    q: 'What makes a safari “luxury” rather than just expensive?',
    a: 'A private vehicle and dedicated naturalist, access to quieter zones and gates, a lodge built to boutique-hotel design and service standards, and curated experiences beyond the game drive itself — guided walks, dining, spa, conservation programming. Price alone does not make a safari luxury; a high tariff with a shared jeep and a crowded zone is just an expensive ordinary safari.',
  },
  {
    q: 'How much does a luxury safari in India cost?',
    a: 'Nightly rates at India’s luxury safari lodges span a wide band — very roughly ₹25,000 to ₹1,35,000 or more for two people, depending on the property, the season and what is included. Confirm current-season rates and the full inclusion list (safaris, permits, naturalist, meals, transfers) before comparing two lodges, because “all-inclusive” means different things at different properties.',
  },
  {
    q: 'Is a private safari vehicle worth the extra cost?',
    a: 'For most travellers on a once-in-a-few-years trip, yes. A private jeep means you set the pace, your naturalist’s attention is on your group alone, and you are not waiting on other guests to finish photographing a sighting. It does not buy you off-route driving or extra time in the park — forest timings and routes still apply — so book it for the experience quality, not for rule exceptions.',
  },
  {
    q: 'Are Tadoba and Pench good choices for a luxury safari, or only Ranthambore and Rajasthan?',
    a: 'Central India — Pench, Tadoba, Kanha and Bandhavgarh — holds several genuinely luxury lodges and premium tented camps, with easy access from Nagpur or Jabalpur. Rajasthan’s Ranthambore is the better-known luxury circuit, but it is not the only one. The deciding factor is usually which lodge sits closest to the gate on your permit, not the reserve’s reputation.',
  },
  {
    q: 'What is the best luxury safari lodge in central India?',
    a: 'There is no single answer — it depends on the reserve, the gate on your permit, your travel dates and whether you want a tented camp or a built lodge. Rather than book from an old “best of” list, ask an operator to match a specific property to your confirmed permit and zone, and get the current tariff and inclusions in writing before you pay.',
  },
  {
    q: 'How does a luxury safari in India compare in cost to Africa?',
    a: 'Considerably less, as a rule. A comparable multi-night luxury safari in India typically costs a fraction of an East or Southern African equivalent, before you add the long-haul flights most African itineraries require from Indian and many other origins. Ask for a line-by-line quote for each so you are comparing like with like.',
  },
  {
    q: 'What should I confirm before booking a luxury lodge?',
    a: 'Get written confirmation of the nightly rate for your exact dates, what the rate includes (number of safaris, permits, naturalist, meals, drinks, transfers), the distance and drive time from the lodge to the gate printed on your permit, the room or tent category, and the cancellation terms. A luxury tariff should come with a clear, itemised inclusion list.',
  },
];

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: 'Luxury Safari Experiences in India: A Complete Guide',
      description:
        'India’s luxury safari scene mapped honestly — what actually makes a safari luxury, where the premium lodges cluster, how pricing works and how it compares to Africa.',
      image: { '@type': 'ImageObject', url: new URL(heroImage.src, Astro.site).toString(), width: 2752, height: 1536 },
      datePublished: '2026-09-04',
      dateModified: '2026-09-04',
      inLanguage: 'en-IN',
      articleSection: 'Safari Planning Guides',
      keywords: [
        'luxury safari experiences',
        'luxury safari India',
        'best luxury safari lodges India',
        'luxury tiger safari',
        'private safari India',
      ],
      author: { '@id': authorId },
      publisher: { '@id': orgId },
      mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
    },
    {
      '@type': 'Person',
      '@id': authorId,
      name: 'Hardik Patel',
      jobTitle: 'Founder and Safari Route Planner',
      url: new URL('/about/', Astro.site).toString(),
      image: new URL(authorImage.src, Astro.site).toString(),
      worksFor: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'Luxury Safari Experiences in India: A Complete Guide',
      datePublished: '2026-09-04',
      dateModified: '2026-09-04',
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      primaryImageOfPage: { '@type': 'ImageObject', url: new URL(heroImage.src, Astro.site).toString() },
      inLanguage: 'en-IN',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: 'Luxury Safari Experiences in India', item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="Luxury Safari Experiences in India: The Complete Guide"
  description="India’s real luxury safari scene, mapped honestly — what makes a safari luxury, where the premium lodges cluster, how pricing works and how it compares to Africa."
  image={heroImage.src}
  canonicalPath="/guides/luxury-safari-experiences-india/"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaGraph)} />

  <div class="guide-root">
    <section class="hero" aria-labelledby="page-title">
      <Image
        src={heroImage}
        alt="A boutique jungle-resort lounge with statement chairs and a brass chandelier, opening through a full-height window onto forested hills"
        width={2752}
        height={1536}
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="hero-img"
      />
      <div class="hero-inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/guides/">Guides</a><span aria-hidden="true">/</span>
          <span aria-current="page">Luxury safari experiences</span>
        </nav>
        <div class="eyebrow">The curated safari guide</div>
        <h1 id="page-title">Luxury Safari <em>Experiences</em></h1>
        <p class="dek">India’s real luxury safari scene, mapped honestly — what actually makes a safari luxury, where the premium lodges cluster, and how the pricing compares to Africa.</p>
        <div class="byline">
          <img class="avatar" src={authorImage.src} width="52" height="52" alt="Hardik Patel, Founder and Safari Route Planner at Wild Excursions" loading="eager" decoding="async" />
          <div>
            <b>Hardik Patel · Founder &amp; Safari Route Planner</b>
            <span>Planning Indian wildlife journeys since 2019 · Updated 4 September 2026</span>
          </div>
        </div>
      </div>
    </section>

    <div class="wrap layout">
      <article>
        <div class="quick">
          <span class="label">Quick answer</span>
          <p>A genuine luxury safari in India combines a <strong>private naturalist-led jeep</strong> (not a shared vehicle), access to lower-density zones and gates, and a lodge built to the design and service standard of India’s best boutique hotels — not just a comfortable tent. Nightly rates for named luxury properties run roughly ₹25,000 to ₹1,35,000+ for two, depending on the lodge, season and inclusions, so confirm current rates before you compare. Central India’s Pench and Tadoba hold several genuinely luxury properties that rarely appear in “best luxury safari” roundups.</p>
        </div>

        <p>A luxury safari is easy to sell and hard to define. Most coverage of the subject shows you a list of expensive lodges and lets the price imply the standard. This guide starts from the other end: what you are actually buying when a safari is described as luxury, where those experiences exist in India, and how to judge one property against another before you pay.</p>

        <section id="different" aria-labelledby="different-title">
          <h2 id="different-title">Why this luxury safari guide is different</h2>
          <p>Most pieces ranking for “luxury safari experiences” are written by lifestyle and travel media, or by Africa-first operators for whom an Indian tiger safari is one line inside a much larger Kenya, Tanzania or Botswana portfolio. They are useful for inspiration, but they are not written by anyone who books guests into these lodges season after season.</p>
          <p>That shows up as a consistent blind spot. Central India — Pench and Tadoba in particular — holds several genuinely luxury lodges and premium tented camps that rarely make the well-known roundups, even though they match or exceed the standard of the properties that do get listed. Wild Excursions plans permits, gates, stays and transfers as one route across these reserves, so this guide covers the ground the inspiration pieces skip.</p>
        </section>

        <section id="framework" aria-labelledby="framework-title">
          <h2 id="framework-title">How to judge a luxury safari before you book</h2>
          <div class="steps">
            <div class="step">
              <h3>Separate “luxury” from “expensive”</h3>
              <p>A high tariff with a shared gypsy, a crowded zone and a generic buffet is an expensive ordinary safari. Genuine luxury changes the experience itself, not just the thread count.</p>
              <ul class="choice-list">
                <li><b>Genuinely luxury</b><span>Private vehicle, dedicated naturalist, quieter zone access, considered food and design.</span></li>
                <li><b>Just expensive</b><span>Premium room rate, but a shared drive and the same zone queue as everyone else.</span></li>
                <li><b>Worth paying for</b><span>Staff-to-guest ratio, a naturalist who reads behaviour, unhurried mornings.</span></li>
                <li><b>Not worth paying for</b><span>“Luxury” framing around a promised tiger sighting no operator can honestly make.</span></li>
              </ul>
            </div>

            <div class="step" id="vehicle">
              <h3>Confirm the vehicle and the naturalist</h3>
              <p>The single biggest difference between a luxury and a standard safari is a private jeep with a naturalist whose attention is on your group alone. Ask exactly what is included.</p>
              <ul>
                <li>Is the safari vehicle private to your room, or shared with other guests?</li>
                <li>Is the naturalist employed by the lodge, and do they accompany every drive?</li>
                <li>How many safaris per night’s stay are included, and in which zones?</li>
                <li>Are park permits and guide fees inside the rate, or billed separately at the gate?</li>
              </ul>
            </div>

            <div class="step" id="zones">
              <h3>Ask about zone and gate access</h3>
              <p>Part of what a luxury lodge sells is distance from the crowd — lower-pressure zones and gates, away from the line of vehicles at a fresh sighting. This depends on where the lodge sits and which permits it can secure, so ask specifically rather than assuming.</p>
            </div>

            <div class="step">
              <h3>Hold the lodge to a boutique-hotel standard</h3>
              <p>Not “glamping” — genuinely considered architecture, cuisine and service. Look for a real staff-to-guest ratio, a kitchen that can handle dietary needs without notice, and design that feels site-specific rather than catalogue.</p>
            </div>

            <div class="step">
              <h3>Look for experiences beyond the jeep</h3>
              <p>The best luxury properties programme the hours you are not on a drive: guided walks in buffer areas, birding, a visit to a local village or craft, a spa, farm-to-table dining, sundowners. Ask for a sample day, not just a room description.</p>
            </div>

            <div class="step">
              <h3>Check that the conservation story is substantive</h3>
              <p>Several of India’s strongest luxury properties treat conservation and community work as core to the experience — rewilded land, anti-poaching support, local employment — not a line on the website. Ask what the lodge actually funds and how guests are involved.</p>
            </div>

            <div class="step">
              <h3>Get the price broken down in writing</h3>
              <p>“All-inclusive” means different things at different lodges. Ask for the same itemised structure from every property you are comparing.</p>
              <div class="table-scroll" tabindex="0" role="region" aria-label="Luxury safari cost checklist">
                <table>
                  <thead><tr><th>Cost line</th><th>Confirm in writing</th></tr></thead>
                  <tbody>
                    <tr><td>Nightly rate</td><td>Exact dates, room or tent category, single vs double occupancy</td></tr>
                    <tr><td>Safaris</td><td>Number included per night, private or shared vehicle, which zones</td></tr>
                    <tr><td>Permits &amp; guide</td><td>Inside the rate or payable at the gate</td></tr>
                    <tr><td>Meals &amp; drinks</td><td>Which meals, which drinks, in-room dining, special menus</td></tr>
                    <tr><td>Transfers</td><td>Airport or station pickup, vehicle type, drive time to the gate</td></tr>
                    <tr><td>Cancellation</td><td>Deposit, refund windows, peak-season terms</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>

        <section id="where" aria-labelledby="where-title">
          <h2 id="where-title">Where India’s luxury safari lodges cluster</h2>
          <p>Use this as an orientation, not a sightings promise. Luxury inventory, tariffs and opening dates change by season, so confirm current detail when you check permits.</p>
          <div class="table-scroll" tabindex="0" role="region" aria-label="Where India’s luxury safari lodges cluster">
            <table>
              <thead><tr><th>Region</th><th>What defines its luxury lodges</th><th>Planning watch-out</th></tr></thead>
              <tbody>
                <tr><td><a href="/tours/ranthambore/">Ranthambore &amp; Rajasthan</a></td><td>The best-known luxury circuit — established tented camps with a historic backdrop, easy from Delhi or Jaipur</td><td>Peak-season dates and preferred vehicle types book far ahead</td></tr>
                <tr><td><a href="/tours/pench/">Pench &amp; central India</a></td><td>Boutique lodges and premium tented camps near the core gates, practical from Nagpur or Jabalpur</td><td>The lodge-to-gate pairing matters more than the park name</td></tr>
                <tr><td><a href="/tours/tadoba/">Tadoba</a></td><td>A growing set of premium properties with strong tiger density and Nagpur access</td><td>Gate choice controls both drive time and which zone you can book</td></tr>
                <tr><td><a href="/tours/kanha/">Kanha &amp; Bandhavgarh</a></td><td>Large forest landscapes with long-established luxury camps</td><td>Allow for longer road transfers and cold winter starts</td></tr>
                <tr><td><a href="/tours/gir/">Gir</a></td><td>A small number of premium properties, and the only place to see Asiatic lions</td><td>Limited luxury inventory — book early</td></tr>
                <tr><td><a href="/tours/kaziranga/">Kaziranga</a></td><td>Fewer luxury options, set against rhino-and-grassland floodplain</td><td>Seasonal operation and Assam road logistics need checking</td></tr>
              </tbody>
            </table>
          </div>

          <div class="note"><strong>On specific lodge names</strong>Tariffs, inclusions and “signature experience” claims for individual properties change every season. Rather than publish a list that ages badly, we match a specific lodge to your confirmed permit, zone and dates on enquiry — with the current rate and inclusions in writing before you commit.</div>
        </section>

        <section id="africa" aria-labelledby="africa-title">
          <h2 id="africa-title">How India’s luxury safari pricing compares to Africa</h2>
          <p>This is the comparison most travellers weighing a first luxury safari actually want, and it rarely gets made directly. A comparable multi-night luxury safari in India typically costs a fraction of an East or Southern African equivalent — before you add the long-haul flights most African itineraries require from India and many other origins.</p>
          <p>The catch is that “comparable” hides a lot: trip length, number of properties, private vs shared guiding and internal flights all move the number. Ask for a line-by-line quote for each option so you are comparing like with like, and factor the flight cost and travel time into the African figure before you decide.</p>
          <div class="reality"><p><strong>Luxury buys a better experience, not a guaranteed one.</strong> A private vehicle, a great naturalist and a quiet zone stack the odds in your favour and make every hour more comfortable. They do not turn a safari into a tiger appointment — and any property that implies otherwise is selling the wrong thing.</p></div>
        </section>

        <section class="sources" id="related" aria-labelledby="sources-title">
          <h2 id="sources-title">Related planning guides</h2>
          <p>Use primary park sources for live permit, fee and identity rules. Use these Wild Excursions guides for the route decisions around your booking.</p>
          <ul>
            <li><a href="/guides/first-time-safari-planning/">First-Time Safari Planning Guide</a> — park selection, permits, timing and what really happens on drive one.</li>
            <li><a href="/guides/family-focused-wildlife-travel/">Family-Focused Wildlife Travel</a> — child readiness, park rules, private vehicles and gate-side stays.</li>
            <li><a href="/guides/ethical-safari-operator-evaluation/">Ethical Safari Operator Evaluation</a> — a checklist for vetting any operator, including on private trips.</li>
            <li><a href="/tours/tadoba/">Tadoba tours</a> and <a href="/tours/pench/">Pench tours</a> — the two central-India reserves with the strongest luxury lodge density.</li>
            <li><a href="/customize-trip/">Customise a private safari</a> — tell us your dates and we’ll match the permit, zone and lodge.</li>
          </ul>
        </section>

        <section id="faq" aria-labelledby="faq-title">
          <h2 id="faq-title">Luxury safari FAQs</h2>
          <div class="faq">
            {faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <div class="answer"><p>{f.a}</p></div>
              </details>
            ))}
          </div>
        </section>

        <section id="hardik-patel" aria-labelledby="author-title">
          <h2 id="author-title">About the author</h2>
          <div class="author-card">
            <img class="author-photo" src={authorImage.src} width="86" height="86" loading="lazy" decoding="async" alt="Hardik Patel, Founder of Wild Excursions" />
            <div>
              <strong><a href="/about/">Hardik Patel</a> · Founder &amp; Safari Route Planner</strong>
              <p>Hardik founded Wild Excursions in 2019 and coordinates permits, gates, stays, safari vehicles and road transfers for Indian wildlife journeys, including private and premium itineraries across central India. This guide was reviewed and updated on 4 September 2026.</p>
            </div>
          </div>
        </section>

        <section class="cta" aria-labelledby="cta-title">
          <h2 id="cta-title">Planning a private or luxury safari?</h2>
          <p>Tell our team your dates, arrival city and what you want from the trip. We’ll match the permit, zone and lodge — with current tariffs in writing, not guessed at from an old listicle.</p>
          <a class="button dark" href="/customize-trip/">Open the safari enquiry form <span aria-hidden="true">→</span></a>
        </section>
      </article>

      <aside aria-label="Luxury safari enquiry">
        <div class="side-inner">
          <nav class="toc" aria-label="On this page">
            <b>On this page</b>
            <ol>
              <li><a href="#different">Why this guide is different</a></li>
              <li><a href="#framework">How to judge a luxury safari</a></li>
              <li><a href="#where">Where the luxury lodges are</a></li>
              <li><a href="#africa">India vs Africa on price</a></li>
              <li><a href="#faq">Luxury safari FAQs</a></li>
            </ol>
          </nav>
          <div class="enquiry-card">
            <h3>Luxury &amp; Private Safari — Custom Trip</h3>
            <form class="enquiry-form" data-whatsapp-form>
              <input name="name" type="text" placeholder="Full Name" aria-label="Full name" autocomplete="name" required />
              <input name="email" type="email" placeholder="Email" aria-label="Email address" autocomplete="email" required />
              <div class="phone-row">
                <select name="countryCode" aria-label="Country dialing code">
                  {COUNTRY_CODES.map((c) => (
                    <option value={c.dial} selected={c.iso === 'IN'}>{c.flag} {c.dial} · {c.name}</option>
                  ))}
                </select>
                <input name="phone" type="tel" placeholder="Your Phone" aria-label="Phone number" autocomplete="tel" required />
              </div>
              <select name="travellers" aria-label="Traveller count" required>
                <option value="">Traveller Count</option>
                <option>2 Travellers</option><option>3 Travellers</option><option>4 Travellers</option><option>5+ Travellers</option>
              </select>
              <textarea name="message" placeholder="Dates, arrival city and what you want from the trip..." aria-label="Trip details"></textarea>
              <button class="send-enquiry" type="submit">Send Enquiry</button>
            </form>
          </div>
          <a class="callback" href="/contact/">Request a Callback</a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style is:global>
  @font-face{font-family:Edo;src:url('/fonts/edo.ttf') format('truetype');font-display:swap}
  @font-face{font-family:Avant;src:url('/fonts/ITCAvantGardeStd-Bk.woff2') format('woff2');font-display:swap;font-weight:400}
  @font-face{font-family:Avant;src:url('/fonts/ITCAvantGardeStd-Demi.woff2') format('woff2');font-display:swap;font-weight:600 800}
</style>

<style>
  .guide-root{
    --ink:#121711;--forest:#1d2a1e;--yellow:#fdcb08;--cream:#f7f1e4;--paper:#fffdf8;--muted:#676b62;--line:#dcd5c6;
    --shadow:0 22px 60px rgba(30,35,25,.12);--radius:22px;--max:1180px;
    background:var(--paper);color:var(--ink);
    font-family:Avant,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased;
  }
  .guide-root :where(h1,h2,h3){line-height:1.12;margin:0;color:var(--ink)}
  :where(.guide-root a){color:inherit}
  .guide-root img{display:block;max-width:100%}
  .wrap{width:min(var(--max),calc(100% - 40px));margin-inline:auto}

  .hero{position:relative;min-height:560px;color:#fff;display:grid;align-items:end;overflow:hidden;background:#10150f}
  .hero .hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
  .hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,13,8,.93) 0%,rgba(9,13,8,.7) 48%,rgba(9,13,8,.2) 78%),linear-gradient(0deg,rgba(9,13,8,.78),transparent 55%)}
  .hero-inner{position:relative;z-index:2;padding:64px clamp(22px,3.4vw,54px) 60px;max-width:820px}
  .crumbs{display:flex;align-items:center;gap:9px;flex-wrap:wrap;font-size:.75rem;color:rgba(255,255,255,.68);margin-bottom:28px}
  .crumbs a{text-decoration:none}.crumbs a:hover{color:#fff}
  .eyebrow{display:flex;align-items:center;gap:10px;color:var(--yellow);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700}
  .eyebrow:before{content:"";width:30px;height:2px;background:var(--yellow)}
  .hero h1{font-size:clamp(2.65rem,6.2vw,5.15rem);color:#fff;max-width:13ch;letter-spacing:-.045em;margin-top:16px}
  .hero h1 em{color:var(--yellow);font-family:Edo,cursive;font-style:normal;font-weight:400;letter-spacing:0}
  .dek{font-size:clamp(1rem,1.7vw,1.22rem);color:rgba(255,255,255,.78);max-width:670px;margin:23px 0 28px}
  .byline{display:flex;align-items:center;gap:13px;font-size:.83rem;color:rgba(255,255,255,.7)}
  .avatar{width:52px;height:52px;border-radius:50%;object-fit:cover;border:2px solid var(--yellow);background:#151515;flex:none}
  .byline b{color:#fff;display:block}.byline span{display:block}

  .layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:74px;padding:70px 0 110px}
  article{min-width:0}
  article p{margin:0 0 1.1em;color:#383d36;font-size:1.02rem;line-height:1.68}
  .guide-root article h2{font-size:clamp(1.75rem,3.7vw,2.8rem);letter-spacing:-.035em;margin:58px 0 20px}
  .guide-root article h3{font-size:clamp(1.2rem,2.1vw,1.62rem);margin:34px 0 12px;letter-spacing:-.02em}
  article ul,article ol{padding-left:1.35rem;color:#383d36}
  article li{padding-left:.35rem;margin:.45rem 0;line-height:1.6}
  article strong{color:var(--ink)}

  .quick{background:var(--cream);border-left:5px solid var(--yellow);border-radius:0 var(--radius) var(--radius) 0;padding:29px 31px;margin-bottom:54px;box-shadow:var(--shadow)}
  .quick .label{display:block;color:#6b5700;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;font-weight:800;margin-bottom:9px}
  .quick p{font-size:1.12rem;line-height:1.62;margin:0;color:#22281f}

  .note{border:1px dashed #b79a2a;background:#fff9d9;border-radius:14px;padding:17px 19px;color:#5b511f;font-size:.86rem;margin:22px 0}
