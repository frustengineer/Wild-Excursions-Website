<script>
  document.querySelectorAll('[data-whatsapp-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form as HTMLFormElement);
      const lines = [
        'Hello Wild Excursions, I would like help planning a private or luxury safari.',
        `Name: ${data.get('name') || ''}`,
        `Email: ${data.get('email') || ''}`,
        `Phone: ${[data.get('countryCode'), data.get('phone')].filter(Boolean).join(' ')}`,
        `Travellers: ${data.get('travellers') || ''}`,
        `Details: ${data.get('message') || '—'}`,
      ];
      window.open(`https://wa.me/917755958493?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
    });
  });
</script>
