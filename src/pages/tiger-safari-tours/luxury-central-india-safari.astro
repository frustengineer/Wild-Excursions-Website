---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { tours } from '../../data/tours';
import heroImage from '../../../home_images/bengal-tiger-wildlife-22.webp';
import comfortImage from '../../../tour_images/forest-safari-road-tour.webp';

const featuredSlugs = [
  'tadoba-grand-safari',
  'bandhavgarh-grand-safari',
  'kanha-grand-safari',
  'pench-grand-safari',
];

const featuredTours = featuredSlugs
  .map((slug) => tours.find((t) => t.slug === slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

const fmt = (n: number) => `₹${n.toLocaleString('en-IN')}`;

const trustStats = [
  { value: '4', label: 'Central India Reserves' },
  { value: '4.9', label: 'Average Rating' },
  { value: '2-4', label: 'Guests Per Jeep' },
];

const whyCards = [
  {
    number: '01',
    title: 'Handpicked Boutique Lodges',
    desc: 'Stays chosen for their proximity to the best zones and their quiet, high-comfort setting — not the nearest bed to the gate.',
  },
  {
    number: '02',
    title: 'Small, Private Jeeps',
    desc: 'No stacking strangers into a shared vehicle. Your safari, your pace, your naturalist.',
  },
  {
    number: '03',
    title: 'Territory of Known Big Males',
    desc: 'Central India’s core zones hold some of the country’s largest, most photographed dominant males — our naturalists track their territories daily.',
  },
  {
    number: '04',
    title: 'Unhurried Itineraries',
    desc: 'Extra nights and extra drives built in, so a single missed sighting never defines the whole trip.',
  },
];

const faqs = [
  {
    question: 'What makes this a "luxury" tiger safari rather than a standard one?',
    answer: 'Smaller, private jeeps instead of shared vehicles, boutique lodges chosen for comfort and location rather than price, senior naturalists, and longer itineraries with more drives built in — so pacing stays relaxed rather than rushed.',
  },
  {
    question: 'Which parks are included in the Central India luxury circuit?',
    answer: 'Tadoba, Bandhavgarh, Kanha and Pench — the four central India reserves with the country’s highest tiger density and some of its most well-documented dominant males.',
  },
  {
    question: 'Why is central India known for big male tigers specifically?',
    answer: 'These four reserves have unusually high prey density and well-established core zones, which lets dominant males hold large, stable territories for years — several of the most photographed tigers in India, past and present, have been central India males.',
  },
  {
    question: 'Can I combine more than one park in a single luxury trip?',
    answer: 'Yes — most of our luxury itineraries combine two or three of these four reserves rather than one, with private transfers between them. Share your dates and we’ll build a costed route.',
  },
  {
    question: 'What is the best time of year for this trip?',
    answer: 'Peak winter (November to February) is most comfortable for game drives; the hotter months of March to May bring tigers to waterholes more predictably and are excellent for sightings if you don’t mind the heat.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<Layout
  title="Luxury Central India Safari Tour - Best Tiger Safari Tour"
  description="Luxury Central India Safari: Take an indulgent luxury tiger safari in central India to witness some of the biggest male tigers, in style and comfort."
  canonicalPath="/tiger-safari-tours/luxury-central-india-safari/"
  image={heroImage.src}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="lcs-hero">
    <Image src={heroImage} alt="A large male Bengal tiger marking its territory on a tree in central India" width={1920} height={1080} format="webp" quality={82} class="lcs-hero-img" loading="eager" fetchpriority="high" />
    <div class="lcs-hero-overlay"></div>
    <div class="lcs-hero-content">
      <p class="lcs-hero-eyebrow"><span></span>Luxury Wildlife Safari in Central India</p>
      <h1>Luxury Central<br />India Safari</h1>
      <p class="lcs-hero-sub">An indulgent tiger safari through Tadoba, Bandhavgarh, Kanha and Pench &mdash; the reserves that hold some of India&rsquo;s biggest, most territorial male tigers &mdash; in private jeeps, boutique lodges, and an unhurried pace built for comfort.</p>
      <div class="lcs-hero-actions">
        <a href="/customize-trip/" class="lcs-cta-btn">Get a Free Custom Quote</a>
        <a href="#lcs-parks" class="lcs-hero-link">See the itineraries <span aria-hidden="true">&darr;</span></a>
      </div>
      <div class="lcs-hero-stats">
        {trustStats.map((s) => (
          <div class="lcs-hero-stat">
            <b>{s.value}</b>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="lcs-section" id="lcs-parks">
    <div class="lcs-wrap">
      <p class="lcs-kicker"><span></span>Choose your reserve</p>
      <h2>Luxury Safari Itineraries by Park</h2>
      <p class="lcs-lead">Each of these is our longest, most unhurried itinerary for the park &mdash; extra nights and extra drives built in, so a single quiet zone never defines the whole trip. All four run on private jeeps with senior naturalists.</p>

      <div class="lcs-grid">
        {featuredTours.map((tour, i) => (
          <a href={`/tours/${tour.jungle}/${tour.slug}/`} class="lcs-card" style={`--i:${i}`}>
            <div class="lcs-card-img">
              <Image src={tour.image} alt={tour.name} width={640} height={480} format="webp" quality={78} loading="lazy" />
              <div class="lcs-card-img-fade"></div>
              <span class="lcs-card-rating">&#9733; {tour.rating}</span>
            </div>
            <div class="lcs-card-body">
              <p class="lcs-card-region">{tour.jungleLabel}</p>
              <h3>{tour.name}</h3>
              <p class="lcs-card-meta">{tour.duration} &middot; {tour.reviews} reviews</p>
              <p class="lcs-card-price">
                {tour.originalPrice > tour.price && <span class="lcs-card-strike">{fmt(tour.originalPrice)}</span>}
                <b>{fmt(tour.price)}</b> <em>/person</em>
              </p>
              <span class="lcs-card-cta">View Itinerary <span aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        ))}
      </div>

      <p class="lcs-more"><a href="/tiger-safari-tours/">See all tiger safari tours <span aria-hidden="true">&rarr;</span></a> &middot; <a href="/luxury-tiger-safaris/">See our top 3 luxury circuits <span aria-hidden="true">&rarr;</span></a></p>
    </div>
  </section>

  <section class="lcs-section lcs-section--why">
    <div class="lcs-wrap">
      <p class="lcs-kicker"><span></span>Why go luxury</p>
      <h2>Built for Comfort, Not Just Ticked Boxes</h2>
      <div class="lcs-why-grid">
        {whyCards.map((c) => (
          <div class="lcs-why-card">
            <span class="lcs-why-number">{c.number}</span>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="lcs-comfort">
    <div class="lcs-wrap lcs-comfort-grid">
      <div class="lcs-comfort-img">
        <Image src={comfortImage} alt="A private safari jeep on a forest track in central India" width={900} height={700} format="webp" quality={80} loading="lazy" />
      </div>
      <div class="lcs-comfort-copy">
        <p class="lcs-kicker"><span></span>Style and comfort</p>
        <h2>Safari, Without the Compromises</h2>
        <p>A luxury central India safari means never sharing a jeep with strangers, staying at lodges chosen for their setting and service rather than proximity to the highway, and itineraries with room to breathe &mdash; an extra drive if the last one was quiet, a slower morning if you want one. It&rsquo;s the same wild forest and the same big cats, minus every friction point.</p>
        <a href="/customize-trip/" class="lcs-hero-link">Ask about a private itinerary <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="lcs-section">
    <div class="lcs-wrap lcs-wrap--narrow">
      <p class="lcs-kicker"><span></span>Questions</p>
      <h2>Luxury Central India Safari: FAQs</h2>
      <FaqAccordion faqs={faqs} />
    </div>
  </section>

  <section class="lcs-cta">
    <div class="lcs-wrap lcs-wrap--narrow lcs-cta-inner">
      <h2>Plan Your Luxury Safari</h2>
      <p>Tell us your dates and which of these four reserves interest you &mdash; we&rsquo;ll come back with a private, costed itinerary built around comfort, free.</p>
      <div class="lcs-cta-actions">
        <a href="/customize-trip/" class="lcs-cta-btn">Get a Free Custom Quote</a>
        <a href="https://wa.me/917755958493" target="_blank" rel="noopener" class="lcs-cta-whatsapp">Message us on WhatsApp</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  :root {
    --lcs-amber: #fdcb08;
    --lcs-gold: #cfa100;
  }

  .lcs-hero {
    position: relative;
    display: grid;
    place-items: end start;
    min-height: 72vh;
    overflow: hidden;
  }

  .lcs-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transform: scale(1.02);
  }

  .lcs-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.6) 55%, rgba(0, 0, 0, 0.94) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.15) 65%);
  }

  .lcs-hero-content {
    position: relative;
    z-index: 1;
    padding: 3rem 1.25rem 2.75rem;
    max-width: 40rem;
    color: #fffbeb;
    width: 100%;
  }

  .lcs-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lcs-amber);
    margin: 0 0 1rem;
  }

  .lcs-hero-eyebrow span {
    display: inline-block;
    width: 1.6rem;
    height: 1px;
    background: var(--lcs-amber);
  }

  .lcs-hero-content h1 {
    font-size: clamp(2.1rem, 6vw, 3.6rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  .lcs-hero-sub {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 251, 235, 0.75);
    margin: 0 0 1.75rem;
    max-width: 34rem;
  }

  .lcs-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.25rem;
  }

  .lcs-cta-btn {
    display: inline-block;
    background: var(--lcs-amber);
    color: #111;
    font-weight: 800;
    font-size: 0.88rem;
    padding: 0.95rem 1.7rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(253, 203, 8, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .lcs-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(253, 203, 8, 0.35);
  }

  .lcs-hero-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: #fffbeb;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 251, 235, 0.35);
    padding-bottom: 0.15rem;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .lcs-hero-link:hover {
    color: var(--lcs-amber);
    border-color: var(--lcs-amber);
  }

  .lcs-hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    border-top: 1px solid rgba(255, 251, 235, 0.15);
    padding-top: 1.5rem;
  }

  .lcs-hero-stat {
    display: flex;
    flex-direction: column;
  }

  .lcs-hero-stat b {
    font-size: 1.7rem;
    font-weight: 900;
    color: var(--lcs-amber);
    line-height: 1;
  }

  .lcs-hero-stat span {
    margin-top: 0.3rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 251, 235, 0.55);
  }

  .lcs-section {
    background: #000;
    padding: 4rem 1.25rem;
  }

  .lcs-section--why {
    background: #0b0b0b;
  }

  .lcs-wrap {
    max-width: 72rem;
    margin: 0 auto;
  }

  .lcs-wrap--narrow {
    max-width: 46rem;
  }

  .lcs-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lcs-gold);
    margin: 0 0 0.75rem;
  }

  .lcs-kicker span {
    display: inline-block;
    width: 1.6rem;
    height: 1px;
    background: var(--lcs-gold);
  }

  .lcs-section h2 {
    font-size: clamp(1.7rem, 3.8vw, 2.5rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fffbeb;
    margin: 0 0 1rem;
  }

  .lcs-lead {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 251, 235, 0.6);
    max-width: 44rem;
    margin: 0 0 2.5rem;
  }

  .lcs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.5rem;
  }

  .lcs-card {
    display: block;
    position: relative;
    border-radius: 1.1rem;
    overflow: hidden;
    background: #141310;
    border: 1px solid rgba(255, 251, 235, 0.08);
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    animation: lcs-card-in 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 80ms);
  }

  @keyframes lcs-card-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .lcs-card:hover {
    transform: translateY(-5px);
    border-color: rgba(253, 203, 8, 0.45);
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.5);
  }

  .lcs-card-img {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .lcs-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .lcs-card:hover .lcs-card-img img {
    transform: scale(1.06);
  }

  .lcs-card-img-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 19, 16, 0) 45%, #141310 100%);
  }

  .lcs-card-rating {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    color: #fffbeb;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.28rem 0.55rem;
    border-radius: 0.5rem;
    z-index: 1;
  }

  .lcs-card-body {
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .lcs-card-region {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lcs-amber);
    margin: 0 0 0.35rem;
  }

  .lcs-card-body h3 {
    font-size: 1.08rem;
    font-weight: 800;
    color: #fffbeb;
    margin: 0 0 0.4rem;
    line-height: 1.3;
  }

  .lcs-card-meta {
    font-size: 0.8rem;
    color: rgba(255, 251, 235, 0.5);
    margin: 0 0 0.7rem;
  }

  .lcs-card-price {
    margin: 0 0 0.85rem;
    font-size: 0.9rem;
    color: #fffbeb;
  }

  .lcs-card-strike {
    color: rgba(255, 251, 235, 0.4);
    text-decoration: line-through;
    margin-right: 0.45rem;
    font-size: 0.8rem;
  }

  .lcs-card-price b {
    font-size: 1.2rem;
    font-weight: 900;
  }

  .lcs-card-price em {
    font-style: normal;
    color: rgba(255, 251, 235, 0.5);
    font-size: 0.76rem;
  }

  .lcs-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--lcs-amber);
  }

  .lcs-more {
    margin: 2.25rem 0 0;
  }

  .lcs-more a {
    color: var(--lcs-amber);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(253, 203, 8, 0.4);
    padding-bottom: 0.15rem;
  }

  .lcs-more a:hover {
    border-color: var(--lcs-amber);
  }

  .lcs-why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));
    gap: 1.25rem;
  }

  .lcs-why-card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgba(255, 251, 235, 0.08);
    background: rgba(255, 251, 235, 0.02);
    padding: 1.5rem;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .lcs-why-card:hover {
    border-color: rgba(253, 203, 8, 0.4);
    transform: translateY(-3px);
  }

  .lcs-why-number {
    position: absolute;
    top: 1rem;
    right: 1.15rem;
    font-size: 2.25rem;
    font-weight: 800;
    color: rgba(255, 251, 235, 0.06);
    line-height: 1;
  }

  .lcs-why-card h3 {
    font-size: 1rem;
    font-weight: 800;
    color: #fffbeb;
    margin: 0 0 0.5rem;
    max-width: 11rem;
  }

  .lcs-why-card p {
    font-size: 0.87rem;
    line-height: 1.55;
    color: rgba(255, 251, 235, 0.55);
    margin: 0;
    max-width: 15rem;
  }

  .lcs-comfort {
    background: #0b0b0b;
    padding: 4rem 1.25rem;
  }

  .lcs-comfort-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    align-items: center;
  }

  .lcs-comfort-img {
    border-radius: 1.1rem;
    overflow: hidden;
    aspect-ratio: 16 / 11;
  }

  .lcs-comfort-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lcs-comfort-copy p {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 251, 235, 0.6);
    margin: 0 0 1.5rem;
  }

  @media (min-width: 900px) {
    .lcs-comfort-grid {
      grid-template-columns: 1fr 1.15fr;
    }
  }

  .lcs-cta {
    background: linear-gradient(160deg, rgba(253, 203, 8, 0.1) 0%, #000 65%);
    padding: 4.5rem 1.25rem;
    text-align: center;
  }

  .lcs-cta h2 {
    font-size: clamp(1.7rem, 3.8vw, 2.4rem);
    font-weight: 900;
    text-transform: uppercase;
    color: #fffbeb;
    margin: 0 0 0.9rem;
  }

  .lcs-cta p {
    color: rgba(255, 251, 235, 0.6);
    line-height: 1.65;
    margin: 0 0 2rem;
  }

  .lcs-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
  }

  .lcs-cta-whatsapp {
    display: inline-block;
    background: transparent;
    border: 1px solid rgba(255, 251, 235, 0.25);
    color: #fffbeb;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 0.9rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .lcs-cta-whatsapp:hover {
    border-color: var(--lcs-amber);
    color: var(--lcs-amber);
  }
</style>
