<script>
  const ENQUIRY_ENDPOINT = '/.netlify/functions/submit-enquiry';

  // First-touch attribution, kept for 30 days in localStorage: a visitor who arrives from
  // an ad and enquires three days later still carries the campaign that brought them in
  // (sessionStorage used to lose it the moment the tab closed). A fresh set of campaign
  // params in the URL always overwrites the stored one.
  const TRACKING_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'fbclid'];

  function readTracking(): Record<string, string> {
    let saved: Record<string, string> = {};
    try {
      saved = JSON.parse(localStorage.getItem('we_track') || '{}');
    } catch {
      saved = {};
    }
    const params = new URLSearchParams(window.location.search);
    const fresh = TRACKING_KEYS.some((key) => params.get(key));
    if (fresh || !saved.at || Date.now() - Number(saved.at) > 2_592_000_000) {
      saved = {
        at: String(Date.now()),
        referrer: document.referrer,
        landing_page: window.location.href,
      };
      TRACKING_KEYS.forEach((key) => {
        const value = params.get(key);
        if (value) saved[key] = value;
      });
      try {
        localStorage.setItem('we_track', JSON.stringify(saved));
      } catch {
        /* private browsing or blocked storage - attribution is best-effort */
      }
    }
    return saved;
  }

  const tracking = readTracking();

  // "Nov 2026" -> "2026-11-01", so a month picker still gives the CRM a real checkin date.
  // "Not sure yet" and "Later / 2027-28" are not dates, so they stay in remarks instead.
  function monthToDate(value: string) {
    const match = /^([A-Za-z]{3,9})[ ]+(\d{4})$/.exec(value.trim());
    if (!match) return '';
    const month = new Date(`${match[1]} 1, ${match[2]}`).getMonth();
    if (Number.isNaN(month)) return '';
    return `${match[2]}-${String(month + 1).padStart(2, '0')}-01`;
  }

  const formSources: Array<[string, string]> = [
    ['#customize-form', 'custom_trip_request'],
    ['#contact-form', 'contact_page_enquiry'],
    ['.trip-planner-form', 'homepage_trip_planner'],
    ['.enquire-form', 'homepage_enquiry'],
    ['[data-expert-dialog-form]', 'jungle_page_callback'],
    ['[data-tour-enquire-form]', 'tour_sidebar_enquiry'],
    ['[data-callback-form]', 'tour_callback_popup'],
    ['[data-itinerary-enquiry-form]', 'itinerary_enquiry_popup'],
    ['[data-group-trip-form]', 'meta_ads_group_trip'],
    ['[data-custom-trip-form]', 'meta_ads_custom_trip'],
  ];

  function sourceFor(form: HTMLFormElement) {
    return form.dataset.crmSource || formSources.find(([selector]) => form.matches(selector))?.[1] || 'website_lead_form';
  }

  // Human-readable titles sent as `formName` to the CRM, so every lead is
  // clearly labeled by which form/page it came from instead of a raw slug.
  const formLabels: Record<string, string> = {
    contact_page_enquiry: 'Contact Page Enquiry',
    custom_trip_request: 'Customize a Trip',
    homepage_trip_planner: 'Homepage Popup — Trip Planner',
    homepage_enquiry: 'Homepage Enquiry Form',
    jungle_page_callback: 'Jungle Page — Request a Callback',
    tour_sidebar_enquiry: 'Tour Page — Sidebar Enquiry',
    tour_callback_popup: 'Tour Page — Callback Popup',
    itinerary_enquiry_popup: 'Tour Page — Itinerary Enquiry',
    meta_ads_group_trip: 'Meta Ads - Tadoba group tour',
    meta_ads_custom_trip: 'Meta Ads — Custom Trip Landing Page',
    meta_ads_tadoba: 'Meta Ads — Tadoba National Park',
    meta_ads_pench: 'Meta Ads — Pench National Park',
    encyclopedia_enquiry: 'Wildlife Encyclopedia — Safari Enquiry',
    canada_safari_guide: 'Canada Safari Guide — Download',
    german_site_enquiry: 'German Website Enquiry (reply in German)',
    india_wildlife_tours_canada: 'India Wildlife Tours — Canada Page',
    tigers_central_india_tour: '14-Day Tigers of Central India — Tour Page',
    tours_index_popup: 'Tours Listing — Popup',
    jungle_page_popup: 'Jungle Page — Popup',
    tour_itinerary_popup: 'Tour Page — Popup',
    departure_itinerary_popup: 'Departure Page — Popup',
    tadoba_fixed_departure: 'Tadoba Fixed Departure Page',
    pench_fixed_departure: 'Pench Fixed Departure Page',
    guide_ethical_operator: 'Guide — Ethical Safari Operator',
    guide_family_wildlife: 'Guide — Family Wildlife Travel',
    guide_first_time_safari: 'Guide — First-Time Safari Planning',
    guide_luxury_safari: 'Guide — Luxury Safari Experiences',
    website_lead_form: 'Website Enquiry',
    website_trip_planner: 'Website Popup — Trip Planner',
  };

  function labelFor(formId: string) {
    return formLabels[formId] ?? formId.replace(/[_-]+/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
  }

  function valueFrom(data: Record<string, string>, names: string[]) {
    for (const name of names) {
      const value = data[name]?.trim();
      if (value) return value;
    }
    return '';
  }

  function validDate(value: string, fallback: string) {
    return /^\d{4}-\d{2}-\d{2}$/.test(value) ? value : fallback;
  }

  function escapeHtml(value: string) {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll(String.fromCharCode(34), '&quot;')
      .replaceAll(String.fromCharCode(39), '&#039;');
  }

  const remarkLabels: Record<string, string> = {
    nationality: 'Nationality',
    adults: 'Adults',
    children: 'Children ages 6-12',
    childrenUnder6: 'Children under 6',
    dateFlexibility: 'Date flexibility (days)',
    budget: 'Budget per person',
    safaris: 'Jeep safaris',
    resortTier: 'Resort category/value',
    transfers: 'Transfers',
    estimatedPrice: 'Estimated discounted price',
    originalPrice: 'Original price',
    savings: 'Savings',
    fromCity: 'Travelling from',
    referralSource: 'How they heard about us',
    duration: 'Trip duration',
    package: 'Package',
    tour: 'Tour',
    travelMonth: 'Travel month',
    groupSize: 'Group size',
  };

  function fieldLabel(key: string) {
    return remarkLabels[key] ?? key
      .replace(/([a-z])([A-Z])/g, '$1 $2')
      .replace(/[_-]+/g, ' ')
      .replace(/\b\w/g, (character) => character.toUpperCase());
  }

  function isLeadForm(form: HTMLFormElement) {
    // Explicitly exclude the two GET-based destination-search forms — everything else
    // that looks like a lead form should be captured regardless of its `method`
    // attribute, since a form simply forgetting `method="post"` must never silently
    // stop reaching the CRM (that exact bug is why this comment exists).
    if (form.matches('[data-journey-search-form], [data-global-journey-form]')) return false;
    return formSources.some(([selector]) => form.matches(selector)) || Boolean(form.querySelector('input[type="tel"], input[type="email"]'));
  }

  function setSubmitButtonsLoading(controls: Array<HTMLButtonElement | HTMLInputElement>, loading: boolean) {
    controls.forEach((control) => {
      control.disabled = loading;
      control.classList.toggle('is-crm-loading', loading);
      control.setAttribute('aria-busy', String(loading));
      if (control instanceof HTMLButtonElement) {
        if (loading) {
          control.dataset.crmOriginalHtml = control.innerHTML;
          const loadingLabel = /price/i.test(control.textContent ?? '') ? 'Getting price…' : 'Sending enquiry…';
          control.innerHTML = `<span class="crm-spinner" aria-hidden="true"></span><span class="crm-loading-label">${loadingLabel}</span>`;
        } else if (control.dataset.crmOriginalHtml !== undefined) {
          control.innerHTML = control.dataset.crmOriginalHtml;
          delete control.dataset.crmOriginalHtml;
        }
      } else if (loading) {
        control.dataset.crmOriginalValue = control.value;
        control.value = 'Sending…';
      } else if (control.dataset.crmOriginalValue !== undefined) {
        control.value = control.dataset.crmOriginalValue;
        delete control.dataset.crmOriginalValue;
      }
    });
  }

  // Fades/slides the success or error message in instead of the abrupt
  // display:none -> block pages toggle on `.is-visible`, so the 3-second
  // wait for the CRM/email round trip ends with a visible response instead
  // of the message just snapping into place.
  function revealMessage(el: HTMLElement | null | undefined) {
    if (!el) return;
    el.style.transition = 'opacity .35s ease, transform .35s ease';
    el.style.opacity = '0';
    el.style.transform = 'translateY(-6px)';
    el.classList.add('is-visible');
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      });
    });
  }

  // Shown when the submission itself fails: never a dead end - always a phone/WhatsApp
  // fallback, and the visitor's typed details are left in place.
  const SUBMIT_FAILED_HTML = 'Sorry, something went wrong and your details are still filled in. Please tap send again, or call or WhatsApp us on <a href="https://wa.me/917755958493" target="_blank" rel="noopener">+91 77559 58493</a>.';

  function showFormFailure(form: HTMLFormElement) {
    const error = form.querySelector<HTMLElement>('[data-crm-form-error]');
    if (!error) return;
    error.innerHTML = SUBMIT_FAILED_HTML;
    revealMessage(error);
    error.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function showFormError(form: HTMLFormElement, text: string) {
    const error = form.querySelector<HTMLElement>('[data-crm-form-error]');
    if (!error) return;
    error.textContent = text;
    revealMessage(error);
    error.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  async function submitEnquiry(body: Record<string, unknown>) {
    // keepalive: the request finishes even if the visitor closes/leaves the page right after
    // tapping submit, since the success message is shown before the server answers
    const response = await fetch(ENQUIRY_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
      keepalive: true,
    });
    const result = await response.json().catch(() => null);
    if (!response.ok || !result?.ok) {
      throw new Error(result?.message || 'Unable to submit enquiry');
    }
    return result;
  }

  // Astro's development hot reload can evaluate this component more than once.
  // Keep one document-level listener so a single click never creates duplicate
  // CRM leads or sends duplicate emails.
  const leadCaptureWindow = window as Window & { __weCrmLeadCaptureBound?: boolean };
  if (!leadCaptureWindow.__weCrmLeadCaptureBound) document.addEventListener('submit', async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !isLeadForm(form)) return;
    event.preventDefault();
    if (form.dataset.crmSubmitting === 'true') return;

    const raw: Record<string, string> = {};
    new FormData(form).forEach((value, key) => {
      if (typeof value !== 'string') return;
      raw[key] = raw[key] ? `${raw[key]}, ${value}` : value;
    });

    const campaignKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
    const formId = sourceFor(form);
    if (formId === 'custom_trip_request' && (!raw.startDate || !raw.endDate)) {
      const error = form.querySelector<HTMLElement>('[data-crm-form-error]');
      if (error) {
        error.textContent = 'Please select your travel dates before submitting.';
        revealMessage(error);
      }
      return;
    }
    const name = valueFrom(raw, ['name', 'fullName', 'callback-name']);
    const phoneNumber = valueFrom(raw, ['phone', 'mobile', 'callback-phone']);
    // Five guide pages name the dial-code select `countryCode` instead of `phoneCountry`;
    // both are joined into one E.164-ish value here so the CRM only ever sees one phone field.
    const dialCodeRaw = (raw.phoneCountry ?? raw.countryCode ?? '').trim();
    const phone = `${dialCodeRaw}${phoneNumber}`.replace(/\s+/g, '');
    // The CRM rejects invalid numbers outright, so stop here rather than losing the lead
    // server-side. Forms without a phone field at all (the Canada guide gate) are exempt.
    const collectsPhone = Boolean(form.querySelector('input[type="tel"], [name="phone"], [name="mobile"], [name="callback-phone"]'));
    const phoneDigits = phone.replace(/\D/g, '');
    if (collectsPhone && (phoneDigits.length < 7 || phoneDigits.length > 15)) {
      showFormError(form, 'Please enter a valid phone number with your country code.');
      return;
    }
    const email = valueFrom(raw, ['email', 'callback-email']);
    const message = valueFrom(raw, ['message', 'query', 'notes']);
    const travellers = valueFrom(raw, ['travellers', 'people']) || String(
      Number(raw.adults || 0) + Number(raw.children || 0) + Number(raw.childrenUnder6 || 0)
    );
    const today = new Date().toISOString().slice(0, 10);
    const checkin = validDate(valueFrom(raw, ['checkin', 'startDate', 'start-date', 'travel-date', 'travelDate', 'date']), today);
    const checkout = validDate(valueFrom(raw, ['checkout', 'endDate', 'end-date']), checkin);
    const destination = valueFrom(raw, ['destination', 'location']) || window.location.pathname.split('/')[2] || 'General enquiry';
    const totalpax = Math.max(1, Number.parseInt(travellers, 10) || 1);

    const mappedKeys = new Set([
      'name', 'fullName', 'fullname', 'full_name', 'callback-name',
      'email', 'callback-email', 'phone', 'mobile', 'callback-phone', 'phoneCountry',
      'destination', 'location', 'checkin', 'checkout', 'startDate', 'endDate',
      'start-date', 'end-date', 'travel-date', 'travelDate', 'date',
      'travellers', 'people', 'totalpax', 'message', 'query', 'notes',
    ]);
    const extraRemarks = Object.entries(raw)
      .filter(([key, value]) => !mappedKeys.has(key) && value.trim() !== '')
      .map(([key, value]) => `${fieldLabel(key)}: ${value.trim()}`);
    const campaignLines = campaignKeys
      .map((key) => [key, tracking[key] ?? ''] as const)
      .filter(([, value]) => Boolean(value))
      .map(([key, value]) => `${key}: ${value}`);

    // The CRM's "Other Information" field renders as HTML, so plain "\n" gets
    // collapsed — join with <br> and group into clearly labeled sections so
    // it stays readable, and always leads with which form/page it came from.
    const dialCode = dialCodeRaw;
    const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    const international = (dialCode !== '' && dialCode !== '+91') || (timeZone !== '' && timeZone !== 'Asia/Calcutta' && timeZone !== 'Asia/Kolkata');
    const remarkSections = [
      international ? `<b>International enquiry</b>${dialCode && dialCode !== '+91' ? ` (${escapeHtml(dialCode)})` : ''}: reply in the guest's daytime` : '',
      `<b>Enquiry Source:</b> ${escapeHtml(labelFor(formId))}`,
      `<b>Visitor:</b> ${escapeHtml([navigator.language, timeZone].filter(Boolean).join(' · '))}`,
      message ? `<b>Message:</b> ${escapeHtml(message)}` : '',
      extraRemarks.length ? `<b>Trip Details:</b><br>${extraRemarks.map(escapeHtml).join('<br>')}` : '',
      campaignLines.length ? `<b>Campaign:</b><br>${campaignLines.map(escapeHtml).join('<br>')}` : '',
    ].filter(Boolean);

    // ---- lead payload for the CRM lead API (dashboard.wildexcursions.in) ----
    // It has a real column per field below, so those are NOT repeated in remarks. Everything
    // else the forms collect (entry point, resort tier extras, price estimates, flexibility,
    // lodge tier, tour/package...) has no column, so it is rolled into remarks to avoid loss.
    const LEAD_COLUMN_KEYS = new Set(['nationality', 'adults', 'children', 'budget', 'safaris', 'resortTier', 'fromCity', 'referralSource']);
    const HONEYPOT_KEYS = new Set(['website', 'companyWebsite', 'company']);
    const leadRemarkLines = Object.entries(raw)
      .filter(([key, value]) => !mappedKeys.has(key) && !LEAD_COLUMN_KEYS.has(key) && !HONEYPOT_KEYS.has(key) && value.trim() !== '')
      .map(([key, value]) => `${fieldLabel(key)}: ${value.trim()}`);

    const leadNationality = valueFrom(raw, ['nationality']);
    const rawCheckout = valueFrom(raw, ['checkout', 'endDate', 'end-date']);
    const leadPayload: Record<string, string> = {
      name: name || 'Website visitor',
      email,
      phone,
      city: valueFrom(raw, ['fromCity']),
      destination,
      // A month-only picker ("Nov 2026") becomes the 1st of that month; anything
      // unparseable ("Not sure yet") falls through to the already-resolved checkin.
      checkin: checkin === today ? (monthToDate(valueFrom(raw, ['travelMonth'])) || checkin) : checkin,
      checkout: validDate(rawCheckout, '') || '',
      adults: (raw.adults ?? '').trim() || String(totalpax),
      children: String(Number(raw.children || 0) + Number(raw.childrenUnder6 || 0)),
      budget: valueFrom(raw, ['budget']),
      jeep_safaris: valueFrom(raw, ['safaris']),
      resort_category: valueFrom(raw, ['resortTier']),
      heard_about: valueFrom(raw, ['referralSource']),
      nationality: leadNationality,
      // The CRM has no nationality column yet, so it must also survive inside remarks.
      remarks: [
        leadNationality ? `Nationality: ${leadNationality}` : '',
        message,
        leadRemarkLines.join('\n'),
      ].filter(Boolean).join('\n\n'),
      form_name: labelFor(formId),
      page_url: window.location.href,
    };
    TRACKING_KEYS.concat(['referrer', 'landing_page']).forEach((key) => {
      if (tracking[key]) leadPayload[key] = tracking[key];
    });

    const payload: Record<string, string> = {
      name: name || 'Website visitor',
      email: email || 'not-provided@wildexcursions.in',
      phone: phone || 'Not provided',
      destination,
      checkin,
      checkout,
      totalpax: String(totalpax),
      formName: labelFor(formId),
      remarks: `${remarkSections.join('<br><br>')}<br><br>`,
    };

    try {
      form.dataset.crmSubmitting = 'true';
      const submitControls = Array.from(form.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button[type="submit"], input[type="submit"]'));
      setSubmitButtonsLoading(submitControls, true);
      form.setAttribute('aria-busy', 'true');
      form.querySelector<HTMLElement>('[data-crm-form-error]')?.classList.remove('is-visible');
      form.querySelector<HTMLElement>('[data-crm-form-success]')?.classList.remove('is-visible');

      const rawTravelStart = valueFrom(raw, ['checkin', 'startDate', 'start-date', 'travel-date', 'travelDate', 'date']);
      const rawTravelEnd = valueFrom(raw, ['checkout', 'endDate', 'end-date']);
      const emailDetailExcludedKeys = new Set([
        'name', 'fullName', 'fullname', 'full_name', 'callback-name',
        'email', 'callback-email', 'phone', 'mobile', 'callback-phone', 'phoneCountry',
        'destination', 'location', 'checkin', 'checkout', 'startDate', 'endDate',
        'start-date', 'end-date', 'travel-date', 'travelDate', 'date',
        'travellers', 'people', 'totalpax', 'message', 'query', 'notes',
        'tour', 'package', 'website', 'companyWebsite',
      ]);
      const emailDetails = Object.entries(raw)
        .filter(([key, value]) => !emailDetailExcludedKeys.has(key) && value.trim() !== '')
        .map(([key, value]) => ({ label: fieldLabel(key), value: value.trim() }));
      const campaign = Object.fromEntries(
        campaignKeys
          .map((key) => [key, tracking[key] ?? ''] as const)
          .filter(([, value]) => value !== '')
      );
      // Snapshot what they typed so it can be put back if the server rejects the lead.
      const typed = Array.from(form.elements)
        .filter((el): el is HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement =>
          (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) && !!el.name)
        .map((el) => ({ el, value: el.value, checked: el instanceof HTMLInputElement ? el.checked : false }));

      // Optimistic: the server round trip (Netlify function + CRM) takes 2-4s, so confirm to the
      // visitor straight away and let the request finish in the background.
      const request = submitEnquiry({
        submissionId: crypto.randomUUID(),
        honeypot: valueFrom(raw, ['website', 'companyWebsite']),
        crm: payload,
        lead: leadPayload,
        customer: {
          name,
          email,
          phone,
          destination,
          travelStart: /^\d{4}-\d{2}-\d{2}$/.test(rawTravelStart) ? rawTravelStart : '',
          travelEnd: /^\d{4}-\d{2}-\d{2}$/.test(rawTravelEnd) ? rawTravelEnd : '',
          travellers: String(totalpax),
          tour: valueFrom(raw, ['tour', 'package']),
          message,
          formName: labelFor(formId),
          pageUrl: window.location.href,
          details: emailDetails,
          campaign,
        },
      });
      const analyticsWindow = window as Window & { dataLayer?: Array<Record<string, unknown>> };
      analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
      analyticsWindow.dataLayer.push({
        event: 'generate_lead',
        form_id: formId,
        form_name: labelFor(formId),
        destination,
        page_path: window.location.pathname,
      });
      const fbq = (window as unknown as { fbq?: (...args: unknown[]) => void }).fbq;
      fbq?.('track', 'Lead', { content_name: labelFor(formId) });
      const success = form.querySelector<HTMLElement>('[data-crm-form-success]');
      revealMessage(success);
      success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      form.dispatchEvent(new CustomEvent('crm:success'));
      // Deferred so other submit listeners on this form (e.g. analytics/sheet
      // sync reading FormData) still see the submitted values — this capture-phase
      // handler otherwise runs and resets the form before they get a chance to.
      window.setTimeout(() => {
        form.reset();
        form.dispatchEvent(new CustomEvent('crm:reset'));
      }, 0);
      form.removeAttribute('aria-busy');
      setSubmitButtonsLoading(submitControls, false);

      request.then(() => {
        delete form.dataset.crmSubmitting;
      }).catch(() => {
        delete form.dataset.crmSubmitting;
        success?.classList.remove('is-visible');
        typed.forEach(({ el, value, checked }) => {
          if (el instanceof HTMLInputElement && (el.type === 'checkbox' || el.type === 'radio')) el.checked = checked;
          else el.value = value;
        });
        showFormFailure(form);
        form.dispatchEvent(new CustomEvent('crm:error'));
      });
    } catch {
      delete form.dataset.crmSubmitting;
      form.removeAttribute('aria-busy');
      setSubmitButtonsLoading(Array.from(form.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button[type="submit"], input[type="submit"]')), false);
      showFormFailure(form);
    }
  }, true);
  leadCaptureWindow.__weCrmLeadCaptureBound = true;
</script>

<style>
  @keyframes crm-spin {
    to { transform: rotate(360deg); }
  }
  @keyframes crm-loading-sheen {
    from { transform: translateX(-130%); }
    to { transform: translateX(230%); }
  }
  :global(button.is-crm-loading),
  :global(input.is-crm-loading) {
    position: relative;
    overflow: hidden;
    cursor: wait !important;
    opacity: 1 !important;
    pointer-events: none;
  }
  :global(button.is-crm-loading::before) {
    content: '';
    position: absolute;
    inset: 0;
    width: 42%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .48), transparent);
    animation: crm-loading-sheen 1.15s linear infinite;
  }
  :global(.crm-spinner) {
    display: inline-block;
    position: relative;
    z-index: 1;
    width: 16px;
    height: 16px;
    margin-right: 9px;
    vertical-align: -3px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    opacity: .72;
    animation: crm-spin 0.6s linear infinite;
  }
  /* Shared success/error styling for every lead form (scoped styles live per-file, so
     these are global - any form can drop in .we-crm-message without restyling). */
  :global(.we-crm-message) {
    display: none;
    margin: 0.85rem 0 0;
    border: 1px solid transparent;
    border-radius: 1rem;
    padding: 0.85rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.5;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  :global(.we-crm-message.is-visible) {
    display: block;
  }
  :global(.we-crm-success) {
    border-color: rgba(52, 211, 153, 0.35);
    background: rgba(52, 211, 153, 0.12);
    color: #8cf0b1;
  }
  :global(.we-crm-error) {
    border-color: rgba(248, 113, 113, 0.35);
    background: rgba(248, 113, 113, 0.12);
    color: #fca5a5;
  }
  :global(.we-crm-error a) {
    color: #fdcb08;
