---
import { personSchema } from '../data/authors';
import { lastModified } from '../utils/lastModified';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import FaqAccordion from './FaqAccordion.astro';
import PhoneCountrySelect from './PhoneCountrySelect.astro';
import { tours } from '../data/tours';
import stockCredits from '../data/stockCredits.json';
import { generateDepartures } from '../utils/departures';
import type { SeoClusterPageData } from '../data/seoCluster';
import tigerHero from '../../bengal-tiger-under-tree-01.webp';
import safariHero from '../assets/hero-carousel/bengal-tiger-forest-hero-06.webp';
import operatorHero from '../assets/hero-carousel/bengal-tiger-running-hero-03.webp';
import customHero from '../../tour_images/forest-safari-road-tour.webp';
import luxuryHero from '../../home_images/spotted-deer-wetland-01.webp';
import photoHero from '../../home_images/bengal-tiger-wildlife-29.webp';
import comparisonHero from '../../tour_images/bengal-tiger-safari-jeep-tour.webp';
import departureHero from '../../travellers_images/traveller-20-safari-friends.webp';
import corporateHero from '../../travellers_images/traveller-02-large-group.webp';
import wildlifeHero from '../../home_images/asian-elephant-wildlife-03.webp';

interface Props { page: SeoClusterPageData }
const { page } = Astro.props;

const heroImages: Record<string, ImageMetadata> = {
  tiger: operatorHero,
  guide: safariHero,
  custom: customHero,
  luxury: luxuryHero,
  photography: photoHero,
  comparison: comparisonHero,
  departures: departureHero,
  corporate: corporateHero,
  wildlife: wildlifeHero,
};
const ownPhotos = import.meta.glob<ImageMetadata>(['../../home_images/*.webp', '../../tour_images/*.webp', '../../tour_jungle/*.webp'], { eager: true, import: 'default' });
const stockPhotos = import.meta.glob<ImageMetadata>('../assets/stock/*.webp', { eager: true, import: 'default' });
/** 'home_images/x.webp' etc. for our own photos, 'stock/x.webp' for API-sourced photos. */
const ownPhoto = (path?: string) => (path ? ownPhotos[`../../${path}`] ?? stockPhotos[`../assets/${path}`] : undefined);
type StockCredit = { credit: { author: string; license: string; licenseUrl: string; source: string } };
const stockCredit = (path?: string) => (path?.startsWith('stock/') ? (stockCredits as Record<string, StockCredit>)[path.slice(6, -5)]?.credit : undefined);
const heroImage = heroImages[page.hero] ?? ownPhoto(page.hero) ?? tigerHero;
const heroCredit = stockCredit(page.hero);
const pageUrl = new URL(page.path, Astro.site).toString();
const organizationId = new URL('/#organization', Astro.site).toString();

const upcomingDepartures = page.showDepartures
  ? tours
      .filter((tour, index, list) => ['tadoba', 'pench', 'kanha', 'bandhavgarh', 'panna', 'satpura'].includes(tour.jungle) && list.findIndex((item) => item.jungle === tour.jungle) === index)
      .flatMap((tour) => generateDepartures(tour).filter((departure) => !departure.soldOut).slice(0, 1).map((departure) => ({ tour, departure })))
      .slice(0, 6)
  : [];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: page.h1, item: pageUrl },
  ],
};
const gitUpdated = lastModified(Astro.routePattern);
const updated = page.published && (!gitUpdated || page.published > gitUpdated) ? page.published : gitUpdated;
const updatedLabel = updated && new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${updated}T00:00:00`));
const mainSchema = {
  '@context': 'https://schema.org',
  '@type': page.schemaType,
  '@id': `${pageUrl}#main`,
  url: pageUrl,
  name: page.h1,
  headline: page.h1,
  description: page.description,
  image: new URL(heroImage.src, Astro.site).toString(),
  author: page.authors.filter((author) => author.prefix === 'Written by').map((author) => personSchema(author.name, author.role)),
  ...(page.published && { datePublished: page.published }),
  ...(updated && { dateModified: updated }),
  provider: { '@id': organizationId },
  publisher: { '@id': organizationId },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
const departureSchemas = upcomingDepartures.map(({ tour, departure }) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${tour.name} — ${departure.dateLabel}`,
  startDate: departure.startLabel,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: tour.jungleLabel, address: tour.region },
  offers: {
    '@type': 'Offer',
    price: departure.price,
    priceCurrency: 'INR',
    availability: 'https://schema.org/InStock',
    url: new URL(`/tours/${tour.jungle}/${tour.slug}/${departure.dateSlug}/`, Astro.site).toString(),
  },
  organizer: { '@id': organizationId },
}));
const isCorporate = page.path === '/corporate-wildlife-tours-india/';
const [focusX = '50%', focusY = '50%'] = (page.heroFocus ?? '').split(/\s+/).filter(Boolean);
const readMinutes = Math.max(3, Math.round(JSON.stringify([page.intro, page.sections, page.faqs]).replace(/<[^>]+>/g, ' ').split(/\s+/).length / 230));
const tocItems = [
  ...page.sections.map((section) => ({ id: section.id, label: section.heading })),
  ...(page.showDepartures ? [{ id: 'upcoming-departures', label: 'Upcoming departures' }] : []),
  { id: 'faqs', label: page.faqHeading },
  ...(page.sources?.length ? [{ id: 'sources', label: 'Sources' }] : []),
];
const promoTour = tours
  .filter((tour) => tour.jungle === (page.promoJungle ?? 'tadoba'))
  .sort((a, b) => a.price - b.price)[0];
---

<Layout title={page.title} description={page.description} image={heroImage.src} canonicalPath={page.path} rawTitle modified={updated}>
  <script type="application/ld+json" set:html={JSON.stringify(mainSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  {departureSchemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}

  <article class="seo-page">
    <header class="ed-banner" style={`--focus:${focusX} ${focusY};--fx:${focusX};--fy:${focusY}`}>
      <Image src={heroImage} alt={page.heroAlt} width={1920} height={1080} format="webp" quality={84} class="ed-banner-img" loading="eager" fetchpriority="high" />
      <div class="ed-banner-shade" aria-hidden="true"></div>
      {page.heroTag && (
        <div class="wx-reticle" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
          <span class="wx-reticle-tag"><span class="wx-rec"></span>{page.heroTag}</span>
        </div>
      )}
      {heroCredit && <p class="ed-banner-credit">Photo: <a href={heroCredit.source} target="_blank" rel="noopener">{heroCredit.author}</a>, {heroCredit.licenseUrl ? <a href={heroCredit.licenseUrl} target="_blank" rel="noopener">{heroCredit.license}</a> : heroCredit.license}</p>}
    </header>

    <div class="ed-wrap">
      <div class="ed-grid">
        <div class="ed-main">
          <nav class="ed-crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><span>{page.breadcrumb}</span></nav>
          <h1 class="ed-title">{page.h1}</h1>
          <p class="ed-category">{page.eyebrow}</p>
          <div class="ed-byline">
            <span class="ed-byline-mark" aria-hidden="true">WE</span>
            <p><strong>{page.authors.map((author, index) => `${index ? ' · ' : ''}${author.prefix} ${author.name}`).join('')}</strong><span>{updatedLabel && <>Updated <time datetime={updated}>{updatedLabel}</time> · </>}{readMinutes} min read{page.sources?.length ? ` · ${page.sources.length} sources` : ''}</span></p>
          </div>

          <div class="ed-answer" id="quick-answer">
            <p class="ed-answer-label">Quick answer</p>
            <p class="ed-answer-text">{page.intro}</p>
          </div>

          {page.heroStats?.length && (
            <dl class="ed-stats">
              {page.heroStats.map((stat) => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}
            </dl>
          )}

          <details class="ed-toc ed-toc-inline">
            <summary>Table of contents <span aria-hidden="true">{page.sections.length + 1}</span></summary>
            <ol>{tocItems.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol>
          </details>

          {page.commercial && (
            <div class="ed-trust" aria-label="Guest ratings">
              <div><strong>5.0★</strong><span>Google</span></div>
              <div><strong>4.9★</strong><span>JustDial</span></div>
              <div><strong>1,082+</strong><span>verified guests</span></div>
              <div><strong>24</strong><span>Indian reserves</span></div>
            </div>
          )}

          {page.sections.map((section) => (
            <section class="ed-section" id={section.id}>
              {section.kicker && <p class="ed-kicker">{section.kicker}</p>}
              <h2>{section.heading}</h2>
              {section.lead && <p class="ed-lead" set:html={section.lead} />}
              {section.paragraphs?.map((paragraph) => <p set:html={paragraph} />)}

              {section.steps && (
                <ol class="ed-steps">
                  {section.steps.map((step, index) => <li><span class="ed-step-num">{index + 1}</span><div><h3>{step.title}</h3><p set:html={step.text} /></div></li>)}
                </ol>
              )}

              {section.cards && (
                <div class="ed-cards">
                  {section.cards.map((card) => <article class="ed-card"><p class="ed-card-tag">{card.label ?? 'Field note'}</p><h3>{card.title}</h3><p set:html={card.text} />{card.href && <a class="ed-card-link" href={card.href}>Explore {card.linkLabel ?? card.title} <span aria-hidden="true">→</span></a>}</article>)}
                </div>
              )}

              {section.bullets && <ul class="ed-list">{section.bullets.map((item) => <li set:html={item} />)}</ul>}

              {section.table && (
                <div class="ed-table">
                  <table>
                    <thead><tr>{section.table.headers.map((header) => <th>{header}</th>)}</tr></thead>
                    <tbody>{section.table.rows.map((row) => <tr>{row.map((cell, cellIndex) => <td data-label={section.table!.headers[cellIndex]} set:html={cell} />)}</tr>)}</tbody>
                  </table>
                </div>
              )}

              {ownPhoto(section.image?.src) && (
                <figure class="ed-figure">
                  <Image src={ownPhoto(section.image!.src)!} alt={section.image!.alt} widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 760px" format="webp" quality={80} loading="lazy" />
                  {(section.image!.caption || stockCredit(section.image!.src)) && (
                    <figcaption>
                      {section.image!.caption}
                      {stockCredit(section.image!.src) && (() => { const c = stockCredit(section.image!.src)!; return <span class="ed-credit">{section.image!.caption && ' · '}Photo: <a href={c.source} target="_blank" rel="noopener">{c.author}</a>, {c.licenseUrl ? <a href={c.licenseUrl} target="_blank" rel="noopener">{c.license}</a> : c.license}</span>; })()}
                    </figcaption>
                  )}
                </figure>
              )}
            </section>
          ))}

          {page.showDepartures && (
            <section class="ed-section" id="upcoming-departures">
              <p class="ed-kicker">Live calendar · maintained by Tejas Paliya</p>
              <h2>Upcoming wildlife tour departures</h2>
              <p class="ed-lead">Dates and prices below come from the same departure source used by our tour pages. Availability is confirmed when you enquire.</p>
              <div class="ed-cards">
                {upcomingDepartures.map(({ tour, departure }) => (
                  <article class="ed-card">
                    <p class="ed-card-tag">{tour.region}</p>
                    <h3>{tour.jungleLabel}</h3>
                    <p><strong>{departure.dateLabel}</strong><br />{tour.duration} · from ₹{departure.price.toLocaleString('en-IN')} per person</p>
                    <a class="ed-card-link" href={`/tours/${tour.jungle}/${tour.slug}/${departure.dateSlug}/`}>Reserve this departure <span aria-hidden="true">→</span></a>
                  </article>
                ))}
              </div>
            </section>
          )}

          <section class="ed-section ed-faq" id="faqs">
            <p class="ed-kicker">Straight answers</p>
            <h2>{page.faqHeading}</h2>
            <p class="ed-lead">{page.faqIntro}</p>
            <FaqAccordion faqs={page.faqs} />
          </section>

          {page.sources?.length && (
            <section class="ed-sources" id="sources">
              <h2>Sources</h2>
              <ol>{page.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener">{source.label}</a>{source.checked && <span> · checked {source.checked}</span>}</li>)}</ol>
            </section>
          )}

          {!page.commercial && (
            <div class="ed-trust" aria-label="Guest ratings">
              <div><strong>5.0★</strong><span>Google</span></div>
              <div><strong>4.9★</strong><span>JustDial</span></div>
              <div><strong>1,082+</strong><span>verified guests</span></div>
              <div><strong>Since 2022</strong><span>Based in Nagpur</span></div>
            </div>
          )}
        </div>

        <aside class="ed-side" aria-label="Contents and trip planning">
          <div class="ed-side-sticky">
            <nav class="ed-toc" aria-label="Table of contents">
              <p class="ed-toc-title">Table of Contents</p>
              <ol>{tocItems.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol>
            </nav>
            {promoTour && (
              <a class="ed-promo" href={`/tours/${promoTour.jungle}/`}>
                <Image src={promoTour.image} alt={`${promoTour.jungleLabel} safari`} widths={[360, 640]} sizes="340px" format="webp" quality={75} loading="lazy" />
                <span class="ed-promo-body">
                  <span class="ed-promo-tag">{promoTour.jungleLabel} tours</span>
                  <strong>{promoTour.name}</strong>
                  <span>From ₹{promoTour.price.toLocaleString('en-IN')} per person · {promoTour.duration}</span>
                  <span class="ed-promo-cta">See packages →</span>
                </span>
              </a>
            )}
            <div class="ed-help">
              <p class="ed-help-title">Plan it with us</p>
              <p>Share your dates for a free quote within 24 hours.</p>
              <a class="ed-btn ed-btn-gold" href={page.ctaHref}>{page.ctaLabel}</a>
              <a class="ed-btn ed-btn-line" href="https://wa.me/917755958493">Ask on WhatsApp</a>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <section class="ed-cta" id={isCorporate ? 'corporate-enquiry' : undefined}>
      <div class="ed-cta-inner">
        <div><p class="ed-kicker">Your next step</p><h2>{page.closingHeading}</h2><p>{page.closingText}</p></div>
        {isCorporate ? (
          <form class="enquire-form seo-enquiry" data-crm-source="corporate_wildlife_retreat">
            <label>Company name<input name="company" required autocomplete="organization" /></label>
            <label>Your name<input name="name" required autocomplete="name" /></label>
            <label>Work email<input type="email" name="email" required autocomplete="email" /></label>
            <label>Phone<span class="seo-phone"><PhoneCountrySelect class="seo-phone-code" /><input type="tel" name="phone" required autocomplete="tel" /></span></label>
            <label>Group size<input type="number" name="travellers" min="4" required /></label>
            <label class="seo-enquiry-wide">What are you planning?<textarea name="message" rows="3"></textarea></label>
            <input type="text" name="website" class="seo-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <p class="seo-form-status" data-crm-form-error></p><p class="seo-form-status" data-crm-form-success>Thanks — our corporate trip lead will contact you shortly.</p>
            <button class="ed-btn ed-btn-gold seo-enquiry-wide" type="submit">Plan a corporate retreat →</button>
          </form>
        ) : (
          <div class="ed-cta-actions">
            <a class="ed-btn ed-btn-gold" href={page.ctaHref}>{page.ctaLabel} →</a>
            <a class="ed-btn ed-btn-ghost" href="https://wa.me/917755958493">WhatsApp us</a>
          </div>
        )}
      </div>
    </section>
  </article>
</Layout>

<style>
  .seo-page{--gold:#fdcb08;--gold-ink:#8a6700;--paper:#f6f3ec;--card:#fffdf8;--ink:#1d1f1a;--body:#3e4038;--muted:#6f7065;--line:#e4ded0;--forest:#16281d;background:var(--paper);color:var(--ink);font-family:Poppins,ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}

  /* Banner: the photo alone, with the viewfinder on the subject */
  .ed-banner{position:relative;height:clamp(300px,58vh,600px);overflow:hidden;background:#0b130e}
  .ed-banner-img{width:100%;height:100%;object-fit:cover;object-position:var(--focus);animation:ed-zoom 18s cubic-bezier(.2,.6,.2,1) both}
  .ed-banner-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.55) 0%,transparent 28%,transparent 75%,rgba(0,0,0,.25) 100%);pointer-events:none}
  .ed-banner-credit{position:absolute;right:.9rem;bottom:.8rem;margin:0;padding:.25rem .65rem;border-radius:999px;background:rgba(0,0,0,.45);font-size:.62rem;color:rgba(255,255,255,.75)}.ed-banner-credit a{color:inherit}
  .wx-reticle{position:absolute;z-index:2;left:var(--fx);top:var(--fy);width:clamp(104px,12vw,170px);aspect-ratio:1;transform:translate(-50%,-50%);animation:wx-lock 1.6s .5s cubic-bezier(.2,.8,.2,1) both}
  .wx-reticle i{position:absolute;width:24%;height:24%;border:2px solid var(--gold);filter:drop-shadow(0 0 6px rgba(0,0,0,.5))}
  .wx-reticle i:nth-child(1){left:0;top:0;border-right:0;border-bottom:0;border-top-left-radius:6px}
  .wx-reticle i:nth-child(2){right:0;top:0;border-left:0;border-bottom:0;border-top-right-radius:6px}
  .wx-reticle i:nth-child(3){left:0;bottom:0;border-right:0;border-top:0;border-bottom-left-radius:6px}
  .wx-reticle i:nth-child(4){right:0;bottom:0;border-left:0;border-top:0;border-bottom-right-radius:6px}
  .wx-reticle-tag{position:absolute;left:50%;top:calc(100% + .6rem);transform:translateX(-50%);display:inline-flex;align-items:center;gap:.45rem;padding:.35rem .75rem;border-radius:999px;background:rgba(8,14,10,.6);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.18);color:#fff;font:800 .6rem/1 system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}
  .wx-rec{width:.45rem;height:.45rem;border-radius:50%;background:#ff4d3d;animation:wx-blink 1.2s steps(2,start) infinite}

  /* Article + sidebar */
  .ed-wrap{width:min(1180px,calc(100% - 2rem));margin-inline:auto;padding-block:2.4rem 4rem}
  .ed-grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:3.2rem;align-items:start}
  .ed-main{min-width:0;max-width:780px}
  .ed-crumb{display:flex;flex-wrap:wrap;gap:.45rem;margin-bottom:1rem;font-size:.75rem;color:var(--muted)}.ed-crumb a{color:inherit;text-decoration:none}.ed-crumb a:hover{color:var(--gold-ink)}
  .ed-title{margin:0;font-size:clamp(1.8rem,3.4vw,2.6rem);line-height:1.18;font-weight:800;letter-spacing:-.02em;color:var(--ink)}
  .ed-category{margin:.8rem 0 0;font-size:.82rem;font-weight:700;color:var(--gold-ink)}
  .ed-byline{display:flex;align-items:center;gap:.75rem;margin-top:1.2rem;padding-bottom:1.4rem;border-bottom:1px solid var(--line)}
  .ed-byline p{margin:0;display:grid;font-size:.78rem;line-height:1.45;color:var(--muted)}.ed-byline strong{color:var(--ink)}
  .ed-byline-mark{display:grid;place-items:center;flex:none;width:2.4rem;height:2.4rem;border-radius:50%;background:var(--forest);color:var(--gold);font:800 .66rem/1 system-ui,sans-serif}

  .ed-answer{margin-top:1.6rem;padding:1.3rem 1.4rem;border-left:4px solid var(--gold);border-radius:0 14px 14px 0;background:#fff8dc}
  .ed-answer-label{margin:0 0 .4rem;font-size:.68rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-ink)}
  .ed-answer-text{margin:0;font-size:1.02rem;line-height:1.75;color:var(--ink)}
  .ed-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin:1.2rem 0 0}
  .ed-stats div{display:flex;flex-direction:column-reverse;justify-content:flex-end;gap:.25rem;padding:.9rem 1rem;border:1px solid var(--line);border-radius:14px;background:var(--card)}
  .ed-stats dd{margin:0;font:800 1.35rem/1.1 Poppins,system-ui,sans-serif;color:var(--forest)}
  .ed-stats dt{font-size:.72rem;line-height:1.35;color:var(--muted)}

  .ed-trust{display:grid;grid-template-columns:repeat(4,1fr);margin-top:2rem;border:1px solid var(--line);border-radius:14px;background:var(--card);overflow:hidden}
  .ed-trust div{padding:1rem;text-align:center;border-right:1px solid var(--line)}.ed-trust div:last-child{border-right:0}
  .ed-trust strong{display:block;font-size:1.1rem;color:var(--forest)}.ed-trust span{font-size:.68rem;color:var(--muted)}

  .ed-section{padding-top:2.6rem;scroll-margin-top:100px}
  .ed-kicker{margin:0 0 .45rem;font-size:.7rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-ink)}
  .ed-section h2,.ed-sources h2{margin:0 0 .9rem;font-size:clamp(1.35rem,2.4vw,1.75rem);line-height:1.25;font-weight:800;letter-spacing:-.015em;color:var(--ink)}
  .ed-lead{font-size:1.04rem!important;color:var(--ink)!important}
  .ed-section p{margin:0 0 1rem;font-size:.97rem;line-height:1.8;color:var(--body)}
  .ed-section :global(a:not(.ed-card-link)){color:#7a5c00;font-weight:600;text-decoration:underline;text-decoration-color:rgba(138,103,0,.4);text-underline-offset:3px}
  .ed-section :global(a:not(.ed-card-link):hover){color:var(--ink)}
  .ed-section :global(strong){color:var(--ink)}

  .ed-steps{list-style:none;margin:1.2rem 0 0;padding:0;display:grid;gap:.8rem}
  .ed-steps li{display:grid;grid-template-columns:2.2rem 1fr;gap:.9rem;padding:1rem 1.1rem;border:1px solid var(--line);border-radius:14px;background:var(--card)}
