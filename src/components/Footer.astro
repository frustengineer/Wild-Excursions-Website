    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
      <div class="footer-cta-grid">
        <div>
          <p class="footer-cta-eyebrow">Tune Into the Wild With Us</p>
          <h2 class="footer-cta-heading">Let&rsquo;s plan your next wild encounter</h2>
          <p class="footer-cta-sub">Real naturalists, honest planning, and a team that stays with you before, during, and after your safari.</p>
        </div>

        <div class="footer-cta-actions">
          <a href="tel:+917755958493" class="footer-cta-btn footer-cta-btn--primary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" class="h-4 w-4">
              <path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L184.6 167c13.7-11.1 18.4-30 11.6-46.3l-40-96z"></path>
