          <Image src={amexLogo} alt="American Express" width={557} height={316} class="h-4 w-auto" />
        </span>
        {paymentBadges.map((badge) => (
          <span class="footer-payment-badge" style={`color:${badge.color};`}>{badge.text}</span>
        ))}
        <span class="footer-payment-badge footer-payment-badge--upi">
          <Image src={upiLogo} alt="UPI - Unified Payments Interface" width={120} height={46} class="h-4 w-auto" />
        </span>
      </div>
    </div>
  </div>

  <div class="footer-bottom border-t border-brand-carbon/10 dark:border-brand-ivory/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-4 py-6 text-center text-xs text-brand-carbon/60 dark:text-brand-ivory/60 sm:px-6 lg:px-10">
      <p>&copy; {year} Wild Excursions. All rights reserved.</p>
      <p>
        <a href="tel:+917755958493" class="hover:text-brand-gold dark:hover:text-brand-amber">+91 77559 58493</a>
        &nbsp;&middot;&nbsp;
        <a href="mailto:info@wildexcursions.in" class="hover:text-brand-gold dark:hover:text-brand-amber">info@wildexcursions.in</a>
      </p>
    </div>
    <p class="footer-wordmark" aria-hidden="true">WILD EXCURSIONS</p>
  </div>
  )}
</footer>

