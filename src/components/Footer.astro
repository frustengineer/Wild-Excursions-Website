              <svg xmlns="http://www.w3.org/2000/svg" viewBox={social.viewBox} fill="currentColor" class="h-4 w-4"><path d={social.path} /></svg>
            </a>
          ) : (
            <span class="footer-social-icon footer-social-icon--pending" aria-label={`${social.label} (coming soon)`} title="Coming soon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox={social.viewBox} fill="currentColor" class="h-4 w-4"><path d={social.path} /></svg>
            </span>
          )
        ))}
      </div>

      <p class="footer-col-heading mt-8">We Accept</p>
      <div class="mt-3 flex flex-wrap items-center gap-2.5">
        <span class="footer-payment-badge" aria-label="Mastercard">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 22" class="h-4 w-6" aria-hidden="true">
            <circle cx="14" cy="11" r="9" fill="#eb001b" />
