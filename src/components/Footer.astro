      </summary>
      <ul class="mt-3 space-y-2 text-sm text-brand-carbon/70 dark:text-brand-ivory/70">
        {guideLinks.map((link) => (
          <li><a href={link.href} class="hover:text-brand-gold dark:hover:text-brand-amber">{link.label}</a></li>
        ))}
