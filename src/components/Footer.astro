  <div class="footer-region-block">
    <div class="mx-auto max-w-6xl px-4 pt-8 pb-6 sm:px-6 lg:px-10">
      <p class="footer-section-label">Explore by Reserve</p>
      <div class="footer-tabs flex flex-nowrap overflow-x-auto gap-5 sm:flex-wrap sm:gap-6 border-b border-brand-carbon/10 pb-3 dark:border-brand-ivory/10">
        {destinationsByRegion.map((group, index) => (
          <button
            type="button"
            data-footer-tab={group.region}
            class={`footer-tab text-sm font-semibold${index === 0 ? ' is-active' : ''}`}
