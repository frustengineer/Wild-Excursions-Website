---
import { Image } from 'astro:assets';
import { tours } from '../data/tours';
import type { Testimonial } from '../data/testimonials';

interface Props {
  rating: number;
  reviewCount: number;
  testimonials: Testimonial[];
  galleryImage: ImageMetadata;
}

const { rating, reviewCount, testimonials, galleryImage } = Astro.props;
const isPortraitImage = galleryImage.height > galleryImage.width;

const fiveStarCount = Math.min(reviewCount, Math.max(0, Math.round(reviewCount * (rating - 4))));
const fourStarCount = reviewCount - fiveStarCount;
const ratingBreakdown = [
  { stars: 5, count: fiveStarCount },
  { stars: 4, count: fourStarCount },
  { stars: 3, count: 0 },
  { stars: 2, count: 0 },
  { stars: 1, count: 0 },
];
const maxBreakdownCount = Math.max(...ratingBreakdown.map((b) => b.count), 1);

function bookedHref(tourSlug: string) {
  const match = tours.find((t) => t.slug === tourSlug);
  return match ? `/tours/${match.jungle}/${match.slug}` : '#';
}
---

<div class="tour-post-reviews">
  <h2 class="tour-post-reviews-heading">Reviews ({reviewCount})</h2>
  <div class="tour-post-reviews-body">
    <div class="tour-post-reviews-summary">
      <div class="tour-post-reviews-stars">
        <span class="tour-post-reviews-star tour-post-reviews-star--sm">&#9733;</span>
        <span class="tour-post-reviews-star tour-post-reviews-star--md">&#9733;</span>
        <span class="tour-post-reviews-star tour-post-reviews-star--lg">&#9733;</span>
        <span class="tour-post-reviews-star tour-post-reviews-star--md">&#9733;</span>
        <span class="tour-post-reviews-star tour-post-reviews-star--sm">&#9733;</span>
      </div>
      <p class="tour-post-reviews-score">{rating}</p>
      <p class="tour-post-reviews-caption">Verified guest reviews</p>
    </div>
    <div class="tour-post-reviews-bars">
      {ratingBreakdown.map((row) => (
        <div class="tour-post-reviews-bar-row">
          <span class="tour-post-reviews-bar-label">{row.stars} &#9733;</span>
          <div class="tour-post-reviews-bar-track">
            <div class="tour-post-reviews-bar-fill" style={`width:${(row.count / maxBreakdownCount) * 100}%`}></div>
          </div>
          <span class="tour-post-reviews-bar-count">{row.count}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<div class="tour-post-traveller-gallery">
  <h2 class="tour-post-traveller-gallery-heading">Traveller Image Gallery</h2>
  <div class="tour-post-traveller-gallery-grid" data-lightbox-group>
    <div class="tour-post-traveller-gallery-main">
      <Image src={galleryImage} alt="Traveller photo" width={900} height={900} format="webp" quality={80} class:list={['h-full w-full object-cover', { 'object-top': isPortraitImage }]} loading="lazy" />
      <button type="button" class="tour-post-traveller-gallery-viewall" data-open-lightbox>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><rect x="2.5" y="5" width="15" height="11" rx="2" /><path d="M7 5l1.2-1.8h3.6L13 5" stroke-linecap="round" stroke-linejoin="round" /><circle cx="10" cy="10.5" r="2.6" /></svg>
        View All ({reviewCount})
      </button>
    </div>
    <div class="tour-post-traveller-gallery-side">
      {[0, 1, 2, 3].map((i) => (
        <div class="tour-post-traveller-gallery-tile">
          <Image src={galleryImage} alt="" width={500} height={400} format="webp" quality={75} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</div>

{testimonials.length > 0 && (
  <div class="tour-post-testimonials">
    <div class="tour-post-testimonials-headrow">
      <div>
        <h2 class="tour-post-testimonials-heading">Popular Reviews</h2>
        <p class="tour-post-testimonials-sub">Photos, ratings, and experiences shared by verified Wild Excursions travellers</p>
      </div>
      <div class="tour-post-testimonials-score">
        <span class="tour-post-testimonials-score-value">{rating}</span>
        <span class="tour-post-testimonials-score-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="tour-post-testimonials-score-count">{reviewCount} reviews</span>
      </div>
    </div>

    <div class="tour-post-testimonials-list" data-testimonials-list>
      {testimonials.map((t, i) => (
        <div class="tour-post-testimonial-card" hidden={i >= 4}>
          <div class="tour-post-testimonial-headrow">
            <div class="tour-post-testimonial-identity">
              <Image src={t.avatar} alt={t.name} width={56} height={56} format="webp" quality={80} class="tour-post-testimonial-avatar" loading="lazy" />
              <div>
                <p class="tour-post-testimonial-name-row">{t.name} <span class="tour-post-testimonial-verified" title="Verified Guest">&#10003;</span></p>
                <p class="tour-post-testimonial-city">{t.city}</p>
              </div>
            </div>
            <span class="tour-post-testimonial-rating">&#9733; {rating}/5</span>
          </div>

          <p class="tour-post-testimonial-booked">Booked: <a href={bookedHref(t.tourSlug)}>{t.tourName} &#8599;</a></p>

          <p class="tour-post-testimonial-quote" data-quote-text>{t.quote}</p>
          <button type="button" class="tour-post-testimonial-readmore" data-quote-toggle>Read More</button>

          <div class="tour-post-testimonial-photos" data-lightbox-group>
            {[0, 1, 2, 3].map((n) => (
              <div class="tour-post-testimonial-photo">
                <Image src={galleryImage} alt="" width={160} height={160} format="webp" quality={70} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
              </div>
            ))}
            <div class="tour-post-testimonial-photo tour-post-testimonial-photo--more">
              <Image src={galleryImage} alt="" width={160} height={160} format="webp" quality={70} class={`h-full w-full object-cover ${isPortraitImage ? 'object-top' : ''}`} loading="lazy" />
              <button type="button" class="tour-post-testimonial-photo-overlay" data-open-lightbox>View All</button>
            </div>
          </div>
        </div>
      ))}
    </div>
    {testimonials.length > 4 && (
      <button type="button" class="tour-post-testimonials-more" data-testimonials-load-more>Load More Reviews</button>
    )}
  </div>
)}

<div class="photo-lightbox" data-photo-lightbox hidden>
  <div class="photo-lightbox-backdrop" data-photo-lightbox-close></div>
  <div class="photo-lightbox-panel">
    <button type="button" class="photo-lightbox-close" data-photo-lightbox-close aria-label="Close gallery">&times;</button>
    <div class="photo-lightbox-grid" data-photo-lightbox-grid></div>
  </div>
</div>

<script>
  function initTestimonialsLoadMore() {
    const btn = document.querySelector<HTMLElement>('[data-testimonials-load-more]');
    const list = document.querySelector<HTMLElement>('[data-testimonials-list]');
    if (!btn || !list) return;

    btn.addEventListener('click', () => {
      list.querySelectorAll<HTMLElement>('.tour-post-testimonial-card[hidden]').forEach((card) => {
        card.hidden = false;
      });
      btn.hidden = true;
    });
  }

  initTestimonialsLoadMore();

  function initTestimonialReadMore() {
    document.querySelectorAll<HTMLButtonElement>('[data-quote-toggle]').forEach((button) => {
      const quote = button.previousElementSibling as HTMLElement | null;
      if (!quote) return;

      button.addEventListener('click', () => {
        const expanded = quote.classList.toggle('is-expanded');
        button.textContent = expanded ? 'Read Less' : 'Read More';
      });
    });
  }

  initTestimonialReadMore();

  function initPhotoLightbox() {
    const modal = document.querySelector<HTMLElement>('[data-photo-lightbox]');
    const grid = document.querySelector<HTMLElement>('[data-photo-lightbox-grid]');
    if (!modal || !grid) return;

    function open(images: string[]) {
      grid!.innerHTML = '';
      images.forEach((src) => {
        const img = document.createElement('img');
        img.src = src;
        img.loading = 'lazy';
        img.alt = '';
        grid!.appendChild(img);
      });
      modal!.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function close() {
      modal!.hidden = true;
      document.body.style.overflow = '';
    }

    document.querySelectorAll<HTMLElement>('[data-open-lightbox]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const group = trigger.closest<HTMLElement>('[data-lightbox-group]');
        if (!group) return;
        const images = Array.from(group.querySelectorAll<HTMLImageElement>('img')).map(
          (img) => img.currentSrc || img.src
        );
        open(images);
      });
    });

    modal.querySelectorAll<HTMLElement>('[data-photo-lightbox-close]').forEach((el) => {
      el.addEventListener('click', close);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal!.hidden) close();
    });
  }

  initPhotoLightbox();
</script>

