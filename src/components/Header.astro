---
import { Image } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
import logo from '../assets/logo.png';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/tours', label: 'Tours' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/blogs', label: 'Blogs' },
];
---

<header class="sticky top-0 z-50 border-b border-brand-carbon/10 bg-brand-ivory/95 backdrop-blur dark:border-brand-ivory/10 dark:bg-brand-carbon/95">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6" aria-label="Main navigation">
    <a href="/" class="-ml-4 flex items-center gap-2 text-xl font-bold text-brand-gold dark:text-brand-amber">
      <Image src={logo} alt="" width={96} height={96} class="h-12 w-12 rounded-full object-cover" />
      Wild Excursions
    </a>

    <ul class="hidden gap-8 text-sm font-medium md:flex">
      {navItems.map((item) => (
        <li><a href={item.href} class="transition-colors hover:text-brand-gold dark:hover:text-brand-amber">{item.label}</a></li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <ThemeToggle />

      <details class="relative md:hidden">
        <summary class="-m-2 flex list-none cursor-pointer p-2" aria-label="Toggle menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <ul class="absolute right-0 mt-2 w-48 rounded-lg border border-brand-carbon/10 bg-brand-ivory p-2 shadow-lg dark:border-brand-ivory/10 dark:bg-brand-carbon">
          {navItems.map((item) => (
            <li><a href={item.href} class="block rounded px-3 py-2 hover:bg-brand-amber/10">{item.label}</a></li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>
