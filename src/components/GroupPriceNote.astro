---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p class:list={['group-price-note', className]}>
  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.4" /><circle cx="16.5" cy="9" r="2.8" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0zM14 20a5 5 0 0 1 8.5-3.6V20z" /></svg>
  Price per adult · min. group of 4
</p>

<style>
  .group-price-note {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    margin: 0.45rem 0 0;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: rgba(253, 203, 8, 0.16);
    color: inherit;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .group-price-note svg {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
    fill: #fdcb08;
  }
</style>
