---
import { currencies, commonCurrencyCodes, flagUrl } from '../data/currencies';

interface Props {
  /** `switch` is the Indian / Foreigner toggle (place it near a price); `sheet` is the currency
   *  picker it opens — render the sheet once per page, outside any container hidden on mobile. */
  part?: 'switch' | 'sheet';
  /** Foreign-national uplift for this page's park, from foreignerUplift(). */
  uplift?: number;
  class?: string;
}

const { part = 'switch', uplift = 0, class: className } = Astro.props;
---

{part === 'switch' ? (
  <div class:list={['price-switch', className]} data-page-uplift={uplift}>
    <div class="price-switch-toggle" role="group" aria-label="Your nationality">
      <button type="button" data-traveller-pick="indian" aria-pressed="true" aria-label="Indian national">Indian</button>
      <button type="button" data-traveller-pick="foreign" aria-pressed="false" aria-label="Foreign national">Foreigner</button>
    </div>
  </div>
) : (
  <div class="cur-sheet" data-cur-sheet hidden>
    <div class="cur-sheet-overlay" data-cur-close></div>
    <div class="cur-sheet-panel" role="dialog" aria-modal="true" aria-label="Currency picker">
      <div class="cur-sheet-head">
        <p>Choose your currency</p>
        <button type="button" data-cur-close aria-label="Close currency picker"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
      </div>
      <label class="cur-sheet-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" /></svg>
        <input type="text" placeholder="Search currencies" data-cur-input autocomplete="off" />
      </label>
      <div class="cur-sheet-body">
        {[
          { label: 'Commonly Used Currencies', list: currencies.filter((c) => commonCurrencyCodes.includes(c.code)) },
          { label: 'All Other Currencies', list: currencies.filter((c) => !commonCurrencyCodes.includes(c.code)) },
        ].map((group) => (
          <>
            <p class="cur-sheet-group" data-cur-group>{group.label}</p>
            <div class="cur-sheet-grid" data-cur-grid>
              {group.list.map((c) => (
                <button type="button" class="cur-sheet-item" data-cur-pick={c.code} data-cur-sym={c.symbol} data-cur-search={`${c.code} ${c.name}`.toLowerCase()}>
                  <img src={flagUrl(c.code)} alt="" width="26" height="20" loading="lazy" decoding="async" />
                  <span class="cur-sheet-code"><b>{c.code}</b> <i>&ndash;{c.symbol}</i></span>
                  <span class="cur-sheet-name">{c.name}</span>
                </button>
              ))}
            </div>
          </>
        ))}
        <p class="cur-sheet-empty" data-cur-empty hidden>No currency found.</p>
      </div>
    </div>
  </div>
)}

<script>
  import { initPriceDisplay } from '../utils/priceDisplay';
  initPriceDisplay();
</script>

<style>
  /* Translucent and colour-inheriting, so it reads on both the dark and light page surfaces. */
  .price-switch-toggle {
    display: flex; padding: .2rem; border-radius: 999px;
    background: rgba(128, 128, 128, .12); border: 1px solid rgba(128, 128, 128, .3);
  }
  .price-switch-toggle button {
    flex: 1; min-width: 0; border: 0; background: none; cursor: pointer; font: inherit;
    font-size: .82rem; font-weight: 700; color: inherit; opacity: .75; padding: .55rem .5rem; border-radius: 999px;
    transition: background .2s, color .2s, opacity .2s;
  }
  .price-switch-toggle button[aria-pressed='true'] { background: #fdcb08; color: #1a1400; opacity: 1; }
  /* light mode matches the landing pages' switch */
  :global(:where(html:not(.dark))) .price-switch-toggle { background: #f7f6f4; border-color: #e8e5e1; }
  :global(:where(html:not(.dark))) .price-switch-toggle button { color: #4a463f; opacity: 1; }
  :global(:where(html:not(.dark))) .price-switch-toggle button[aria-pressed='true'] { background: #1f1f1f; color: #fff; }

  .cur-sheet { position: fixed; inset: 0; z-index: 90; display: flex; align-items: flex-end; }
  .cur-sheet[hidden] { display: none; }
  .cur-sheet-overlay { position: absolute; inset: 0; background: rgba(15, 15, 15, .55); }
  .cur-sheet-panel {
    position: relative; z-index: 1; width: 100%; max-height: 82vh; display: flex; flex-direction: column;
    background: #fff; color: #1f1f1f; border-radius: 1.2rem 1.2rem 0 0; padding-top: .4rem;
    box-shadow: 0 -14px 44px rgba(0, 0, 0, .25); animation: cur-sheet-in .28s cubic-bezier(.2, .8, .2, 1) both;
  }
  @keyframes cur-sheet-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
  .cur-sheet-head { display: flex; align-items: center; justify-content: space-between; padding: .55rem 1.15rem .7rem; border-bottom: 1px solid #e8e5e1; }
  .cur-sheet-head p { margin: 0; font-size: 1.05rem; font-weight: 800; }
  .cur-sheet-head button { border: 0; background: none; color: #8a857e; cursor: pointer; padding: .2rem; display: grid; place-items: center; }
  .cur-sheet-head svg { width: 1.25rem; height: 1.25rem; }
  .cur-sheet-search { display: flex; align-items: center; gap: .5rem; margin: .85rem 1.15rem; padding: .7rem .85rem; border: 1px solid #e8e5e1; border-radius: .7rem; color: #8a857e; }
  .cur-sheet-search svg { width: 1.05rem; height: 1.05rem; flex-shrink: 0; }
  .cur-sheet-search input { border: 0; outline: 0; background: none; flex: 1; min-width: 0; font: inherit; font-size: 16px; color: #1f1f1f; }
  .cur-sheet-body { overflow-y: auto; padding: 0 1.15rem 1.4rem; }
  .cur-sheet-group { margin: 1rem 0 .55rem; font-size: .82rem; font-weight: 800; color: #4a463f; }
  .cur-sheet-group[hidden], .cur-sheet-grid[hidden], .cur-sheet-item[hidden], .cur-sheet-empty[hidden] { display: none; }
  .cur-sheet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem .6rem; }
  .cur-sheet-item {
    display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: .55rem; align-items: center;
    text-align: left; border: 0; background: none; cursor: pointer; padding: .55rem .4rem; border-radius: .55rem; font: inherit; color: inherit; min-width: 0;
  }
  .cur-sheet-item:hover, .cur-sheet-item.is-active { background: #f4f6f9; }
  .cur-sheet-item img { grid-row: 1 / 3; width: 1.6rem; height: auto; border-radius: 3px; box-shadow: 0 0 0 1px rgba(0, 0, 0, .09); }
  .cur-sheet-code { font-size: .86rem; overflow-wrap: anywhere; }
  .cur-sheet-code i { font-style: normal; color: #8a857e; }
  .cur-sheet-name { grid-column: 2; font-size: .72rem; color: #8a857e; line-height: 1.3; overflow-wrap: anywhere; }
  .cur-sheet-empty { text-align: center; color: #8a857e; padding: 2rem 0; }
  :global(html.dark) .cur-sheet-panel { background: #171614; color: #f1eeea; }
  :global(html.dark) .cur-sheet-head, :global(html.dark) .cur-sheet-search { border-color: #302d29; }
  :global(html.dark) .cur-sheet-search input { color: #f1eeea; }
  :global(html.dark) .cur-sheet-group { color: #cbc5bc; }
  :global(html.dark) .cur-sheet-item:hover, :global(html.dark) .cur-sheet-item.is-active { background: #201e1b; }
  @media (min-width: 768px) {
    .cur-sheet { align-items: center; justify-content: center; }
    .cur-sheet-panel { max-width: 34rem; max-height: 80vh; border-radius: 1.2rem; }
  }
</style>
