---
import '../styles/global.css';
import WildNavbar from '../components/WildNavbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CrmLeadCapture from '../components/CrmLeadCapture.astro';
import TripPlannerPopup from '../components/TripPlannerPopup.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  hideHeader?: boolean;
  hideFooterOnMobile?: boolean;
  hideWhatsAppOnMobile?: boolean;
  noindex?: boolean;
  canonicalPath?: string;
  rawTitle?: boolean;
  hideTripPlannerPopup?: boolean;
  hideFooter?: boolean;
  footerCtaOnly?: boolean;
  criticalImagePreloads?: Array<{
    href: string;
    srcset?: string;
    sizes?: string;
    media?: string;
    type?: string;
  }>;
}

const { title, description, image = '/images/og-default.jpg', hideHeader = false, hideFooterOnMobile = false, hideWhatsAppOnMobile = false, noindex = false, canonicalPath, rawTitle = false, hideTripPlannerPopup = false, hideFooter = false, footerCtaOnly = false, criticalImagePreloads = [] } = Astro.props;
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const isHomePage = Astro.url.pathname === '/';

---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {isHomePage && (
      <link
        rel="preload"
        href="/fonts/beachclub-grunge-hero-subset.woff2"
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
        fetchpriority="high"
      />
    )}
    {criticalImagePreloads.map((preload) => (
      <link
        rel="preload"
        as="image"
        href={preload.href}
        imagesrcset={preload.srcset}
        imagesizes={preload.sizes}
        media={preload.media}
        type={preload.type}
        fetchpriority="high"
      />
    ))}
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="zEm2D7M8DtyN85kfcAOls8Qa6tEt-DNTRA7Kn8hC4Tc" />


    <title>{rawTitle ? title : `${title} | Wild Excursions`}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Wild Excursions" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Wild_Excursions" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Microsoft Clarity -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y5t9aipzzq");
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'TravelAgency',
      '@id': new URL('/#organization', Astro.site).toString(),
      name: 'Wild Excursions',
      url: Astro.site,
      logo: new URL('/apple-touch-icon.png', Astro.site).toString(),
      image: new URL('/apple-touch-icon.png', Astro.site).toString(),
      telephone: '+91-7755958493',
      email: 'info@wildexcursions.in',
      priceRange: '₹₹',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '7th Floor, Shreeji Park, Plot No 19, E High Ct Rd, opposite Kachipura, Shankar Nagar, Ramdaspeth',
        addressLocality: 'Nagpur',
        addressRegion: 'Maharashtra',
        postalCode: '440010',
        addressCountry: 'IN',
      },
      sameAs: [
        'https://www.instagram.com/wildexcursions.in/',
        'https://www.facebook.com/wildexcursions.in',
        'https://x.com/Wild_Excursions',
        'https://www.linkedin.com/company/wild-excursions/',
        'https://youtube.com/@wild_excursions',
        'https://www.tripadvisor.in/Attraction_Review-g662323-d27514308-Reviews-Wild_Excursions-Nagpur_Nagpur_District_Maharashtra.html',
      ],
    })}
    />
  </head>
  <body class={`relative isolate flex min-h-screen flex-col ${hideHeader ? 'bg-brand-ivory text-brand-carbon dark:bg-black dark:text-brand-ivory' : 'bg-brand-ivory text-brand-carbon dark:bg-black dark:text-brand-ivory'}`}>
    <div class="page-progress-bar" aria-hidden="true"></div>
    {!hideHeader && <WildNavbar />}
    <main class={`flex-1 ${!hideHeader ? 'pt-[5.75rem] sm:pt-24' : ''}`}>
      <slot />
    </main>
    {!hideFooter && (
      <div class:list={{ 'hidden sm:block': hideFooterOnMobile }}>
        <Footer ctaOnly={footerCtaOnly} />
      </div>
    )}
    <div class:list={{ 'hidden sm:block': hideWhatsAppOnMobile }}>
      <WhatsAppButton />
    </div>
    <CrmLeadCapture />
    {!hideTripPlannerPopup && <TripPlannerPopup />}
    <AnalyticsConsent />

    <script>
      (function initPageProgressBar() {
        const bar = document.querySelector<HTMLElement>('.page-progress-bar');
        if (!bar) return;

        function finish() {
          bar!.style.transition = 'width 0.25s ease';
          bar!.style.width = '100%';
          bar!.classList.remove('is-active');
          window.setTimeout(() => {
            bar!.style.transition = 'opacity 0.25s ease';
            bar!.style.opacity = '0';
            window.setTimeout(() => {
              bar!.style.transition = 'none';
              bar!.style.width = '0%';
            }, 260);
          }, 200);
        }

        if (document.readyState === 'complete') finish();
        else window.addEventListener('load', finish);

        function start() {
          bar!.style.transition = 'none';
          bar!.style.width = '0%';
          bar!.style.opacity = '1';
          requestAnimationFrame(() => {
            bar!.style.transition = 'width 3.2s cubic-bezier(0.1, 0.6, 0.15, 1)';
            bar!.style.width = '78%';
            bar!.classList.add('is-active');
          });
        }

        document.addEventListener('click', (event) => {
          const link = (event.target as HTMLElement)?.closest?.('a[href]') as HTMLAnchorElement | null;
          if (!link || link.target === '_blank') return;
          if ((event as MouseEvent).metaKey || (event as MouseEvent).ctrlKey || (event as MouseEvent).shiftKey || (event as MouseEvent).altKey) return;
          let url: URL;
          try { url = new URL(link.href, location.href); } catch { return; }
          if (url.origin !== location.origin) return;
          if (url.pathname === location.pathname && url.hash) return;
          start();
        }, true);

        document.addEventListener('submit', (event) => {
          const form = event.target;
          if (!(form instanceof HTMLFormElement)) return;
          if (form.matches('[data-journey-search-form], [data-global-journey-form]')) start();
        });
      })();
    </script>

    <script>
      (function initImageLoadShimmer() {
        function markLoaded(img: HTMLImageElement) {
          img.classList.remove('wild-img-loading');
          img.classList.add('wild-img-loaded');
        }

        function track(img: HTMLImageElement) {
          if (img.complete && img.naturalWidth > 0) return;
          img.classList.add('wild-img-loading');
        }

        Array.from(document.images).forEach(track);

        document.addEventListener('load', (event) => {
          const target = event.target;
          if (target instanceof HTMLImageElement) markLoaded(target);
        }, true);

        document.addEventListener('error', (event) => {
          const target = event.target;
          if (target instanceof HTMLImageElement) markLoaded(target);
        }, true);
      })();
    </script>
  </body>
</html>
