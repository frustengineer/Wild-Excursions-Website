---
import { Image } from 'astro:assets';
import type { Source } from '../data/encyclopedia';
import { reviewedDate } from '../data/encyclopedia';
import { coverForPath, galleryForPath, type Photo } from '../data/encyclopediaMedia';
import Layout from './Layout.astro';
import PhoneCountrySelect from '../components/PhoneCountrySelect.astro';

type Fact = { label: string; value: string };
type Table = { head: string[]; rows: (string | number)[][]; caption?: string };
type Section = { title: string; paragraphs: string[]; list?: string[]; table?: Table; after?: string };
type Related = { title: string; href: string; label?: string };
type Faq = { q: string; a: string };

interface Props {
  title: string;
  /** <title> tag, ≤60 chars; defaults to `title` */
  seoTitle?: string;
  /** self-contained answer shown under the H1 for answer engines */
  quickAnswer?: string;
  /** schema.org entity the page is about */
  about?: { type: string; name: string; extra?: Record<string, unknown> };
  eyebrow: string;
  description: string;
  path: string;
  parentTitle?: string;
  parentHref?: string;
  facts?: Fact[];
  sections: Section[];
  related?: Related[];
  relatedTitle?: string;
  sources?: Source[];
  note?: string;
  highlights?: string[];
  faqs?: Faq[];
  photoNote?: string;
  /** page-specific lead CTA copy */
  cta?: { title: string; text: string };
  /** kept for older callers; the light theme no longer varies by accent */
  accent?: 'green' | 'rust' | 'gold';
}

const {
  title,
  seoTitle,
  quickAnswer,
  about,
  eyebrow,
  description,
  path,
  parentTitle = 'Wildlife Encyclopedia',
  parentHref = '/wildlife-encyclopedia/',
  facts = [],
  sections,
  related = [],
  relatedTitle = 'Continue Exploring',
  sources = [],
  note,
  highlights = [],
  faqs = [],
  photoNote,
  cta,
} = Astro.props;

const park = path.startsWith('/pench/') ? 'Pench' : path.startsWith('/tadoba/') ? 'Tadoba' : '';
const bookingHref = park === 'Pench' ? '/pench-national-park/' : park === 'Tadoba' ? '/tadoba-national-park/' : '/customize-trip/';
const planLabel = park ? `Plan your ${park} safari` : 'Plan your wildlife safari';
const phone = '+917755958493';
const whatsapp = `https://wa.me/917755958493?text=${encodeURIComponent(`Hi Wild Excursions, I read "${title}" and want help planning a ${park || 'wildlife'} safari.`)}`;
const ctaTitle = cta?.title ?? `${planLabel} with a naturalist`;
const ctaText = cta?.text ?? 'Tell us your dates. We check live permit availability, choose the right gate and stay, and send a full quote within 24 hours — free.';
const midCtas = [
  { title: ctaTitle, text: ctaText },
  { title: 'Safari permits sell out early', text: 'Permits open 120 days ahead and weekend and summer slots go first. Share your dates and we will secure permits, Gypsy and stay together.' },
];

const gallery: Photo[] = galleryForPath(path);
const inline = gallery.slice(1);
const inlineAt = (i: number) => (i === 1 ? inline[0] ?? gallery[1] : i === 3 ? inline[1] ?? gallery[2] : undefined);
const credited = gallery.filter((p) => p.credit);
const relatedCards = related.map((item) => ({ ...item, cover: coverForPath(item.href) }));

const canonicalURL = new URL(path, Astro.site ?? 'https://wildexcursions.in');
const coverURL = new URL(gallery[0].src.src, canonicalURL).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description,
      image: coverURL,
      url: canonicalURL.toString(),
      mainEntityOfPage: canonicalURL.toString(),
      dateModified: '2026-10-09',
      inLanguage: 'en-IN',
      ...(about ? { about: { '@type': about.type, name: about.name, ...about.extra } } : {}),
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.enc-answer'] },
      author: { '@type': 'Organization', name: 'Wild Excursions' },
      publisher: { '@type': 'Organization', name: 'Wild Excursions' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', canonicalURL).toString() },
        ...(parentHref !== path ? [{ '@type': 'ListItem', position: 2, name: parentTitle, item: new URL(parentHref, canonicalURL).toString() }] : []),
        { '@type': 'ListItem', position: parentHref !== path ? 3 : 2, name: title, item: canonicalURL.toString() },
      ],
    },
    ...(faqs.length
      ? [{ '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
      : []),
  ],
};

const trust = [
  { title: '30,000+', sub: 'Travellers have explored the wild with us across India.', d: 'M12 21s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.5-9.5 9-9.5 9z' },
  { title: '4.9 / 5', sub: 'Rated across TripAdvisor and Google reviews.', d: 'M12 3l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6z' },
  { title: 'Naturalist-led', sub: 'Safaris planned around official gates, seasons and permits.', d: 'M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z' },
  { title: '24/7 on-trip help', sub: 'We are reachable before, during and after your trip.', d: 'M4 12a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-1v-6h3M4 12v4a2 2 0 0 0 2 2h1v-6H4' },
];

const linkFarm = [
  { title: 'Wildlife Encyclopedia', links: [
    { label: 'Encyclopedia Home', href: '/wildlife-encyclopedia/' },
    { label: 'Tadoba Encyclopedia', href: '/tadoba/wildlife-encyclopedia/' },
    { label: 'Pench Encyclopedia', href: '/pench/wildlife-encyclopedia/' },
    { label: 'Wildlife Species Library', href: '/wildlife/' },
    { label: 'Famous Tigers of Tadoba', href: '/tadoba/famous-tigers/' },
  ]},
  { title: 'Safari Gates', links: [
    { label: 'Tadoba Gate Directory', href: '/tadoba/gates/' },
    { label: 'Moharli Gate', href: '/tadoba/gates/moharli/' },
    { label: 'Kolara Gate', href: '/tadoba/gates/kolara/' },
    { label: 'Pench Gate Directory', href: '/pench/gates/' },
    { label: 'Turia Gate', href: '/pench/gates/turia/' },
  ]},
  { title: 'Plan a Safari', links: [
    { label: 'Tadoba Safari Package', href: '/tadoba-national-park/' },
    { label: 'Pench Safari Package', href: '/pench-national-park/' },
    { label: 'All Tour Packages', href: '/tours/' },
    { label: 'Customize a Trip', href: '/customize-trip/' },
    { label: 'Contact Us', href: '/contact/' },
  ]},
];

const chevron = 'm5 7 5 5 5-5';
---

<Layout title={seoTitle ?? `${title} | Wild Excursions`} description={description} canonicalPath={path} rawTitle image={coverURL} defaultTheme="light" hideWhatsAppOnMobile>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />

  <div class="enc">
    <div class="enc-shell">
      <nav class="enc-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">›</span>
        {parentHref !== path && <><a href={parentHref}>{parentTitle}</a><span aria-hidden="true">›</span></>}
        <span aria-current="page">{title}</span>
      </nav>

      <div class="enc-gallery">
        <figure class="enc-gallery-main">
          <Image src={gallery[0].src} alt={gallery[0].alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 767px) 100vw, 1160px" format="webp" quality={80} loading="eager" fetchpriority="high" />
          <figcaption>{gallery[0].alt}</figcaption>
          <button type="button" class="enc-view-all" data-lightbox-open>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="15" cy="9" r="1.6"/><path d="M3.5 16.5 8 12a2 2 0 0 1 2.7-.1l2 1.8a2 2 0 0 0 2.8-.1L20.5 11"/></svg>
            View All {gallery.length} Images
          </button>
        </figure>
        <button type="button" class="enc-gallery-stack" data-lightbox-open aria-label={`View all ${gallery.length} photos`}>
          {gallery.slice(1, 4).map((p) => (
            <span class="enc-stack-thumb"><Image src={p.src} alt="" width={88} height={88} format="webp" quality={58} loading="lazy" /></span>
          ))}
          <span class="enc-stack-thumb enc-stack-more">+{Math.max(0, gallery.length - 3)}</span>
        </button>
      </div>
    </div>

    <div class="enc-shell enc-layout">
      <div class="enc-body">
        <h1>{title}</h1>
        <div class="enc-titlerow">
          <span class="enc-pill">{eyebrow}</span>
          <span class="enc-reviewed">
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17zm4 6.2-4.8 5.3a.9.9 0 0 1-1.3 0L6 11a.9.9 0 1 1 1.3-1.2l1.3 1.3 4.1-4.6A.9.9 0 1 1 14 7.7z"/></svg>
            Fact-checked · {reviewedDate}
          </span>
        </div>
        {quickAnswer ? (
          <div class="enc-answer">
            <p class="enc-answer-label">Quick Answer</p>
            <p>{quickAnswer}</p>
          </div>
        ) : <p class="enc-dek">{description}</p>}

        {facts.length > 0 && (
          <>
            <hr class="enc-rule" />
            <dl class="enc-facts">
              {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
            </dl>
          </>
        )}
        <hr class="enc-rule" />

        {highlights.length > 0 && (
          <section class="enc-block">
            <h2 class="enc-block-title">Highlights</h2>
            <ul class="enc-highlights">{highlights.map((h) => <li>{h}</li>)}</ul>
          </section>
        )}

        {note && (
          <aside class="enc-note">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1"/></svg>
            <div><strong>Good to know</strong><p>{note}</p></div>
          </aside>
        )}
        {photoNote && <p class="enc-photonote">{photoNote}</p>}

        <nav class="enc-tabs" aria-label="On this page">
          {sections.map((s, i) => <a href={`#section-${i + 1}`}>{s.title}</a>)}
          {faqs.length > 0 && <a href="#faqs">FAQs</a>}
        </nav>

        {sections.map((s, i) => {
          const pic = inlineAt(i);
          return (
            <>
              <section class="enc-block enc-section" id={`section-${i + 1}`}>
                <h2 class="enc-block-title">{s.title}</h2>
                {s.paragraphs.map((p) => <p>{p}</p>)}
                {s.list && <ul class="enc-highlights">{s.list.map((li) => <li>{li}</li>)}</ul>}
                {s.table && (
                  <div class="enc-table-wrap">
                    <table class="enc-table">
                      {s.table.caption && <caption>{s.table.caption}</caption>}
                      <thead><tr>{s.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                      <tbody>{s.table.rows.map((r) => <tr>{r.map((c, ci) => (ci === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>)}</tbody>
                    </table>
                  </div>
                )}
                {s.after && <p class="enc-after">{s.after}</p>}
              </section>
              {(i === 1 || i === 4) && i < sections.length - 1 && (
                <aside class="enc-cta" aria-label="Plan your safari">
                  <div>
                    <p class="enc-cta-title">{midCtas[i === 1 ? 0 : 1].title}</p>
                    <p class="enc-cta-text">{midCtas[i === 1 ? 0 : 1].text}</p>
                  </div>
                  <div class="enc-cta-btns">
                    <a href="#enquire" class="enc-btn" data-enquire>Get Free Quote</a>
                    <a href={whatsapp} class="enc-btn enc-btn-wa" target="_blank" rel="noopener">WhatsApp</a>
                  </div>
                </aside>
              )}
              {pic && i < sections.length - 1 && (
                <figure class="enc-inline">
                  <Image src={pic.src} alt={pic.alt} widths={[640, 960]} sizes="(max-width: 1023px) 100vw, 760px" format="webp" quality={76} loading="lazy" />
                  <figcaption>{pic.alt}{pic.credit && <span> · Photo: {pic.credit.author} ({pic.credit.license})</span>}</figcaption>
                </figure>
              )}
            </>
          );
        })}

        <slot />

        {faqs.length > 0 && (
          <section class="enc-block" id="faqs">
            <h2 class="enc-block-title">Frequently Asked Questions</h2>
            {faqs.map((f) => (
              <details class="enc-acc">
                <summary>{f.q}<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevron}/></svg></summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        {relatedCards.length > 0 && (
          <section class="enc-block">
            <h2 class="enc-block-title">{relatedTitle}</h2>
            <div class="enc-cards">
              {relatedCards.map((r) => (
                <a href={r.href} class="enc-card">
                  <span class="enc-card-img">
                    <Image src={r.cover.src} alt={r.cover.alt} width={360} height={270} format="webp" quality={70} loading="lazy" />
                    {r.label && <span class="enc-card-label">{r.label}</span>}
                  </span>
                  <span class="enc-card-name">{r.title}</span>
                  <span class="enc-card-cta">Read guide <span aria-hidden="true">→</span></span>
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="enc-block enc-trust" aria-label="Why travel with Wild Excursions">
          {trust.map((t) => (
            <div class="enc-trust-item">
              <span class="enc-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.d}/></svg></span>
              <p class="enc-trust-title">{t.title}</p>
              <p class="enc-trust-sub">{t.sub}</p>
            </div>
          ))}
        </section>

        <section class="enc-block">
          {sources.length > 0 && (
            <details class="enc-acc">
              <summary>Sources &amp; References<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevron}/></svg></summary>
              <p>Facts on wildlife and visitor access can change. These are the principal references for this page; always confirm current permits and rules with the responsible forest department.</p>
              <ul>{sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul>
            </details>
          )}
          <details class="enc-acc">
            <summary>Photo Credits<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={chevron}/></svg></summary>
            <p>Photos without a credit below are by Wild Excursions. The rest come from Wikimedia Commons under the licences shown.</p>
            <ul>
              {credited.map((p) => (
                <li>{p.alt} — <a href={p.credit!.source} target="_blank" rel="noopener noreferrer">{p.credit!.author}</a>, <a href={p.credit!.licenseUrl} target="_blank" rel="noopener noreferrer license">{p.credit!.license}</a></li>
              ))}
            </ul>
          </details>
        </section>

        <div class="enc-banner" id="plan">
          <Image class="enc-banner-bg" src={gallery[2].src} alt="" width={960} height={400} format="webp" quality={60} loading="lazy" />
          <div>
            <p class="enc-banner-kicker">Free safari planning · reply within 24 hours</p>
            <h2>{ctaTitle}</h2>
            <p>{ctaText}</p>
          </div>
          <div class="enc-banner-ctas">
            <a href="#enquire" class="enc-btn" data-enquire>Get Free Quote</a>
            <a href={whatsapp} class="enc-btn enc-btn-wa" target="_blank" rel="noopener">WhatsApp Us</a>
            <a href={`tel:${phone}`} class="enc-btn enc-btn-ghost">Call +91 77559 58493</a>
          </div>
        </div>
      </div>

      <aside class="enc-side" id="enquire">
        <div class="enc-side-card">
          <p class="enc-side-kicker">Free safari planning</p>
          <p class="enc-side-title">{planLabel}</p>
          <p class="enc-side-sub">Tell us your dates — a naturalist replies within 24 hours with gate, stay and permit options.</p>
          <form class="enc-form" method="post" data-crm-source="encyclopedia_enquiry">
            <input type="hidden" name="destination" value={park ? `${park} National Park` : 'Wildlife safari'} />
            <input type="hidden" name="sourcePage" value={path} />
            <input type="text" name="name" placeholder="Full Name" autocomplete="name" required />
            <input type="email" name="email" placeholder="Email" autocomplete="email" required />
            <div class="enc-form-phone">
              <PhoneCountrySelect class="enc-form-code" />
              <input type="tel" name="phone" placeholder="Your Phone" inputmode="numeric" autocomplete="tel" pattern="[0-9]{7,15}" maxlength="15" title="Digits only, 7 to 15 of them" required />
            </div>
            <div class="enc-form-row">
              <input type="date" name="travelDate" aria-label="Travel date" required />
              <select name="travellers" aria-label="Travellers" required>
                <option value="" selected disabled>Travellers</option>
                {[1, 2, 3, 4, 5, 6].map((n) => <option value={n}>{n} traveller{n > 1 ? 's' : ''}</option>)}
                <option value="7+">7+ travellers</option>
              </select>
            </div>
            <textarea name="message" rows="3" placeholder="Anything we should know?"></textarea>
            <button type="submit">Send Enquiry</button>
            <p class="enc-form-msg enc-form-ok" data-crm-form-success>Thanks — your enquiry is in. Our safari expert will reach you shortly.</p>
            <p class="enc-form-msg enc-form-err" data-crm-form-error>We couldn&rsquo;t send that. Please check your connection and try again.</p>
          </form>
        </div>
        <a href={bookingHref} class="enc-side-link">
          <span>{park ? `${park} safari packages` : 'Browse safari packages'}</span><span aria-hidden="true">→</span>
        </a>
      </aside>
    </div>

    <div class="enc-shell">
      <div class="enc-linkfarm">
        <p class="enc-linkfarm-h">Explore More</p>
        <div class="enc-linkfarm-cols">
          {linkFarm.map((col) => (
            <div><p>{col.title}</p><ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
          ))}
        </div>
      </div>
    </div>

    <div class="enc-mbar">
      <span>{planLabel}<em>Free expert advice</em></span>
      <a href="#enquire" class="enc-btn" data-enquire>Send Enquiry</a>
    </div>

    <dialog class="enc-lightbox" data-lightbox aria-label={`${title} photos`}>
      <div class="enc-lightbox-head">
        <p>{title} · {gallery.length} photos</p>
        <button type="button" data-lightbox-close aria-label="Close photos">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <div class="enc-lightbox-grid">
        {gallery.map((p) => (
          <figure>
            <Image src={p.src} alt={p.alt} widths={[480, 960]} sizes="(max-width: 767px) 100vw, 50vw" format="webp" quality={76} loading="lazy" />
            <figcaption>{p.alt}{p.credit && <span>Photo: {p.credit.author} · {p.credit.license}</span>}</figcaption>
          </figure>
        ))}
      </div>
    </dialog>
  </div>
</Layout>

<script>
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  document.querySelectorAll('[data-lightbox-open]').forEach((b) => b.addEventListener('click', () => box?.showModal()));
  box?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => box.close());
  box?.addEventListener('click', (e) => { if (e.target === box) box.close(); });
  document.querySelectorAll<HTMLAnchorElement>('[data-enquire]').forEach((a) =>
    a.addEventListener('click', () => setTimeout(() => document.querySelector<HTMLInputElement>('#enquire input[name="name"]')?.focus({ preventScroll: true }), 450)),
  );
</script>

<style>
  .enc {
    --ink: #1f1f1f; --ink-soft: #4a463f; --muted: #8a857e; --line: #e8e5e1;
    --field: #f7f6f4; --amber: #fdcb08; --gold: #cfa100; --green: #0fb680; --tint: #fff7dc;
    --page: #ffffff; --surface: #ffffff;
    background: var(--page); color: var(--ink);
    font-family: "Poppins", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 15px; line-height: 1.65; padding-bottom: 5rem;
  }
  :global(html.dark) .enc {
    --ink: #f1eeea; --ink-soft: #cbc5bc; --muted: #948d85; --line: #302d29;
    --field: #1b1a18; --page: #0e0d0c; --surface: #171614; --tint: #2a2410;
  }
  .enc * { box-sizing: border-box; }
  .enc :global(a) { color: var(--gold); text-decoration: none; }
  .enc :global(a:hover) { text-decoration: underline; }
  .enc :global(h1), .enc :global(h2) { color: var(--ink); letter-spacing: -0.01em; }
  .enc :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .enc-shell { width: min(1160px, calc(100% - 2rem)); margin-inline: auto; }
  .enc-rule { border: 0; border-top: 1px solid var(--line); margin: 1.5rem 0; }

  .enc-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; padding-top: 1.25rem; font-size: .78rem; color: var(--muted); }
  .enc-crumbs a { color: var(--ink-soft); }
  .enc-crumbs [aria-current] { color: var(--muted); }

  .enc-gallery { position: relative; margin-top: 1rem; }
  .enc-gallery-main { position: relative; margin: 0; aspect-ratio: 21 / 9; overflow: hidden; border-radius: .9rem; background: #e8e5e1; }
  .enc-gallery-main figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 2.5rem 13rem .85rem 1rem; color: #fff; font-size: .78rem; font-weight: 600; background: linear-gradient(transparent, rgba(0,0,0,.6)); }
  .enc-view-all { position: absolute; right: .8rem; bottom: .8rem; display: inline-flex; align-items: center; gap: .4rem; border: 0; cursor: pointer; background: #fff; color: #111; font: 700 .78rem/1 inherit; font-family: inherit; padding: .6rem .9rem; border-radius: .75rem; box-shadow: 0 6px 16px rgba(0,0,0,.16); }
  .enc-view-all svg { width: .95rem; height: .95rem; }
