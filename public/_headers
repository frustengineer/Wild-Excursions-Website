# Astro fingerprints everything in /_astro/ (the hash changes whenever the file does), so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts, icons and other public files keep their names across deploys, so cache them for a shorter time.
/fonts/*
  Cache-Control: public, max-age=2592000

/favicon*
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/payments/*
  Cache-Control: public, max-age=2592000
